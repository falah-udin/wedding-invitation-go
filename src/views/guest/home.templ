package guest

import "wedding-invitation-go/internal/models"

// HomePage — halaman home publik
templ HomePage(setting models.Config, templates []models.Template, isLoggedIn bool, userRole string) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ setting.SiteName } - { setting.SiteTagline }</title>
		<meta name="description" content={ setting.FooterDescription }/>
		<meta name="keywords" content="undangan pernikahan digital, buat undangan online, platform undangan digital, template undangan pernikahan, jasa undangan digital, wedding saas, undangan web rsvp"/>
		<meta name="author" content={ setting.DeveloperName }/>
		<meta name="robots" content="index, follow"/>

		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content={ setting.SiteName }/>
		<meta property="og:title" content={ setting.SiteName + " - " + setting.SiteTagline }/>
		<meta property="og:description" content={ setting.FooterDescription }/>
		<meta property="og:locale" content="id_ID"/>

		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:title" content={ setting.SiteName + " - " + setting.SiteTagline }/>
		<meta name="twitter:description" content={ setting.FooterDescription }/>

		if setting.SiteFavicon != "" {
			<link rel="icon" href={ "/storage/" + setting.SiteFavicon }/>
			<link rel="apple-touch-icon" href={ "/storage/" + setting.SiteFavicon }/>
		} else {
			if setting.SiteFavicon != "" {
			<link rel="icon" href={ "/storage/" + setting.SiteFavicon }/>
			<link rel="apple-touch-icon" href={ "/storage/" + setting.SiteFavicon }/>
		} else {
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
		}
		}

		<!-- PWA -->
		<link rel="manifest" href="/manifest.webmanifest"/>
		<meta name="theme-color" content="#8b5cf6"/>
		<meta name="apple-mobile-web-app-capable" content="yes"/>
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
		<meta name="apple-mobile-web-app-title" content="Wedding Invitation"/>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="/css/home.css?v=20261001-1"/>
	</head>
	<body>

		<nav class="navbar navbar-expand-lg fixed-top">
			<div class="container">
				<a class="navbar-brand" href="/">
					if setting.SiteFavicon != "" {
						<img src={ "/storage/" + setting.SiteFavicon } alt="Logo" style="width: 32px; height: 32px; object-fit: contain; margin-right: 8px; vertical-align: middle;"/>
					}
					<span class="wedding">Wedding</span><span class="saas">SaaS</span>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
					<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 30 30">
						<path stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-miterlimit="10" d="M4 7h22M4 15h22M4 23h22"/>
					</svg>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<div class="d-flex gap-2 ms-auto">
						if isLoggedIn {
							if userRole == "admin" {
								<a href="/admin/dashboard" class="btn btn-primary-custom">
									<i class="bi bi-speedometer2 me-2"></i>Dashboard
								</a>
							} else if userRole == "client" {
								<a href="/client/dashboard" class="btn btn-primary-custom">
									<i class="bi bi-speedometer2 me-2"></i>Dashboard
								</a>
							} else {
								<a href="/staff/dashboard" class="btn btn-primary-custom">
									<i class="bi bi-speedometer2 me-2"></i>Dashboard
								</a>
							}
						} else {
							<a href="/login" class="btn btn-login">
								<i class="bi bi-box-arrow-in-right me-2"></i>Login
							</a>
							<a href="/register" class="btn btn-primary-custom">
								<i class="bi bi-person-plus me-2"></i>Daftar
							</a>
						}
					</div>
				</div>
			</div>
		</nav>

		<section class="hero">
			<div class="hero-orb hero-orb-1"></div>
			<div class="hero-orb hero-orb-2"></div>
			<div class="hero-orb hero-orb-3"></div>

			<div class="container">
				<div class="row align-items-center">
					<div class="col-lg-12 text-center">
						<div class="hero-badge">
							if setting.SiteFavicon != "" {
								<img src={ "/storage/" + setting.SiteFavicon } alt="Logo" class="hero-badge-logo"/>
							} else {
								<span class="dot"></span>
							}
							Platform Undangan Digital
						</div>

						<h1 class="hero-title">
							Buat Undangan Pernikahan <span>Digital Gratis</span> dalam Hitungan Menit
						</h1>
						<p class="hero-subtitle">
							Platform undangan pernikahan online dengan berbagai template elegan, 
							RSVP online, guest book, dan galeri foto. Praktis, hemat, dan ramah lingkungan.
						</p>
						<div class="d-flex gap-3 justify-content-center flex-wrap">
							<a href="/login" class="btn btn-primary-custom" style="padding: 12px 30px; font-size: 0.95rem;">
								<i class="bi bi-plus-circle me-2"></i>Buat Undangan
							</a>
							<a href="#templates" class="btn btn-outline-white">
								<i class="bi bi-eye me-2"></i>Lihat Template
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="templates" class="templates section-pad">
			<div class="container">
				<h2 class="section-title">Pilihan Template</h2>
				<div class="row g-4">
					if len(templates) > 0 {
						for _, tmpl := range templates {
							<div class="col-md-3">
								<div class="template-card">
									<div class="template-image">
										if tmpl.Thumbnail != nil && *tmpl.Thumbnail != "" {
											<img src={ *tmpl.Thumbnail } alt={ tmpl.Name }/>
										} else {										
											<div class="fallback-icon">
												<i class="bi bi-brush" style="font-size: 2.5rem; color: #10b981;"></i>
											</div>
										}
									</div>
									<div class="template-body">
										<h4 class="template-name">{ tmpl.Name }</h4>
											<p class="template-desc">
												if tmpl.Description != nil {
													{ *tmpl.Description }
												}
											</p>										
											<div class="template-actions">
											<a href={ templ.URL("/preview/template/" + tmpl.Slug) } target="_blank" class="btn-template btn-template-outline">
												<i class="bi bi-eye"></i> <span>Preview</span>
											</a>
											if isLoggedIn {
												<a href="/invitation/create/select-client" class="btn-template btn-template-primary">
													<i class="bi bi-plus-circle"></i> <span>Gunakan</span>
												</a>
											} else {
												<a href="/login" class="btn-template btn-template-primary">
													<i class="bi bi-box-arrow-in-right"></i> <span>Login</span>
												</a>
											}
										</div>
									</div>
								</div>
							</div>
						}
					} else {
						<div class="col-12 text-center">
							<p class="text-secondary">Template akan segera tersedia</p>
						</div>
					}
				</div>
			</div>
		</section>

		<section id="features" class="features section-pad">
			<div class="container">
				<h2 class="section-title">Fitur Tambahan</h2>
				<div class="row g-4">
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-layout-three-columns"></i></div>
							<h3 class="feature-title">Template Elegan</h3>
							<p class="feature-desc">Pilih dari berbagai template modern, klasik, dan islami yang siap pakai.</p>
						</div>
					</div>
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-envelope-check"></i></div>
							<h3 class="feature-title">RSVP Online</h3>
							<p class="feature-desc">Tamu dapat mengirim konfirmasi kehadiran langsung dari undangan.</p>
						</div>
					</div>
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-music-note"></i></div>
							<h3 class="feature-title">Musik Latar</h3>
							<p class="feature-desc">Tambahkan musik latar dari library gratis atau upload sendiri.</p>
						</div>
					</div>
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-images"></i></div>
							<h3 class="feature-title">Galeri Foto</h3>
							<p class="feature-desc">Bagikan momen indah melalui galeri foto di undangan.</p>
						</div>
					</div>
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-graph-up"></i></div>
							<h3 class="feature-title">Analytics</h3>
							<p class="feature-desc">Lihat statistik views dan konfirmasi kehadiran.</p>
						</div>
					</div>
					<div class="col-md-4">
						<div class="feature-card">
							<div class="feature-icon"><i class="bi bi-share"></i></div>
							<h3 class="feature-title">Mudah Dibagikan</h3>
							<p class="feature-desc">Bagikan link undangan ke WhatsApp, Instagram, dan sosial media lainnya.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="cta">
			<div class="container text-center">
				<h2 class="cta-title">Siap Membuat Undangan Digital?</h2>
				<p class="cta-subtitle">
					Mulai sekarang dan buat undangan pernikahan impian Anda
				</p>
				<a href="/login" class="btn btn-cta">
					<i class="bi bi-rocket-takeoff me-2"></i>Mulai Sekarang
				</a>
			</div>
		</section>

		<footer class="footer">
			<div class="container">
				<div class="row g-4">
					<div class="col-lg-4 col-md-6">
						<h5 class="footer-brand">
							if setting.SiteFavicon != "" {
								<img src={ "/storage/" + setting.SiteFavicon } alt="Logo" style="width: 32px; height: 32px; object-fit: contain; margin-right: 8px; vertical-align: middle;"/>
							}
							<span class="wedding">Wedding</span><span class="saas">SaaS</span>
						</h5>
						<p class="footer-desc">
							{ setting.FooterDescription }
						</p>
						<div class="footer-socials">
							if setting.SocialInstagram != "" {
								<a href={ templ.URL(setting.SocialInstagram) } target="_blank" rel="noopener" class="social-link" title="Instagram">
									<i class="bi bi-instagram"></i>
								</a>
							}
							if setting.SocialFacebook != "" {
								<a href={ templ.URL(setting.SocialFacebook) } target="_blank" rel="noopener" class="social-link" title="Facebook">
									<i class="bi bi-facebook"></i>
								</a>
							}
							if setting.SocialTiktok != "" {
								<a href={ templ.URL(setting.SocialTiktok) } target="_blank" rel="noopener" class="social-link" title="TikTok">
									<i class="bi bi-tiktok"></i>
								</a>
							}
							if setting.SocialYoutube != "" {
								<a href={ templ.URL(setting.SocialYoutube) } target="_blank" rel="noopener" class="social-link" title="YouTube">
									<i class="bi bi-youtube"></i>
								</a>
							}
							if setting.SocialTwitter != "" {
								<a href={ templ.URL(setting.SocialTwitter) } target="_blank" rel="noopener" class="social-link" title="Twitter">
									<i class="bi bi-twitter-x"></i>
								</a>
							}
						</div>
					</div>

					<div class="col-lg-4 col-md-6">
						<h6 class="footer-heading">Kontak Kami</h6>
						<ul class="footer-list">
							if setting.ContactEmail != "" {
								<li>
									<i class="bi bi-envelope"></i>
									<a href={ templ.URL("mailto:" + setting.ContactEmail) }>{ setting.ContactEmail }</a>
								</li>
							}
							if setting.ContactPhone != "" {
								<li>
									<i class="bi bi-telephone"></i>
									<span>{ setting.ContactPhone }</span>
								</li>
							}
							if setting.ContactWhatsapp != "" {
								<li>
									<i class="bi bi-whatsapp"></i>
									<a href={ templ.URL("https://wa.me/" + setting.ContactWhatsapp) } target="_blank" rel="noopener">WhatsApp Chat</a>
								</li>
							}
							if setting.ContactAddress != "" {
								<li>
									<i class="bi bi-geo-alt"></i>
									<span>{ setting.ContactAddress }</span>
								</li>
							}
						</ul>
					</div>

					<div class="col-lg-4 col-md-6">
						<h6 class="footer-heading">Dikembangkan Oleh</h6>
						<p class="footer-desc mb-2">
							<i class="bi bi-code-slash me-1" style="color:#10b981;"></i>
							if setting.DeveloperUrl != "" {
								<a href={ templ.URL(setting.DeveloperUrl) } target="_blank" rel="noopener" class="footer-link">{ setting.DeveloperName }</a>
							} else {
								{ setting.DeveloperName }
							}
						</p>
						if setting.DeveloperEmail != "" {
							<p class="footer-desc mb-2">
								<i class="bi bi-envelope-at me-1"></i>
								<a href={ templ.URL("mailto:" + setting.DeveloperEmail) } class="footer-link">{ setting.DeveloperEmail }</a>
							</p>
						}
						if setting.FooterVersion != "" {
							<p class="footer-version">
								<i class="bi bi-tag me-1"></i>{ setting.FooterVersion }
							</p>
						}
						if setting.QrisImage != "" {
							<div class="qris-support-card" onclick="openQrisModal()">
								<div class="qris-support-icon">
									<img src={ "/storage/" + setting.QrisImage } alt="QRIS"/>
								</div>
								<div class="qris-support-text">
									<strong>Dukung Developer</strong>
									<span>Klik untuk lihat QRIS</span>
								</div>
								<i class="bi bi-arrow-right qris-support-arrow"></i>
							</div>
						}
					</div>
				</div>

				<hr class="footer-divider"/>

				<div class="text-center">
					<p class="footer-text">
						© 2026 { setting.FooterCopyright }
					</p>
				</div>
			</div>
		</footer>

		if setting.QrisImage != "" {
			<div class="qris-modal-overlay" id="qrisModal" onclick="closeQrisModalOnOverlay(event)">
				<div class="qris-modal-content">
					<button type="button" class="qris-modal-close" onclick="closeQrisModal()">
						<i class="bi bi-x-lg"></i>
					</button>
					<div class="qris-modal-icon">
						<i class="bi bi-qr-code"></i>
					</div>
					<h5 class="qris-modal-title">Dukung Developer</h5>
					<p class="qris-modal-subtitle">
						Scan QRIS di bawah untuk memberikan dukungan<br/>kepada pengembang platform ini
					</p>
					<div class="qris-modal-image-wrap">
						<img src={ "/storage/" + setting.QrisImage } alt="QRIS Developer" id="qrisModalImage"/>
					</div>
					<a href={ templ.URL("/storage/" + setting.QrisImage) } download="QRIS-Developer-2026.png" class="qris-download-btn" id="qrisDownloadBtn">
						<i class="bi bi-download"></i> Download QRIS
					</a>
					<p class="qris-modal-footer" style="margin-top: 12px;">
						Terima kasih atas dukungan Anda!
					</p>
				</div>
			</div>
		}

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
		<script>
			function openQrisModal() {
				const modal = document.getElementById('qrisModal');
				if (modal) {
					modal.classList.add('active');
					document.body.style.overflow = 'hidden';
				}
			}
			function closeQrisModal() {
				const modal = document.getElementById('qrisModal');
				if (modal) {
					modal.classList.remove('active');
					document.body.style.overflow = '';
				}
			}
			function closeQrisModalOnOverlay(event) {
				if (event.target.id === 'qrisModal') {
					closeQrisModal();
				}
			}
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') {
					closeQrisModal();
				}
			});

			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function() {
					navigator.serviceWorker.register('/sw.js').catch(function() {});
				});
			}
		</script>
	</body>
	</html>
}
