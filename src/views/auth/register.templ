package auth

import "wedding-invitation-go/internal/models"

// RegisterContent — konten halaman register (tanpa DOCTYPE/head/body)
// Akan dibungkus oleh layouts.AuthLayout
templ RegisterContent(setting models.Config, errorMsg string, successMsg string) {
	<div class="auth-left">
		<a href="/" class="back-home-btn" title="Kembali ke Beranda">
			<i class="bi bi-arrow-left"></i>
			<span>Kembali ke Beranda</span>
		</a>

		<div class="auth-info">
			<h2 class="auth-info-title">
				Mulai <span>Perjalanan</span> Digitalmu
			</h2>
			<p class="auth-info-desc">
				Daftar gratis dan buat undangan pernikahan digital impianmu dalam hitungan menit.
			</p>
			<ul class="auth-info-list">
				<li><i class="bi bi-check-circle-fill"></i><span>Gratis, tanpa biaya tersembunyi</span></li>
				<li><i class="bi bi-check-circle-fill"></i><span>Banyak pilihan template elegan</span></li>
				<li><i class="bi bi-check-circle-fill"></i><span>RSVP &amp; guest book online</span></li>
				<li><i class="bi bi-check-circle-fill"></i><span>Mudah dibagikan ke sosial media</span></li>
			</ul>
		</div>
	</div>

	<div class="auth-right">
		<div class="auth-card">
			<div class="auth-header">
				<h1 class="auth-title">
					Buat <span>Akun</span>
				</h1>
				<p class="auth-subtitle">Mulai buat undangan digital Anda</p>
			</div>

			if errorMsg != "" {
				<div class="alert-auth alert-danger" role="alert">
					<i class="bi bi-exclamation-triangle-fill"></i>
					<div>{ errorMsg }</div>
				</div>
			}
			if successMsg != "" {
				<div class="alert-auth alert-success" role="alert">
					<i class="bi bi-check-circle-fill"></i>
					<div>{ successMsg }</div>
				</div>
			}

			<form method="POST" action="/register" style="width: 100%;">
				<div class="form-group">
					<label for="name" class="form-label">
						<i class="bi bi-person"></i>Nama Lengkap
					</label>
					<input type="text" id="name" name="name" class="form-control" placeholder="Masukkan nama lengkap" required autofocus/>
				</div>

				<div class="form-group">
					<label for="email" class="form-label">
						<i class="bi bi-envelope"></i>Email
					</label>
					<input type="email" id="email" name="email" class="form-control" placeholder="contoh@email.com" required/>
				</div>

				<div class="password-grid-mobile">
					<div class="form-group" style="margin-bottom: 0;">
						<label for="password" class="form-label">
							<i class="bi bi-lock"></i>Password
						</label>
						<div class="password-wrapper">
							<input type="password" id="password" name="password" class="form-control" placeholder="Minimal 8 karakter" required/>
							<button type="button" class="password-toggle" id="togglePassword" aria-label="Toggle password visibility">
								<i class="bi bi-eye"></i>
							</button>
						</div>
					</div>

					<div class="form-group" style="margin-bottom: 0;">
						<label for="password_confirmation" class="form-label">
							<i class="bi bi-check-circle"></i>Konfirmasi
						</label>
						<div class="password-wrapper">
							<input type="password" id="password_confirmation" name="password_confirmation" class="form-control" placeholder="Ulangi password" required/>
							<button type="button" class="password-toggle" id="toggleConfirmPassword" aria-label="Toggle confirm password visibility">
								<i class="bi bi-eye"></i>
							</button>
						</div>
					</div>
				</div>

				<div class="alert-info-role">
					<i class="bi bi-info-circle-fill"></i>
					<div>
						<strong>Pendaftaran sebagai Client</strong>
						<p>Akun Anda otomatis terdaftar sebagai Client dan bisa langsung membuat undangan digital.</p>
					</div>
				</div>

				<button type="submit" class="btn-auth">
					<i class="bi bi-person-plus"></i>
					<span>Daftar Sekarang</span>
				</button>
			</form>

			<div class="divider-or">atau</div>

			<a href="/auth/google" class="btn-google">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
					<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
					<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
					<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
					<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
				</svg>
				<span>Daftar dengan Google</span>
			</a>

			<div class="login-section">
				<p class="login-text">Sudah punya akun?</p>
				<a href="/login" class="btn-login-link">
					<i class="bi bi-box-arrow-in-right"></i>
					<span>Login Sekarang</span>
				</a>
			</div>
		</div>
	</div>

	<script>
		document.getElementById('togglePassword').addEventListener('click', function() {
			const password = document.getElementById('password');
			const icon = this.querySelector('i');
			const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
			password.setAttribute('type', type);
			icon.classList.toggle('bi-eye');
			icon.classList.toggle('bi-eye-slash');
		});

		document.getElementById('toggleConfirmPassword').addEventListener('click', function() {
			const password = document.getElementById('password_confirmation');
			const icon = this.querySelector('i');
			const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
			password.setAttribute('type', type);
			icon.classList.toggle('bi-eye');
			icon.classList.toggle('bi-eye-slash');
		});
	</script>
}
