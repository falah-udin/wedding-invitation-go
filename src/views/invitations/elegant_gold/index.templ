package elegant_gold

import (
	"context"
	"io"

	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/models"
)

// ElegantGold — template undangan Elegant Gold (FULL)
func ElegantGold(ctx context.Context, w io.Writer, project models.Project, data map[string]interface{}, guestName string) error {
	groomName := getStr(data, "groom_name")
	brideName := getStr(data, "bride_name")
	groomPhoto := getDefaultPhoto(data, "groom_photo")
	bridePhoto := getDefaultPhoto(data, "bride_photo")
	eventInstagram := getStr(data, "event_instagram")
	musicURL := getMusicUrlFromProject(project)
	isNamedGuest := guestName != "" && guestName != "Tamu Undangan"
	fatherGroomName := getStr(data, "father_groom")
	motherGroomName := getStr(data, "mother_groom")
	fatherBrideName := getStr(data, "father_bride")
	motherBrideName := getStr(data, "mother_bride")

	component := elegantGoldPage(
		project, data, guestName,
		groomName, brideName,
		groomPhoto, bridePhoto,
		fatherGroomName, motherGroomName,
		fatherBrideName, motherBrideName,
		eventInstagram, musicURL, isNamedGuest,
	)
	return component.Render(ctx, w)
}

templ elegantGoldPage(
	project models.Project,
	data map[string]interface{},
	guestName string,
	groomName string,
	brideName string,
	groomPhoto string,
	bridePhoto string,
	fatherGroomName string,
	motherGroomName string,
	fatherBrideName string,
	motherBrideName string,
	eventInstagram string,
	musicURL string,
	isNamedGuest bool,
) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"/>
		<title>{ groomName } &amp; { brideName } - Elegant Gold</title>

		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Inter:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet"/>

		<style>
			/* ============================================ */
			/* ROOT VARIABLES */
			/* ============================================ */
			:root {
				--gold: #c9a03d;
				--gold-light: #e8d5a3;
				--gold-dark: #a8842e;
				--gold-glow: rgba(201, 160, 61, 0.15);
				--dark: #0f0f0f;
				--dark-light: #1a1a1a;
				--dark-card: #222222;
				--cream: #fdf8f0;
				--text-light: #e8d5b7;
				--text-muted: rgba(232, 213, 183, 0.5);
				--white: #ffffff;
				--shadow: 0 8px 50px rgba(0,0,0,0.4);
				--shadow-gold: 0 8px 40px rgba(201, 160, 61, 0.08);
			}

			html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
			* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			body {
				font-family: 'Inter', sans-serif;
				background: var(--dark);
				color: var(--text-light);
				line-height: 1.8;
				overflow-x: hidden;
				min-height: 100vh;
				min-height: 100svh;
			}
			img { max-width: 100%; height: auto; }
			.container { max-width: 960px; margin: 0 auto; padding: 0 20px; }
			@media (min-width: 768px) { .container { padding: 0 40px; } }

			/* ============================================ */
			/* ANIMATIONS */
			/* ============================================ */
			@keyframes sparkle {
				0%, 100% { opacity: 0.3; transform: scale(1) rotate(0deg); }
				50% { opacity: 0.8; transform: scale(1.2) rotate(15deg); }
			}
			@keyframes shimmer {
				0% { background-position: -200% center; }
				100% { background-position: 200% center; }
			}
			@keyframes pulseGold {
				0% { box-shadow: 0 0 0 0 rgba(201, 160, 61, 0.4); }
				70% { box-shadow: 0 0 0 16px rgba(201, 160, 61, 0); }
				100% { box-shadow: 0 0 0 0 rgba(201, 160, 61, 0); }
			}
			@keyframes slideInToast {
				from { transform: translateX(100%); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}
			@keyframes bounceDown {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(8px); }
			}
			@keyframes fadeInGuestGold {
				from { opacity: 0; transform: translateY(15px) scale(0.96); filter: blur(4px); }
				to { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
			}
			@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

			/* ============================================ */
			/* TYPOGRAPHY */
			/* ============================================ */
			.section-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.8rem; text-transform: uppercase; letter-spacing: 8px;
				color: var(--gold); text-align: center;
				margin-bottom: 6px; font-weight: 400;
			}
			.section-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.8rem; font-weight: 700; text-align: center;
				margin-bottom: 12px; color: var(--gold);
				line-height: 1.2; letter-spacing: 2px;
				text-shadow: 0 0 60px rgba(201, 160, 61, 0.05);
			}
			.section-title .gold-ornament {
				display: block; color: var(--gold); font-size: 1.4rem;
				margin-top: 10px; opacity: 0.4; font-weight: 300;
			}
			.section-subtitle {
				text-align: center; color: var(--text-muted);
				font-size: 0.95rem; max-width: 500px;
				margin: -8px auto 45px; font-style: italic; font-weight: 300;
			}
			@media (max-width: 600px) {
				.section-title { font-size: 2rem; }
				.section-subtitle { font-size: 0.85rem; padding: 0 16px; }
			}

			/* DIVIDER */
			.divider-gold {
				display: flex; align-items: center; justify-content: center;
				gap: 16px; margin: 16px 0;
			}
			.divider-gold span {
				width: 60px; height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				opacity: 0.3;
			}
			.divider-gold i { color: var(--gold); font-size: 0.7rem; opacity: 0.5; }
			.divider-gold .heart-gold {
				color: var(--gold); font-size: 0.8rem; opacity: 0.6;
				animation: sparkle 2s ease-in-out infinite;
			}

			/* TOAST */
			.toast-container {
				position: fixed; top: 20px; right: 20px; z-index: 9999;
				display: flex; flex-direction: column; gap: 8px;
			}
			.toast {
				background: var(--dark-light); color: var(--white);
				padding: 12px 20px; border-radius: 12px;
				box-shadow: var(--shadow); animation: slideInToast 0.4s ease;
				min-width: 200px; display: flex; align-items: center; gap: 10px;
				font-size: 0.85rem; border-left: 3px solid var(--gold);
			}
			.toast i { font-size: 1.1rem; }
			.toast.success i { color: #10b981; }
			.toast.error i { color: #ef4444; }
			.toast.info i { color: var(--gold); }

			/* SCROLL INDICATOR */
			.scroll-indicator {
				position: absolute; bottom: 20px; left: 50%;
				transform: translateX(-50%); z-index: 10;
				color: rgba(255,255,255,0.3); font-size: 0.65rem;
				text-transform: uppercase; letter-spacing: 4px;
				display: flex; flex-direction: column; align-items: center;
				gap: 4px; cursor: pointer; transition: all 0.3s;
				padding: 8px 0;
			}
			.scroll-indicator:hover { color: var(--gold); }
			.scroll-indicator i { font-size: 1.2rem; animation: bounceDown 2s infinite; }

			/* OVERLAY */
			#startOverlay {
				position: fixed; top: 0; left: 0; right: 0; bottom: 0;
				width: 100vw; height: 100vh; height: 100svh;
				background: rgba(15, 15, 15, 0.96);
				z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				backdrop-filter: blur(12px);
				transition: opacity 0.8s ease;
				cursor: pointer; padding: 20px; box-sizing: border-box;
				overflow-y: auto;
			}
			#startOverlay .overlay-inner {
				text-align: center; max-width: 500px; width: 100%;
				padding: 20px; position: relative; margin: auto;
			}
			#startOverlay .overlay-ornament {
				font-size: 4rem; color: var(--gold); opacity: 0.15;
				margin-bottom: 16px; display: block;
				animation: sparkle 3s ease-in-out infinite;
			}
			#startOverlay .overlay-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.8rem; font-weight: 700;
				color: var(--gold); margin-bottom: 8px; letter-spacing: 4px;
				text-shadow: 0 0 60px rgba(201, 160, 61, 0.05);
			}
			#startOverlay .overlay-subtitle {
				color: var(--text-muted); font-size: 1rem;
				margin-bottom: 8px; font-weight: 300;
			}
			#startOverlay .overlay-divider {
				width: 60px; height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				margin: 12px auto 20px; opacity: 0.3;
			}
			.overlay-guest {
				margin: 24px 0 30px;
				animation: fadeInGuestGold 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.4s both;
				position: relative;
			}
			.overlay-guest-label {
				font-family: 'Playfair Display', serif;
				font-size: 0.7rem; text-transform: uppercase; letter-spacing: 7px;
				color: rgba(212, 175, 55, 0.6); margin-bottom: 12px;
				font-style: italic; font-weight: 400;
			}
			.overlay-guest-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.65rem; font-weight: 600; font-style: italic;
				color: #f4e5b1; line-height: 1.25; margin-bottom: 6px; letter-spacing: 0.5px;
				text-shadow: 0 0 20px rgba(212, 175, 55, 0.35), 0 0 40px rgba(212, 175, 55, 0.15), 0 2px 8px rgba(0, 0, 0, 0.3);
			}
			.overlay-guest-divider {
				width: 90px; height: 1px;
				background: linear-gradient(90deg, transparent 0%, rgba(212, 175, 55, 0.4) 30%, rgba(212, 175, 55, 0.8) 50%, rgba(212, 175, 55, 0.4) 70%, transparent 100%);
				margin: 16px auto 0; position: relative; opacity: 0.8;
			}
			.overlay-guest-divider::before,
			.overlay-guest-divider::after {
				content: '✦'; position: absolute; top: 50%; transform: translateY(-50%);
				font-size: 0.6rem; color: #d4af37;
				text-shadow: 0 0 8px rgba(212, 175, 55, 0.6);
			}
			.overlay-guest-divider::before { left: -20px; }
			.overlay-guest-divider::after { right: -20px; }
			@media (max-width: 600px) {
				.overlay-guest { margin: 20px 0 24px; }
				.overlay-guest-name { font-size: 1.3rem; letter-spacing: 0.3px; }
				.overlay-guest-label { font-size: 0.6rem; letter-spacing: 5px; margin-bottom: 8px; }
				.overlay-guest-divider { width: 70px; margin-top: 12px; }
			}
			#startOverlay .btn-start {
				display: inline-block;
				background: linear-gradient(135deg, var(--gold), var(--gold-dark), var(--gold));
				background-size: 200% auto;
				color: var(--dark); padding: 16px 48px;
				border-radius: 50px; font-weight: 600; font-size: 0.95rem;
				border: none; cursor: pointer;
				box-shadow: 0 4px 40px rgba(201, 160, 61, 0.2);
				transition: all 0.4s ease; letter-spacing: 2px;
				position: relative; overflow: hidden;
			}
			#startOverlay .btn-start::before {
				content: ''; position: absolute; top: 0; left: -100%;
				width: 100%; height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
				transition: left 0.6s ease;
			}
			#startOverlay .btn-start:hover::before { left: 100%; }
			#startOverlay .btn-start:hover {
				transform: scale(1.05) translateY(-2px);
				box-shadow: 0 8px 60px rgba(201, 160, 61, 0.3);
				background-position: right center;
			}
			#startOverlay .btn-start:active { transform: scale(0.95); }
			#startOverlay .hint {
				font-size: 0.6rem; opacity: 0.2; margin-top: 18px;
				letter-spacing: 2px; color: var(--text-light);
			}
			@media (max-width: 600px) {
				#startOverlay .overlay-title { font-size: 2rem; }
				#startOverlay .btn-start { padding: 14px 32px; font-size: 0.85rem; width: 100%; max-width: 280px; }
				#startOverlay .overlay-ornament { font-size: 3rem; }
			}

			/* MUSIC PLAYER */
			.music-player { position: fixed; bottom: 24px; right: 24px; z-index: 1000; }
			.music-btn {
				width: 56px; height: 56px; border-radius: 50%;
				background: linear-gradient(135deg, var(--gold), var(--gold-dark));
				border: 2px solid var(--gold-light);
				color: var(--dark); font-size: 1.5rem; cursor: pointer;
				box-shadow: 0 4px 30px rgba(201, 160, 61, 0.2);
				transition: all 0.3s;
				display: flex; align-items: center; justify-content: center;
			}
			.music-btn:hover { transform: scale(1.05) rotate(-5deg); box-shadow: 0 8px 50px rgba(201, 160, 61, 0.3); }
			.music-btn.playing { animation: pulseGold 1.5s infinite; }

			/* HERO */
			.hero-gold {
				min-height: 100vh; min-height: 100svh; height: auto;
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
				text-align: center; position: relative;
				background: linear-gradient(135deg, #0f0f0f 0%, #1a0f05 30%, #0f0f0f 70%, #1a0f05 100%);
				padding: 40px 20px 90px; overflow: hidden;
			}
			.hero-gold::before {
				content: '';
				position: absolute; top: 0; left: 0; right: 0; bottom: 0;
				background:
					radial-gradient(ellipse at 20% 20%, rgba(201, 160, 61, 0.04) 0%, transparent 50%),
					radial-gradient(ellipse at 80% 80%, rgba(201, 160, 61, 0.04) 0%, transparent 50%);
				pointer-events: none;
			}
			.hero-gold::after {
				content: '';
				position: absolute; top: 0; left: 0; right: 0; bottom: 0;
				background-image:
					radial-gradient(circle at 15% 25%, rgba(201, 160, 61, 0.02) 1px, transparent 1px),
					radial-gradient(circle at 35% 65%, rgba(201, 160, 61, 0.015) 1px, transparent 1px),
					radial-gradient(circle at 55% 15%, rgba(201, 160, 61, 0.02) 1px, transparent 1px),
					radial-gradient(circle at 75% 75%, rgba(201, 160, 61, 0.015) 1px, transparent 1px);
				background-size: 80px 80px;
				pointer-events: none;
			}
			.hero-content {
				position: relative; z-index: 2;
				width: 100%; max-width: 750px;
				margin: 0 auto;
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
			}
			.hero-ornament-top {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem; color: var(--gold);
				opacity: 0.2; letter-spacing: 12px; margin-bottom: 20px;
			}
			.hero-badge {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem; letter-spacing: 10px; text-transform: uppercase;
				border: 1px solid rgba(201, 160, 61, 0.15);
				padding: 8px 28px; border-radius: 30px; display: inline-block;
				margin-bottom: 24px; color: var(--gold); font-weight: 400;
				background: rgba(201, 160, 61, 0.03); backdrop-filter: blur(4px);
			}
			.hero-couple {
				font-family: 'Playfair Display', serif;
				font-size: 5rem; font-weight: 700;
				color: var(--gold); letter-spacing: 4px;
				line-height: 1.1;
				text-shadow: 0 0 80px rgba(201, 160, 61, 0.05);
				display: flex; flex-direction: column;
				align-items: center; justify-content: center;
			}
			.hero-couple .groom-name,
			.hero-couple .bride-name { display: block; text-align: center; word-break: break-word; }
			.hero-couple .ampersand {
				display: block; color: var(--text-light);
				font-size: 3.5rem; font-weight: 300;
				opacity: 0.6; line-height: 1.2;
				margin: 4px 0; text-align: center;
			}
			@media (max-width: 600px) {
				.hero-couple { font-size: 2.8rem !important; }
				.hero-couple .ampersand { font-size: 2.2rem !important; margin: 2px 0 !important; }
			}
			@media (max-width: 400px) {
				.hero-couple { font-size: 2.2rem !important; }
				.hero-couple .ampersand { font-size: 1.8rem !important; }
			}
			.hero-subtitle {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.3rem; font-weight: 400;
				color: var(--text-light); letter-spacing: 10px;
				margin-top: 12px; opacity: 0.7;
			}
			.hero-dates {
				display: flex; justify-content: center;
				gap: 30px; margin: 16px 0 8px; flex-wrap: wrap;
			}
			.hero-dates .date-item {
				display: flex; align-items: center; gap: 10px;
				font-size: 0.95rem; opacity: 0.8;
				letter-spacing: 1px; font-weight: 300;
			}
			.hero-dates .date-item i { color: var(--gold); font-size: 0.9rem; }
			.hero-dates .date-divider { color: var(--gold); opacity: 0.2; font-size: 0.6rem; }
			.hero-venue {
				font-size: 0.95rem; opacity: 0.6;
				margin-bottom: 36px; letter-spacing: 1px; font-weight: 300;
			}
			.btn-rsvp {
				display: inline-block;
				background: linear-gradient(135deg, var(--gold), var(--gold-dark), var(--gold));
				background-size: 200% auto;
				color: var(--dark);
				padding: 16px 48px; border-radius: 50px;
				text-decoration: none; font-weight: 600; font-size: 0.95rem;
				transition: all 0.4s ease;
				border: none; cursor: pointer;
				box-shadow: 0 4px 30px rgba(201, 160, 61, 0.15);
				letter-spacing: 1px; position: relative; overflow: hidden;
			}
			.btn-rsvp::before {
				content: ''; position: absolute; top: 0; left: -100%;
				width: 100%; height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
				transition: left 0.6s ease;
			}
			.btn-rsvp:hover::before { left: 100%; }
			.btn-rsvp:hover {
				transform: translateY(-3px) scale(1.02);
				box-shadow: 0 8px 50px rgba(201, 160, 61, 0.3);
				background-position: right center;
			}
			.hero-ornament-bottom {
				position: absolute;
				font-size: 8rem;
				color: rgba(201, 160, 61, 0.02);
				pointer-events: none;
				font-family: 'Playfair Display', serif;
			}
			.hero-ornament-bottom-1 { bottom: -20px; left: -30px; transform: rotate(-10deg); }
			.hero-ornament-bottom-2 { top: 20px; right: -30px; transform: rotate(15deg); }
			@media (max-width: 600px) {
				.hero-gold { padding: 30px 16px 80px; }
				.hero-subtitle { font-size: 1rem !important; letter-spacing: 6px !important; }
				.hero-ornament-bottom { font-size: 4rem; }
				.hero-dates { gap: 12px !important; flex-direction: column; align-items: center; }
				.hero-dates .date-divider { display: none; }
				.hero-badge { font-size: 0.7rem; letter-spacing: 6px; padding: 6px 16px; }
				.scroll-indicator { bottom: 16px; font-size: 0.55rem; letter-spacing: 3px; }
				.scroll-indicator i { font-size: 1rem; }
			}

            			/* COUPLE */
			.section-gold { padding: 80px 0; background: var(--dark); }
			.section-gold-alt { padding: 80px 0; background: rgba(201, 160, 61, 0.02); }
			.couple-grid {
				display: grid; grid-template-columns: 1fr auto 1fr;
				gap: 40px; align-items: center;
			}
			@media (max-width: 700px) { .couple-grid { grid-template-columns: 1fr; gap: 40px; } }
			.couple-card {
				text-align: center;
				background: rgba(201, 160, 61, 0.03);
				border: 1px solid rgba(201, 160, 61, 0.08);
				border-radius: 24px; padding: 35px 25px;
				transition: all 0.5s ease;
				position: relative; overflow: hidden;
			}
			.couple-card::before {
				content: ''; position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: linear-gradient(135deg, rgba(201, 160, 61, 0.02), transparent 50%, rgba(201, 160, 61, 0.02));
				opacity: 0; transition: opacity 0.5s ease;
			}
			.couple-card:hover::before { opacity: 1; }
			.couple-card:hover {
				transform: translateY(-8px);
				border-color: rgba(201, 160, 61, 0.2);
				box-shadow: 0 12px 60px rgba(0,0,0,0.3);
			}
			.couple-photo-wrap {
				position: relative;
				width: 180px; height: 180px;
				margin: 0 auto 20px;
			}
			.couple-photo-wrap::after {
				content: ''; position: absolute;
				top: -4px; left: -4px; right: -4px; bottom: -4px;
				border-radius: 50%;
				border: 2px solid rgba(201, 160, 61, 0.15);
				animation: sparkle 3s ease-in-out infinite;
			}
			.couple-photo {
				width: 180px; height: 180px;
				border-radius: 50%;
				overflow: hidden;
				border: 3px solid var(--gold);
				box-shadow: 0 4px 40px rgba(201, 160, 61, 0.1);
				transition: all 0.5s ease;
				position: relative; z-index: 1;
			}
			.couple-card:hover .couple-photo {
				transform: scale(1.03);
				box-shadow: 0 8px 60px rgba(201, 160, 61, 0.15);
			}
			@media (max-width: 600px) {
				.couple-photo-wrap, .couple-photo { width: 140px; height: 140px; }
			}
			.couple-info h3 {
				font-family: 'Playfair Display', serif;
				font-size: 1.8rem; font-weight: 600;
				color: var(--gold); margin-bottom: 4px; letter-spacing: 1px;
			}
			.couple-title {
				color: var(--text-muted); font-size: 0.75rem;
				text-transform: uppercase; letter-spacing: 3px; font-weight: 300;
			}
			.couple-parents {
				font-weight: 400; color: var(--text-light);
				font-style: italic; opacity: 0.7; font-size: 0.9rem;
			}
			.couple-social {
				margin-top: 14px; display: flex;
				justify-content: center; gap: 12px;
			}
			.couple-social a {
				color: var(--text-muted); transition: all 0.3s;
				font-size: 1.1rem;
				display: inline-flex; align-items: center; justify-content: center;
				width: 36px; height: 36px; border-radius: 50%;
				border: 1px solid rgba(201, 160, 61, 0.1);
			}
			.couple-social a:hover {
				color: var(--gold); border-color: var(--gold);
				transform: translateY(-2px) scale(1.1);
				background: rgba(201, 160, 61, 0.05);
			}
			.couple-ampersand {
				font-family: 'Playfair Display', serif;
				font-size: 3.5rem; color: var(--gold);
				font-weight: 400; opacity: 0.4;
				animation: sparkle 2s ease-in-out infinite;
			}
			@media (max-width: 700px) { .couple-ampersand { font-size: 2.5rem; } }

			/* LOVE STORY */
			.love-timeline {
				position: relative; padding-left: 35px;
				max-width: 600px; margin: 0 auto;
			}
			.love-timeline::before {
				content: ''; position: absolute;
				left: 10px; top: 0; bottom: 0;
				width: 2px;
				background: linear-gradient(180deg, transparent, var(--gold), transparent);
				opacity: 0.15;
			}
			.timeline-item {
				position: relative; margin-bottom: 28px; padding-left: 30px;
			}
			.timeline-dot {
				position: absolute; left: -28px; top: 4px;
				width: 22px; height: 22px;
				background: var(--gold); border-radius: 50%;
				display: flex; align-items: center; justify-content: center;
				font-size: 0.5rem; color: var(--dark);
				border: 2px solid var(--dark);
				box-shadow: 0 2px 12px rgba(201, 160, 61, 0.2);
				transition: all 0.3s;
			}
			.timeline-item:hover .timeline-dot {
				transform: scale(1.2);
				box-shadow: 0 4px 24px rgba(201, 160, 61, 0.3);
			}
			.timeline-content {
				background: rgba(201, 160, 61, 0.03);
				border-radius: 16px; padding: 20px 24px;
				border: 1px solid rgba(201, 160, 61, 0.06);
				transition: all 0.4s ease;
			}
			.timeline-item:hover .timeline-content {
				border-color: rgba(201, 160, 61, 0.15);
				background: rgba(201, 160, 61, 0.05);
				transform: translateX(6px);
			}
			.timeline-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.15rem; font-weight: 600;
				color: var(--gold); margin-bottom: 4px; letter-spacing: 1px;
			}
			.timeline-desc {
				color: var(--text-muted); font-size: 0.9rem;
				margin: 0; font-weight: 300;
			}
			@media (max-width: 600px) {
				.love-timeline { padding-left: 24px; }
				.timeline-item { padding-left: 20px; }
				.timeline-content { padding: 16px 18px; }
			}

			/* EVENT */
			.event-grid {
				display: grid; grid-template-columns: 1fr 1fr; gap: 28px;
			}
			@media (max-width: 600px) { .event-grid { grid-template-columns: 1fr; } }
			.event-card {
				background: rgba(201, 160, 61, 0.03);
				border: 1px solid rgba(201, 160, 61, 0.08);
				border-radius: 20px; padding: 32px 24px;
				text-align: center; transition: all 0.4s ease;
				position: relative; overflow: hidden;
			}
			.event-card::before {
				content: ''; position: absolute;
				top: -50%; left: -50%;
				width: 200%; height: 200%;
				background: radial-gradient(circle at center, rgba(201, 160, 61, 0.02), transparent 70%);
				opacity: 0; transition: opacity 0.5s ease;
			}
			.event-card:hover::before { opacity: 1; }
			.event-card:hover {
				transform: translateY(-6px);
				border-color: rgba(201, 160, 61, 0.2);
				box-shadow: 0 12px 50px rgba(0,0,0,0.2);
			}
			.event-icon {
				width: 72px; height: 72px;
				background: linear-gradient(135deg, rgba(201, 160, 61, 0.05), rgba(201, 160, 61, 0.02));
				border-radius: 50%;
				display: flex; align-items: center; justify-content: center;
				margin: 0 auto 16px;
				font-size: 1.8rem; color: var(--gold);
				border: 2px solid rgba(201, 160, 61, 0.1);
				transition: all 0.4s ease;
				position: relative; z-index: 1;
			}
			.event-card:hover .event-icon {
				transform: scale(1.05);
				border-color: var(--gold);
				box-shadow: 0 0 40px rgba(201, 160, 61, 0.05);
			}
			.event-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.3rem; font-weight: 600;
				color: var(--gold); margin-bottom: 12px;
				position: relative; z-index: 1;
			}
			.event-datetime, .event-venue {
				display: flex; align-items: center; justify-content: center;
				gap: 10px; color: var(--text-muted);
				font-size: 0.9rem; margin-bottom: 6px;
				font-weight: 300;
				position: relative; z-index: 1;
			}
			.event-datetime i, .event-venue i {
				color: var(--gold); font-size: 0.9rem; opacity: 0.7;
			}
			.btn-map {
				display: inline-block; margin-top: 16px;
				color: var(--gold); text-decoration: none;
				font-weight: 500;
				border-bottom: 2px solid var(--gold);
				padding-bottom: 4px;
				transition: all 0.3s; font-size: 0.85rem;
				position: relative; z-index: 1; opacity: 0.7;
			}
			.btn-map:hover {
				opacity: 1; color: var(--gold-light);
				border-bottom-color: var(--gold-light);
			}

			/* GALLERY */
			.gallery-grid {
				display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
			}
			@media (max-width: 600px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
			.gallery-item {
				position: relative; border-radius: 16px;
				overflow: hidden; cursor: pointer; aspect-ratio: 1;
				border: 1px solid rgba(201, 160, 61, 0.06);
				transition: all 0.4s ease;
			}
			.gallery-item::before {
				content: ''; position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.3));
				z-index: 1; opacity: 0; transition: opacity 0.4s ease;
			}
			.gallery-item:hover::before { opacity: 1; }
			.gallery-item:hover {
				transform: translateY(-6px) scale(1.02);
				border-color: var(--gold);
				box-shadow: 0 12px 50px rgba(0,0,0,0.3);
				z-index: 2;
			}
			.gallery-item img {
				width: 100%; height: 100%;
				object-fit: cover; transition: transform 0.6s ease;
			}
			.gallery-item:hover img { transform: scale(1.08); }
			.gallery-item .gallery-overlay {
				position: absolute; top: 0; left: 0; right: 0; bottom: 0;
				background: rgba(0,0,0,0.3);
				display: flex; align-items: center; justify-content: center;
				opacity: 0; transition: all 0.4s ease;
				color: var(--gold); font-size: 2.5rem; z-index: 2;
			}
			.gallery-item:hover .gallery-overlay { opacity: 1; }
			.gallery-item .gallery-badge {
				position: absolute; bottom: 12px; right: 12px;
				background: rgba(201, 160, 61, 0.9); color: var(--dark);
				padding: 4px 12px; border-radius: 20px;
				font-size: 0.6rem; font-weight: 600; z-index: 2;
				opacity: 0; transform: translateY(10px);
				transition: all 0.4s ease;
			}
			.gallery-item:hover .gallery-badge { opacity: 1; transform: translateY(0); }

			/* BANK */
			.bank-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 20px; max-width: 800px; margin: 0 auto;
			}
			.bank-card-elegant {
				background: linear-gradient(145deg, rgba(201, 160, 61, 0.06), rgba(201, 160, 61, 0.02));
				border: 1px solid rgba(201, 160, 61, 0.15);
				border-radius: 20px; padding: 24px 22px;
				text-align: center; transition: all 0.4s ease;
				position: relative; overflow: hidden;
			}
			.bank-card-elegant::before {
				content: ''; position: absolute; top: 0; left: 0; right: 0;
				height: 3px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				opacity: 0.6;
			}
			.bank-card-elegant:hover {
				transform: translateY(-6px);
				border-color: rgba(201, 160, 61, 0.35);
				box-shadow: 0 12px 50px rgba(201, 160, 61, 0.08);
			}
			.bank-logo {
				width: 70px; height: 70px; margin: 0 auto 14px;
				border-radius: 16px;
				background: rgba(201, 160, 61, 0.08);
				border: 1px solid rgba(201, 160, 61, 0.15);
				display: flex; align-items: center; justify-content: center;
				overflow: hidden; transition: all 0.3s;
			}
			.bank-card-elegant:hover .bank-logo {
				background: rgba(201, 160, 61, 0.12);
				transform: scale(1.05);
			}
			.bank-logo img { max-width: 70%; max-height: 70%; object-fit: contain; }
			.bank-logo .bank-logo-icon {
				font-size: 1.8rem; color: var(--gold);
				font-weight: 700;
				font-family: 'Playfair Display', serif; letter-spacing: 1px;
			}
			.bank-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.1rem; font-weight: 600;
				color: var(--gold); margin-bottom: 10px; letter-spacing: 1px;
			}
			.bank-number-wrapper {
				display: flex; align-items: center; justify-content: center;
				gap: 8px;
				background: rgba(201, 160, 61, 0.04);
				border: 1px dashed rgba(201, 160, 61, 0.25);
				border-radius: 12px; padding: 10px 14px;
				margin-bottom: 10px; cursor: pointer;
				transition: all 0.3s;
			}
			.bank-number-wrapper:hover {
				background: rgba(201, 160, 61, 0.08);
				border-color: var(--gold);
			}
			.bank-number {
				font-family: 'Courier New', monospace;
				font-size: 1.05rem; font-weight: 700;
				color: var(--gold-light); letter-spacing: 2px;
				word-break: break-all;
			}
			.copy-icon {
				color: var(--gold); font-size: 0.9rem;
				opacity: 0.6; transition: all 0.3s; flex-shrink: 0;
			}
			.bank-number-wrapper:hover .copy-icon { opacity: 1; transform: scale(1.15); }
			.bank-holder {
				font-size: 0.85rem; color: var(--text-muted);
				font-style: italic; margin-top: 4px;
			}
			.bank-holder strong {
				color: var(--text-light); font-weight: 500; font-style: normal;
			}
			.bank-type-badge {
				position: absolute; top: 12px; right: 12px;
				font-size: 0.55rem; padding: 3px 10px;
				border-radius: 20px;
				background: rgba(201, 160, 61, 0.15);
				color: var(--gold);
				letter-spacing: 1.5px; text-transform: uppercase;
				font-weight: 600;
			}
			@media (max-width: 600px) {
				.bank-grid { grid-template-columns: 1fr; }
				.bank-logo { width: 60px; height: 60px; }
				.bank-logo .bank-logo-icon { font-size: 1.4rem; }
				.bank-name { font-size: 1rem; }
				.bank-number { font-size: 0.95rem; letter-spacing: 1.5px; }
			}

			/* RSVP */
			.rsvp-form { max-width: 500px; margin: 0 auto; }
			.form-group { margin-bottom: 18px; }
			.form-group label {
				display: block; font-size: 0.8rem;
				font-weight: 500; margin-bottom: 6px;
				color: var(--gold); letter-spacing: 1px;
			}
			.form-group .required { color: #c0392b; }
			.form-group input, .form-group select, .form-group textarea {
				width: 100%; padding: 14px 18px;
				border: 1px solid rgba(201, 160, 61, 0.12);
				border-radius: 14px; font-size: 1rem;
				font-family: 'Inter', sans-serif;
				background: rgba(201, 160, 61, 0.02);
				color: var(--text-light); transition: all 0.3s;
			}
			.form-group input::placeholder, .form-group textarea::placeholder {
				color: rgba(232, 213, 183, 0.2);
			}
			.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
				outline: none; border-color: var(--gold);
				box-shadow: 0 0 0 4px rgba(201, 160, 61, 0.05);
				background: rgba(201, 160, 61, 0.04);
			}
			.form-group select option { background: var(--dark-light); color: var(--text-light); }
			.rsvp-form input[readonly] {
				background: rgba(201, 160, 61, 0.06) !important;
				border-color: rgba(201, 160, 61, 0.4) !important;
				color: var(--gold-light) !important;
				cursor: not-allowed; font-weight: 600; letter-spacing: 0.3px;
			}
			.rsvp-form input[readonly]:focus {
				box-shadow: none;
				border-color: rgba(201, 160, 61, 0.5) !important;
			}
			.btn-submit {
				width: 100%; padding: 16px;
				background: linear-gradient(135deg, var(--gold), var(--gold-dark), var(--gold));
				background-size: 200% auto;
				color: var(--dark); border: none;
				border-radius: 14px; font-size: 1rem;
				font-weight: 600; cursor: pointer;
				transition: all 0.3s; letter-spacing: 1px;
				position: relative; overflow: hidden;
			}
			.btn-submit::before {
				content: ''; position: absolute; top: 0; left: -100%;
				width: 100%; height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
				transition: left 0.6s ease;
			}
			.btn-submit:hover::before { left: 100%; }
			.btn-submit:hover {
				transform: translateY(-2px);
				box-shadow: 0 8px 40px rgba(201, 160, 61, 0.2);
				background-position: right center;
			}
			.btn-submit:active { transform: scale(0.98); }
			#rsvpList {
				display: flex; flex-direction: column; gap: 10px;
				max-height: 400px; overflow-y: auto; padding-right: 4px;
			}
			.rsvp-item {
				background: rgba(201, 160, 61, 0.02);
				border: 1px solid rgba(201, 160, 61, 0.06);
				border-radius: 14px; padding: 16px 20px;
				transition: all 0.3s ease;
			}
			.rsvp-item:hover {
				border-color: rgba(201, 160, 61, 0.15);
				background: rgba(201, 160, 61, 0.04);
				transform: translateX(4px);
			}
			.rsvp-item .row-main {
				display: flex; justify-content: space-between;
				align-items: center; flex-wrap: wrap; gap: 6px;
				margin-bottom: 6px;
			}
			.rsvp-item .guest-name {
				font-weight: 600; font-size: 0.95rem;
				color: var(--text-light); word-break: break-word;
			}
			.rsvp-item .status-badge {
				font-size: 0.65rem; padding: 3px 14px;
				border-radius: 20px; font-weight: 500;
				white-space: nowrap; flex-shrink: 0;
			}
			.rsvp-item .status-badge.hadir { background: rgba(16, 185, 129, 0.15); color: #10b981; }
			.rsvp-item .status-badge.tidak_hadir { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
			.rsvp-item .status-badge.ragu { background: rgba(245, 158, 11, 0.15); color: #f59e0b; }
			.rsvp-item .row-detail {
				display: flex; justify-content: space-between;
				align-items: center; flex-wrap: wrap; gap: 6px;
				padding-top: 4px;
				border-top: 1px solid rgba(201, 160, 61, 0.04);
			}
			.rsvp-item .meta-left {
				display: flex; align-items: center;
				gap: 12px; flex-wrap: wrap;
			}
			.rsvp-item .meta-left .time {
				font-size: 0.65rem; color: var(--text-muted);
				opacity: 0.5;
				display: flex; align-items: center; gap: 4px;
			}
			.rsvp-item .meta-left .guests {
				font-size: 0.65rem; color: var(--text-muted);
				background: rgba(201, 160, 61, 0.04);
				padding: 1px 10px; border-radius: 10px;
				display: flex; align-items: center; gap: 4px;
			}
			.rsvp-item .message {
				font-size: 0.8rem; color: var(--text-muted);
				background: rgba(201, 160, 61, 0.02);
				padding: 8px 14px; border-radius: 10px;
				margin-top: 6px;
				border-left: 3px solid var(--gold);
				font-style: italic; line-height: 1.5;
				word-break: break-word;
			}
			.rsvp-item .message::before { content: '"'; color: var(--gold); font-size: 1.2rem; }
			.rsvp-item .message::after { content: '"'; color: var(--gold); font-size: 1.2rem; }
			.rsvp-empty {
				text-align: center; color: var(--text-muted);
				font-size: 0.85rem; padding: 30px 0; opacity: 0.5;
			}
			.rsvp-empty i { display: block; font-size: 2rem; margin-bottom: 10px; }

			/* LIGHTBOX */
			.lightbox {
				position: fixed; top: 0; left: 0;
				width: 100%; height: 100%;
				background: rgba(0,0,0,0.92); z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				cursor: pointer; animation: fadeIn 0.3s ease;
			}
			.lightbox img {
				max-width: 90%; max-height: 90%;
				object-fit: contain;
				border: 1px solid rgba(201, 160, 61, 0.05);
			}
			.lightbox-close {
				position: absolute; top: 20px; right: 30px;
				color: white; font-size: 2.5rem; cursor: pointer;
				transition: 0.3s;
			}
			.lightbox-close:hover { transform: rotate(90deg); color: var(--gold); }

			/* FOOTER TAHAP 1 */
			.section-footer {
				padding: 60px 20px 45px;
				background: var(--dark);
				text-align: center;
				border-top: 1px solid rgba(201, 160, 61, 0.1);
				position: relative; overflow: hidden;
			}
			.section-footer::before {
				content: '✦'; position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				font-family: 'Playfair Display', serif;
				font-size: 18rem; color: rgba(201, 160, 61, 0.02);
				pointer-events: none; z-index: 0;
			}
			.section-footer .footer-inner {
				position: relative; z-index: 1;
				max-width: 700px; margin: 0 auto;
			}
			.footer-couple {
				font-family: 'Playfair Display', serif;
				font-size: 1.8rem; color: var(--gold);
				margin-bottom: 12px; letter-spacing: 3px;
				text-shadow: 0 0 40px rgba(201, 160, 61, 0.1);
			}
			.footer-ampersand { color: var(--text-light); margin: 0 16px; opacity: 0.5; font-weight: 300; }
			.footer-divider {
				width: 60px; height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				margin: 16px auto; opacity: 0.4;
			}
			.footer-date {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.9rem; margin-bottom: 18px;
				opacity: 0.5; font-weight: 300;
				color: var(--text-light); letter-spacing: 4px;
				font-style: italic;
			}
			.footer-social {
				display: flex; justify-content: center;
				gap: 16px; margin-bottom: 18px;
			}
			.footer-social a {
				color: rgba(201, 160, 61, 0.4); font-size: 1.2rem;
				transition: all 0.3s;
				display: inline-flex; align-items: center; justify-content: center;
				width: 44px; height: 44px; border-radius: 50%;
				border: 1px solid rgba(201, 160, 61, 0.15);
			}
			.footer-social a:hover {
				color: var(--gold); border-color: var(--gold);
				transform: translateY(-3px);
				background: rgba(201, 160, 61, 0.05);
				box-shadow: 0 6px 20px rgba(201, 160, 61, 0.1);
			}
			.footer-prayer {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem; font-style: italic;
				opacity: 0.4; color: var(--text-light); letter-spacing: 1px;
			}
			@media (max-width: 600px) {
				.footer-couple { font-size: 1.4rem; letter-spacing: 2px; }
				.footer-ampersand { margin: 0 10px; }
				.section-footer::before { font-size: 10rem; }
			}

			/* FOOTER TAHAP 2 */
			.web-footer {
				background: #0a0a0a;
				padding: 3rem 0 1.5rem;
				border-top: 1px solid rgba(201, 160, 61, 0.15);
				color: rgba(255,255,255,0.5);
				position: relative; overflow: hidden;
			}
			.web-footer::before {
				content: ''; position: absolute; top: 0; left: 0; right: 0;
				height: 1px;
				background: linear-gradient(90deg, transparent, rgba(201, 160, 61, 0.5), transparent);
			}
			.web-footer .container {
				max-width: 1280px; margin: 0 auto;
				padding: 0 24px; position: relative; z-index: 1;
			}
			.web-footer-brand {
				font-family: 'Playfair Display', serif;
				font-size: 1.5rem; font-weight: 700;
				margin-bottom: 0.75rem; text-decoration: none;
				display: inline-block; letter-spacing: 2px;
			}
			.web-footer-brand .wedding {
				background: linear-gradient(135deg, #c9a03d 0%, #f4e5b1 50%, #c9a03d 100%);
				-webkit-background-clip: text; background-clip: text;
				color: transparent;
			}
			.web-footer-brand .saas { color: var(--gold); font-weight: 400; }
			.web-footer-desc {
				color: rgba(255,255,255,0.45); font-size: 0.85rem;
				line-height: 1.6; margin-bottom: 1rem; font-weight: 300;
			}
			.web-footer-heading {
				font-family: 'Playfair Display', serif;
				font-size: 0.95rem; font-weight: 600;
				color: var(--gold); margin-bottom: 1rem;
				position: relative; padding-bottom: 0.5rem;
				letter-spacing: 1.5px;
			}
			.web-footer-heading::after {
				content: ''; position: absolute; bottom: 0; left: 0;
				width: 30px; height: 1px;
				background: linear-gradient(90deg, var(--gold), transparent);
				border-radius: 2px;
			}
			.web-footer-list { list-style: none; padding: 0; margin: 0; }
			.web-footer-list li {
				display: flex; align-items: flex-start;
				gap: 10px; margin-bottom: 0.65rem;
				color: rgba(255,255,255,0.5);
				font-size: 0.85rem; line-height: 1.5; font-weight: 300;
			}
			.web-footer-list li i {
				color: var(--gold); font-size: 1rem;
				margin-top: 2px; flex-shrink: 0; opacity: 0.85;
			}
			.web-footer-list li a, .web-footer-link {
				color: rgba(255,255,255,0.5); text-decoration: none;
				transition: color 0.2s;
			}
			.web-footer-list li a:hover, .web-footer-link:hover { color: var(--gold-light); }
			.web-footer-socials {
				display: flex; gap: 10px;
				flex-wrap: wrap; margin-top: 0.75rem;
			}
			.web-social-link {
				width: 40px; height: 40px;
				display: inline-flex; align-items: center; justify-content: center;
				background: rgba(201, 160, 61, 0.05);
				border: 1px solid rgba(201, 160, 61, 0.2);
				border-radius: 50%;
				color: var(--gold-light); font-size: 1.05rem;
				transition: all 0.3s; text-decoration: none;
			}
			.web-social-link:hover {
				background: rgba(201, 160, 61, 0.15);
				border-color: var(--gold);
				color: #ffffff; transform: translateY(-3px);
				box-shadow: 0 6px 20px rgba(201, 160, 61, 0.25);
			}
			.web-footer-version {
				color: rgba(255,255,255,0.35); font-size: 0.7rem;
				margin: 0; padding: 4px 12px;
				background: rgba(201, 160, 61, 0.05);
				border-radius: 20px; display: inline-block;
				border: 1px solid rgba(201, 160, 61, 0.1); letter-spacing: 1px;
			}
			.web-footer-divider {
				border: 0; border-top: 1px solid rgba(201, 160, 61, 0.08);
				margin: 2rem 0 1.25rem; opacity: 1;
			}
			.web-footer-text {
				color: rgba(255,255,255,0.3); font-size: 0.75rem;
				margin: 0; text-align: center;
				letter-spacing: 1px; font-weight: 300;
			}
			.web-footer .row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}
			@media (max-width: 768px) {
				.web-footer { padding: 2.25rem 0 1.25rem; text-align: center; }
				.web-footer-heading::after { left: 50%; transform: translateX(-50%); }
				.web-footer-list li { justify-content: center; }
				.web-footer-socials { justify-content: center; }
			}
			@media (max-width: 480px) {
				[data-aos] { opacity: 1 !important; transform: none !important; }
			}
		</style>
	</head>
	<body data-music-url={ musicURL } data-project-id={ formatUint(project.ID) } data-project-slug={ project.Slug }>

    		<!-- ============================================ -->
		<!-- OVERLAY START -->
		<!-- ============================================ -->
		<div id="startOverlay">
			<div class="overlay-inner">
				<span class="overlay-ornament">✦</span>

				<h1 class="overlay-title">Elegant Gold</h1>

				<p class="overlay-subtitle">
					{ groomName } &amp; { brideName }
				</p>

				<div class="overlay-divider"></div>

				<div class="overlay-guest">
					if isNamedGuest {
						<div class="overlay-guest-label">Kepada</div>
					} else {
						<div class="overlay-guest-label">Salam Hangat untuk</div>
					}
					<div class="overlay-guest-name">{ guestName }</div>
					<div class="overlay-guest-divider"></div>
				</div>

				<button class="btn-start" onclick={ templpkg.JSFuncCall("startMusic") }>
					<i class="bi bi-play-fill me-2"></i>
					Buka Undangan
				</button>

				<p class="hint">✦ Klik untuk membuka undangan ✦</p>
			</div>
		</div>

		<!-- ============================================ -->
		<!-- MUSIC PLAYER -->
		<!-- ============================================ -->
		<div class="music-player" id="musicPlayer">
			<button class="music-btn" id="musicToggle" onclick={ templpkg.JSFuncCall("toggleMusic") }>
				<i class="bi bi-music-note"></i>
			</button>
		</div>

		<!-- ============================================ -->
		<!-- HERO -->
		<!-- ============================================ -->
		<section class="hero-gold" id="section-hero">
			<div class="hero-ornament-bottom hero-ornament-bottom-1">✦</div>
			<div class="hero-ornament-bottom hero-ornament-bottom-2">✦</div>

			<div class="hero-content" data-aos="fade-up" data-aos-duration="1200">
				<div class="hero-ornament-top">✦ ✦ ✦</div>
				<div class="hero-badge">The Wedding of</div>

				<h1 class="hero-couple">
					<span class="groom-name">{ groomName }</span>
					<span class="ampersand">&amp;</span>
					<span class="bride-name">{ brideName }</span>
				</h1>

				<div class="hero-subtitle">Elegant Gold</div>

				<div class="divider-gold">
					<span></span>
					<i class="bi bi-heart-fill heart-gold"></i>
					<i class="bi bi-star-fill" style="font-size:0.4rem; opacity:0.3;"></i>
					<i class="bi bi-heart-fill heart-gold"></i>
					<span></span>
				</div>

				<div class="hero-dates">
					if showDates(data) == "both" || showDates(data) == "akad" {
						<div class="date-item">
							<i class="bi bi-calendar3"></i>
							<span>Akad: { getStr(data, "akad_date") }</span>
						</div>
					}

					if showDates(data) == "both" {
						<span class="date-divider">|</span>
					}

					if showDates(data) == "both" || showDates(data) == "resepsi" {
						<div class="date-item">
							<i class="bi bi-calendar-event"></i>
							<span>{ getResepsiLabel(data) }: { getStr(data, "resepsi_date") }</span>
						</div>
					}
				</div>

				<div class="hero-venue" style="display:flex; align-items:center; justify-content:center; flex-wrap:wrap; gap:6px; font-size:0.95rem; opacity:0.6; margin-bottom:36px; letter-spacing:1px; font-weight:300;">
					if showVenue(data) == "both" || showVenue(data) == "akad" {
						<span>
							<i class="bi bi-geo-alt me-2" style="color:var(--gold);"></i>
							Akad: { getStr(data, "akad_venue") }
						</span>
					}

					if showVenue(data) == "both" {
						<span style="color:rgba(255,255,255,0.05); font-size:0.5rem;">|</span>
					}

					if showVenue(data) == "both" || showVenue(data) == "resepsi" {
						<span>
							<i class="bi bi-geo-alt me-2" style="color:var(--gold);"></i>
							{ getResepsiLabel(data) }: { getStr(data, "resepsi_venue") }
						</span>
					}
				</div>

				<a href="#section-rsvp" class="btn-rsvp">
					<i class="bi bi-envelope-check me-2"></i>Konfirmasi Kehadiran
				</a>
			</div>

			<div class="scroll-indicator" onclick={ templpkg.JSFuncCall("scrollToCouple") }>
				<span>Scroll</span>
				<i class="bi bi-chevron-double-down"></i>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- COUPLE -->
		<!-- ============================================ -->
		<section class="section-gold" id="section-couple">
			<div class="container">
				<div class="section-label" data-aos="fade-up">MEMPELAI</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Pasangan Bahagia
					<span class="gold-ornament">✦</span>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Dua hati yang dipertemukan dalam ikatan suci, bersinar dalam kemewahan cinta
				</p>

				<div class="couple-grid">
					<div class="couple-card" data-aos="fade-right" data-aos-delay="100">
						<div class="couple-photo-wrap">
							<div class="couple-photo">
								<img src={ groomPhoto } alt={ groomName } style="width:100%; height:100%; object-fit:cover;"/>
							</div>
						</div>
						<div class="couple-info">
							<h3>{ groomName }</h3>
							<p class="couple-title">Putra dari</p>
							<p class="couple-parents">{ getParentsNameSplit(fatherGroomName, motherGroomName) }</p>
							if getStr(data, "groom_instagram") != "-" {
								<div class="couple-social">
									<a href={ templpkg.SafeURL(getStr(data, "groom_instagram")) } target="_blank"><i class="bi bi-instagram"></i></a>
								</div>
							}
						</div>
					</div>

					<div class="couple-ampersand" data-aos="zoom-in" data-aos-delay="150">&amp;</div>

					<div class="couple-card" data-aos="fade-left" data-aos-delay="200">
						<div class="couple-photo-wrap">
							<div class="couple-photo">
								<img src={ bridePhoto } alt={ brideName } style="width:100%; height:100%; object-fit:cover;"/>
							</div>
						</div>
						<div class="couple-info">
							<h3>{ brideName }</h3>
							<p class="couple-title">Putri dari</p>
							<p class="couple-parents">{ getParentsNameSplit(fatherBrideName, motherBrideName) }</p>
							if getStr(data, "bride_instagram") != "-" {
								<div class="couple-social">
									<a href={ templpkg.SafeURL(getStr(data, "bride_instagram")) } target="_blank"><i class="bi bi-instagram"></i></a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- LOVE STORY -->
		<!-- ============================================ -->
		if stories := getLoveStories(data); len(stories) > 0 {
			<section class="section-gold-alt" id="section-love">
				<div class="container">
					<div class="section-label" data-aos="fade-up">CERITA</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Perjalanan Cinta
						<span class="gold-ornament">✦</span>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Setiap pertemuan adalah takdir yang indah, setiap momen adalah emas
					</p>

					<div class="love-timeline">
						for index, story := range stories {
							<div class="timeline-item" data-aos="fade-up" data-aos-delay={ formatInt(100 * (index + 1)) }>
								<div class="timeline-dot"><i class="bi bi-heart-fill" style="font-size:0.4rem;"></i></div>
								<div class="timeline-content">
									<h4 class="timeline-title">{ story["title"] }</h4>
									<p class="timeline-desc">{ story["desc"] }</p>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- ============================================ -->
		<!-- EVENT -->
		<!-- ============================================ -->
		<section class="section-gold" id="section-event">
			<div class="container">
				<div class="section-label" data-aos="fade-up">ACARA</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Detail Acara
					<span class="gold-ornament">✦</span>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Kami mengundang kehadiran Bapak/Ibu/Saudara/i dalam kebahagiaan ini
				</p>

				<div class="event-grid">
					<div class="event-card" data-aos="fade-up" data-aos-delay="100">
						<div class="event-icon"><i class="bi bi-gem"></i></div>
						<h3 class="event-title">Akad Nikah</h3>
						<div class="event-datetime">
							<i class="bi bi-calendar3"></i>
							<span>{ getStr(data, "akad_date") }</span>
						</div>
						<div class="event-datetime">
							<i class="bi bi-clock"></i>
							<span>Pukul { getStr(data, "akad_time") }</span>
						</div>
						<div class="event-venue">
							<i class="bi bi-geo-alt"></i>
							<span>{ getStr(data, "akad_venue") }</span>
						</div>
						if getStr(data, "maps_url_akad") != "-" {
							<div>
								<a href={ templpkg.SafeURL(getStr(data, "maps_url_akad")) } target="_blank" class="btn-map">
									<i class="bi bi-geo-alt me-2"></i>Buka Lokasi
								</a>
							</div>
						}
					</div>

					<div class="event-card" data-aos="fade-up" data-aos-delay="150">
						<div class="event-icon"><i class="bi bi-balloon"></i></div>

						<h3 class="event-title">{ getResepsiLabel(data) }</h3>

						if isIslamicLabel(data) && getResepsiArabic(data) != "" {
							<div style="font-family:'Cormorant Garamond',serif; font-size:0.85rem; color:var(--gold); margin-bottom:8px; font-style:italic; opacity:0.7;">
								{ getResepsiArabic(data) }
							</div>
						}

						<div class="event-datetime">
							<i class="bi bi-calendar3"></i>
							<span>{ getStr(data, "resepsi_date") }</span>
						</div>
						<div class="event-datetime">
							<i class="bi bi-clock"></i>
							<span>Pukul { getStr(data, "resepsi_time") }</span>
						</div>
						<div class="event-venue">
							<i class="bi bi-geo-alt"></i>
							<span>{ getStr(data, "resepsi_venue") }</span>
						</div>
						if getStr(data, "maps_url_resepsi") != "-" {
							<div>
								<a href={ templpkg.SafeURL(getStr(data, "maps_url_resepsi")) } target="_blank" class="btn-map">
									<i class="bi bi-geo-alt me-2"></i>Buka Lokasi { getResepsiLabel(data) }
								</a>
							</div>
						}
					</div>
				</div>

				if getStr(data, "maps_url") != "-" && getStr(data, "maps_url_akad") == "-" && getStr(data, "maps_url_resepsi") == "-" {
					<div style="text-align:center; margin-top:30px;" data-aos="fade-up">
						<a href={ templpkg.SafeURL(getStr(data, "maps_url")) } target="_blank"
						style="display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg, var(--gold), var(--gold-dark)); color:var(--dark); padding:12px 32px; border-radius:50px; text-decoration:none; font-size:0.85rem; font-weight:500; transition:all 0.3s; box-shadow:0 4px 30px rgba(201,160,61,0.15);">
							<i class="bi bi-geo-alt-fill"></i>
							<span>Buka Lokasi { getResepsiLabel(data) }</span>
						</a>
					</div>
				}
			</div>
		</section>

        		<!-- ============================================ -->
		<!-- GALLERY -->
		<!-- ============================================ -->
		if gallery := getGallery(data); len(gallery) > 0 {
			<section class="section-gold" id="section-gallery">
				<div class="container">
					<div class="section-label" data-aos="fade-up">GALERI</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Momen Terindah
						<span class="gold-ornament">✦</span>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Kebahagiaan yang terabadikan dalam setiap momen berharga
					</p>

					<div class="gallery-grid">
						for index, img := range gallery {
							<div class="gallery-item" data-aos="fade-up" data-aos-delay={ formatInt(100 * ((index % 6) + 1)) }>
								<img src={ img } alt={ "Foto " + formatInt(index+1) } loading="lazy"/>
								<div class="gallery-overlay"><i class="bi bi-zoom-in"></i></div>
								<span class="gallery-badge">✦</span>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- ============================================ -->
		<!-- RSVP -->
		<!-- ============================================ -->
		<section class="section-gold-alt" id="section-rsvp">
			<div class="container">
				<div class="section-label" data-aos="fade-up">KONFIRMASI</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Kehadiran
					<span class="gold-ornament">✦</span>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Kami sangat berbahagia jika Anda bisa hadir di hari bahagia kami
				</p>

				<form class="rsvp-form" method="POST" action={ templpkg.SafeURL("/invitation/" + project.Slug + "/rsvp") } data-aos="fade-up" data-aos-delay="150" id="rsvpForm">
					<input type="hidden" name="project_id" value={ formatUint(project.ID) }/>

					if hasExistingRsvp(data) {
						<div style="background: rgba(201,160,61,0.08); border: 1px solid var(--gold); border-radius: 14px; padding: 14px 18px; margin-bottom: 20px;">
							<div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
								<i class="bi bi-check-circle-fill" style="color: var(--gold); font-size: 1.2rem;"></i>
								<strong style="color: var(--gold-light);">Anda sudah RSVP</strong>
							</div>
							<p style="margin: 0; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
								Data di bawah sudah terisi otomatis. Anda bisa edit jika ada perubahan.
							</p>
						</div>
					}

					<div class="form-group">
						<label for="rsvp-name">Nama Anda <span class="required">*</span></label>
						if isNamedGuest {
							<input type="text" id="rsvp-name" name="guest_name" value={ guestName } readonly/>
							<small style="display:block; margin-top:6px; font-size:0.7rem; color:var(--text-muted); font-style:italic;">
								<i class="bi bi-info-circle me-1"></i>Nama otomatis terisi dari undangan yang Anda terima
							</small>
						} else {
							<input type="text" id="rsvp-name" name="guest_name" placeholder="Nama lengkap" required/>
						}
					</div>

					<div class="form-group">
						<label for="rsvp-attendance">Kehadiran <span class="required">*</span></label>
						<select id="rsvp-attendance" name="attendance" required>
							if getExistingRsvpField(data, "attendance", "") == "" {
								<option value="" selected>Pilih konfirmasi</option>
							} else {
								<option value="">Pilih konfirmasi</option>
							}
							if getExistingRsvpField(data, "attendance", "") == "hadir" {
								<option value="hadir" selected>Hadir</option>
							} else {
								<option value="hadir">Hadir</option>
							}
							if getExistingRsvpField(data, "attendance", "") == "tidak_hadir" {
								<option value="tidak_hadir" selected>Tidak Hadir</option>
							} else {
								<option value="tidak_hadir">Tidak Hadir</option>
							}
							if getExistingRsvpField(data, "attendance", "") == "ragu" {
								<option value="ragu" selected>Ragu-ragu</option>
							} else {
								<option value="ragu">Ragu-ragu</option>
							}
						</select>
					</div>

					<div class="form-group">
						<label for="rsvp-guests">Jumlah Tamu</label>
						<input type="number" id="rsvp-guests" name="total_guests" value={ formatInt(getExistingRsvpGuests(data)) } min="1" max="10"/>
					</div>

					<div class="form-group">
						<label for="rsvp-message">Ucapan &amp; Doa</label>
						<textarea id="rsvp-message" name="message" rows="3" placeholder="Tuliskan ucapan dan doa untuk pengantin...">{ getExistingRsvpField(data, "message", "") }</textarea>
					</div>

					<button type="submit" class="btn-submit">
						<i class="bi bi-send me-2"></i>
						Kirim Konfirmasi
					</button>
				</form>

				<div style="max-width:500px; margin:30px auto 0; padding-top:20px; border-top:1px solid rgba(201,160,61,0.06);">
					<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
						<h4 style="font-size:0.95rem; color:var(--gold); font-weight:600; margin:0;">
							<i class="bi bi-people me-2"></i>Konfirmasi Kehadiran
						</h4>
						<span id="rsvpCount" style="font-size:0.7rem; color:var(--text-muted); background:rgba(201,160,61,0.06); padding:2px 14px; border-radius:12px;">
							0 tamu
						</span>
					</div>

					<div id="rsvpList">
						<div style="text-align:center; color:var(--text-muted); font-size:0.8rem; padding:20px 0;">
							<i class="bi bi-hourglass-split me-2"></i>Memuat daftar konfirmasi...
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================ -->
		<!-- AMPLOP DIGITAL -->
		<!-- ============================================ -->
		if showBankAccounts(data) && len(getBankAccounts(data)) > 0 {
			<section class="section-gold-alt" id="section-bank">
				<div class="container">
					<div class="section-label" data-aos="fade-up">AMPLOP DIGITAL</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Kirim Hadiah
						<span class="gold-ornament">✦</span>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Doa restu Anda adalah hadiah terindah. Namun jika ingin memberi, kami sediakan:
					</p>

					<div class="bank-grid">
						for index, account := range getBankAccounts(data) {
							<div class="bank-card-elegant" data-aos="fade-up" data-aos-delay={ formatInt(80 * (index + 1)) }>
								<span class="bank-type-badge">{ getBankTypeBadge(account) }</span>

								<div class="bank-logo">
									if hasCustomIcon(account) {
										<img src={ "/storage/" + getAccountIconPath(account) } alt={ getAccountBankName(account, data) }/>
									} else {
										<span class="bank-logo-icon">{ getAccountInitial(account, data) }</span>
									}
								</div>

								<div class="bank-name">{ getAccountBankName(account, data) }</div>

								<div class="bank-number-wrapper" data-number={ getAccountNumber(account) } onclick={ templpkg.JSFuncCall("copyBankNumberFromEl", templpkg.JSExpression("this")) }>
									<span class="bank-number">{ getAccountNumber(account) }</span>
									<i class="bi bi-clipboard copy-icon"></i>
								</div>

								<div class="bank-holder">
									a.n. <strong>{ getAccountName(account) }</strong>
								</div>
							</div>
						}
					</div>

					<p style="text-align:center; margin-top:32px; font-size:0.8rem; color:var(--text-muted); font-style:italic; opacity:0.7;" data-aos="fade-up">
						<i class="bi bi-info-circle me-1" style="color:var(--gold);"></i>
						Klik nomor rekening untuk menyalin
					</p>
				</div>
			</section>
		}

		<!-- ============================================ -->
		<!-- FOOTER TAHAP 1 -->
		<!-- ============================================ -->
		<footer class="section-footer">
			<div class="footer-inner">
				<div class="footer-couple">
					<span>{ groomName }</span>
					<span class="footer-ampersand">&amp;</span>
					<span>{ brideName }</span>
				</div>
				<div class="footer-divider"></div>
				<p class="footer-date">{ getStr(data, "akad_date") }</p>
				<div class="footer-social">
					if eventInstagram != "-" && eventInstagram != "" {
						<a href={ templpkg.SafeURL(eventInstagram) } target="_blank"><i class="bi bi-instagram"></i></a>
					}
					if getStr(data, "whatsapp") != "-" {
						<a href={ templpkg.SafeURL("https://wa.me/" + getStr(data, "whatsapp")) } target="_blank"><i class="bi bi-whatsapp"></i></a>
					}
				</div>
				<p class="footer-prayer">
					"Cinta sejati adalah anugerah terindah dari Tuhan"
				</p>
			</div>
		</footer>

		<!-- ============================================ -->
		<!-- FOOTER TAHAP 2 -->
		<!-- ============================================ -->
		<footer class="web-footer">
			<div class="container">
				<div class="row">
					<div>
						<a href="/" class="web-footer-brand-link" style="text-decoration:none;">
							<h5 class="web-footer-brand">
								if getSiteConfig(data, "site_favicon", "") != "" {
									<img src={ "/storage/" + getSiteConfig(data, "site_favicon", "") } alt="Logo" style="width: 32px; height: 32px; object-fit: contain; margin-right: 8px; vertical-align: middle;"/>
								}
								<span class="wedding">Wedding</span><span class="saas">SaaS</span>
							</h5>
						</a>
						<p class="web-footer-desc">
							{ getSiteConfig(data, "footer_description", "Platform undangan pernikahan digital dengan template elegan, RSVP online, guest book, dan galeri foto.") }
						</p>

						<p class="web-footer-desc mb-2" style="margin-top: 8px;">
							<i class="bi bi-globe me-1" style="color:var(--gold);"></i>
							<a href="https://wedding.litebox.my.id" target="_blank" rel="noopener" class="web-footer-link">
								wedding.litebox.my.id
							</a>
						</p>

						<div class="web-footer-socials">
							if getSiteConfig(data, "social_instagram", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "social_instagram", "")) } target="_blank" rel="noopener" class="web-social-link" title="Instagram">
									<i class="bi bi-instagram"></i>
								</a>
							}
							if getSiteConfig(data, "social_facebook", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "social_facebook", "")) } target="_blank" rel="noopener" class="web-social-link" title="Facebook">
									<i class="bi bi-facebook"></i>
								</a>
							}
							if getSiteConfig(data, "social_tiktok", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "social_tiktok", "")) } target="_blank" rel="noopener" class="web-social-link" title="TikTok">
									<i class="bi bi-tiktok"></i>
								</a>
							}
							if getSiteConfig(data, "social_youtube", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "social_youtube", "")) } target="_blank" rel="noopener" class="web-social-link" title="YouTube">
									<i class="bi bi-youtube"></i>
								</a>
							}
							if getSiteConfig(data, "social_twitter", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "social_twitter", "")) } target="_blank" rel="noopener" class="web-social-link" title="Twitter">
									<i class="bi bi-twitter-x"></i>
								</a>
							}
						</div>
					</div>

					<div>
						<h6 class="web-footer-heading">Kontak Kami</h6>
						<ul class="web-footer-list">
							if getSiteConfig(data, "contact_email", "") != "" {
								<li>
									<i class="bi bi-envelope"></i>
									<a href={ templpkg.SafeURL("mailto:" + getSiteConfig(data, "contact_email", "")) }>{ getSiteConfig(data, "contact_email", "") }</a>
								</li>
							}
							if getSiteConfig(data, "contact_phone", "") != "" {
								<li>
									<i class="bi bi-telephone"></i>
									<span>{ getSiteConfig(data, "contact_phone", "") }</span>
								</li>
							}
							if getSiteConfig(data, "contact_whatsapp", "") != "" {
								<li>
									<i class="bi bi-whatsapp"></i>
									<a href={ templpkg.SafeURL("https://wa.me/" + getSiteConfig(data, "contact_whatsapp", "")) } target="_blank" rel="noopener">WhatsApp Chat</a>
								</li>
							}
							if getSiteConfig(data, "contact_address", "") != "" {
								<li>
									<i class="bi bi-geo-alt"></i>
									<span>{ getSiteConfig(data, "contact_address", "") }</span>
								</li>
							}
						</ul>
					</div>

					<div>
						<h6 class="web-footer-heading">Dikembangkan Oleh</h6>
						<p class="web-footer-desc mb-2">
							<i class="bi bi-code-slash me-1" style="color:var(--gold);"></i>
							if getSiteConfig(data, "developer_url", "") != "" {
								<a href={ templpkg.SafeURL(getSiteConfig(data, "developer_url", "")) } target="_blank" rel="noopener" class="web-footer-link">{ getSiteConfig(data, "developer_name", "Tim Developer") }</a>
							} else {
								{ getSiteConfig(data, "developer_name", "Tim Developer") }
							}
						</p>
						if getSiteConfig(data, "developer_email", "") != "" {
							<p class="web-footer-desc mb-2">
								<i class="bi bi-envelope-at me-1"></i>
								<a href={ templpkg.SafeURL("mailto:" + getSiteConfig(data, "developer_email", "")) } class="web-footer-link">{ getSiteConfig(data, "developer_email", "") }</a>
							</p>
						}
						if getSiteConfig(data, "footer_version", "") != "" {
							<p class="web-footer-version">
								<i class="bi bi-tag me-1"></i>{ getSiteConfig(data, "footer_version", "") }
							</p>
						}
					</div>
				</div>

				<hr class="web-footer-divider"/>

				<div class="text-center">
					<p class="web-footer-text">
						© { formatInt(currentYear()) } { getSiteConfig(data, "footer_copyright", "Wedding SaaS. Platform Undangan Digital. All rights reserved.") }
					</p>
				</div>
			</div>
		</footer>

		<!-- ============================================ -->
		<!-- SCRIPTS -->
		<!-- ============================================ -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<script>
			// AOS
			AOS.init({
				duration: 800,
				easing: 'ease-in-out',
				once: true,
				mirror: false,
				offset: 50,
				disable: function() { return window.innerWidth < 480; }
			});
			window.addEventListener('resize', function() { AOS.refresh(); });

			// MUSIC PLAYER — baca dari data-attribute
			var musicUrl = document.body.dataset.musicUrl || '';
			var projectID = document.body.dataset.projectId || '';
			var projectSlug = document.body.dataset.projectSlug || '';
			var audio = null;
			var isPlaying = false;
			var hasStarted = false;
			var MUSIC_KEY = 'wedding_music_state_' + projectID;

			function initAudio() {
				if (!musicUrl) return false;
				if (audio) return true;
				audio = new Audio(musicUrl);
				audio.loop = true;
				audio.volume = 0.5;
				return true;
			}

			window.startMusic = function() {
				if (!initAudio()) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					closeOverlay();
					return;
				}
				audio.play().then(function() {
					isPlaying = true;
					hasStarted = true;
					var btn = document.getElementById('musicToggle');
					if (btn) {
						btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
						btn.classList.add('playing');
					}
					localStorage.setItem(MUSIC_KEY, 'playing');
					closeOverlay();
				}).catch(function(e) {
					console.log('Play failed:', e);
					closeOverlay();
					document.addEventListener('click', function retry() {
						audio.play().catch(function(){});
						document.removeEventListener('click', retry);
					}, { once: true });
				});
			};

			function closeOverlay() {
				var overlay = document.getElementById('startOverlay');
				if (overlay) {
					overlay.style.opacity = '0';
					setTimeout(function() {
						overlay.style.display = 'none';
						document.body.style.overflow = '';
					}, 800);
				}
			}

			window.toggleMusic = function() {
				if (!audio && musicUrl) initAudio();
				if (!audio) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					return;
				}
				var btn = document.getElementById('musicToggle');
				if (isPlaying) {
					audio.pause();
					isPlaying = false;
					btn.innerHTML = '<i class="bi bi-music-note"></i>';
					btn.classList.remove('playing');
					localStorage.setItem(MUSIC_KEY, 'paused');
				} else {
					audio.play().catch(function(e) { console.log('Play blocked'); });
					isPlaying = true;
					btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
					btn.classList.add('playing');
					localStorage.setItem(MUSIC_KEY, 'playing');
				}
			};

			document.getElementById('startOverlay')?.addEventListener('click', function(e) {
				startMusic();
			});
			document.getElementById('musicToggle')?.addEventListener('click', function(e) {
				if (!hasStarted) startMusic();
			});
			document.addEventListener('keydown', function(e) {
				if (e.key === ' ' && !hasStarted) { e.preventDefault(); startMusic(); }
			});

			window.scrollToCouple = function() {
				var el = document.getElementById('section-couple');
				if (el) el.scrollIntoView({ behavior: 'smooth' });
			};

			function showToast(type, message) {
				var container = document.querySelector('.toast-container');
				if (!container) {
					container = document.createElement('div');
					container.className = 'toast-container';
					document.body.appendChild(container);
				}
				var toast = document.createElement('div');
				toast.className = 'toast';
				var icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
				toast.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
				container.appendChild(toast);
				setTimeout(function() {
					toast.style.opacity = '0';
					toast.style.transform = 'translateX(100px)';
					setTimeout(function() { toast.remove(); }, 400);
				}, 3000);
			}

			function escapeHtml(text) {
				if (!text) return '';
				var div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			// COPY BANK NUMBER
			window.copyBankNumberFromEl = function(el) {
				var number = el.getAttribute('data-number');
				if (!number) return;
				copyText(number, el);
			};

			function copyText(number, element) {
				var doSuccess = function() {
					showToast('success', 'Nomor rekening dicopy!');
					if (element) {
						var icon = element.querySelector('.copy-icon');
						if (icon) {
							var original = icon.className;
							icon.className = 'bi bi-check-circle-fill copy-icon';
							icon.style.color = '#10b981';
							icon.style.opacity = '1';
							setTimeout(function() {
								icon.className = original;
								icon.style.color = '';
								icon.style.opacity = '';
							}, 1500);
						}
					}
				};
				if (navigator.clipboard) {
					navigator.clipboard.writeText(number).then(doSuccess).catch(function() {
						fallbackCopy(number, element);
					});
				} else {
					fallbackCopy(number, element);
				}
			}

			function fallbackCopy(text, element) {
				var textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				try {
					document.execCommand('copy');
					showToast('success', 'Nomor rekening dicopy!');
				} catch (err) {
					showToast('error', 'Gagal copy nomor');
				}
				document.body.removeChild(textarea);
			}

			// LIGHTBOX
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('.gallery-item').forEach(function(item) {
					item.addEventListener('click', function() {
						var img = this.querySelector('img');
						if (img) {
							var lightbox = document.createElement('div');
							lightbox.className = 'lightbox';
							lightbox.innerHTML = '<span class="lightbox-close">&times;</span><img src="' + img.src + '" alt="' + (img.alt || 'Foto') + '">';
							document.body.appendChild(lightbox);
							lightbox.addEventListener('click', function(e) {
								if (e.target === this || e.target.classList.contains('lightbox-close')) {
									this.remove();
								}
							});
						}
					});
				});
			});

			// LOAD RSVP LIST
			function loadRsvpList() {
				var listContainer = document.getElementById('rsvpList');
				var countContainer = document.getElementById('rsvpCount');
				if (!listContainer) return;

				fetch('/invitation/' + projectSlug + '/rsvp-list')
					.then(function(r) { return r.json(); })
					.then(function(data) {
						if (!data || data.length === 0) {
							listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-envelope"></i>Belum ada konfirmasi kehadiran</div>';
							if (countContainer) countContainer.textContent = '0 tamu';
							return;
						}
						var totalGuests = 0;
						var html = '';
						data.forEach(function(item) {
							var statusText = item.attendance === 'hadir' ? '✅ Hadir' : (item.attendance === 'tidak_hadir' ? '❌ Tidak Hadir' : '❓ Ragu-ragu');
							totalGuests += parseInt(item.total_guests || 1);
							var time = new Date(item.created_at);
							var timeStr = time.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) + ' ' + time.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
							var messageHtml = item.message ? '<div class="message">' + escapeHtml(item.message) + '</div>' : '';
							html += '<div class="rsvp-item"><div class="row-main"><span class="guest-name">' + escapeHtml(item.guest_name) + '</span><span class="status-badge ' + item.attendance + '">' + statusText + '</span></div><div class="row-detail"><div class="meta-left"><span class="time"><i class="bi bi-clock"></i> ' + timeStr + '</span><span class="guests"><i class="bi bi-person"></i> ' + (item.total_guests || 1) + ' org</span></div></div>' + messageHtml + '</div>';
						});
						listContainer.innerHTML = html;
						if (countContainer) countContainer.textContent = totalGuests + ' tamu';
					})
					.catch(function() {
						listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-exclamation-triangle"></i>Gagal memuat daftar konfirmasi<br><button onclick="loadRsvpList()" style="margin-top:10px; padding:8px 20px; background:var(--gold); color:var(--dark); border:none; border-radius:8px; cursor:pointer; font-weight:600;"><i class="bi bi-arrow-clockwise"></i> Coba Lagi</button></div>';
					});
			}

			// SUBMIT RSVP
			document.addEventListener('DOMContentLoaded', function() {
				var form = document.getElementById('rsvpForm');
				if (!form) return;
				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var formData = new FormData(form);
					var btn = form.querySelector('button[type="submit"]');
					var originalText = btn.innerHTML;
					btn.disabled = true;
					btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Mengirim...';
					fetch(form.action, { method: 'POST', body: formData })
						.then(function(r) { return r.json(); })
						.then(function(data) {
							if (data.success) {
								var isUpdate = data.updated === true;
								Swal.fire({
									title: isUpdate ? 'Konfirmasi Diperbarui!' : 'Berhasil!',
									text: data.message,
									icon: 'success',
									confirmButtonColor: '#c9a03d',
									background: '#1a1a1a',
									color: '#e8d5b7',
									timer: 2000,
									timerProgressBar: true,
									showConfirmButton: false
								});
								if (!isUpdate) form.reset();
								setTimeout(function() { loadRsvpList(); }, 500);
							} else {
								Swal.fire({
									title: 'Gagal!',
									text: data.message || 'Terjadi kesalahan',
									icon: 'error',
									confirmButtonColor: '#c9a03d',
									background: '#1a1a1a',
									color: '#e8d5b7'
								});
							}
						})
						.catch(function() {
							Swal.fire({
								title: 'Error!',
								text: 'Terjadi kesalahan, silakan coba lagi',
								icon: 'error',
								confirmButtonColor: '#c9a03d',
								background: '#1a1a1a',
								color: '#e8d5b7'
							});
						})
						.finally(function() {
							btn.disabled = false;
							btn.innerHTML = originalText;
						});
				});
				loadRsvpList();
			});
		</script>
	</body>
	</html>
}
