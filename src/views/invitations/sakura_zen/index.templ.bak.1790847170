package sakura_zen

import (
	"context"
	"io"

	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/invitation"
	"wedding-invitation-go/internal/models"
	"wedding-invitation-go/views/invitations/shared"
)

// SakuraZen — tema undangan Japanese Zen / Sakura
func SakuraZen(ctx context.Context, w io.Writer, project models.Project, data *invitation.TemplateData, guestName string) error {
	component := sakuraZenPage(data)
	return component.Render(ctx, w)
}

templ sakuraZenPage(data *invitation.TemplateData) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"/>
		<title>{ data.GroomName } &amp; { data.BrideName } - Sakura Zen</title>

		if data.SiteConfig.SiteFavicon != "" {
			<link rel="icon" href={ "/storage/" + data.SiteConfig.SiteFavicon }/>
			<link rel="apple-touch-icon" href={ "/storage/" + data.SiteConfig.SiteFavicon }/>
		} else {
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
		}

		<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet"/>

		<style>
			/* ============================================ */
			/* ROOT VARIABLES — SAKURA ZEN */
			/* ============================================ */
			:root {
				--sakura: #f8b5c4;
				--sakura-dark: #d68a9c;
				--sakura-light: #fce4ea;
				--sakura-soft: #fef5f8;
				--ink: #1a1a1a;
				--ink-soft: #3a3a3a;
				--ink-muted: #6b6b6b;
				--ink-light: #9a9a9a;
				--paper: #faf7f2;
				--paper-dark: #f0ebe3;
				--paper-soft: #f5f1ea;
				--accent: #c73e54;
				--accent-dark: #a02e42;
				--white: #ffffff;
				--shadow: 0 4px 20px rgba(26, 26, 26, 0.06);
				--shadow-md: 0 8px 40px rgba(26, 26, 26, 0.1);
			}

			* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
			body {
				font-family: 'Inter', sans-serif;
				background: var(--paper);
				color: var(--ink);
				line-height: 1.8;
				overflow-x: hidden;
				min-height: 100vh;
				min-height: 100svh;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
			}
			body.overlay-active {
				overflow: hidden;
				position: fixed;
				width: 100%;
				height: 100%;
			}
			img { max-width: 100%; height: auto; display: block; }

			.container { max-width: 720px; margin: 0 auto; padding: 0 24px; }
			@media (max-width: 600px) { .container { padding: 0 20px; } }

			/* ============================================ */
			/* SAKURA PETALS — FALLING ANIMATION */
			/* ============================================ */
			.sakura-petals {
				position: fixed;
				inset: 0;
				pointer-events: none;
				z-index: 100;
				overflow: hidden;
			}
			.petal {
				position: absolute;
				top: -50px;
				font-size: 1.2rem;
				opacity: 0.4;
				color: var(--sakura);
				animation: fall linear infinite;
			}
			.petal:nth-child(1) { left: 5%; animation-duration: 12s; animation-delay: 0s; }
			.petal:nth-child(2) { left: 20%; animation-duration: 15s; animation-delay: 2s; font-size: 0.8rem; }
			.petal:nth-child(3) { left: 35%; animation-duration: 10s; animation-delay: 4s; }
			.petal:nth-child(4) { left: 50%; animation-duration: 14s; animation-delay: 1s; font-size: 0.9rem; }
			.petal:nth-child(5) { left: 65%; animation-duration: 13s; animation-delay: 3s; }
			.petal:nth-child(6) { left: 80%; animation-duration: 11s; animation-delay: 5s; font-size: 1rem; }
			.petal:nth-child(7) { left: 92%; animation-duration: 16s; animation-delay: 6s; }
			@keyframes fall {
				0% { transform: translateY(-50px) rotate(0deg); opacity: 0; }
				10% { opacity: 0.5; }
				90% { opacity: 0.5; }
				100% { transform: translateY(100vh) rotate(360deg); opacity: 0; }
			}

			/* ============================================ */
			/* TYPOGRAPHY */
			/* ============================================ */
			.section-label {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 8px;
				color: var(--sakura-dark);
				text-align: center;
				margin-bottom: 16px;
				font-weight: 500;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 16px;
			}
			.section-label::before, .section-label::after {
				content: '❀';
				font-size: 0.8rem;
				opacity: 0.6;
				color: var(--sakura);
			}
			.section-title {
				font-family: 'Cormorant Garamond', serif;
				font-size: 2.8rem;
				font-weight: 400;
				text-align: center;
				margin-bottom: 16px;
				color: var(--ink);
				line-height: 1.2;
				letter-spacing: -0.01em;
			}
			.section-title em {
				font-style: italic;
				color: var(--sakura-dark);
				font-weight: 300;
			}
			.section-subtitle {
				font-family: 'Cormorant Garamond', serif;
				text-align: center;
				color: var(--ink-muted);
				font-size: 1rem;
				max-width: 520px;
				margin: 0 auto 60px;
				font-style: italic;
				line-height: 1.8;
				font-weight: 300;
			}
			@media (max-width: 600px) {
				.section-title { font-size: 2rem; }
				.section-subtitle { font-size: 0.9rem; margin-bottom: 40px; }
			}
			.kanji-accent {
				font-family: 'Noto Serif JP', serif;
				font-size: 4rem;
				color: var(--sakura);
				opacity: 0.15;
				position: absolute;
				pointer-events: none;
				font-weight: 700;
			}

			/* ============================================ */
			/* TOAST */
			/* ============================================ */
			.toast-container {
				position: fixed; top: 20px; right: 20px; z-index: 9999;
				display: flex; flex-direction: column; gap: 8px;
			}
			.toast {
				background: var(--ink); color: var(--white);
				padding: 12px 20px; border-radius: 4px;
				box-shadow: var(--shadow-md);
				animation: slideInToast 0.4s ease;
				min-width: 200px;
				display: flex; align-items: center; gap: 10px;
				font-size: 0.85rem;
				border-left: 3px solid var(--sakura);
			}
			.toast i { font-size: 1.1rem; }
			.toast.success i { color: #10b981; }
			.toast.error i { color: #ef4444; }
			.toast.info i { color: var(--sakura); }
			@keyframes slideInToast {
				from { transform: translateX(100%); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}

			/* ============================================ */
			/* OVERLAY START */
			/* ============================================ */
			#startOverlay {
				position: fixed; top: 0; left: 0; right: 0; bottom: 0;
				width: 100vw; height: 100vh;
				background: rgba(250, 247, 242, 0.97);
				z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				transition: opacity 0.8s ease;
				cursor: pointer;
				padding: 24px;
				overflow-y: auto;
			}
			#startOverlay::before {
				content: '花';
				position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				font-family: 'Noto Serif JP', serif;
				font-size: 30rem;
				color: var(--sakura);
				opacity: 0.05;
				pointer-events: none;
				font-weight: 700;
			}
			#startOverlay .overlay-inner {
				position: relative;
				z-index: 2;
				text-align: center;
				max-width: 500px; width: 100%;
				padding: 20px; margin: auto;
			}
			#startOverlay .overlay-sakura {
				font-size: 3rem;
				color: var(--sakura);
				margin-bottom: 16px;
				display: block;
				opacity: 0.8;
			}
			#startOverlay .overlay-title {
				font-family: 'Cormorant Garamond', serif;
				font-size: 2.4rem;
				font-weight: 400;
				color: var(--ink);
				margin-bottom: 8px;
				letter-spacing: 2px;
			}
			#startOverlay .overlay-subtitle {
				font-family: 'Noto Serif JP', serif;
				color: var(--sakura-dark);
				font-size: 0.95rem;
				margin-bottom: 8px;
				letter-spacing: 3px;
			}
			#startOverlay .overlay-divider {
				width: 60px; height: 1px;
				background: linear-gradient(90deg, transparent, var(--sakura), transparent);
				margin: 20px auto 24px;
			}
			#startOverlay .overlay-guest-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--ink-muted);
				margin-bottom: 10px;
				font-style: italic;
			}
			#startOverlay .overlay-guest-name {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.6rem;
				font-weight: 500;
				color: var(--ink);
				line-height: 1.3;
				margin-bottom: 36px;
				font-style: italic;
			}
			#startOverlay .btn-start {
				display: inline-flex; align-items: center; gap: 10px;
				background: var(--sakura);
				color: var(--white);
				padding: 16px 44px;
				border: none; border-radius: 2px;
				font-family: 'Inter', sans-serif;
				font-weight: 500; font-size: 0.85rem;
				cursor: pointer;
				box-shadow: 0 4px 20px rgba(248, 181, 196, 0.3);
				transition: all 0.3s;
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			#startOverlay .btn-start:hover {
				transform: translateY(-2px);
				background: var(--sakura-dark);
				box-shadow: 0 8px 30px rgba(248, 181, 196, 0.4);
			}
			#startOverlay .hint {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.65rem;
				opacity: 0.5;
				margin-top: 20px;
				letter-spacing: 4px;
				color: var(--ink-muted);
			}
			@media (max-width: 600px) {
				#startOverlay .overlay-title { font-size: 1.8rem; }
				#startOverlay .btn-start { padding: 14px 32px; font-size: 0.75rem; width: 100%; max-width: 280px; justify-content: center; }
			}

			/* ============================================ */
			/* MUSIC PLAYER */
			/* ============================================ */
			.music-player { position: fixed; bottom: 24px; right: 24px; z-index: 1000; }
			.music-btn {
				width: 52px; height: 52px; border-radius: 50%;
				background: var(--paper);
				border: 1px solid var(--sakura);
				color: var(--sakura-dark);
				font-size: 1.3rem; cursor: pointer;
				box-shadow: 0 4px 20px rgba(248, 181, 196, 0.2);
				transition: all 0.3s;
				display: flex; align-items: center; justify-content: center;
			}
			.music-btn:hover { transform: scale(1.05); background: var(--sakura-soft); }
			.music-btn.playing { animation: pulseSakura 2s infinite; }
			@keyframes pulseSakura {
				0% { box-shadow: 0 0 0 0 rgba(248, 181, 196, 0.4); }
				70% { box-shadow: 0 0 0 16px rgba(248, 181, 196, 0); }
				100% { box-shadow: 0 0 0 0 rgba(248, 181, 196, 0); }
			}

			/* ============================================ */
			/* HERO — SAKURA ZEN */
			/* ============================================ */
			.hero-sakura {
				position: relative;
				min-height: 100vh;
				min-height: 100svh;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 80px 24px;
				background: linear-gradient(180deg, var(--sakura-soft) 0%, var(--paper) 50%, var(--paper-dark) 100%);
				overflow: hidden;
			}
			.hero-sakura::before {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse at 50% 20%, rgba(248, 181, 196, 0.15) 0%, transparent 60%);
				pointer-events: none;
			}
			.hero-sakura .hero-inner {
				position: relative;
				z-index: 2;
				max-width: 720px;
				width: 100%;
			}
			.hero-sakura .hero-kanji {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.2rem;
				color: var(--sakura-dark);
				letter-spacing: 8px;
				margin-bottom: 24px;
				font-weight: 400;
				opacity: 0.7;
			}
			.hero-sakura .hero-eyebrow {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 10px;
				color: var(--ink-muted);
				margin-bottom: 24px;
				font-style: italic;
				font-weight: 300;
			}
			.hero-sakura .hero-names {
				font-family: 'Cormorant Garamond', serif;
				font-size: 4.5rem;
				font-weight: 300;
				line-height: 1.05;
				margin-bottom: 24px;
				display: flex;
				flex-direction: column;
				align-items: center;
				color: var(--ink);
				letter-spacing: -0.01em;
			}
			.hero-sakura .hero-names .amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				font-size: 2.2rem;
				color: var(--sakura-dark);
				margin: 12px 0;
				font-weight: 300;
			}
			.hero-sakura .hero-divider {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 16px;
				margin: 24px 0;
			}
			.hero-sakura .hero-divider .line {
				width: 60px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--sakura-dark), transparent);
				opacity: 0.5;
			}
			.hero-sakura .hero-divider .ornament {
				color: var(--sakura);
				font-size: 1rem;
			}
			.hero-sakura .hero-dates {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--ink-muted);
				letter-spacing: 4px;
				margin-bottom: 32px;
				font-style: italic;
				font-weight: 300;
			}
			.hero-sakura .btn-rsvp {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: var(--sakura);
				color: var(--white);
				padding: 15px 40px;
				border: none;
				border-radius: 2px;
				font-family: 'Inter', sans-serif;
				font-weight: 500;
				font-size: 0.8rem;
				text-decoration: none;
				letter-spacing: 3px;
				text-transform: uppercase;
				transition: all 0.3s;
				cursor: pointer;
				box-shadow: 0 4px 20px rgba(248, 181, 196, 0.3);
			}
			.hero-sakura .btn-rsvp:hover {
				background: var(--sakura-dark);
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(248, 181, 196, 0.4);
			}
			@media (max-width: 700px) {
				.hero-sakura { padding: 60px 20px; }
				.hero-sakura .hero-names { font-size: 2.6rem; }
				.hero-sakura .hero-names .amp { font-size: 1.5rem; }
			}

			/* ============================================ */
			/* OPENING QUOTE */
			/* ============================================ */
			.opening-sakura {
				padding: 100px 24px;
				background: var(--paper);
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.opening-sakura::before {
				content: '禅';
				position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				font-family: 'Noto Serif JP', serif;
				font-size: 20rem;
				color: rgba(248, 181, 196, 0.08);
				pointer-events: none;
				font-weight: 700;
			}
			.opening-sakura .opening-inner {
				position: relative;
				z-index: 2;
				max-width: 640px;
				margin: 0 auto;
			}
			.opening-sakura .opening-icon {
				font-size: 2.5rem;
				color: var(--sakura);
				margin-bottom: 24px;
				display: block;
				opacity: 0.8;
			}
			.opening-sakura .opening-quote {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.5rem;
				font-style: italic;
				font-weight: 300;
				color: var(--ink-soft);
				line-height: 1.7;
				margin-bottom: 32px;
			}
			.opening-sakura .opening-source {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--sakura-dark);
			}
			@media (max-width: 600px) {
				.opening-sakura { padding: 80px 20px; }
				.opening-sakura .opening-quote { font-size: 1.15rem; }
			}

			/* ============================================ */
			/* SECTION BASE */
			/* ============================================ */
			.section-sakura {
				padding: 100px 0;
				background: var(--paper);
				position: relative;
			}
			.section-sakura-alt {
				padding: 100px 0;
				background: var(--paper-dark);
				position: relative;
			}
			@media (max-width: 600px) {
				.section-sakura, .section-sakura-alt { padding: 80px 0; }
			}

			/* ============================================ */
			/* COUPLE */
			/* ============================================ */
			.couple-sakura-grid {
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				gap: 40px;
				align-items: center;
			}
			@media (max-width: 700px) {
				.couple-sakura-grid { grid-template-columns: 1fr; gap: 40px; }
				.couple-sakura-amp { display: none; }
			}
			.couple-sakura-card {
				text-align: center;
			}
			.couple-sakura-photo-wrap {
				position: relative;
				width: 200px; height: 200px;
				margin: 0 auto 24px;
			}
			.couple-sakura-photo-wrap::before {
				content: '';
				position: absolute;
				inset: -10px;
				border: 1px solid var(--sakura);
				opacity: 0.4;
			}
			.couple-sakura-photo-wrap::after {
				content: '';
				position: absolute;
				inset: -5px;
				border: 1px solid var(--sakura);
				opacity: 0.2;
			}
			.couple-sakura-photo {
				width: 200px; height: 200px;
				border-radius: 50%;
				overflow: hidden;
				border: 3px solid var(--paper);
				box-shadow: 0 4px 30px rgba(248, 181, 196, 0.2);
				position: relative; z-index: 1;
				background: var(--paper-dark);
			}
			.couple-sakura-photo img {
				width: 100%; height: 100%; object-fit: cover;
			}
			@media (max-width: 700px) {
				.couple-sakura-photo-wrap, .couple-sakura-photo { width: 160px; height: 160px; }
			}
			.couple-sakura-info h3 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.8rem;
				font-weight: 400;
				color: var(--ink);
				margin-bottom: 8px;
				letter-spacing: 0.5px;
			}
			.couple-sakura-role {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--sakura-dark);
				margin-bottom: 12px;
			}
			.couple-sakura-parents-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				color: var(--ink-light);
				font-style: italic;
				margin-bottom: 4px;
			}
			.couple-sakura-parents {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--ink-soft);
				font-style: italic;
				line-height: 1.6;
				margin-bottom: 16px;
			}
			.couple-sakura-social {
				display: flex;
				justify-content: center;
				gap: 12px;
				margin-top: 16px;
			}
			.couple-sakura-social a {
				width: 38px; height: 38px;
				border-radius: 50%;
				border: 1px solid var(--sakura);
				color: var(--sakura-dark);
				font-size: 0.95rem;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 0.3s;
				text-decoration: none;
				background: var(--paper);
			}
			.couple-sakura-social a:hover {
				background: var(--sakura);
				color: var(--white);
				transform: translateY(-2px);
			}
			.couple-sakura-amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				font-size: 2.5rem;
				color: var(--sakura);
				font-weight: 300;
			}

			/* ============================================ */
			/* LOVE STORY */
			/* ============================================ */
			.story-sakura-timeline {
				position: relative;
				max-width: 640px;
				margin: 0 auto;
				padding-left: 40px;
			}
			.story-sakura-timeline::before {
				content: '';
				position: absolute;
				left: 12px; top: 0; bottom: 0;
				width: 1px;
				background: linear-gradient(180deg, transparent, var(--sakura), transparent);
				opacity: 0.5;
			}
			.story-sakura-item {
				position: relative;
				margin-bottom: 40px;
				padding-left: 24px;
			}
			.story-sakura-item:last-child { margin-bottom: 0; }
			.story-sakura-dot {
				position: absolute;
				left: -30px; top: 8px;
				width: 20px; height: 20px;
				background: var(--paper);
				border: 1px solid var(--sakura);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--sakura);
				font-size: 0.55rem;
			}
			.story-sakura-content {
				background: var(--paper);
				border: 1px solid rgba(248, 181, 196, 0.25);
				padding: 24px 28px;
				border-radius: 2px;
				transition: all 0.3s;
				box-shadow: var(--shadow);
			}
			.story-sakura-item:hover .story-sakura-content {
				border-color: var(--sakura);
				box-shadow: var(--shadow-md);
				transform: translateX(4px);
			}
			.story-sakura-title {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.2rem;
				font-weight: 500;
				color: var(--ink);
				margin-bottom: 8px;
				letter-spacing: 0.5px;
			}
			.story-sakura-desc {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.98rem;
				color: var(--ink-muted);
				font-style: italic;
				line-height: 1.7;
				font-weight: 300;
			}

			/* ============================================ */
			/* EVENT */
			/* ============================================ */
			.event-sakura-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 28px;
			}
			@media (max-width: 700px) {
				.event-sakura-grid { grid-template-columns: 1fr; }
			}
			.event-sakura-card {
				background: var(--paper);
				border: 1px solid rgba(248, 181, 196, 0.3);
				border-radius: 2px;
				padding: 48px 32px;
				text-align: center;
				transition: all 0.4s;
				position: relative;
				overflow: hidden;
				box-shadow: var(--shadow);
			}
			.event-sakura-card::before {
				content: '';
				position: absolute;
				top: 12px; left: 12px; right: 12px; bottom: 12px;
				border: 1px solid rgba(248, 181, 196, 0.15);
				pointer-events: none;
			}
			.event-sakura-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--shadow-md);
				border-color: var(--sakura);
			}
			.event-sakura-icon {
				width: 64px; height: 64px;
				background: var(--sakura-soft);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 20px;
				color: var(--sakura-dark);
				font-size: 1.5rem;
				border: 1px solid var(--sakura);
			}
			.event-sakura-title {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.5rem;
				font-weight: 500;
				color: var(--ink);
				margin-bottom: 6px;
				letter-spacing: 0.5px;
			}
			.event-sakura-arabic {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.85rem;
				color: var(--sakura-dark);
				margin-bottom: 20px;
				font-style: italic;
			}
			.event-sakura-detail {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--ink-muted);
				line-height: 2;
				margin-bottom: 20px;
			}
			.event-sakura-btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				color: var(--sakura-dark);
				text-decoration: none;
				font-size: 0.78rem;
				font-weight: 500;
				letter-spacing: 3px;
				text-transform: uppercase;
				border-bottom: 1px solid var(--sakura);
				padding-bottom: 4px;
				transition: all 0.3s;
			}
			.event-sakura-btn:hover {
				color: var(--accent);
				gap: 14px;
			}

			/* ============================================ */
			/* GALLERY */
			/* ============================================ */
			.gallery-sakura-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 16px;
			}
			@media (max-width: 600px) {
				.gallery-sakura-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
			}
			.gallery-sakura-item {
				position: relative;
				aspect-ratio: 1;
				overflow: hidden;
				border-radius: 2px;
				border: 1px solid rgba(248, 181, 196, 0.3);
				cursor: pointer;
				transition: all 0.4s;
			}
			.gallery-sakura-item:hover {
				border-color: var(--sakura);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.gallery-sakura-item img {
				width: 100%; height: 100%;
				object-fit: cover;
				transition: transform 0.6s;
			}
			.gallery-sakura-item:hover img { transform: scale(1.06); }
			.gallery-sakura-item .overlay {
				position: absolute;
				inset: 0;
				background: rgba(248, 181, 196, 0);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--white);
				font-size: 1.6rem;
				opacity: 0;
				transition: all 0.3s;
			}
			.gallery-sakura-item:hover .overlay {
				background: rgba(248, 181, 196, 0.4);
				opacity: 1;
			}

			/* ============================================ */
			/* RSVP */
			/* ============================================ */
			.rsvp-form { max-width: 520px; margin: 0 auto; }
			.form-group { margin-bottom: 20px; text-align: left; }
			.form-group label {
				display: block;
				font-family: 'Noto Serif JP', serif;
				font-size: 0.75rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 3px;
				color: var(--sakura-dark);
				margin-bottom: 8px;
			}
			.form-group .required { color: var(--accent); }
			.form-group input, .form-group select, .form-group textarea {
				width: 100%;
				padding: 14px 18px;
				border: 1px solid rgba(248, 181, 196, 0.4);
				border-radius: 2px;
				font-size: 1rem;
				font-family: 'Inter', sans-serif;
				background: var(--paper);
				color: var(--ink);
				transition: all 0.3s;
			}
			.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
				outline: none;
				border-color: var(--sakura);
				box-shadow: 0 0 0 3px rgba(248, 181, 196, 0.15);
			}
			.form-group input[readonly] {
				background: var(--sakura-soft);
				color: var(--sakura-dark);
				cursor: not-allowed;
				font-weight: 500;
			}
			.form-group textarea { resize: vertical; min-height: 90px; }
			.btn-submit {
				width: 100%;
				padding: 16px;
				background: var(--sakura);
				color: var(--white);
				border: none;
				border-radius: 2px;
				font-family: 'Inter', sans-serif;
				font-size: 0.85rem;
				font-weight: 500;
				cursor: pointer;
				transition: all 0.3s;
				letter-spacing: 3px;
				text-transform: uppercase;
				margin-top: 8px;
			}
			.btn-submit:hover {
				background: var(--sakura-dark);
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(248, 181, 196, 0.3);
			}
			.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

			.rsvp-warning {
				background: var(--sakura-soft);
				border-left: 3px solid var(--sakura);
				padding: 16px 20px;
				margin-bottom: 24px;
				border-radius: 2px;
			}
			.rsvp-warning-title {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 4px;
			}
			.rsvp-warning-title i {
				color: var(--sakura-dark);
				font-size: 1.1rem;
			}
			.rsvp-warning-title strong {
				font-size: 0.9rem;
				color: var(--ink);
				font-weight: 500;
			}
			.rsvp-warning p {
				margin: 0;
				font-size: 0.82rem;
				color: var(--ink-muted);
				line-height: 1.6;
			}

			.rsvp-list-wrap {
				max-width: 520px;
				margin: 60px auto 0;
				padding-top: 32px;
				border-top: 1px solid rgba(248, 181, 196, 0.3);
			}
			.rsvp-list-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 24px;
			}
			.rsvp-list-head h4 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.15rem;
				font-weight: 500;
				color: var(--ink);
				margin: 0;
				letter-spacing: 0.5px;
			}
			.rsvp-count {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.78rem;
				color: var(--sakura-dark);
				letter-spacing: 2px;
				text-transform: uppercase;
			}
			#rsvpList {
				display: flex;
				flex-direction: column;
				gap: 12px;
				max-height: 440px;
				overflow-y: auto;
			}
			.rsvp-item {
				background: var(--paper);
				border: 1px solid rgba(248, 181, 196, 0.3);
				border-radius: 2px;
				padding: 16px 20px;
				transition: all 0.3s;
			}
			.rsvp-item:hover {
				border-color: var(--sakura);
				box-shadow: 0 4px 20px rgba(248, 181, 196, 0.15);
			}
			.rsvp-item .row-main {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 6px;
			}
			.rsvp-item .guest-name {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.05rem;
				font-weight: 500;
				color: var(--ink);
			}
			.rsvp-item .status-badge {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.62rem;
				padding: 3px 12px;
				border-radius: 2px;
				letter-spacing: 2px;
				text-transform: uppercase;
				font-weight: 500;
			}
			.rsvp-item .status-badge.hadir {
				background: rgba(16, 185, 129, 0.1);
				color: #059669;
			}
			.rsvp-item .status-badge.tidak_hadir {
				background: rgba(192, 57, 43, 0.1);
				color: #c0392b;
			}
			.rsvp-item .status-badge.ragu {
				background: rgba(245, 158, 11, 0.12);
				color: #d97706;
			}
			.rsvp-item .row-detail {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 8px;
			}
			.rsvp-item .meta-left {
				display: flex;
				align-items: center;
				gap: 14px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.8rem;
				color: var(--ink-light);
				font-style: italic;
			}
			.rsvp-item .meta-left span { display: flex; align-items: center; gap: 4px; }
			.rsvp-item .message {
				margin-top: 10px;
				padding: 12px 16px;
				background: var(--sakura-soft);
				border-left: 3px solid var(--sakura);
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem;
				color: var(--ink-muted);
				font-style: italic;
				line-height: 1.6;
				border-radius: 2px;
			}
			.rsvp-empty {
				text-align: center;
				color: var(--ink-light);
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.9rem;
				font-style: italic;
				padding: 40px 0;
			}
			.rsvp-empty i {
				display: block;
				font-size: 1.8rem;
				margin-bottom: 10px;
				color: var(--sakura);
				opacity: 0.5;
			}

			/* ============================================ */
			/* BANK / AMPLOP DIGITAL */
			/* ============================================ */
			.bank-sakura-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 20px; max-width: 800px; margin: 0 auto;
			}
			.bank-sakura-card {
				background: var(--paper);
				border: 1px solid rgba(248, 181, 196, 0.3);
				border-radius: 2px; padding: 28px 24px;
				text-align: center; transition: all 0.4s ease;
				box-shadow: var(--shadow);
				position: relative; overflow: hidden;
			}
			.bank-sakura-card::before {
				content: ''; position: absolute;
				top: 0; left: 0; right: 0; height: 2px;
				background: linear-gradient(90deg, transparent, var(--sakura), transparent);
			}
			.bank-sakura-card:hover {
				transform: translateY(-6px);
				border-color: var(--sakura);
				box-shadow: var(--shadow-md);
			}
			.bank-logo {
				width: 68px; height: 68px; margin: 0 auto 14px;
				border-radius: 50%;
				background: var(--sakura-soft);
				border: 1px solid var(--sakura);
				display: flex; align-items: center; justify-content: center;
				overflow: hidden; transition: all 0.3s;
				position: relative; z-index: 1;
			}
			.bank-sakura-card:hover .bank-logo {
				background: var(--sakura-light);
				transform: scale(1.05);
			}
			.bank-logo img { max-width: 70%; max-height: 70%; object-fit: contain; }
			.bank-logo-icon {
				font-size: 1.5rem; color: var(--sakura-dark);
				font-weight: 700; font-family: 'Cormorant Garamond', serif;
				letter-spacing: 1px;
			}
			.bank-name {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.1rem; font-weight: 500;
				color: var(--ink); margin-bottom: 12px;
				letter-spacing: 0.5px; position: relative; z-index: 1;
			}
			.bank-number-wrapper {
				display: flex; align-items: center; justify-content: center;
				gap: 8px;
				background: var(--sakura-soft);
				border: 1px dashed rgba(248, 181, 196, 0.6);
				border-radius: 2px; padding: 10px 14px;
				margin-bottom: 10px; cursor: pointer;
				transition: all 0.3s; position: relative; z-index: 1;
			}
			.bank-number-wrapper:hover {
				background: var(--sakura-light);
				border-color: var(--sakura);
				transform: scale(1.02);
			}
			.bank-number {
				font-family: 'Courier New', monospace;
				font-size: 1rem; font-weight: 700;
				color: var(--ink); letter-spacing: 2px;
				word-break: break-all;
			}
			.copy-icon {
				color: var(--sakura-dark); font-size: 0.85rem;
				opacity: 0.7; transition: all 0.3s; flex-shrink: 0;
			}
			.bank-number-wrapper:hover .copy-icon { opacity: 1; transform: scale(1.15); }
			.bank-holder {
				font-size: 0.82rem; color: var(--ink-muted);
				font-style: italic; margin-top: 4px;
				position: relative; z-index: 1;
			}
			.bank-holder strong { color: var(--ink); font-weight: 500; font-style: normal; }
			.bank-type-badge {
				position: absolute; top: 12px; right: 12px;
				font-size: 0.5rem; padding: 3px 10px; border-radius: 2px;
				background: var(--sakura-soft);
				color: var(--sakura-dark);
				letter-spacing: 1.5px; text-transform: uppercase;
				font-weight: 700; z-index: 2;
				border: 1px solid var(--sakura);
			}
			@media (max-width: 600px) {
				.bank-sakura-grid { grid-template-columns: 1fr; }
				.bank-logo { width: 58px; height: 58px; }
				.bank-logo-icon { font-size: 1.3rem; }
				.bank-name { font-size: 1rem; }
				.bank-number { font-size: 0.9rem; letter-spacing: 1.5px; }
			}

			/* ============================================ */
			/* FOOTER */
			/* ============================================ */
			.footer-sakura {
				padding: 100px 24px 60px;
				background: linear-gradient(180deg, var(--paper-dark) 0%, var(--paper) 100%);
				text-align: center;
				position: relative;
				overflow: hidden;
				border-top: 1px solid rgba(248, 181, 196, 0.3);
			}
			.footer-sakura::before {
				content: '⛩';
				position: absolute;
				top: 50%; left: 50%;
				transform: translate(-50%, -50%);
				font-family: 'Noto Serif JP', serif;
				font-size: 18rem;
				color: rgba(248, 181, 196, 0.1);
				pointer-events: none;
			}
			.footer-sakura-inner {
				position: relative;
				z-index: 1;
				max-width: 640px;
				margin: 0 auto;
			}
			.footer-sakura-icon {
				font-size: 2rem;
				color: var(--sakura);
				margin-bottom: 20px;
				display: block;
			}
			.footer-sakura-couple {
				font-family: 'Cormorant Garamond', serif;
				font-size: 2rem;
				font-weight: 400;
				color: var(--ink);
				margin-bottom: 16px;
				letter-spacing: 0.5px;
			}
			.footer-sakura-couple .amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				color: var(--sakura-dark);
				margin: 0 14px;
				font-weight: 300;
			}
			.footer-sakura-date {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.85rem;
				color: var(--sakura-dark);
				letter-spacing: 5px;
				text-transform: uppercase;
				margin-bottom: 32px;
			}
			.footer-sakura-prayer {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				font-style: italic;
				color: var(--ink-muted);
				max-width: 520px;
				margin: 0 auto;
				line-height: 1.9;
				font-weight: 300;
			}

			/* ============================================ */
			/* FOOTER SOCIAL (WAJIB) */
			/* ============================================ */
			.footer-social {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 24px;
			}
			.footer-social a {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 10px 18px;
				border: 1px solid rgba(248, 181, 196, 0.5);
				border-radius: 2px;
				color: var(--sakura-dark);
				text-decoration: none;
				font-size: 0.8rem;
				font-weight: 500;
				transition: all 0.3s;
				opacity: 0.9;
				white-space: nowrap;
				background: var(--paper);
			}
			.footer-social a:hover {
				background: var(--sakura);
				color: var(--white);
				border-color: var(--sakura);
				transform: translateY(-2px);
			}
			.footer-social a i { font-size: 1rem; }
			.footer-social a span { font-size: 0.8rem; font-weight: 500; }

			/* ============================================ */
			/* WEB FOOTER (WAJIB) */
			/* ============================================ */
			.web-footer {
				background: var(--ink);
				padding: 3rem 0 1.5rem;
				border-top: 1px solid rgba(248, 181, 196, 0.15);
				color: rgba(255,255,255,0.6);
				position: relative;
			}
			.web-footer .container { max-width: 1280px !important; }
			.web-footer-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}
			.web-footer-brand {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.4rem;
				font-weight: 500;
				margin-bottom: 20px;
				text-decoration: none;
				display: inline-block;
				letter-spacing: 1px;
			}
			.web-footer-brand img {
				display: inline-block !important;
				vertical-align: middle;
				margin-right: 8px;
			}
			.web-footer-brand .wedding {
				background: linear-gradient(135deg, #f8b5c4 0%, #d68a9c 100%);
				-webkit-background-clip: text; background-clip: text;
				color: transparent;
			}
			.web-footer-brand .saas { color: var(--sakura); }
			.web-footer-desc {
				color: rgba(255,255,255,0.5); font-size: 0.85rem;
				line-height: 1.6; margin-bottom: 1rem;
			}
			.web-footer-heading {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem; font-weight: 500;
				color: var(--sakura); margin-bottom: 1rem;
				position: relative; padding-bottom: 0.5rem;
			}
			.web-footer-heading::after {
				content: ''; position: absolute; bottom: 0; left: 0;
				width: 30px; height: 1px;
				background: linear-gradient(90deg, var(--sakura), transparent);
			}
			.web-footer-list { list-style: none; padding: 0; margin: 0; }
			.web-footer-list li {
				display: flex; align-items: flex-start;
				gap: 10px; margin-bottom: 0.65rem;
				color: rgba(255,255,255,0.55); font-size: 0.85rem;
			}
			.web-footer-list li i {
				color: var(--sakura); font-size: 1rem;
				margin-top: 2px; flex-shrink: 0;
			}
			.web-footer-list li a, .web-footer-link {
				color: rgba(255,255,255,0.55); text-decoration: none;
				transition: color 0.2s;
			}
			.web-footer-list li a:hover, .web-footer-link:hover { color: var(--sakura); }
			.web-footer-socials {
				display: flex; gap: 10px;
				flex-wrap: wrap; margin-top: 0.75rem;
			}
			.web-social-link {
				width: 38px; height: 38px;
				display: inline-flex; align-items: center; justify-content: center;
				background: rgba(248, 181, 196, 0.08);
				border: 1px solid rgba(248, 181, 196, 0.2);
				border-radius: 50%;
				color: var(--sakura); font-size: 1.05rem;
				transition: all 0.25s; text-decoration: none;
			}
			.web-social-link:hover {
				background: var(--sakura);
				border-color: var(--sakura);
				color: var(--ink); transform: translateY(-3px);
			}
			.web-footer-version {
				color: rgba(255,255,255,0.35); font-size: 0.75rem;
				margin: 0; padding: 4px 10px;
				background: rgba(248, 181, 196, 0.06);
				border-radius: 2px; display: inline-block;
			}
			.web-footer-divider {
				border: 0; border-top: 1px solid rgba(248, 181, 196, 0.1);
				margin: 2rem 0 1.25rem;
			}
			.web-footer-text {
				color: rgba(255,255,255,0.35); font-size: 0.8rem;
				margin: 0; text-align: center;
			}
			.web-footer-icon { color: var(--sakura); }
			@media (max-width: 768px) {
				.web-footer { padding: 2.25rem 0 1.25rem; text-align: center; }
				.web-footer-heading::after { left: 50%; transform: translateX(-50%); }
				.web-footer-list li { justify-content: center; }
				.web-footer-socials { justify-content: center; }
			}
		</style>
	</head>
	<body data-music-url={ data.MusicURL } data-project-id={ invitation.FormatUint(data.Project.ID) } data-project-slug={ data.Project.Slug }>

		<!-- SAKURA PETALS -->
		<div class="sakura-petals">
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
			<span class="petal">🌸</span>
		</div>

		<!-- OVERLAY -->
		<div id="startOverlay">
			<div class="overlay-inner">
				<span class="overlay-sakura">🌸</span>
				<h1 class="overlay-title">Sakura Zen</h1>
				<p class="overlay-subtitle">桜 ・ 禅</p>
				<div class="overlay-divider"></div>

				<div class="overlay-guest-label">
					{ invitation.GuestGreeting(data.IsNamedGuest) }
				</div>
				<div class="overlay-guest-name">{ data.GuestName }</div>

				<button class="btn-start" onclick={ templpkg.JSFuncCall("startMusic") }>
					<i class="bi bi-flower1"></i>
					Buka Undangan
				</button>

				<p class="hint">お 楽 し み に</p>
			</div>
		</div>

		<!-- MUSIC PLAYER -->
		@shared.MusicPlayer()

		<!-- HERO -->
		<section class="hero-sakura" id="section-hero">
			<div class="hero-inner" data-aos="fade-up" data-aos-duration="1200">
				<div class="hero-kanji">桜 と 愛</div>
				<div class="hero-eyebrow">The Wedding Of</div>

				<h1 class="hero-names">
					<span>{ data.GroomName }</span>
					<span class="amp">&amp;</span>
					<span>{ data.BrideName }</span>
				</h1>

				<div class="hero-divider">
					<span class="line"></span>
					<span class="ornament">❀</span>
					<span class="line"></span>
				</div>

				<div class="hero-dates">
					if data.ShouldShowAkadDate() {
						{ data.AkadDate }
					}
					if data.ShouldShowBothDates() {
						<span> ・ </span>
					}
					if data.ShouldShowResepsiDate() {
						{ data.ResepsiDate }
					}
				</div>

				<button class="btn-rsvp" onclick={ templpkg.JSFuncCall("scrollToSection") }>
					<i class="bi bi-arrow-down"></i>
					Lihat Undangan
				</button>
			</div>
		</section>

		<!-- OPENING QUOTE -->
		<section class="opening-sakura" id="section-opening">
			<div class="opening-inner" data-aos="fade-up">
				<span class="opening-icon">❀</span>
				<div class="opening-quote">
					"Dengan memohon rahmat dan ridho Tuhan Yang Maha Esa, kami bermaksud menyelenggarakan pernikahan putra-putri kami."
				</div>
				<div class="opening-source">The Wedding Of { data.GroomName } &amp; { data.BrideName }</div>
			</div>
		</section>

		<!-- COUPLE -->
		<section class="section-sakura" id="section-couple">
			<div class="container">
				<div class="section-label" data-aos="fade-up">Mempelai</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Two Hearts<br/><em>in Bloom</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Seperti bunga sakura yang mekar, cinta kami tumbuh indah dalam kesederhanaan
				</p>

				<div class="couple-sakura-grid">
					<!-- GROOM -->
					<div class="couple-sakura-card" data-aos="fade-right" data-aos-delay="150">
						<div class="couple-sakura-photo-wrap">
							<div class="couple-sakura-photo">
								<img src={ data.GroomPhotoOrDefault() } alt={ data.GroomName } loading="lazy"/>
							</div>
						</div>
						<div class="couple-sakura-info">
							<h3>{ data.GroomName }</h3>
							<div class="couple-sakura-role">花婿 ・ The Groom</div>
							<div class="couple-sakura-parents-label">Putra dari</div>
							<div class="couple-sakura-parents">{ data.ParentsGroom() }</div>
							if data.GroomInstagram != "" {
								<div class="couple-sakura-social">
									<a href={ templpkg.SafeURL(data.GroomInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>

					<div class="couple-sakura-amp" data-aos="zoom-in" data-aos-delay="200">❀</div>

					<!-- BRIDE -->
					<div class="couple-sakura-card" data-aos="fade-left" data-aos-delay="250">
						<div class="couple-sakura-photo-wrap">
							<div class="couple-sakura-photo">
								<img src={ data.BridePhotoOrDefault() } alt={ data.BrideName } loading="lazy"/>
							</div>
						</div>
						<div class="couple-sakura-info">
							<h3>{ data.BrideName }</h3>
							<div class="couple-sakura-role">花嫁 ・ The Bride</div>
							<div class="couple-sakura-parents-label">Putri dari</div>
							<div class="couple-sakura-parents">{ data.ParentsBride() }</div>
							if data.BrideInstagram != "" {
								<div class="couple-sakura-social">
									<a href={ templpkg.SafeURL(data.BrideInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- LOVE STORY -->
		if len(data.LoveStories) > 0 {
			<section class="section-sakura-alt" id="section-love">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Our Story</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Perjalanan<br/><em>yang mekar</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Setiap momen adalah kelopak yang jatuh indah dalam waktu
					</p>

					<div class="story-sakura-timeline">
						for index, story := range data.LoveStories {
							<div class="story-sakura-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<div class="story-sakura-dot">❀</div>
								<div class="story-sakura-content">
									<h4 class="story-sakura-title">{ story.Title }</h4>
									<p class="story-sakura-desc">{ story.Desc }</p>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- EVENT -->
		<section class="section-sakura" id="section-event">
			<div class="container">
				<div class="section-label" data-aos="fade-up">Event</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Detail<br/><em>Acara</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Dengan penuh rasa hormat, kami mengundang Bapak/Ibu/Saudara/i
				</p>

				<div class="event-sakura-grid">
					<!-- Akad -->
					<div class="event-sakura-card" data-aos="fade-up" data-aos-delay="150">
						<div class="event-sakura-icon"><i class="bi bi-flower1"></i></div>
						<h3 class="event-sakura-title">Akad Nikah</h3>
						<div class="event-sakura-detail">
							<div>{ data.AkadDate }</div>
							<div>Pukul { data.AkadTime } WIB</div>
							<div>{ data.AkadVenue }</div>
						</div>
						if data.MapsURLAkad != "" {
							<a href={ templpkg.SafeURL(data.MapsURLAkad) } target="_blank" rel="noopener" class="event-sakura-btn">
								<i class="bi bi-geo-alt"></i> Lihat Lokasi
							</a>
						}
					</div>

					<!-- Resepsi -->
					<div class="event-sakura-card" data-aos="fade-up" data-aos-delay="200">
						<div class="event-sakura-icon"><i class="bi bi-stars"></i></div>
						<h3 class="event-sakura-title">{ data.ResepsiLabelDisplay() }</h3>
						if data.IsIslamicResepsi() && data.ResepsiArabic() != "" {
							<div class="event-sakura-arabic">{ data.ResepsiArabic() }</div>
						}
						<div class="event-sakura-detail">
							<div>{ data.ResepsiDate }</div>
							<div>Pukul { data.ResepsiTime } WIB</div>
							<div>{ data.ResepsiVenue }</div>
						</div>
						if data.MapsURLResepsi != "" {
							<a href={ templpkg.SafeURL(data.MapsURLResepsi) } target="_blank" rel="noopener" class="event-sakura-btn">
								<i class="bi bi-geo-alt"></i> Lihat Lokasi
							</a>
						}
					</div>
				</div>
			</div>
		</section>

		<!-- GALLERY -->
		if len(data.Gallery) > 0 {
			<section class="section-sakura-alt" id="section-gallery">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Gallery</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Momen<br/><em>yang indah</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Kenangan yang kami abadikan dalam setiap kelopak waktu
					</p>

					<div class="gallery-sakura-grid">
						for index, img := range data.Gallery {
							<div class="gallery-sakura-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(60 * ((index % 6) + 1)) }>
								<img src={ img } alt={ "Foto " + invitation.FormatInt(index+1) } loading="lazy"/>
								<div class="overlay"><i class="bi bi-zoom-in"></i></div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- RSVP -->
		<section class="section-sakura" id="section-rsvp">
			<div class="container">
				<div class="section-label" data-aos="fade-up">RSVP</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Konfirmasi<br/><em>Kehadiran</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Kami sangat berbahagia jika Anda bisa hadir di hari bahagia kami
				</p>

				@shared.RSVPForm(data, shared.RSVPTextIndonesia)

				@shared.RSVPListWrap()
			</div>
		</section>

		<!-- AMPLOP DIGITAL -->
		if data.ShouldShowBankAccounts() && len(data.BankAccounts) > 0 {
			<section class="section-sakura-alt" id="section-bank">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Amplop Digital</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Kirim<br/><em>Hadiah</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Doa restu Anda adalah hadiah terindah. Namun jika ingin memberi, kami sediakan:
					</p>

					<div class="bank-sakura-grid">
						for index, account := range data.BankAccounts {
							<div class="bank-sakura-card" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<span class="bank-type-badge">{ invitation.GetBankTypeBadge(account) }</span>

								<div class="bank-logo">
									if invitation.HasCustomIcon(account) {
										<img src={ invitation.GetAccountIconURL(account) } alt={ invitation.GetAccountBankName(account) }/>
									} else {
										<span class="bank-logo-icon">{ invitation.GetAccountInitial(account) }</span>
									}
								</div>

								<div class="bank-name">{ invitation.GetAccountBankName(account) }</div>

								<div class="bank-number-wrapper" data-number={ invitation.GetAccountNumber(account) } onclick={ templpkg.JSFuncCall("copyBankNumberFromEl", templpkg.JSExpression("this")) }>
									<span class="bank-number">{ invitation.GetAccountNumber(account) }</span>
									<i class="bi bi-clipboard copy-icon"></i>
								</div>

								<div class="bank-holder">
									a.n. <strong>{ invitation.GetAccountName(account) }</strong>
								</div>
							</div>
						}
					</div>

					<p style="text-align:center; margin-top:32px; font-size:0.8rem; color:var(--ink-muted); font-style:italic; opacity:0.8;" data-aos="fade-up">
						<i class="bi bi-info-circle me-1" style="color:var(--sakura-dark);"></i>
						Klik nomor rekening untuk menyalin
					</p>
				</div>
			</section>
		}

		<!-- FOOTER -->
		<footer class="footer-sakura">
			<div class="footer-sakura-inner">
				<span class="footer-sakura-icon">⛩</span>

				<div class="footer-sakura-couple">
					{ data.GroomName }<span class="amp">&amp;</span>{ data.BrideName }
				</div>
				<div class="footer-sakura-date">{ data.AkadDate }</div>

				@shared.SocialLinks(data, shared.SocialLinksTextDefault)

				<p class="footer-sakura-prayer">
					"Seperti sakura yang mekar di musim semi, cinta kami tumbuh indah dalam restu-Nya."
				</p>
			</div>
		</footer>

		<!-- WEB FOOTER -->
		@shared.WebFooter(data, shared.WebFooterTextDefault)

		<!-- SCRIPTS -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<script>
			AOS.init({
				duration: 900,
				easing: 'ease-out',
				once: true,
				offset: 60,
			});

			// LOCK SCROLL SAAT OVERLAY
			document.addEventListener('DOMContentLoaded', function() {
				var overlay = document.getElementById('startOverlay');
				if (overlay && overlay.style.display !== 'none') {
					document.body.classList.add('overlay-active');
				}
			});

			// MUSIC PLAYER
			var musicUrl = document.body.dataset.musicUrl || '';
			var projectID = document.body.dataset.projectId || '';
			var projectSlug = document.body.dataset.projectSlug || '';
			var audio = null;
			var isPlaying = false;
			var hasStarted = false;
			var MUSIC_KEY = 'wedding_music_state_' + projectID;

			function initAudio() {
				if (!musicUrl) return false;
				if (audio) return true;
				audio = new Audio(musicUrl);
				audio.loop = true;
				audio.volume = 0.5;
				return true;
			}

			window.startMusic = function() {
				if (!initAudio()) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					closeOverlay();
					return;
				}
				audio.play().then(function() {
					isPlaying = true;
					hasStarted = true;
					var btn = document.getElementById('musicToggle');
					if (btn) {
						btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
						btn.classList.add('playing');
					}
					localStorage.setItem(MUSIC_KEY, 'playing');
					closeOverlay();
				}).catch(function(e) {
					console.log('Play failed:', e);
					closeOverlay();
					document.addEventListener('click', function retry() {
						audio.play().catch(function(){});
						document.removeEventListener('click', retry);
					}, { once: true });
				});
			};

			function closeOverlay() {
				var overlay = document.getElementById('startOverlay');
				if (overlay) {
					overlay.style.opacity = '0';
					setTimeout(function() {
						overlay.style.display = 'none';
					}, 800);
				}
				document.body.classList.remove('overlay-active');
				window.scrollTo(0, 0);
			}

			window.toggleMusic = function() {
				if (!audio && musicUrl) initAudio();
				if (!audio) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					return;
				}
				var btn = document.getElementById('musicToggle');
				if (isPlaying) {
					audio.pause();
					isPlaying = false;
					btn.innerHTML = '<i class="bi bi-music-note"></i>';
					btn.classList.remove('playing');
					localStorage.setItem(MUSIC_KEY, 'paused');
				} else {
					audio.play().catch(function(e) {});
					isPlaying = true;
					btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
					btn.classList.add('playing');
					localStorage.setItem(MUSIC_KEY, 'playing');
				}
			};

			document.getElementById('startOverlay')?.addEventListener('click', function(e) {
				startMusic();
			});
				document.getElementById('musicToggle')?.addEventListener('click', function(e) {
				if (!hasStarted) startMusic();
			});

			window.scrollToSection = function() {
				var el = document.getElementById('section-couple');
				if (el) el.scrollIntoView({ behavior: 'smooth' });
			};

			function showToast(type, message) {
				var container = document.querySelector('.toast-container');
				if (!container) {
					container = document.createElement('div');
					container.className = 'toast-container';
					document.body.appendChild(container);
				}
				var toast = document.createElement('div');
				toast.className = 'toast';
				var icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
				toast.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
				container.appendChild(toast);
				setTimeout(function() {
					toast.style.opacity = '0';
					toast.style.transform = 'translateX(100px)';
					setTimeout(function() { toast.remove(); }, 400);
				}, 3000);
			}

			function escapeHtml(text) {
				if (!text) return '';
				var div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			window.copyBankNumberFromEl = function(el) {
				var number = el.getAttribute('data-number');
				if (!number) return;
				copyText(number, el);
			};

			function copyText(number, element) {
				var doSuccess = function() {
					showToast('success', 'Nomor rekening dicopy!');
				};
				if (navigator.clipboard) {
					navigator.clipboard.writeText(number).then(doSuccess).catch(function() {
						fallbackCopy(number, element);
					});
				} else {
					fallbackCopy(number, element);
				}
			}

			function fallbackCopy(text, element) {
				var textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				try {
					document.execCommand('copy');
					showToast('success', 'Nomor rekening dicopy!');
				} catch (err) {
					showToast('error', 'Gagal copy nomor');
				}
				document.body.removeChild(textarea);
			}

			// LIGHTBOX
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('.gallery-sakura-item').forEach(function(item) {
					item.addEventListener('click', function() {
						var img = this.querySelector('img');
						if (img) {
							var lb = document.createElement('div');
							lb.style.cssText = 'position:fixed;inset:0;background:rgba(26,26,26,0.94);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:20px;';
							lb.innerHTML = '<span style="position:absolute;top:20px;right:24px;color:#f8b5c4;font-size:2rem;cursor:pointer;">&times;</span><img src="' + img.src + '" style="max-width:92%;max-height:92%;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,0.6);border-radius:4px;"/>';
							document.body.appendChild(lb);
							lb.addEventListener('click', function(e) {
								if (e.target === this || e.target.textContent === '×') {
									this.remove();
								}
							});
						}
					});
				});
			});

			// LOAD RSVP LIST
			function loadRsvpList() {
				var listContainer = document.getElementById('rsvpList');
				var countContainer = document.getElementById('rsvpCount');
				if (!listContainer) return;

				fetch('/invitation/' + projectSlug + '/rsvp-list')
					.then(function(r) { return r.json(); })
					.then(function(data) {
						if (!data || data.length === 0) {
							listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-envelope"></i>Belum ada konfirmasi kehadiran</div>';
							if (countContainer) countContainer.textContent = '0 tamu';
							return;
						}
						var totalGuests = 0;
						var html = '';
						data.forEach(function(item) {
							var statusText = item.attendance === 'hadir' ? 'Hadir' : (item.attendance === 'tidak_hadir' ? 'Tidak Hadir' : 'Ragu');
							totalGuests += parseInt(item.total_guests || 1);
							var time = new Date(item.created_at);
							var timeStr = time.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
							var messageHtml = item.message ? '<div class="message">' + escapeHtml(item.message) + '</div>' : '';
							html += '<div class="rsvp-item"><div class="row-main"><span class="guest-name">' + escapeHtml(item.guest_name) + '</span><span class="status-badge ' + item.attendance + '">' + statusText + '</span></div><div class="row-detail"><div class="meta-left"><span><i class="bi bi-calendar"></i> ' + timeStr + '</span><span><i class="bi bi-people"></i> ' + (item.total_guests || 1) + ' org</span></div></div>' + messageHtml + '</div>';
						});
						listContainer.innerHTML = html;
						if (countContainer) countContainer.textContent = totalGuests + ' tamu';
					})
					.catch(function() {
						listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-exclamation-triangle"></i>Gagal memuat daftar konfirmasi</div>';
					});
			}

			// SUBMIT RSVP
			document.addEventListener('DOMContentLoaded', function() {
				var form = document.getElementById('rsvpForm');
				if (!form) return;
				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var formData = new FormData(form);
					var btn = form.querySelector('button[type="submit"]');
					var originalText = btn.innerHTML;
					btn.disabled = true;
					btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Mengirim...';
					fetch(form.action, { method: 'POST', body: formData })
						.then(function(r) { return r.json(); })
						.then(function(data) {
							if (data.success) {
								var isUpdate = data.updated === true;
								Swal.fire({
									title: isUpdate ? 'Konfirmasi Diperbarui!' : 'Terima Kasih!',
									text: data.message,
									icon: 'success',
									confirmButtonColor: '#f8b5c4',
									background: '#faf7f2',
									color: '#1a1a1a',
									timer: 2200,
									timerProgressBar: true,
									showConfirmButton: false
								});
								if (!isUpdate) form.reset();
								setTimeout(function() { loadRsvpList(); }, 500);
							} else {
								Swal.fire({
									title: 'Gagal!',
									text: data.message || 'Terjadi kesalahan',
									icon: 'error',
									confirmButtonColor: '#f8b5c4',
									background: '#faf7f2',
									color: '#1a1a1a'
								});
							}
						})
						.catch(function() {
							Swal.fire({
								title: 'Error!',
								text: 'Terjadi kesalahan, silakan coba lagi',
								icon: 'error',
								confirmButtonColor: '#f8b5c4',
								background: '#faf7f2',
								color: '#1a1a1a'
							});
						})
						.finally(function() {
							btn.disabled = false;
							btn.innerHTML = originalText;
						});
				});
				loadRsvpList();
			});
		</script>
	</body>
	</html>
}
