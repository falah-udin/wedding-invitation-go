package traditional_java

import (
	"context"
	"io"

	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/invitation"
	"wedding-invitation-go/internal/models"
	"wedding-invitation-go/views/invitations/shared"
)

// TraditionalJava — template undangan Traditional Java (adat Jawa klasik)
func TraditionalJava(ctx context.Context, w io.Writer, project models.Project, data *invitation.TemplateData, guestName string) error {
	component := traditionalJavaPage(data)
	return component.Render(ctx, w)
}

templ traditionalJavaPage(data *invitation.TemplateData) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"/>
		<title>{ data.GroomName } &amp; { data.BrideName } - Traditional Java</title>

		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet"/>

		<style>
			:root {
				--sogan: #6b4423;
				--sogan-dark: #4a2f18;
				--sogan-light: #8b5a2b;
				--gold: #b8860b;
				--gold-light: #d4a017;
				--gold-pale: #e8d5a3;
				--cream: #f5efe0;
				--cream-dark: #ebe2cd;
				--ink: #1a0f08;
				--ink-soft: #2d1f0a;
				--text: #3d2b1f;
				--text-muted: #6b5a45;
				--text-light: #8a7a65;
				--batik-line: rgba(107, 68, 35, 0.12);
				--batik-line-strong: rgba(107, 68, 35, 0.25);
				--white: #ffffff;
				--shadow: 0 4px 30px rgba(26, 15, 8, 0.08);
				--shadow-md: 0 8px 40px rgba(26, 15, 8, 0.12);
				--shadow-lg: 0 20px 60px rgba(26, 15, 8, 0.18);
			}

			* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
			body {
				font-family: 'Inter', sans-serif;
				background: var(--cream);
				color: var(--text);
				line-height: 1.7;
				overflow-x: hidden;
				min-height: 100vh;
				min-height: 100svh;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
			}
			img { max-width: 100%; height: auto; display: block; }

			.container { max-width: 720px; margin: 0 auto; padding: 0 24px; }
			.container-wide { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
			@media (max-width: 600px) {
				.container, .container-wide { padding: 0 20px; }
			}

			.batik-pattern {
				position: absolute;
				inset: 0;
				pointer-events: none;
				z-index: 0;
				background-image:
					radial-gradient(circle at 20px 20px, rgba(107, 68, 35, 0.04) 3px, transparent 4px),
					radial-gradient(circle at 60px 60px, rgba(107, 68, 35, 0.03) 3px, transparent 4px),
					repeating-linear-gradient(45deg, rgba(107, 68, 35, 0.015) 0px, rgba(107, 68, 35, 0.015) 1px, transparent 1px, transparent 12px),
					repeating-linear-gradient(-45deg, rgba(107, 68, 35, 0.015) 0px, rgba(107, 68, 35, 0.015) 1px, transparent 1px, transparent 12px);
				background-size: 80px 80px, 80px 80px, 20px 20px, 20px 20px;
			}

			.section-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 8px;
				color: var(--gold);
				text-align: center;
				margin-bottom: 16px;
				font-weight: 500;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 16px;
			}
			.section-label::before,
			.section-label::after {
				content: '❦';
				font-size: 0.8rem;
				color: var(--gold);
				opacity: 0.5;
			}
			.section-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.8rem;
				font-weight: 600;
				text-align: center;
				margin-bottom: 16px;
				color: var(--sogan);
				line-height: 1.2;
				letter-spacing: -0.01em;
			}
			.section-title em {
				font-style: italic;
				color: var(--gold);
				font-weight: 400;
			}
			.section-subtitle {
				font-family: 'Cormorant Garamond', serif;
				text-align: center;
				color: var(--text-muted);
				font-size: 1rem;
				max-width: 520px;
				margin: 0 auto 60px;
				font-style: italic;
				line-height: 1.8;
				font-weight: 400;
			}
			@media (max-width: 600px) {
				.section-title { font-size: 2rem; }
				.section-subtitle { font-size: 0.9rem; margin-bottom: 40px; }
				.section-label { font-size: 0.65rem; letter-spacing: 5px; }
			}

			.divider-java {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 14px;
				margin: 24px 0;
			}
			.divider-java .line {
				width: 60px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				opacity: 0.5;
			}
			.divider-java .ornament {
				font-family: 'Playfair Display', serif;
				color: var(--gold);
				font-size: 1rem;
				opacity: 0.7;
			}
			.divider-java .diamond {
				width: 6px;
				height: 6px;
				background: var(--gold);
				transform: rotate(45deg);
				opacity: 0.6;
			}

			.toast-container {
				position: fixed; top: 20px; right: 20px; z-index: 9999;
				display: flex; flex-direction: column; gap: 8px;
			}
			.toast {
				background: var(--sogan-dark); color: var(--white);
				padding: 12px 20px; border-radius: 4px;
				box-shadow: var(--shadow-lg);
				animation: slideInToast 0.4s ease;
				min-width: 200px;
				display: flex; align-items: center; gap: 10px;
				font-size: 0.85rem;
				border-left: 3px solid var(--gold);
			}
			.toast i { font-size: 1.1rem; }
			.toast.success i { color: #10b981; }
			.toast.error i { color: #ef4444; }
			.toast.info i { color: var(--gold-light); }
			@keyframes slideInToast {
				from { transform: translateX(100%); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}

			#startOverlay {
				position: fixed; top: 0; left: 0; right: 0; bottom: 0;
				width: 100vw; height: 100vh; height: 100svh;
				background-color: var(--ink);
				z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				transition: opacity 0.8s ease;
				cursor: pointer;
				padding: 24px;
				overflow-y: auto;
			}
			#startOverlay .overlay-bg-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				opacity: 0.2;
				filter: sepia(0.4) blur(1.5px) saturate(0.6);
				z-index: 0;
				pointer-events: none;
			}
			#startOverlay::before {
				content: '';
				position: absolute;
				inset: 0;
				background: 
					radial-gradient(ellipse at 50% 40%, rgba(26, 15, 8, 0.35) 0%, transparent 65%),
					linear-gradient(180deg, 
						rgba(26, 15, 8, 0.88) 0%, 
						rgba(26, 15, 8, 0.82) 40%, 
						rgba(26, 15, 8, 0.92) 75%, 
						rgba(26, 15, 8, 0.98) 100%);
				z-index: 1;
				pointer-events: none;
			}
			#startOverlay .overlay-batik {
				position: absolute;
				inset: 20px;
				border: 1px solid rgba(184, 134, 11, 0.2);
				z-index: 1;
				pointer-events: none;
			}
			#startOverlay .overlay-batik::before,
			#startOverlay .overlay-batik::after {
				content: '❦';
				position: absolute;
				color: var(--gold);
				opacity: 0.4;
				font-size: 1rem;
			}
			#startOverlay .overlay-batik::before { top: -8px; left: -8px; }
			#startOverlay .overlay-batik::after { bottom: -8px; right: -8px; }
			#startOverlay .overlay-inner {
				position: relative;
				z-index: 2;
				text-align: center;
				max-width: 480px;
				width: 100%;
				padding: 20px;
				margin: auto;
				animation: fadeIn 1.2s ease;
			}
			#startOverlay .overlay-gunungan {
				font-family: 'Playfair Display', serif;
				font-size: 3rem;
				color: var(--gold);
				opacity: 0.5;
				margin-bottom: 20px;
				display: block;
				line-height: 1;
			}
			#startOverlay .overlay-eyebrow {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 10px;
				color: var(--gold-light);
				margin-bottom: 32px;
				font-weight: 500;
			}
			#startOverlay .overlay-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.2rem;
				font-weight: 500;
				color: var(--cream);
				margin-bottom: 28px;
				line-height: 1.25;
			}
			#startOverlay .overlay-title span { display: block; }
			#startOverlay .overlay-title .amp {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.4rem;
				color: var(--gold);
				margin: 12px 0;
				font-style: italic;
				font-weight: 400;
			}
			#startOverlay .overlay-divider {
				width: 80px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				margin: 28px auto;
			}
			#startOverlay .overlay-guest-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--gold-pale);
				margin-bottom: 10px;
				font-style: italic;
			}
			#startOverlay .overlay-guest-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.5rem;
				font-weight: 500;
				color: var(--cream);
				margin-bottom: 40px;
				font-style: italic;
			}
			#startOverlay .btn-start {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: linear-gradient(135deg, var(--gold), var(--sogan), var(--gold));
				background-size: 200% auto;
				color: var(--cream);
				padding: 16px 44px;
				border: 1px solid var(--gold-light);
				border-radius: 2px;
				font-family: 'Cormorant Garamond', serif;
				font-weight: 600;
				font-size: 0.85rem;
				cursor: pointer;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
				transition: all 0.4s ease;
				letter-spacing: 4px;
				text-transform: uppercase;
			}
			#startOverlay .btn-start:hover {
				transform: translateY(-2px);
				background-position: right center;
				box-shadow: 0 12px 40px rgba(184, 134, 11, 0.4);
			}
			#startOverlay .hint {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.65rem;
				color: var(--gold-pale);
				margin-top: 28px;
				letter-spacing: 4px;
				text-transform: uppercase;
				opacity: 0.5;
				font-style: italic;
			}
			@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

			@media (max-width: 600px) {
				#startOverlay { padding: 20px; }
				#startOverlay .overlay-batik { inset: 12px; }
				#startOverlay .overlay-gunungan { font-size: 2rem; }
				#startOverlay .overlay-title { font-size: 1.7rem; }
				#startOverlay .overlay-guest-name { font-size: 1.25rem; margin-bottom: 32px; }
				#startOverlay .btn-start { padding: 14px 32px; font-size: 0.75rem; width: 100%; max-width: 260px; justify-content: center; }
			}

			.music-player {
				position: fixed;
				bottom: 24px;
				right: 24px;
				z-index: 1000;
			}
			.music-btn {
				width: 50px;
				height: 50px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--sogan), var(--sogan-dark));
				border: 2px solid var(--gold);
				color: var(--cream);
				font-size: 1.15rem;
				cursor: pointer;
				box-shadow: 0 4px 20px rgba(26, 15, 8, 0.3);
				transition: all 0.3s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.music-btn:hover {
				transform: scale(1.08) rotate(-5deg);
				background: var(--sogan-dark);
				border-color: var(--gold-light);
			}
			.music-btn.playing { animation: pulseJava 2s infinite; }
			@keyframes pulseJava {
				0% { box-shadow: 0 0 0 0 rgba(184, 134, 11, 0.4); }
				70% { box-shadow: 0 0 0 16px rgba(184, 134, 11, 0); }
				100% { box-shadow: 0 0 0 0 rgba(184, 134, 11, 0); }
			}

			.hero-java {
				position: relative;
				min-height: 100vh;
				min-height: 100svh;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 100px 24px;
				background: 
					radial-gradient(ellipse at 50% 30%, var(--sogan) 0%, var(--ink-soft) 60%, var(--ink) 100%);
				color: var(--cream);
				overflow: hidden;
			}
			.hero-java .hero-bg-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				opacity: 0.18;
				filter: sepia(0.5) blur(1px) saturate(0.5);
				z-index: 0;
				pointer-events: none;
			}
			.hero-java::before {
				content: '';
				position: absolute;
				inset: 0;
				background: 
					radial-gradient(ellipse at 50% 30%, rgba(74, 47, 24, 0.5) 0%, transparent 65%),
					linear-gradient(180deg, 
						rgba(26, 15, 8, 0.75) 0%, 
						rgba(26, 15, 8, 0.6) 40%, 
						rgba(26, 15, 8, 0.8) 70%, 
						rgba(26, 15, 8, 0.95) 100%);
				z-index: 1;
				pointer-events: none;
			}
			.hero-java::after {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(circle at 20px 20px, rgba(184, 134, 11, 0.03) 2px, transparent 3px),
					radial-gradient(circle at 60px 60px, rgba(184, 134, 11, 0.02) 2px, transparent 3px);
				background-size: 80px 80px;
				z-index: 1;
				pointer-events: none;
			}
			.hero-java .hero-batik-frame {
				position: absolute;
				inset: 24px;
				border: 1px solid rgba(184, 134, 11, 0.2);
				z-index: 2;
				pointer-events: none;
			}
			.hero-java .hero-batik-frame::before,
			.hero-java .hero-batik-frame::after {
				content: '❦';
				position: absolute;
				color: var(--gold);
				opacity: 0.5;
				font-size: 1.2rem;
			}
			.hero-java .hero-batik-frame::before { top: -10px; left: -10px; }
			.hero-java .hero-batik-frame::after { bottom: -10px; right: -10px; }
			.hero-java .hero-inner {
				position: relative;
				z-index: 3;
				max-width: 720px;
				width: 100%;
			}
			.hero-java .hero-gunungan {
				font-family: 'Playfair Display', serif;
				font-size: 4rem;
				color: var(--gold);
				opacity: 0.6;
				margin-bottom: 20px;
				display: block;
				line-height: 1;
			}
			.hero-java .hero-eyebrow {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 12px;
				color: var(--gold-light);
				margin-bottom: 32px;
				font-weight: 500;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
			}
			.hero-java .hero-names {
				font-family: 'Playfair Display', serif;
				font-size: 4.5rem;
				font-weight: 600;
				line-height: 1.05;
				letter-spacing: -0.02em;
				margin-bottom: 24px;
				display: flex;
				flex-direction: column;
				align-items: center;
				color: var(--cream);
				text-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
			}
			.hero-java .hero-names .amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				font-size: 2.4rem;
				color: var(--gold);
				margin: 12px 0;
				line-height: 1;
				font-weight: 400;
			}
			.hero-java .hero-subtitle {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem;
				font-style: italic;
				letter-spacing: 4px;
				color: var(--gold-pale);
				margin-bottom: 32px;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
			}
			.hero-java .hero-divider {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 14px;
				margin: 24px 0;
			}
			.hero-java .hero-divider .line {
				width: 60px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				opacity: 0.6;
			}
			.hero-java .hero-divider .ornament {
				color: var(--gold);
				font-size: 1rem;
				opacity: 0.8;
				white-space: nowrap;
			}
			.hero-java .hero-dates {
				display: flex;
				justify-content: center;
				gap: 32px;
				margin: 20px 0;
				flex-wrap: wrap;
			}
			.hero-java .hero-dates .date-item {
				display: flex;
				align-items: center;
				gap: 10px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem;
				color: var(--gold-pale);
				font-style: italic;
				text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
			}
			.hero-java .hero-dates .date-item i {
				color: var(--gold);
				font-size: 0.85rem;
			}
			.hero-java .hero-venue {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem;
				color: var(--gold-pale);
				margin-bottom: 40px;
				font-style: italic;
				text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
			}
			.hero-java .btn-rsvp-java {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: linear-gradient(135deg, var(--gold), var(--sogan), var(--gold));
				background-size: 200% auto;
				color: var(--cream);
				padding: 16px 44px;
				border: 1px solid var(--gold-light);
				border-radius: 2px;
				text-decoration: none;
				font-family: 'Cormorant Garamond', serif;
				font-weight: 600;
				font-size: 0.85rem;
				letter-spacing: 4px;
				text-transform: uppercase;
				transition: all 0.4s ease;
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
			}
			.hero-java .btn-rsvp-java:hover {
				transform: translateY(-2px);
				background-position: right center;
				box-shadow: 0 12px 40px rgba(184, 134, 11, 0.4);
			}
			.hero-java .scroll-down {
				position: absolute;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%);
				color: var(--gold);
				font-size: 1.3rem;
				animation: bounceJava 2s infinite;
				cursor: pointer;
				background: none;
				border: none;
				z-index: 3;
				opacity: 0.6;
			}
			@keyframes bounceJava {
				0%, 100% { transform: translateX(-50%) translateY(0); }
				50% { transform: translateX(-50%) translateY(8px); }
			}
			@media (max-width: 700px) {
				.hero-java { padding: 80px 20px; }
				.hero-java .hero-batik-frame { inset: 16px; }
				.hero-java .hero-names { font-size: 2.6rem; }
				.hero-java .hero-names .amp { font-size: 1.6rem; margin: 8px 0; }
				.hero-java .hero-gunungan { font-size: 2.5rem; }
				.hero-java .hero-eyebrow { letter-spacing: 6px; font-size: 0.65rem; }
				.hero-java .hero-dates { gap: 16px; flex-direction: column; align-items: center; }
			}
			@media (max-width: 400px) {
				.hero-java .hero-names { font-size: 2.2rem; }
			}

			.opening-java {
				padding: 120px 24px;
				background: var(--cream);
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.opening-java::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(circle at 30px 30px, rgba(107, 68, 35, 0.03) 2px, transparent 3px),
					radial-gradient(circle at 90px 90px, rgba(107, 68, 35, 0.02) 2px, transparent 3px);
				background-size: 120px 120px;
				pointer-events: none;
			}
			.opening-java-inner {
				position: relative;
				z-index: 2;
				max-width: 640px;
				margin: 0 auto;
			}
			.opening-java-icon {
				font-family: 'Playfair Display', serif;
				font-size: 3rem;
				color: var(--gold);
				opacity: 0.4;
				margin-bottom: 24px;
				display: block;
			}
			.opening-java-quote {
				font-family: 'Playfair Display', serif;
				font-size: 1.5rem;
				font-style: italic;
				font-weight: 400;
				color: var(--sogan);
				line-height: 1.7;
				margin-bottom: 32px;
				letter-spacing: -0.005em;
			}
			.opening-java-source {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--gold);
				font-weight: 500;
			}
			.opening-java-source::before,
			.opening-java-source::after {
				content: '—';
				color: var(--gold);
				opacity: 0.5;
				margin: 0 8px;
			}
			@media (max-width: 600px) {
				.opening-java { padding: 80px 20px; }
				.opening-java-icon { font-size: 2.2rem; margin-bottom: 16px; }
				.opening-java-quote { font-size: 1.15rem; margin-bottom: 24px; }
			}

			.section-java {
				padding: 120px 0;
				background: var(--cream);
				position: relative;
			}
			.section-java-alt {
				padding: 120px 0;
				background: var(--cream-dark);
				position: relative;
			}
			.section-java-alt::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(circle at 20px 20px, rgba(107, 68, 35, 0.025) 2px, transparent 3px),
					radial-gradient(circle at 60px 60px, rgba(107, 68, 35, 0.02) 2px, transparent 3px);
				background-size: 80px 80px;
				pointer-events: none;
			}
			.section-java .container,
			.section-java-alt .container { position: relative; z-index: 1; }
			@media (max-width: 600px) {
				.section-java, .section-java-alt { padding: 80px 0; }
			}

			.couple-java-grid {
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				gap: 40px;
				align-items: start;
				margin-top: 20px;
			}
			@media (max-width: 700px) {
				.couple-java-grid { grid-template-columns: 1fr; gap: 48px; }
				.couple-java-amp { display: none; }
			}
			.couple-java-card {
				text-align: center;
			}
			.couple-java-photo-wrap {
				position: relative;
				width: 220px;
				height: 280px;
				margin: 0 auto 24px;
				overflow: hidden;
			}
			.couple-java-photo-wrap::before {
				content: '';
				position: absolute;
				inset: -8px;
				border: 1px solid var(--gold);
				opacity: 0.4;
				z-index: 2;
				pointer-events: none;
			}
			.couple-java-photo-wrap::after {
				content: '';
				position: absolute;
				inset: -4px;
				border: 1px solid var(--gold);
				opacity: 0.25;
				z-index: 2;
				pointer-events: none;
			}
			.couple-java-photo {
				position: relative;
				width: 100%;
				height: 100%;
				overflow: hidden;
			}
			.couple-java-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.7s ease;
			}
			.couple-java-card:hover .couple-java-photo img { transform: scale(1.04); }
			.couple-java-photo::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 60%, rgba(26, 15, 8, 0.2));
				pointer-events: none;
			}
			.couple-java-info h3 {
				font-family: 'Playfair Display', serif;
				font-size: 1.8rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 8px;
				letter-spacing: -0.01em;
			}
			.couple-java-role {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--gold);
				margin-bottom: 12px;
				font-weight: 500;
			}
			.couple-java-parents-label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.82rem;
				color: var(--text-light);
				font-style: italic;
				margin-bottom: 6px;
			}
			.couple-java-parents {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--text);
				font-style: italic;
				line-height: 1.6;
				margin-bottom: 16px;
			}
			.couple-java-origin {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.8rem;
				color: var(--text-muted);
				font-style: italic;
				padding: 8px 16px;
				display: inline-block;
				border-top: 1px solid var(--batik-line-strong);
				border-bottom: 1px solid var(--batik-line-strong);
				margin-top: 8px;
			}
			.couple-java-origin::before {
				content: '✦ ';
				color: var(--gold);
				margin-right: 4px;
			}
			.couple-java-social {
				margin-top: 16px;
				display: flex;
				justify-content: center;
				gap: 12px;
			}
			.couple-java-social a {
				width: 36px;
				height: 36px;
				border-radius: 50%;
				border: 1px solid var(--gold);
				color: var(--sogan);
				font-size: 0.95rem;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 0.3s;
				text-decoration: none;
				opacity: 0.7;
			}
			.couple-java-social a:hover {
				background: var(--gold);
				color: var(--cream);
				opacity: 1;
				transform: translateY(-2px);
			}
			.couple-java-amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				font-size: 2.5rem;
				color: var(--gold);
				font-weight: 400;
				margin-top: 100px;
				opacity: 0.6;
			}
			@media (max-width: 700px) {
				.couple-java-photo-wrap { width: 180px; height: 230px; }
				.couple-java-info h3 { font-size: 1.5rem; }
			}

			.kembar-mayang-card {
				max-width: 560px;
				margin: 0 auto;
				background: linear-gradient(135deg, var(--cream), #faf3e0);
				border: 1px solid var(--gold);
				padding: 48px 40px;
				text-align: center;
				position: relative;
				box-shadow: var(--shadow-md);
			}
			.kembar-mayang-card::before,
			.kembar-mayang-card::after {
				content: '';
				position: absolute;
				width: 30px;
				height: 30px;
				border: 1px solid var(--gold);
			}
			.kembar-mayang-card::before {
				top: 12px;
				left: 12px;
				border-right: none;
				border-bottom: none;
			}
			.kembar-mayang-card::after {
				bottom: 12px;
				right: 12px;
				border-left: none;
				border-top: none;
			}
			.kembar-mayang-icon {
				font-family: 'Playfair Display', serif;
				font-size: 2.5rem;
				color: var(--gold);
				opacity: 0.6;
				margin-bottom: 20px;
				display: block;
			}
			.kembar-mayang-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.6rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 16px;
			}
			.kembar-mayang-text {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				font-style: italic;
				color: var(--text-muted);
				line-height: 1.8;
			}
			@media (max-width: 600px) {
				.kembar-mayang-card { padding: 36px 24px; }
				.kembar-mayang-title { font-size: 1.3rem; }
				.kembar-mayang-text { font-size: 0.9rem; }
			}

			.prosesi-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 24px;
				margin-top: 20px;
			}
			@media (max-width: 900px) {
				.prosesi-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 500px) {
				.prosesi-grid { grid-template-columns: 1fr; gap: 20px; }
			}
			.prosesi-card {
				text-align: center;
				padding: 32px 20px;
				background: var(--cream);
				border: 1px solid var(--batik-line-strong);
				position: relative;
				transition: all 0.4s ease;
			}
			.prosesi-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 3px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				transform: scaleX(0);
				transition: transform 0.5s ease;
			}
			.prosesi-card:hover::before { transform: scaleX(1); }
			.prosesi-card:hover {
				border-color: var(--gold);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.prosesi-num {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.7rem;
				letter-spacing: 4px;
				color: var(--gold);
				text-transform: uppercase;
				margin-bottom: 12px;
				font-weight: 600;
			}
			.prosesi-icon {
				font-family: 'Playfair Display', serif;
				font-size: 1.8rem;
				color: var(--sogan);
				opacity: 0.7;
				margin-bottom: 16px;
				display: block;
			}
			.prosesi-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 8px;
			}
			.prosesi-desc {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				font-style: italic;
				color: var(--text-muted);
				line-height: 1.6;
			}

			.story-java-timeline {
				position: relative;
				max-width: 640px;
				margin: 0 auto;
				padding-left: 40px;
			}
			.story-java-timeline::before {
				content: '';
				position: absolute;
				left: 15px;
				top: 0;
				bottom: 0;
				width: 1px;
				background: linear-gradient(180deg, transparent, var(--gold), transparent);
				opacity: 0.4;
			}
			.story-java-item {
				position: relative;
				margin-bottom: 40px;
				padding-left: 24px;
			}
			.story-java-item:last-child { margin-bottom: 0; }
			.story-java-dot {
				position: absolute;
				left: -32px;
				top: 6px;
				width: 14px;
				height: 14px;
				background: var(--cream);
				border: 2px solid var(--gold);
				border-radius: 50%;
				transition: all 0.3s;
			}
			.story-java-item:hover .story-java-dot {
				transform: scale(1.3);
				background: var(--gold);
			}
			.story-java-content {
				background: var(--cream);
				border: 1px solid var(--batik-line);
				padding: 24px 28px;
				transition: all 0.3s;
			}
			.story-java-item:hover .story-java-content {
				border-color: var(--gold);
				box-shadow: var(--shadow-md);
				transform: translateX(4px);
			}
			.story-java-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 8px;
			}
			.story-java-desc {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.95rem;
				color: var(--text-muted);
				font-style: italic;
				line-height: 1.7;
			}
			@media (max-width: 600px) {
				.story-java-timeline { padding-left: 24px; }
				.story-java-content { padding: 18px 20px; }
			}

			.event-java-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 32px;
			}
			@media (max-width: 700px) {
				.event-java-grid { grid-template-columns: 1fr; gap: 24px; }
			}
			.event-java-card {
				background: var(--cream);
				border: 1px solid var(--batik-line-strong);
				padding: 48px 32px;
				text-align: center;
				transition: all 0.4s ease;
				position: relative;
				overflow: hidden;
			}
			.event-java-card::before {
				content: '';
				position: absolute;
				inset: 12px;
				border: 1px solid rgba(184, 134, 11, 0.15);
				pointer-events: none;
			}
			.event-java-card:hover {
				border-color: var(--gold);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.event-java-icon {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--gold), var(--sogan));
				color: var(--cream);
				font-size: 1.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 24px;
				box-shadow: 0 4px 20px rgba(107, 68, 35, 0.25);
			}
			.event-java-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.6rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 6px;
			}
			.event-java-arabic {
				font-family: 'Amiri', serif;
				font-size: 0.9rem;
				color: var(--gold);
				margin-bottom: 24px;
				font-style: italic;
			}
			.event-java-detail {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--text-muted);
				line-height: 2;
				margin-bottom: 24px;
			}
			.event-java-detail .row {
				display: flex;
				flex-direction: column;
				margin-bottom: 16px;
			}
			.event-java-detail .row:last-child { margin-bottom: 0; }
			.event-java-detail .label {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--gold);
				margin-bottom: 6px;
				font-weight: 600;
				font-style: normal;
			}
			.event-java-detail .value {
				color: var(--text);
				font-family: 'Playfair Display', serif;
				font-size: 1rem;
			}
			.event-java-btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				color: var(--sogan);
				text-decoration: none;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 4px;
				text-transform: uppercase;
				border-bottom: 1px solid var(--gold);
				padding-bottom: 6px;
				transition: all 0.3s;
				position: relative;
				z-index: 1;
			}
			.event-java-btn:hover {
				color: var(--gold);
				gap: 14px;
			}
			@media (max-width: 600px) {
				.event-java-card { padding: 36px 24px; }
				.event-java-title { font-size: 1.3rem; }
			}

			.gallery-java-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 16px;
			}
			@media (max-width: 600px) {
				.gallery-java-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
			}
			.gallery-java-item {
				position: relative;
				aspect-ratio: 1;
				overflow: hidden;
				cursor: pointer;
				border: 1px solid var(--batik-line-strong);
				transition: all 0.4s ease;
			}
			.gallery-java-item::before {
				content: '';
				position: absolute;
				inset: 6px;
				border: 1px solid rgba(184, 134, 11, 0.3);
				z-index: 2;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.3s;
			}
			.gallery-java-item:hover::before { opacity: 1; }
			.gallery-java-item:hover {
				border-color: var(--gold);
				box-shadow: var(--shadow-md);
			}
			.gallery-java-item img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.6s ease;
			}
			.gallery-java-item:hover img { transform: scale(1.06); }
			.gallery-java-item .overlay {
				position: absolute;
				inset: 0;
				background: rgba(26, 15, 8, 0);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--gold);
				font-size: 1.6rem;
				opacity: 0;
				transition: all 0.3s;
				z-index: 3;
				pointer-events: none;
			}
			.gallery-java-item:hover .overlay {
				background: rgba(26, 15, 8, 0.25);
				opacity: 1;
			}

			.rsvp-form {
				max-width: 520px;
				margin: 0 auto;
			}
			.form-group {
				margin-bottom: 24px;
				text-align: left;
			}
			.form-group label {
				display: block;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--gold);
				margin-bottom: 10px;
			}
			.form-group .required { color: #c0392b; }
			.form-group input,
			.form-group select,
			.form-group textarea {
				width: 100%;
				padding: 16px 0;
				border: none;
				border-bottom: 1px solid var(--batik-line-strong);
				background: transparent;
				font-family: 'Cormorant Garamond', serif;
				font-size: 1rem;
				color: var(--text);
				transition: border-color 0.3s;
				border-radius: 0;
			}
			.form-group input:focus,
			.form-group select:focus,
			.form-group textarea:focus {
				outline: none;
				border-bottom-color: var(--gold);
			}
			.form-group input::placeholder,
			.form-group textarea::placeholder {
				color: var(--text-light);
				font-style: italic;
			}
			.form-group input[readonly] {
				color: var(--text-muted);
				cursor: not-allowed;
				background: transparent;
			}
			.form-group textarea { resize: vertical; min-height: 90px; }
			.btn-submit {
				width: 100%;
				padding: 18px;
				background: linear-gradient(135deg, var(--sogan), var(--sogan-dark));
				color: var(--cream);
				border: 1px solid var(--gold);
				border-radius: 2px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.82rem;
				font-weight: 600;
				cursor: pointer;
				transition: all 0.3s;
				letter-spacing: 5px;
				text-transform: uppercase;
				margin-top: 16px;
			}
			.btn-submit:hover {
				background: linear-gradient(135deg, var(--gold), var(--sogan));
				transform: translateY(-2px);
				box-shadow: 0 8px 30px rgba(107, 68, 35, 0.3);
			}
			.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

			.rsvp-list-wrap {
				max-width: 520px;
				margin: 80px auto 0;
				padding-top: 40px;
				border-top: 1px solid var(--batik-line-strong);
			}
			.rsvp-list-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 28px;
			}
			.rsvp-list-head h4 {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem;
				font-weight: 600;
				color: var(--sogan);
			}
			.rsvp-count {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.75rem;
				color: var(--gold);
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			#rsvpList {
				display: flex;
				flex-direction: column;
				max-height: 440px;
				overflow-y: auto;
			}
			.rsvp-item {
				padding: 20px 0;
				border-bottom: 1px solid var(--batik-line);
			}
			.rsvp-item:last-child { border-bottom: none; }
			.rsvp-item .row-main {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 8px;
			}
			.rsvp-item .guest-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--sogan);
			}
			.rsvp-item .status-badge {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.62rem;
				padding: 3px 12px;
				border-radius: 2px;
				letter-spacing: 2px;
				text-transform: uppercase;
				font-weight: 600;
			}
			.rsvp-item .status-badge.hadir {
				background: rgba(16, 185, 129, 0.1);
				color: #059669;
			}
			.rsvp-item .status-badge.tidak_hadir {
				background: rgba(192, 57, 43, 0.1);
				color: #c0392b;
			}
			.rsvp-item .status-badge.ragu {
				background: rgba(184, 134, 11, 0.12);
				color: var(--gold);
			}
			.rsvp-item .row-detail {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 8px;
			}
			.rsvp-item .meta {
				display: flex;
				align-items: center;
				gap: 16px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.75rem;
				color: var(--text-light);
				font-style: italic;
			}
			.rsvp-item .meta span { display: flex; align-items: center; gap: 5px; }
			.rsvp-item .message {
				margin-top: 12px;
				padding: 14px 18px;
				background: var(--cream-dark);
				border-left: 2px solid var(--gold);
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.92rem;
				color: var(--text-muted);
				font-style: italic;
				line-height: 1.7;
			}
			.rsvp-empty {
				text-align: center;
				color: var(--text-light);
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.9rem;
				font-style: italic;
				padding: 40px 0;
			}
			.rsvp-empty i { display: block; font-size: 1.6rem; margin-bottom: 12px; color: var(--gold); opacity: 0.4; }

			.bank-java-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 24px;
				max-width: 720px;
				margin: 0 auto;
			}
			.bank-java-card {
				background: var(--cream);
				border: 1px solid var(--batik-line-strong);
				padding: 40px 28px;
				text-align: center;
				transition: all 0.4s ease;
				position: relative;
			}
			.bank-java-card::before {
				content: '';
				position: absolute;
				inset: 8px;
				border: 1px solid rgba(184, 134, 11, 0.15);
				pointer-events: none;
			}
			.bank-java-card:hover {
				border-color: var(--gold);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.bank-java-logo {
				width: 64px;
				height: 64px;
				margin: 0 auto 24px;
				border-radius: 50%;
				background: linear-gradient(135deg, var(--sogan), var(--sogan-dark));
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				border: 2px solid var(--gold);
				position: relative;
				z-index: 1;
			}
			.bank-java-logo img {
				width: 60%;
				height: 60%;
				object-fit: contain;
				filter: brightness(0) invert(1);
			}
			.bank-java-logo .initial {
				font-family: 'Playfair Display', serif;
				font-size: 1.4rem;
				color: var(--cream);
				font-weight: 600;
			}
			.bank-java-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--sogan);
				margin-bottom: 20px;
				letter-spacing: 0.5px;
				position: relative;
				z-index: 1;
			}
			.bank-java-number {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: var(--cream-dark);
				padding: 14px 22px;
				border-radius: 2px;
				cursor: pointer;
				transition: all 0.3s;
				margin-bottom: 14px;
				width: 100%;
				justify-content: center;
				border: 1px dashed var(--gold);
				position: relative;
				z-index: 1;
			}
			.bank-java-number:hover {
				background: rgba(184, 134, 11, 0.1);
				transform: translateY(-1px);
			}
			.bank-java-number span {
				font-family: 'Courier New', monospace;
				font-size: 0.95rem;
				font-weight: 700;
				color: var(--sogan);
				letter-spacing: 2px;
			}
			.bank-java-number i {
				font-size: 0.85rem;
				color: var(--gold);
				transition: color 0.3s;
			}
			.bank-java-number:hover i { color: var(--sogan); }
			.bank-java-holder {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				color: var(--text-muted);
				font-style: italic;
				position: relative;
				z-index: 1;
			}
			.bank-java-holder strong {
				color: var(--sogan);
				font-style: normal;
				font-weight: 600;
			}
			.bank-java-note {
				text-align: center;
				margin-top: 40px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				color: var(--text-muted);
				font-style: italic;
			}

			.footer-java {
				padding: 100px 24px 48px;
				background: linear-gradient(180deg, var(--sogan-dark) 0%, var(--ink) 100%);
				color: var(--cream);
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.footer-java::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(circle at 30px 30px, rgba(184, 134, 11, 0.05) 2px, transparent 3px),
					radial-gradient(circle at 90px 90px, rgba(184, 134, 11, 0.03) 2px, transparent 3px);
				background-size: 120px 120px;
				pointer-events: none;
			}
			.footer-java-inner {
				position: relative;
				z-index: 1;
				max-width: 640px;
				margin: 0 auto;
			}
			.footer-java-gunungan {
				font-family: 'Playfair Display', serif;
				font-size: 2.5rem;
				color: var(--gold);
				opacity: 0.5;
				margin-bottom: 24px;
				display: block;
				line-height: 1;
			}
			.footer-java-couple {
				font-family: 'Playfair Display', serif;
				font-size: 2rem;
				font-weight: 500;
				color: var(--cream);
				margin-bottom: 12px;
				letter-spacing: 0.5px;
			}
			.footer-java-couple .amp {
				font-family: 'Cormorant Garamond', serif;
				font-style: italic;
				color: var(--gold);
				margin: 0 14px;
				font-weight: 400;
			}
			.footer-java-divider {
				width: 80px;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--gold), transparent);
				margin: 24px auto;
			}
			.footer-java-date {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				color: var(--gold-pale);
				letter-spacing: 5px;
				text-transform: uppercase;
				margin-bottom: 32px;
				font-style: italic;
			}
			
			.footer-java-pepindhan {
				font-family: 'Playfair Display', serif;
				font-size: 1rem;
				font-style: italic;
				color: var(--gold-pale);
				max-width: 520px;
				margin: 0 auto;
				line-height: 1.9;
				opacity: 0.9;
			}
			.footer-java-pepindhan-translate {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				font-style: italic;
				color: var(--text-light);
				margin-top: 12px;
				opacity: 0.7;
				max-width: 480px;
				margin-left: auto;
				margin-right: auto;
			}
			@media (max-width: 600px) {
				.footer-java { padding: 80px 20px 40px; }
				.footer-java-couple { font-size: 1.5rem; }
				.footer-java-pepindhan { font-size: 0.9rem; }
			}

			.web-footer {
				padding: 56px 0 32px;
				background: var(--ink);
				color: rgba(245, 239, 224, 0.55);
				border-top: 1px solid rgba(184, 134, 11, 0.15);
			}
			.web-footer-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}
			.web-footer-brand {
				font-family: 'Playfair Display', serif;
				font-size: 1.4rem;
				font-weight: 600;
				margin-bottom: 20px;
				text-decoration: none;
				display: inline-block;
			}
			.web-footer-brand .wedding { color: var(--cream); }
			.web-footer-brand .saas {
				color: var(--gold);
				font-style: italic;
			}
			.web-footer-desc {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.9rem;
				line-height: 1.8;
				margin-bottom: 20px;
				color: rgba(245, 239, 224, 0.55);
				font-style: italic;
			}
			.web-footer-heading {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.7rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--gold);
				margin-bottom: 24px;
			}
			.web-footer-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.web-footer-list li {
				display: flex;
				align-items: flex-start;
				gap: 10px;
				margin-bottom: 14px;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.9rem;
				line-height: 1.6;
				color: rgba(245, 239, 224, 0.55);
			}
			.web-footer-list li i {
				color: var(--gold);
				margin-top: 3px;
				flex-shrink: 0;
				opacity: 0.8;
			}
			.web-footer-list a,
			.web-footer-link {
				color: rgba(245, 239, 224, 0.55);
				text-decoration: none;
				transition: color 0.2s;
			}
			.web-footer-list a:hover,
			.web-footer-link:hover { color: var(--gold-pale); }
			.web-footer-socials {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
				margin-top: 20px;
			}
			.web-footer-socials a {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				background: rgba(184, 134, 11, 0.08);
				border: 1px solid rgba(184, 134, 11, 0.25);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--gold);
				font-size: 0.95rem;
				transition: all 0.3s;
				text-decoration: none;
			}
			.web-footer-socials a:hover {
				background: var(--gold);
				color: var(--ink);
				transform: translateY(-2px);
			}
			.web-footer-version {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.72rem;
				padding: 5px 12px;
				background: rgba(184, 134, 11, 0.08);
				border: 1px solid rgba(184, 134, 11, 0.2);
				border-radius: 2px;
				display: inline-block;
				color: rgba(245, 239, 224, 0.45);
				letter-spacing: 1px;
			}
			.web-footer-divider {
				border: 0;
				border-top: 1px solid rgba(184, 134, 11, 0.12);
				margin: 2rem 0 1.25rem;
				opacity: 1;
			}
			@media (max-width: 768px) {
				.web-footer { padding: 48px 0 28px; text-align: center; }
				.web-footer-list li { justify-content: center; }
				.web-footer-socials { justify-content: center; }
			}
		
			/* RSVP WARNING & LIST (shared) */
			.rsvp-warning {
				background: rgba(184, 134, 11, 0.08);
				border-left: 2px solid var(--gold);
				padding: 16px 20px;
				margin-bottom: 28px;
			}
			.rsvp-warning-title {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 4px;
			}
			.rsvp-warning-title i {
				color: var(--gold);
				font-size: 1.1rem;
			}
			.rsvp-warning-title strong {
				font-family: 'Playfair Display', serif;
				font-size: 0.9rem;
				color: var(--sogan);
				font-weight: 600;
			}
			.rsvp-warning p {
				margin: 0;
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.85rem;
				color: var(--text-muted);
				font-style: italic;
				line-height: 1.6;
			}
			.rsvp-list-wrap {
				max-width: 520px;
				margin: 80px auto 0;
				padding-top: 40px;
				border-top: 1px solid var(--batik-line-strong);
			}
			.rsvp-list-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 28px;
			}
			.rsvp-list-head h4 {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem;
				font-weight: 600;
				color: var(--sogan);
				margin: 0;
			}
			.rsvp-count {
				font-family: 'Cormorant Garamond', serif;
				font-size: 0.75rem;
				color: var(--gold);
				letter-spacing: 3px;
				text-transform: uppercase;
			}

		
			/* Web Footer Icon (shared) */
			.web-footer-icon { color: var(--gold); }

		
			/* Web Footer container — override lebar */
			.web-footer .container {
				max-width: 1280px !important;
			}

		
			/* Web Footer brand logo — inline dengan teks */
			.web-footer-brand img {
				display: inline-block !important;
				vertical-align: middle;
				margin-right: 8px;
			}

		
			/* Footer Social — icon + teks (shared) */
			.footer-social {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 24px;
			}
			.footer-social a {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 10px 18px;
				border: 1px solid rgba(184, 134, 11, 0.25);
				border-radius: 50px;
				color: rgb(184, 134, 11);
				text-decoration: none;
				font-size: 0.8rem;
				font-weight: 500;
				transition: all 0.3s;
				opacity: 0.8;
			}
			.footer-social a:hover {
				background: rgba(184, 134, 11, 0.1);
				border-color: rgb(184, 134, 11);
				transform: translateY(-2px);
				opacity: 1;
			}
			.footer-social a i {
				font-size: 1rem;
			}
			.footer-social a span {
				font-size: 0.8rem;
				font-weight: 500;
			}

		</style>
	</head>
	<body data-music-url={ data.MusicURL } data-project-id={ invitation.FormatUint(data.Project.ID) } data-project-slug={ data.Project.Slug }>

		<!-- OVERLAY START -->
		<div id="startOverlay">
			if data.HeroImage != "" {
				<img src={ data.HeroImage } alt="" class="overlay-bg-img" loading="eager"/>
			}
			<div class="overlay-batik"></div>
			<div class="overlay-inner">
				<span class="overlay-gunungan">⚜</span>

				<div class="overlay-eyebrow">The Wedding Of</div>

				<div class="overlay-title">
					<span>{ data.GroomName }</span>
					<span class="amp">&amp;</span>
					<span>{ data.BrideName }</span>
				</div>

				<div class="overlay-divider"></div>

				<div class="overlay-guest-label">
					{ invitation.GuestGreeting(data.IsNamedGuest) }
				</div>
				<div class="overlay-guest-name">{ data.GuestName }</div>

				<button class="btn-start" onclick={ templpkg.JSFuncCall("startMusic") }>
					<i class="bi bi-envelope-paper"></i>
					Buka Undangan
				</button>

				<p class="hint">Tap untuk membuka undangan</p>
			</div>
		</div>

		<!-- MUSIC PLAYER -->
		@shared.MusicPlayer()

		<!-- HERO — GUNUNGAN -->
		<section class="hero-java" id="section-hero">
			if data.HeroImage != "" {
				<img src={ data.HeroImage } alt="" class="hero-bg-img" loading="eager"/>
			}
			<div class="hero-batik-frame"></div>

			<div class="hero-inner" data-aos="fade-up" data-aos-duration="1200">
				<span class="hero-gunungan">⚜</span>

				<div class="hero-eyebrow">The Wedding Of</div>

				<h1 class="hero-names">
					<span>{ data.GroomName }</span>
					<span class="amp">&amp;</span>
					<span>{ data.BrideName }</span>
				</h1>

				<div class="hero-subtitle">Ngundhuh Wohing Panggaotan</div>

				<div class="hero-divider">
					<span class="line"></span>
					<span class="ornament">❦</span>
					<span class="line"></span>
				</div>

				<div class="hero-dates">
					if data.ShouldShowAkadDate() {
						<div class="date-item">
							<i class="bi bi-flower1"></i>
							<span>Akad: { data.AkadDate }</span>
						</div>
					}
					if data.ShouldShowResepsiDate() {
						<div class="date-item">
							<i class="bi bi-brightness-high"></i>
							<span>{ data.ResepsiLabelDisplay() }: { data.ResepsiDate }</span>
						</div>
					}
				</div>

				<div class="hero-venue">
					if data.ShouldShowAkadVenue() {
						<span>{ data.AkadVenue }</span>
					}
					if data.ShouldShowBothVenues() {
						<span> · </span>
					}
					if data.ShouldShowResepsiVenue() {
						<span>{ data.ResepsiVenue }</span>
					}
				</div>

				<button class="btn-rsvp-java" onclick={ templpkg.JSFuncCall("scrollToOpening") }>
					<i class="bi bi-chevron-double-down"></i>
					Buka Undangan
				</button>
			</div>

			<button class="scroll-down" onclick={ templpkg.JSFuncCall("scrollToOpening") }>
				<i class="bi bi-chevron-double-down"></i>
			</button>
		</section>

		<!-- OPENING — PEPINDHAN -->
		<section class="opening-java" id="section-opening">
			<div class="opening-java-inner" data-aos="fade-up">
				<span class="opening-java-icon">⚜</span>
				<div class="opening-java-quote">
					"Kanthi lumunturing sih nugrahaning Gusti, mugi tansah pinaringan wilujeng lan bagas waras dhumateng panjenengan sedaya."
				</div>
				<div class="opening-java-source">Bismillahirrahmanirrahim</div>
			</div>
		</section>

		<!-- COUPLE -->
		<section class="section-java" id="section-couple">
			<div class="batik-pattern"></div>
			<div class="container">
				<div class="section-label" data-aos="fade-up">Temanten Kekalih</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Mempelai<br/><em>yang berbahagia</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Kanthi lumunturing sih nugrahaning Gusti, kami badhe ngleresaken putra-putri kami
				</p>

				<div class="couple-java-grid">
					<!-- GROOM -->
					<div class="couple-java-card" data-aos="fade-up" data-aos-delay="150">
						<div class="couple-java-photo-wrap">
							<div class="couple-java-photo">
								<img src={ data.GroomPhotoOrDefault() } alt={ data.GroomName } loading="lazy"/>
							</div>
						</div>
						<div class="couple-java-info">
							<h3>{ data.GroomName }</h3>
							<div class="couple-java-role">Temanten Kakung</div>
							<div class="couple-java-parents-label">Putra saking</div>
							<div class="couple-java-parents">
								{ data.ParentsGroom() }
							</div>
							if data.GroomFamilyOrigin != "" {
								<div class="couple-java-origin">{ data.GroomFamilyOrigin }</div>
							}
							if data.GroomInstagram != "" {
								<div class="couple-java-social">
									<a href={ templpkg.SafeURL(data.GroomInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>

					<div class="couple-java-amp" data-aos="zoom-in" data-aos-delay="200">⚭</div>

					<!-- BRIDE -->
					<div class="couple-java-card" data-aos="fade-up" data-aos-delay="250">
						<div class="couple-java-photo-wrap">
							<div class="couple-java-photo">
								<img src={ data.BridePhotoOrDefault() } alt={ data.BrideName } loading="lazy"/>
							</div>
						</div>
						<div class="couple-java-info">
							<h3>{ data.BrideName }</h3>
							<div class="couple-java-role">Temanten Putri</div>
							<div class="couple-java-parents-label">Putri saking</div>
							<div class="couple-java-parents">
								{ data.ParentsBride() }
							</div>
							if data.BrideFamilyOrigin != "" {
								<div class="couple-java-origin">{ data.BrideFamilyOrigin }</div>
							}
							if data.BrideInstagram != "" {
								<div class="couple-java-social">
									<a href={ templpkg.SafeURL(data.BrideInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- KEMBAR MAYANG -->
		if data.KembarMayang == "yes" {
			<section class="section-java-alt" id="section-kembar-mayang">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Adat Jawa</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Kembar<br/><em>Mayang</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Salah satunggaling tata cara pengantin Jawa ingkang sarat makna
					</p>

					<div class="kembar-mayang-card" data-aos="zoom-in">
						<span class="kembar-mayang-icon">⚜</span>
						<h3 class="kembar-mayang-title">Kembar Mayang</h3>
						<p class="kembar-mayang-text">
							Kembar Mayang inggih menika simbol pangarep-arep lan donga, minangka pralambang bilih pengantin badhe manggih katentreman lan kebagusan wonten ing gesang bebrayan.
						</p>
					</div>
				</div>
			</section>
		}

		<!-- PROSESI ADAT JAWA -->
		<section class="section-java" id="section-prosesi">
			<div class="batik-pattern"></div>
			<div class="container">
				<div class="section-label" data-aos="fade-up">Tata Cara</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Prosesi<br/><em>Adat Jawa</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Rangkaian tata cara pengantin Jawa ingkang sarat makna lan filosofi
				</p>

				<div class="prosesi-grid">
					<div class="prosesi-card" data-aos="fade-up" data-aos-delay="150">
						<div class="prosesi-num">01</div>
						<span class="prosesi-icon">❦</span>
						<h4 class="prosesi-title">Siraman</h4>
						<p class="prosesi-desc">
							Upacara siraman minangka simbol resiking raga lan ati saderengipun tumuju dhumateng griya palakrama.
						</p>
					</div>
					<div class="prosesi-card" data-aos="fade-up" data-aos-delay="200">
						<div class="prosesi-num">02</div>
						<span class="prosesi-icon">✦</span>
						<h4 class="prosesi-title">Midodareni</h4>
						<p class="prosesi-desc">
							Dalu midodareni inggih menika dalu ingkang sakral, wayahipun para temanten nyenyuwun dhateng Gusti.
						</p>
					</div>
					<div class="prosesi-card" data-aos="fade-up" data-aos-delay="250">
						<div class="prosesi-num">03</div>
						<span class="prosesi-icon">❈</span>
						<h4 class="prosesi-title">Panggih</h4>
						<p class="prosesi-desc">
							Upacara panggih minangka patemoning pengantin kakung lan putri wonten ing dinten palakrama.
						</p>
					</div>
					<div class="prosesi-card" data-aos="fade-up" data-aos-delay="300">
						<div class="prosesi-num">04</div>
						<span class="prosesi-icon">✿</span>
						<h4 class="prosesi-title">Sungkeman</h4>
						<p class="prosesi-desc">
							Sungkeman minangka wujud bekti dhumateng tiyang sepuh ingkang sampun ngukir gesangipun.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- LOVE STORY -->
		if len(data.LoveStories) > 0 {
			<section class="section-java-alt" id="section-love">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Lelakon Katresnan</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Perjalanan<br/><em>Katresnan</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Saben lakon inggih menika lelaku ingkang nggawa kita tumuju dinten punika
					</p>

					<div class="story-java-timeline">
						for index, story := range data.LoveStories {
							<div class="story-java-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<div class="story-java-dot"></div>
								<div class="story-java-content">
									<h4 class="story-java-title">{ story.Title }</h4>
									<p class="story-java-desc">{ story.Desc }</p>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- EVENT -->
		<section class="section-java" id="section-event">
			<div class="batik-pattern"></div>
			<div class="container">
				<div class="section-label" data-aos="fade-up">Adicara</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Rantaman<br/><em>Adicara</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Kanthi pakurmatan, kula ngundang Bapak/Ibu/Sedherek sedaya supados rawuh wonten ing adicara
				</p>

				<div class="event-java-grid">
					<!-- Akad -->
					<div class="event-java-card" data-aos="fade-up" data-aos-delay="150">
						<div class="event-java-icon">
							<i class="bi bi-flower1"></i>
						</div>
						<h3 class="event-java-title">Akad Nikah</h3>
						<div class="event-java-detail">
							<div class="row">
								<span class="label">Dinten</span>
								<span class="value">{ data.AkadDate }</span>
							</div>
							<div class="row">
								<span class="label">Wanci</span>
								<span class="value">{ data.AkadTime } WIB</span>
							</div>
							<div class="row">
								<span class="label">Papan</span>
								<span class="value">{ data.AkadVenue }</span>
							</div>
						</div>
						if data.MapsURLAkad != "" {
							<a href={ templpkg.SafeURL(data.MapsURLAkad) } target="_blank" rel="noopener" class="event-java-btn">
								<i class="bi bi-geo-alt"></i> Mriki Papanipun
							</a>
						}
					</div>

					<!-- Resepsi -->
					<div class="event-java-card" data-aos="fade-up" data-aos-delay="200">
						<div class="event-java-icon">
							<i class="bi bi-brightness-high"></i>
						</div>
						<h3 class="event-java-title">{ data.ResepsiLabelDisplay() }</h3>
						if data.IsIslamicResepsi() && data.ResepsiArabic() != "" {
							<div class="event-java-arabic">{ data.ResepsiArabic() }</div>
						}
						<div class="event-java-detail">
							<div class="row">
								<span class="label">Dinten</span>
								<span class="value">{ data.ResepsiDate }</span>
							</div>
							<div class="row">
								<span class="label">Wanci</span>
								<span class="value">{ data.ResepsiTime } WIB</span>
							</div>
							<div class="row">
								<span class="label">Papan</span>
								<span class="value">{ data.ResepsiVenue }</span>
							</div>
						</div>
						if data.MapsURLResepsi != "" {
							<a href={ templpkg.SafeURL(data.MapsURLResepsi) } target="_blank" rel="noopener" class="event-java-btn">
								<i class="bi bi-geo-alt"></i> Mriki Papanipun
							</a>
						}
					</div>
				</div>
			</div>
		</section>

		<!-- GALLERY -->
		if len(data.Gallery) > 0 {
			<section class="section-java-alt" id="section-gallery">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Pepethikan</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Momen<br/><em>ingkang endah</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Pepethikaning lelagoning katresnan ingkang kacathet wonten ing saben momen
					</p>

					<div class="gallery-java-grid">
						for index, img := range data.Gallery {
							<div class="gallery-java-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(60 * ((index % 6) + 1)) }>
								<img src={ img } alt={ "Foto " + invitation.FormatInt(index+1) } loading="lazy"/>
								<div class="overlay"><i class="bi bi-zoom-in"></i></div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- RSVP -->
		<section class="section-java" id="section-rsvp">
			<div class="batik-pattern"></div>
			<div class="container">
				<div class="section-label" data-aos="fade-up">RSVP</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Konfirmasi<br/><em>Rawuh</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Nyuwun pangestu lan konfirmasi rawuh panjenengan supados adicara saged lumampah kanthi sae
				</p>

				@shared.RSVPForm(data, shared.RSVPTextJawa)

				@shared.RSVPListWrap()
			</div>
		</section>

		<!-- BANK / AMPLOP DIGITAL -->
		if data.ShouldShowBankAccounts() && len(data.BankAccounts) > 0 {
			<section class="section-java-alt" id="section-bank">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Pisungsung</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Amplop<br/><em>digital</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Donga pangestu panjenengan inggih menika hadiah ingkang paling endah
					</p>

					<div class="bank-java-grid">
						for index, account := range data.BankAccounts {
							<div class="bank-java-card" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<div class="bank-java-logo">
									if invitation.HasCustomIcon(account) {
										<img src={ invitation.GetAccountIconURL(account) } alt={ invitation.GetAccountBankName(account) } loading="lazy"/>
									} else {
										<span class="initial">{ invitation.GetAccountInitial(account) }</span>
									}
								</div>
								<div class="bank-java-name">{ invitation.GetAccountBankName(account) }</div>

								<div class="bank-java-number" data-number={ invitation.GetAccountNumber(account) } onclick={ templpkg.JSFuncCall("copyBankNumberFromEl", templpkg.JSExpression("this")) }>
									<span>{ invitation.GetAccountNumber(account) }</span>
									<i class="bi bi-clipboard"></i>
								</div>

								<div class="bank-java-holder">
									a.n. <strong>{ invitation.GetAccountName(account) }</strong>
								</div>
							</div>
						}
					</div>

					<p class="bank-java-note" data-aos="fade-up">
						<i class="bi bi-info-circle me-1"></i>
						Klik nomor kangge nyalin
					</p>
				</div>
			</section>
		}

		<!-- FOOTER — PEPINDHAN JAWA -->
		<footer class="footer-java">
			<div class="footer-java-inner">
				<span class="footer-java-gunungan">⚜</span>

				<div class="footer-java-couple">
					{ data.GroomName }<span class="amp">&amp;</span>{ data.BrideName }
				</div>
				<div class="footer-java-divider"></div>
				<div class="footer-java-date">{ data.AkadDate }</div>

				@shared.SocialLinks(data, shared.SocialLinksTextDefault)

				<p class="footer-java-pepindhan">
					"Kaya dene surya lan candra, tansah madhangi jagad kanthi katresnan lan kabagyan."
				</p>
				<p class="footer-java-pepindhan-translate">
					"Kados srengéngé lan mbulan, tansah madhangi jagad kanthi katresnan lan kabagyan."
				</p>
			</div>
		</footer>

		<!-- WEB FOOTER -->
		@shared.WebFooter(data, shared.WebFooterTextShort)

		<!-- SCRIPTS -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<script>
			AOS.init({
				duration: 900,
				easing: 'ease-out',
				once: true,
				mirror: false,
				offset: 60,
				disable: function() { return window.innerWidth < 480; }
			});
			window.addEventListener('resize', function() { AOS.refresh(); });

			// MUSIC PLAYER
			var musicUrl = document.body.dataset.musicUrl || '';
			var projectID = document.body.dataset.projectId || '';
			var projectSlug = document.body.dataset.projectSlug || '';
			var audio = null;
			var isPlaying = false;
			var hasStarted = false;
			var MUSIC_KEY = 'wedding_music_state_' + projectID;

			function initAudio() {
				if (!musicUrl) return false;
				if (audio) return true;
				audio = new Audio(musicUrl);
				audio.loop = true;
				audio.volume = 0.5;
				return true;
			}

			window.startMusic = function() {
				if (!initAudio()) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					closeOverlay();
					return;
				}
				audio.play().then(function() {
					isPlaying = true;
					hasStarted = true;
					var btn = document.getElementById('musicToggle');
					if (btn) {
						btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
						btn.classList.add('playing');
					}
					localStorage.setItem(MUSIC_KEY, 'playing');
					closeOverlay();
				}).catch(function(e) {
					console.log('Play failed:', e);
					closeOverlay();
					document.addEventListener('click', function retry() {
						audio.play().catch(function(){});
						document.removeEventListener('click', retry);
					}, { once: true });
				});
			};

			function closeOverlay() {
				var overlay = document.getElementById('startOverlay');
				if (overlay) {
					overlay.style.opacity = '0';
					setTimeout(function() {
						overlay.style.display = 'none';
						document.body.style.overflow = '';
					}, 800);
				}
			}

			window.toggleMusic = function() {
				if (!audio && musicUrl) initAudio();
				if (!audio) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					return;
				}
				var btn = document.getElementById('musicToggle');
				if (isPlaying) {
					audio.pause();
					isPlaying = false;
					btn.innerHTML = '<i class="bi bi-music-note"></i>';
					btn.classList.remove('playing');
					localStorage.setItem(MUSIC_KEY, 'paused');
				} else {
					audio.play().catch(function(e) { console.log('Play blocked'); });
					isPlaying = true;
					btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
					btn.classList.add('playing');
					localStorage.setItem(MUSIC_KEY, 'playing');
				}
			};

			document.getElementById('startOverlay')?.addEventListener('click', function(e) {
				startMusic();
			});
			document.getElementById('musicToggle')?.addEventListener('click', function(e) {
				if (!hasStarted) startMusic();
			});
			document.addEventListener('keydown', function(e) {
				if (e.key === ' ' && !hasStarted) { e.preventDefault(); startMusic(); }
			});

			window.scrollToOpening = function() {
				var el = document.getElementById('section-opening');
				if (el) el.scrollIntoView({ behavior: 'smooth' });
			};

			function showToast(type, message) {
				var container = document.querySelector('.toast-container');
				if (!container) {
					container = document.createElement('div');
					container.className = 'toast-container';
					document.body.appendChild(container);
				}
				var toast = document.createElement('div');
				toast.className = 'toast';
				var icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
				toast.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
				container.appendChild(toast);
				setTimeout(function() {
					toast.style.opacity = '0';
					toast.style.transform = 'translateX(100px)';
					setTimeout(function() { toast.remove(); }, 400);
				}, 3000);
			}

			function escapeHtml(text) {
				if (!text) return '';
				var div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			window.copyBankNumberFromEl = function(el) {
				var number = el.getAttribute('data-number');
				if (!number) return;
				copyText(number, el);
			};

			function copyText(number, element) {
				var doSuccess = function() {
					showToast('success', 'Nomor rekening dicopy!');
					if (element) {
						var icon = element.querySelector('i');
						if (icon) {
							var original = icon.className;
							icon.className = 'bi bi-check-lg';
							icon.style.color = '#10b981';
							setTimeout(function() {
								icon.className = original;
								icon.style.color = '';
							}, 1500);
						}
						}
				};
				if (navigator.clipboard) {
					navigator.clipboard.writeText(number).then(doSuccess).catch(function() {
						fallbackCopy(number, element);
					});
				} else {
					fallbackCopy(number, element);
				}
			}

			function fallbackCopy(text, element) {
				var textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				try {
					document.execCommand('copy');
					showToast('success', 'Nomor rekening dicopy!');
				} catch (err) {
					showToast('error', 'Gagal copy nomor');
				}
				document.body.removeChild(textarea);
			}

			// GALLERY LIGHTBOX
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('.gallery-java-item').forEach(function(item) {
					item.addEventListener('click', function() {
						var img = this.querySelector('img');
						if (img) {
							var lb = document.createElement('div');
							lb.style.cssText = 'position:fixed;inset:0;background:rgba(26,15,8,0.94);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:20px;';
							lb.innerHTML = '<span style="position:absolute;top:20px;right:24px;color:#d4a017;font-size:2rem;cursor:pointer;opacity:0.7;">&times;</span><img src="' + img.src + '" style="max-width:92%;max-height:92%;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,0.6);border:1px solid rgba(184,134,11,0.3);"/>';
							document.body.appendChild(lb);
							lb.addEventListener('click', function(e) {
								if (e.target === this || e.target.textContent === '×') {
									this.remove();
								}
							});
						}
					});
				});
			});

			// LOAD RSVP LIST
			function loadRsvpList() {
				var listContainer = document.getElementById('rsvpList');
				var countContainer = document.getElementById('rsvpCount');
				if (!listContainer) return;

				fetch('/invitation/' + projectSlug + '/rsvp-list')
					.then(function(r) { return r.json(); })
					.then(function(data) {
						if (!data || data.length === 0) {
							listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-envelope"></i>Dereng wonten konfirmasi rawuh</div>';
							if (countContainer) countContainer.textContent = '0 tamu';
							return;
						}
						var totalGuests = 0;
						var html = '';
						data.forEach(function(item) {
							var statusText = item.attendance === 'hadir' ? 'Rawuh' : (item.attendance === 'tidak_hadir' ? 'Mboten Rawuh' : 'Dereng Pasti');
							totalGuests += parseInt(item.total_guests || 1);
							var time = new Date(item.created_at);
							var timeStr = time.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
							var messageHtml = item.message ? '<div class="message">' + escapeHtml(item.message) + '</div>' : '';
							html += '<div class="rsvp-item"><div class="row-main"><span class="guest-name">' + escapeHtml(item.guest_name) + '</span><span class="status-badge ' + item.attendance + '">' + statusText + '</span></div><div class="row-detail"><div class="meta"><span><i class="bi bi-calendar"></i> ' + timeStr + '</span><span><i class="bi bi-people"></i> ' + (item.total_guests || 1) + ' tamu</span></div></div>' + messageHtml + '</div>';
						});
						listContainer.innerHTML = html;
						if (countContainer) countContainer.textContent = totalGuests + ' tamu';
					})
					.catch(function() {
						listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-exclamation-triangle"></i>Gagal ngangsal daftar konfirmasi<br><button onclick="loadRsvpList()" style="margin-top:12px; padding:8px 20px; background:var(--sogan); color:var(--cream); border:1px solid var(--gold); border-radius:2px; cursor:pointer; font-family:\'Cormorant Garamond\',serif; font-size:0.8rem; letter-spacing:2px; text-transform:uppercase;"><i class="bi bi-arrow-clockwise me-1"></i> Cobi Malih</button></div>';
					});
			}

			// SUBMIT RSVP
			document.addEventListener('DOMContentLoaded', function() {
				var form = document.getElementById('rsvpForm');
				if (!form) return;
				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var formData = new FormData(form);
					var btn = form.querySelector('button[type="submit"]');
					var originalText = btn.innerHTML;
					btn.disabled = true;
					btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Ngirim...';
					fetch(form.action, { method: 'POST', body: formData })
						.then(function(r) { return r.json(); })
						.then(function(data) {
							if (data.success) {
								var isUpdate = data.updated === true;
								Swal.fire({
									title: isUpdate ? 'Konfirmasi Dipun-enggal!' : 'Matur Nuwun!',
									text: data.message,
									icon: 'success',
									confirmButtonColor: '#b8860b',
									background: '#f5efe0',
									color: '#3d2b1f',
									timer: 2200,
									timerProgressBar: true,
									showConfirmButton: false
								});
								if (!isUpdate) form.reset();
								setTimeout(function() { loadRsvpList(); }, 500);
							} else {
								Swal.fire({
									title: 'Gagal!',
									text: data.message || 'Wonten kalepatan',
									icon: 'error',
									confirmButtonColor: '#b8860b',
									background: '#f5efe0',
									color: '#3d2b1f'
								});
							}
						})
						.catch(function() {
							Swal.fire({
								title: 'Error!',
								text: 'Wonten kalepatan, cobi malih',
								icon: 'error',
								confirmButtonColor: '#b8860b',
								background: '#f5efe0',
								color: '#3d2b1f'
							});
						})
						.finally(function() {
							btn.disabled = false;
							btn.innerHTML = originalText;
						});
				});
				loadRsvpList();
			});
		</script>
	</body>
	</html>
}
