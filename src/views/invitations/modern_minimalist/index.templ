package modern_minimalist

import (
	"context"
	"io"

	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/invitation"
	"wedding-invitation-go/internal/models"
	"wedding-invitation-go/views/invitations/shared"
)

// ModernMinimalist — template undangan Modern Minimalist
func ModernMinimalist(ctx context.Context, w io.Writer, project models.Project, data *invitation.TemplateData, guestName string) error {
	component := modernMinimalistPage(data)
	return component.Render(ctx, w)
}

templ modernMinimalistPage(data *invitation.TemplateData) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"/>
		<title>{ data.GroomName } &amp; { data.BrideName } - Modern Minimalist</title>

		if data.SiteConfig.SiteFavicon != "" {
			<link rel="icon" href={ "/storage/" + data.SiteConfig.SiteFavicon }/>
			<link rel="apple-touch-icon" href={ "/storage/" + data.SiteConfig.SiteFavicon }/>
		} else {
			<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
		}

		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet"/>

		<style>
			:root {
				--bg: #fafaf9;
				--bg-alt: #f5f5f4;
				--bg-dark: #1c1917;
				--card: #ffffff;
				--text: #1c1917;
				--text-muted: #78716c;
				--text-light: #a8a29e;
				--accent: #4a5d4a;
				--accent-light: #7d8c7d;
				--accent-soft: rgba(74, 93, 74, 0.08);
				--line: #e7e5e4;
				--line-strong: #d6d3d1;
				--white: #ffffff;
				--shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
				--shadow-md: 0 8px 32px rgba(0, 0, 0, 0.08);
				--shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.12);
			}

			* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
			html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
			body {
				font-family: 'Inter', sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.7;
				overflow-x: hidden;
				min-height: 100vh;
				min-height: 100svh;
				font-weight: 400;
				-webkit-font-smoothing: antialiased;
			}
			img { max-width: 100%; height: auto; display: block; }

			body.overlay-active {
				overflow: hidden;
				position: fixed;
				width: 100%;
				height: 100%;
			}

			.container { max-width: 720px; margin: 0 auto; padding: 0 24px; }
			.container-wide { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

			@media (max-width: 600px) {
				.container, .container-wide { padding: 0 20px; }
			}

			.section-label {
				font-size: 0.68rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--text-muted);
				text-align: center;
				margin-bottom: 16px;
				font-weight: 500;
			}
			.section-label::before {
				content: '';
				display: inline-block;
				width: 20px;
				height: 1px;
				background: var(--text-light);
				vertical-align: middle;
				margin-right: 12px;
				opacity: 0.5;
			}
			.section-label::after {
				content: '';
				display: inline-block;
				width: 20px;
				height: 1px;
				background: var(--text-light);
				vertical-align: middle;
				margin-left: 12px;
				opacity: 0.5;
			}
			.section-title {
				font-family: 'Playfair Display', serif;
				font-size: 3rem;
				font-weight: 400;
				text-align: center;
				margin-bottom: 20px;
				color: var(--text);
				line-height: 1.15;
				letter-spacing: -0.02em;
			}
			.section-title em {
				font-style: italic;
				color: var(--accent);
			}
			.section-subtitle {
				text-align: center;
				color: var(--text-muted);
				font-size: 0.95rem;
				max-width: 500px;
				margin: 0 auto 60px;
				font-weight: 300;
				line-height: 1.8;
			}
			@media (max-width: 600px) {
				.section-title { font-size: 2rem; }
				.section-subtitle { font-size: 0.85rem; margin-bottom: 40px; }
			}

			.toast-container {
				position: fixed; top: 20px; right: 20px; z-index: 9999;
				display: flex; flex-direction: column; gap: 8px;
			}
			.toast {
				background: var(--text); color: var(--white);
				padding: 12px 20px; border-radius: 8px;
				box-shadow: var(--shadow-lg);
				animation: slideInToast 0.4s ease;
				min-width: 200px;
				display: flex; align-items: center; gap: 10px;
				font-size: 0.85rem;
			}
			.toast i { font-size: 1.1rem; }
			.toast.success i { color: #10b981; }
			.toast.error i { color: #ef4444; }
			.toast.info i { color: var(--accent-light); }
			@keyframes slideInToast {
				from { transform: translateX(100%); opacity: 0; }
				to { transform: translateX(0); opacity: 1; }
			}

			#startOverlay {
				position: fixed; top: 0; left: 0; right: 0; bottom: 0;
				width: 100vw; height: 100vh; height: 100svh;
				background-color: #1a1a1a;
				z-index: 9999;
				display: flex; align-items: center; justify-content: center;
				transition: opacity 0.8s ease;
				cursor: pointer;
				padding: 24px;
				overflow-y: auto;
			}
			#startOverlay .overlay-bg-img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				opacity: 0.22;
				filter: blur(1px) saturate(0.6);
				z-index: 0;
				pointer-events: none;
			}
			#startOverlay::before {
				content: '';
				position: absolute;
				inset: 0;
				background: 
					radial-gradient(ellipse at 50% 40%, rgba(28,25,23,0.3) 0%, transparent 70%),
					linear-gradient(180deg, 
						rgba(28,25,23,0.85) 0%, 
						rgba(28,25,23,0.78) 40%, 
						rgba(28,25,23,0.88) 70%, 
						rgba(28,25,23,0.95) 100%);
				z-index: 1;
				pointer-events: none;
			}
			#startOverlay .overlay-inner {
				position: relative;
				z-index: 2;
				text-align: center;
				max-width: 480px;
				width: 100%;
				padding: 20px;
				margin: auto;
				animation: fadeIn 1.2s ease;
			}
			#startOverlay .overlay-eyebrow {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 8px;
				color: rgba(255, 255, 255, 0.7);
				margin-bottom: 32px;
				font-weight: 400;
			}
			#startOverlay .overlay-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.4rem;
				font-weight: 400;
				color: var(--white);
				margin-bottom: 32px;
				letter-spacing: -0.01em;
				line-height: 1.25;
			}
			#startOverlay .overlay-title span { display: block; }
			#startOverlay .overlay-title .amp {
				font-size: 1.3rem;
				color: rgba(255, 255, 255, 0.6);
				margin: 10px 0;
				font-style: italic;
				font-weight: 300;
			}
			#startOverlay .overlay-divider {
				width: 60px;
				height: 1px;
				background: rgba(255, 255, 255, 0.3);
				margin: 32px auto;
			}
			#startOverlay .overlay-guest-label {
				font-size: 0.62rem;
				text-transform: uppercase;
				letter-spacing: 5px;
				color: rgba(255, 255, 255, 0.5);
				margin-bottom: 10px;
			}
			#startOverlay .overlay-guest-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.6rem;
				font-weight: 400;
				color: var(--white);
				margin-bottom: 40px;
				font-style: italic;
			}
			#startOverlay .btn-start {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: var(--white);
				color: var(--text);
				padding: 16px 44px;
				border-radius: 2px;
				font-weight: 500;
				font-size: 0.8rem;
				border: none;
				cursor: pointer;
				box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
				transition: all 0.3s;
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			#startOverlay .btn-start:hover {
				transform: translateY(-2px);
				background: var(--accent);
				color: var(--white);
			}
			#startOverlay .hint {
				font-size: 0.6rem;
				color: rgba(255, 255, 255, 0.4);
				margin-top: 28px;
				letter-spacing: 3px;
				text-transform: uppercase;
			}
			@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

			@media (max-width: 600px) {
				#startOverlay { padding: 20px; }
				#startOverlay .overlay-title { font-size: 1.9rem; }
				#startOverlay .overlay-guest-name { font-size: 1.3rem; margin-bottom: 32px; }
				#startOverlay .btn-start { padding: 14px 32px; font-size: 0.75rem; width: 100%; max-width: 260px; justify-content: center; }
			}

			.music-player {
				position: fixed;
				bottom: 24px;
				right: 24px;
				z-index: 1000;
			}
			.music-btn {
				width: 48px;
				height: 48px;
				border-radius: 50%;
				background: rgba(28, 25, 23, 0.9);
				backdrop-filter: blur(10px);
				border: none;
				color: var(--white);
				font-size: 1.15rem;
				cursor: pointer;
				box-shadow: var(--shadow-md);
				transition: all 0.3s;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.music-btn:hover {
				transform: scale(1.08);
				background: var(--accent);
			}
			.music-btn.playing { animation: pulseMinimal 2s infinite; }
			@keyframes pulseMinimal {
				0% { box-shadow: 0 0 0 0 rgba(74, 93, 74, 0.4); }
				70% { box-shadow: 0 0 0 16px rgba(74, 93, 74, 0); }
				100% { box-shadow: 0 0 0 0 rgba(74, 93, 74, 0); }
			}

			.hero-editorial {
				position: relative;
				min-height: 100vh;
				min-height: 100svh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding-top: 140px;
				padding-bottom: 80px;
				padding-left: 24px;
				padding-right: 24px;
				color: var(--white);
				overflow: hidden;
				background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 50%, #1a1a1a 100%);
			}
			.hero-editorial .hero-bg-img {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				z-index: 0;
				pointer-events: none;
				opacity: 0.25;
				filter: blur(1.5px) saturate(0.7);
			}
			.hero-editorial::before {
				content: '';
				position: absolute;
				inset: 0;
				background: 
					radial-gradient(ellipse at 50% 30%, rgba(28,25,23,0.55) 0%, transparent 60%),
					linear-gradient(180deg, 
						rgba(28,25,23,0.72) 0%, 
						rgba(28,25,23,0.55) 30%, 
						rgba(28,25,23,0.75) 65%, 
						rgba(28,25,23,0.95) 100%);
				z-index: 1;
				pointer-events: none;
			}
			.hero-editorial::after {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.3) 0%, transparent 70%);
				z-index: 1;
				pointer-events: none;
			}
			.hero-editorial .hero-inner {
				position: relative;
				z-index: 2;
				text-align: center;
				max-width: 720px;
				width: 100%;
			}
			.hero-editorial .hero-eyebrow {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 8px;
				color: rgba(255, 255, 255, 0.85);
				margin-bottom: 28px;
				font-weight: 400;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
			}
			.hero-editorial .hero-names {
				font-family: 'Playfair Display', serif;
				font-size: 5.5rem;
				font-weight: 400;
				line-height: 0.95;
				letter-spacing: -0.03em;
				margin-bottom: 24px;
				display: flex;
				flex-direction: column;
				align-items: center;
				color: var(--white);
				text-shadow: 
					0 4px 32px rgba(0, 0, 0, 0.55),
					0 2px 12px rgba(0, 0, 0, 0.4),
					0 1px 4px rgba(0, 0, 0, 0.3);
			}
			.hero-editorial .hero-names .amp {
				font-style: italic;
				font-size: 2.2rem;
				color: rgba(255, 255, 255, 0.75);
				margin: 14px 0;
				line-height: 1;
				font-weight: 300;
			}
			.hero-editorial .hero-divider {
				width: 60px;
				height: 1px;
				background: rgba(255, 255, 255, 0.55);
				margin: 32px auto;
				box-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
			}
			.hero-editorial .hero-dates {
				font-size: 0.85rem;
				color: rgba(255, 255, 255, 0.92);
				letter-spacing: 4px;
				text-transform: uppercase;
				margin-bottom: 40px;
				font-weight: 400;
				text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
			}
			.hero-editorial .btn-scroll {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: rgba(255, 255, 255, 0.08);
				color: var(--white);
				padding: 14px 32px;
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-radius: 2px;
				text-decoration: none;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 3px;
				text-transform: uppercase;
				transition: all 0.3s;
				cursor: pointer;
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
			}
			.hero-editorial .btn-scroll:hover {
				background: var(--white);
				color: var(--text);
				border-color: var(--white);
			}
			.hero-editorial .scroll-down {
				position: absolute;
				bottom: 24px;
				left: 50%;
				transform: translateX(-50%);
				color: rgba(255, 255, 255, 0.6);
				font-size: 1.3rem;
				animation: bounceMinimal 2s infinite;
				cursor: pointer;
				background: none;
				border: none;
				z-index: 3;
			}
			@keyframes bounceMinimal {
				0%, 100% { transform: translateX(-50%) translateY(0); }
				50% { transform: translateX(-50%) translateY(8px); }
			}
			@media (max-width: 700px) {
				.hero-editorial { 
					padding-top: 100px; 
					padding-bottom: 60px;
					padding-left: 20px;
					padding-right: 20px;
				}
				.hero-editorial .hero-names { font-size: 3rem; }
				.hero-editorial .hero-names .amp { font-size: 1.5rem; margin: 10px 0; }
				.hero-editorial .hero-eyebrow { letter-spacing: 5px; margin-bottom: 20px; }
				.hero-editorial .hero-dates { font-size: 0.7rem; letter-spacing: 2px; margin-bottom: 32px; }
			}
			@media (max-width: 400px) {
				.hero-editorial .hero-names { font-size: 2.4rem; }
			}

			.opening-mini {
				padding: 120px 24px;
				background: var(--bg-alt);
				text-align: center;
				position: relative;
				overflow: hidden;
			}
			.opening-mini::before {
				content: '"';
				position: absolute;
				top: 40px;
				left: 50%;
				transform: translateX(-50%);
				font-family: 'Playfair Display', serif;
				font-size: 12rem;
				color: var(--accent);
				opacity: 0.06;
				line-height: 1;
				pointer-events: none;
			}
			.opening-mini-inner {
				position: relative;
				z-index: 2;
				max-width: 640px;
				margin: 0 auto;
			}
			.opening-mini-quote {
				font-family: 'Playfair Display', serif;
				font-size: 1.6rem;
				font-style: italic;
				font-weight: 400;
				color: var(--text);
				line-height: 1.6;
				margin-bottom: 32px;
				letter-spacing: -0.01em;
			}
			.opening-mini-source {
				font-size: 0.7rem;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--text-muted);
				font-weight: 500;
			}
			.opening-mini-source::before {
				content: '— ';
				color: var(--accent);
			}
			@media (max-width: 600px) {
				.opening-mini { padding: 80px 20px; }
				.opening-mini::before { font-size: 8rem; top: 20px; }
				.opening-mini-quote { font-size: 1.15rem; line-height: 1.6; margin-bottom: 24px; }
			}

			.section-mini {
				padding: 120px 0;
				background: var(--bg);
			}
			.section-mini-alt {
				padding: 120px 0;
				background: var(--bg-alt);
			}
			@media (max-width: 600px) {
				.section-mini, .section-mini-alt { padding: 80px 0; }
			}

			.couple-editorial {
				display: flex;
				flex-direction: column;
				gap: 80px;
			}
			.couple-editorial-row {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 48px;
				align-items: center;
			}
			.couple-editorial-row.reverse {
				direction: rtl;
			}
			.couple-editorial-row.reverse > * {
				direction: ltr;
			}
			@media (max-width: 700px) {
				.couple-editorial-row,
				.couple-editorial-row.reverse {
					grid-template-columns: 1fr;
					gap: 24px;
					direction: ltr;
				}
				.couple-editorial { gap: 60px; }
			}
			.couple-editorial-photo {
				position: relative;
				aspect-ratio: 3 / 4;
				overflow: hidden;
				background: var(--bg-alt);
				border-radius: 2px;
			}
			.couple-editorial-photo img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.7s ease;
			}
			.couple-editorial-photo:hover img { transform: scale(1.04); }
			.couple-editorial-photo::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, transparent 60%, rgba(28,25,23,0.15));
				pointer-events: none;
			}
			.couple-editorial-info {
				padding: 20px 0;
			}
			.couple-editorial-role {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 6px;
				color: var(--accent);
				margin-bottom: 20px;
				font-weight: 500;
			}
			.couple-editorial-info h3 {
				font-family: 'Playfair Display', serif;
				font-size: 2.4rem;
				font-weight: 400;
				color: var(--text);
				margin-bottom: 20px;
				line-height: 1.15;
				letter-spacing: -0.02em;
			}
			.couple-editorial-divider {
				width: 40px;
				height: 1px;
				background: var(--text);
				margin-bottom: 20px;
			}
			.couple-editorial-parents-label {
				font-size: 0.7rem;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 8px;
			}
			.couple-editorial-parents {
				font-size: 0.95rem;
				color: var(--text-muted);
				font-style: italic;
				line-height: 1.7;
				font-weight: 300;
				margin-bottom: 24px;
			}
			.couple-editorial-social {
				display: flex;
				gap: 12px;
			}
			.couple-editorial-social a {
				width: 36px;
				height: 36px;
				border-radius: 50%;
				border: 1px solid var(--line-strong);
				color: var(--text-muted);
				font-size: 0.95rem;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: all 0.3s;
				text-decoration: none;
			}
			.couple-editorial-social a:hover {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--white);
			}
			@media (max-width: 700px) {
				.couple-editorial-info h3 { font-size: 1.8rem; }
				.couple-editorial-photo { aspect-ratio: 1; }
			}
			.couple-editorial-row.reverse .couple-editorial-photo { order: 2; }
			.couple-editorial-row.reverse .couple-editorial-info { order: 1; }

			.story-editorial {
				max-width: 640px;
				margin: 0 auto;
				counter-reset: story-counter;
			}
			.story-editorial-item {
				display: grid;
				grid-template-columns: 80px 1fr;
				gap: 32px;
				padding: 40px 0;
				border-bottom: 1px solid var(--line);
				align-items: start;
			}
			.story-editorial-item:last-child { border-bottom: none; padding-bottom: 0; }
			.story-editorial-item:first-child { padding-top: 0; }
			.story-editorial-num {
				font-family: 'Playfair Display', serif;
				font-size: 3rem;
				font-style: italic;
				color: var(--accent);
				font-weight: 400;
				line-height: 1;
				opacity: 0.4;
			}
			.story-editorial-content h4 {
				font-family: 'Playfair Display', serif;
				font-size: 1.4rem;
				font-weight: 400;
				color: var(--text);
				margin-bottom: 12px;
				letter-spacing: -0.01em;
			}
			.story-editorial-content p {
				font-size: 0.95rem;
				color: var(--text-muted);
				line-height: 1.8;
				font-weight: 300;
			}
			@media (max-width: 600px) {
				.story-editorial-item { grid-template-columns: 50px 1fr; gap: 20px; padding: 28px 0; }
				.story-editorial-num { font-size: 2rem; }
				.story-editorial-content h4 { font-size: 1.15rem; margin-bottom: 8px; }
				.story-editorial-content p { font-size: 0.88rem; }
			}

			.event-editorial-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 32px;
			}
			@media (max-width: 700px) {
				.event-editorial-grid { grid-template-columns: 1fr; gap: 24px; }
			}
			.event-editorial-card {
				background: var(--card);
				border: 1px solid var(--line);
				padding: 56px 40px;
				text-align: center;
				transition: all 0.4s ease;
				position: relative;
				overflow: hidden;
			}
			.event-editorial-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 3px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 0.5s ease;
			}
			.event-editorial-card:hover::before { transform: scaleX(1); }
			.event-editorial-card:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.event-editorial-icon {
				width: 56px;
				height: 56px;
				border-radius: 50%;
				background: var(--accent-soft);
				color: var(--accent);
				font-size: 1.4rem;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto 28px;
			}
			.event-editorial-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.6rem;
				font-weight: 400;
				color: var(--text);
				margin-bottom: 8px;
				letter-spacing: -0.01em;
			}
			.event-editorial-arabic {
				font-family: 'Amiri', serif;
				font-size: 0.9rem;
				color: var(--accent);
				margin-bottom: 28px;
				font-style: italic;
			}
			.event-editorial-detail {
				font-size: 0.9rem;
				color: var(--text-muted);
				line-height: 2;
				font-weight: 300;
				margin-bottom: 28px;
			}
			.event-editorial-detail .row {
				display: flex;
				flex-direction: column;
				margin-bottom: 16px;
			}
			.event-editorial-detail .row:last-child { margin-bottom: 0; }
			.event-editorial-detail .label {
				font-size: 0.65rem;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: var(--text-light);
				margin-bottom: 6px;
				font-weight: 500;
			}
			.event-editorial-detail .value {
				color: var(--text);
				font-size: 0.95rem;
			}
			.event-editorial-btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				color: var(--text);
				text-decoration: none;
				font-size: 0.75rem;
				font-weight: 500;
				letter-spacing: 3px;
				text-transform: uppercase;
				border-bottom: 1px solid var(--text);
				padding-bottom: 6px;
				transition: all 0.3s;
			}
			.event-editorial-btn:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
				gap: 14px;
			}
			@media (max-width: 600px) {
				.event-editorial-card { padding: 40px 28px; }
				.event-editorial-title { font-size: 1.3rem; }
			}

			.gallery-masonry {
				columns: 3;
				column-gap: 16px;
			}
			@media (max-width: 900px) {
				.gallery-masonry { columns: 2; column-gap: 12px; }
			}
			@media (max-width: 500px) {
				.gallery-masonry { columns: 2; column-gap: 8px; }
			}
			.gallery-masonry-item {
				break-inside: avoid;
				margin-bottom: 16px;
				position: relative;
				overflow: hidden;
				cursor: pointer;
				background: var(--bg-alt);
				border-radius: 2px;
				transition: transform 0.4s ease;
			}
			@media (max-width: 900px) {
				.gallery-masonry-item { margin-bottom: 12px; }
			}
			@media (max-width: 500px) {
				.gallery-masonry-item { margin-bottom: 8px; }
			}
			.gallery-masonry-item img {
				width: 100%;
				height: auto;
				display: block;
				transition: transform 0.7s ease;
			}
			.gallery-masonry-item:hover img { transform: scale(1.05); }
			.gallery-masonry-item::after {
				content: '';
				position: absolute;
				inset: 0;
				background: rgba(28, 25, 23, 0);
				transition: background 0.3s;
				pointer-events: none;
			}
			.gallery-masonry-item:hover::after { background: rgba(28, 25, 23, 0.15); }
			.gallery-masonry-item i {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%) scale(0.7);
				color: var(--white);
				font-size: 1.5rem;
				opacity: 0;
				transition: all 0.3s;
				pointer-events: none;
				z-index: 2;
			}
			.gallery-masonry-item:hover i { opacity: 1; transform: translate(-50%, -50%) scale(1); }

			.rsvp-form {
				max-width: 480px;
				margin: 0 auto;
			}
			.form-group {
				margin-bottom: 24px;
				text-align: left;
			}
			.form-group label {
				display: block;
				font-size: 0.68rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 3px;
				color: var(--text-muted);
				margin-bottom: 10px;
			}
			.form-group .required { color: #dc2626; }
			.form-group input,
			.form-group select,
			.form-group textarea {
				width: 100%;
				padding: 16px 0;
				border: none;
				border-bottom: 1px solid var(--line-strong);
				background: transparent;
				font-size: 0.95rem;
				font-family: 'Inter', sans-serif;
				color: var(--text);
				transition: border-color 0.3s;
				border-radius: 0;
			}
			.form-group input:focus,
			.form-group select:focus,
			.form-group textarea:focus {
				outline: none;
				border-bottom-color: var(--accent);
			}
			.form-group input::placeholder,
			.form-group textarea::placeholder { color: var(--text-light); }
			.form-group input[readonly] {
				color: var(--text-muted);
				cursor: not-allowed;
				background: transparent;
			}
			.form-group textarea { resize: vertical; min-height: 90px; }
			.btn-submit {
				width: 100%;
				padding: 18px;
				background: var(--text);
				color: var(--white);
				border: none;
				border-radius: 2px;
				font-size: 0.78rem;
				font-weight: 500;
				cursor: pointer;
				transition: all 0.3s;
				letter-spacing: 4px;
				text-transform: uppercase;
				margin-top: 16px;
			}
			.btn-submit:hover {
				background: var(--accent);
				transform: translateY(-1px);
				box-shadow: var(--shadow-md);
			}
			.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }

			.rsvp-list-wrap {
				max-width: 480px;
				margin: 80px auto 0;
				padding-top: 40px;
				border-top: 1px solid var(--line);
			}
			.rsvp-list-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 28px;
			}
			.rsvp-list-head h4 {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem;
				font-weight: 400;
				color: var(--text);
			}
			.rsvp-count {
				font-size: 0.72rem;
				color: var(--text-light);
				letter-spacing: 2px;
				text-transform: uppercase;
			}
			#rsvpList {
				display: flex;
				flex-direction: column;
				gap: 0;
				max-height: 440px;
				overflow-y: auto;
			}
			.rsvp-item {
				padding: 24px 0;
				border-bottom: 1px solid var(--line);
			}
			.rsvp-item:last-child { border-bottom: none; }
			.rsvp-item .row-main {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 8px;
				margin-bottom: 8px;
			}
			.rsvp-item .guest-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.05rem;
				font-weight: 400;
				color: var(--text);
			}
			.rsvp-item .status-badge {
				font-size: 0.62rem;
				padding: 3px 12px;
				border-radius: 2px;
				letter-spacing: 2px;
				text-transform: uppercase;
				font-weight: 500;
			}
			.rsvp-item .status-badge.hadir {
				background: rgba(16, 185, 129, 0.1);
				color: #059669;
			}
			.rsvp-item .status-badge.tidak_hadir {
				background: rgba(220, 38, 38, 0.08);
				color: #dc2626;
			}
			.rsvp-item .status-badge.ragu {
				background: rgba(245, 158, 11, 0.1);
				color: #d97706;
			}
			.rsvp-item .row-detail {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 8px;
			}
			.rsvp-item .meta {
				display: flex;
				align-items: center;
				gap: 16px;
				font-size: 0.72rem;
				color: var(--text-light);
			}
			.rsvp-item .meta span { display: flex; align-items: center; gap: 5px; }
			.rsvp-item .message {
				margin-top: 12px;
				padding: 14px 18px;
				background: var(--bg-alt);
				border-left: 2px solid var(--accent);
				font-size: 0.85rem;
				color: var(--text-muted);
				font-style: italic;
				line-height: 1.7;
				border-radius: 2px;
			}
			.rsvp-empty {
				text-align: center;
				color: var(--text-light);
				font-size: 0.85rem;
				padding: 40px 0;
			}
			.rsvp-empty i { display: block; font-size: 1.6rem; margin-bottom: 12px; opacity: 0.5; }

			.bank-mini-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 24px;
				max-width: 720px;
				margin: 0 auto;
			}
			.bank-mini-card {
				background: var(--card);
				border: 1px solid var(--line);
				padding: 40px 28px;
				text-align: center;
				transition: all 0.4s ease;
				position: relative;
			}
			.bank-mini-card::before {
				content: '';
				position: absolute;
				top: 0; left: 0; right: 0;
				height: 2px;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 0.5s ease;
			}
			.bank-mini-card:hover::before { transform: scaleX(1); }
			.bank-mini-card:hover {
				border-color: var(--accent);
				box-shadow: var(--shadow-md);
				transform: translateY(-4px);
			}
			.bank-mini-logo {
				width: 60px;
				height: 60px;
				margin: 0 auto 24px;
				border-radius: 50%;
				background: var(--accent-soft);
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}
			.bank-mini-logo img {
				width: 55%;
				height: 55%;
				object-fit: contain;
			}
			.bank-mini-logo .initial {
				font-family: 'Playfair Display', serif;
				font-size: 1.3rem;
				color: var(--accent);
				font-weight: 400;
			}
			.bank-mini-name {
				font-family: 'Playfair Display', serif;
				font-size: 1.1rem;
				font-weight: 400;
				color: var(--text);
				margin-bottom: 20px;
				letter-spacing: 0.5px;
			}
			.bank-mini-number {
				display: inline-flex;
				align-items: center;
				gap: 10px;
				background: var(--bg-alt);
				padding: 14px 22px;
				border-radius: 2px;
				cursor: pointer;
				transition: all 0.3s;
				margin-bottom: 14px;
				width: 100%;
				justify-content: center;
			}
			.bank-mini-number:hover {
				background: var(--accent-soft);
				transform: translateY(-1px);
			}
			.bank-mini-number span {
				font-family: 'Courier New', monospace;
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text);
				letter-spacing: 2px;
			}
			.bank-mini-number i {
				font-size: 0.8rem;
				color: var(--text-muted);
				transition: color 0.3s;
			}
			.bank-mini-number:hover i { color: var(--accent); }
			.bank-mini-holder {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-style: italic;
			}
			.bank-mini-holder strong {
				color: var(--text);
				font-style: normal;
				font-weight: 500;
			}
			.bank-mini-note {
				text-align: center;
				margin-top: 40px;
				font-size: 0.8rem;
				color: var(--text-light);
				font-style: italic;
			}

			.footer-mini {
				padding: 100px 24px 48px;
				background: var(--bg);
				text-align: center;
				border-top: 1px solid var(--line);
				position: relative;
			}
			.footer-mini-couple {
				font-family: 'Playfair Display', serif;
				font-size: 2rem;
				font-weight: 400;
				color: var(--text);
				margin-bottom: 12px;
				letter-spacing: -0.01em;
			}
			.footer-mini-couple .amp {
				font-style: italic;
				color: var(--accent);
				margin: 0 12px;
				font-weight: 300;
			}
			.footer-mini-divider {
				width: 60px;
				height: 1px;
				background: var(--line-strong);
				margin: 28px auto;
			}
			.footer-mini-date {
				font-size: 0.75rem;
				color: var(--text-muted);
				letter-spacing: 5px;
				text-transform: uppercase;
				margin-bottom: 32px;
			}
			
			.footer-mini-prayer {
				font-family: 'Playfair Display', serif;
				font-size: 0.95rem;
				font-style: italic;
				color: var(--text-muted);
				max-width: 500px;
				margin: 0 auto;
				line-height: 1.7;
			}

			.web-footer {
				padding: 56px 0 32px;
				background: var(--bg-dark);
				color: rgba(255, 255, 255, 0.6);
			}
			.web-footer-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}
			.web-footer-brand {
				font-family: 'Playfair Display', serif;
				font-size: 1.4rem;
				font-weight: 500;
				margin-bottom: 20px;
				text-decoration: none;
				display: inline-block;
			}
			.web-footer-brand .wedding { color: rgba(255, 255, 255, 0.9); }
			.web-footer-brand .saas {
				color: var(--accent-light);
				font-style: italic;
			}
			.web-footer-desc {
				font-size: 0.82rem;
				line-height: 1.8;
				margin-bottom: 20px;
				font-weight: 300;
				color: rgba(255, 255, 255, 0.5);
			}
			.web-footer-heading {
				font-size: 0.68rem;
				font-weight: 500;
				text-transform: uppercase;
				letter-spacing: 4px;
				color: rgba(255, 255, 255, 0.85);
				margin-bottom: 24px;
			}
			.web-footer-list {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.web-footer-list li {
				display: flex;
				align-items: flex-start;
				gap: 10px;
				margin-bottom: 14px;
				font-size: 0.82rem;
				line-height: 1.6;
				color: rgba(255, 255, 255, 0.5);
				font-weight: 300;
			}
			.web-footer-list li i {
				color: var(--accent-light);
				margin-top: 3px;
				flex-shrink: 0;
				opacity: 0.7;
			}
			.web-footer-list a, .web-footer-link {
				color: rgba(255, 255, 255, 0.5);
				text-decoration: none;
				transition: color 0.2s;
			}
			.web-footer-list a:hover, .web-footer-link:hover { color: var(--white); }
			.web-footer-socials {
				display: flex;
				gap: 12px;
				flex-wrap: wrap;
				margin-top: 20px;
			}
			.web-footer-socials a {
				width: 38px;
				height: 38px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.1);
				display: flex;
				align-items: center;
				justify-content: center;
				color: rgba(255, 255, 255, 0.6);
				font-size: 0.95rem;
				transition: all 0.3s;
				text-decoration: none;
			}
			.web-footer-socials a:hover {
				background: var(--accent);
				color: var(--white);
				border-color: var(--accent);
				transform: translateY(-2px);
			}
			.web-footer-version {
				font-size: 0.7rem;
				padding: 5px 12px;
				background: rgba(255, 255, 255, 0.05);
				border-radius: 2px;
				display: inline-block;
				color: rgba(255, 255, 255, 0.4);
				letter-spacing: 1px;
			}
			.web-footer-divider {
				border: 0;
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				margin: 2rem 0 1.25rem;
				opacity: 1;
			}
			@media (max-width: 768px) {
				.web-footer { padding: 48px 0 28px; text-align: center; }
				.web-footer-list li { justify-content: center; }
				.web-footer-socials { justify-content: center; }
			}
		
			/* RSVP WARNING & LIST (shared) */
			.rsvp-warning {
				background: var(--accent-soft);
				border-left: 2px solid var(--accent);
				padding: 16px 20px;
				margin-bottom: 28px;
				border-radius: 2px;
			}
			.rsvp-warning-title {
				display: flex;
				align-items: center;
				gap: 8px;
				margin-bottom: 4px;
			}
			.rsvp-warning-title i {
				color: var(--accent);
				font-size: 1.1rem;
			}
			.rsvp-warning-title strong {
				font-size: 0.85rem;
				color: var(--text);
				font-weight: 500;
			}
			.rsvp-warning p {
				margin: 0;
				font-size: 0.78rem;
				color: var(--text-muted);
				line-height: 1.6;
			}
			.rsvp-list-wrap {
				max-width: 480px;
				margin: 80px auto 0;
				padding-top: 40px;
				border-top: 1px solid var(--line);
			}
			.rsvp-list-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 28px;
			}
			.rsvp-list-head h4 {
				font-family: 'Playfair Display', serif;
				font-size: 1.2rem;
				font-weight: 400;
				color: var(--text);
				margin: 0;
			}
			.rsvp-count {
				font-size: 0.72rem;
				color: var(--text-light);
				letter-spacing: 2px;
				text-transform: uppercase;
			}

		
			/* Web Footer Icon (shared) */
			.web-footer-icon { color: var(--accent-light); }

		
			/* Web Footer container — override lebar */
			.web-footer .container {
				max-width: 1280px !important;
			}

		
			/* Web Footer brand logo — inline dengan teks */
			.web-footer-brand img {
				display: inline-block !important;
				vertical-align: middle;
				margin-right: 8px;
			}

		
			/* Footer Social — icon + teks (shared) */
			.footer-social {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 10px;
				margin-bottom: 24px;
			}
			.footer-social a {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 10px 18px;
				border: 1px solid rgba(125, 140, 125, 0.25);
				border-radius: 50px;
				color: rgb(125, 140, 125);
				text-decoration: none;
				font-size: 0.8rem;
				font-weight: 500;
				transition: all 0.3s;
				opacity: 0.8;
				white-space: nowrap;
			}
			.footer-social a:hover {
				background: rgba(125, 140, 125, 0.1);
				border-color: rgb(125, 140, 125);
				transform: translateY(-2px);
				opacity: 1;
			}
			.footer-social a i {
				font-size: 1rem;
			}
			.footer-social a span {
				font-size: 0.8rem;
				font-weight: 500;
			}

		</style>
	</head>
	<body data-music-url={ data.MusicURL } data-project-id={ invitation.FormatUint(data.Project.ID) } data-project-slug={ data.Project.Slug }>

		<!-- OVERLAY -->
		<div id="startOverlay">
			if data.HeroImage != "" {
				<img src={ data.HeroImage } alt="" class="overlay-bg-img" loading="eager"/>
			}
			<div class="overlay-inner">
				<div class="overlay-eyebrow">The Wedding Of</div>

				<div class="overlay-title">
					<span>{ data.GroomName }</span>
					<span class="amp">&amp;</span>
					<span>{ data.BrideName }</span>
				</div>

				<div class="overlay-divider"></div>

				<div class="overlay-guest-label">
					{ invitation.GuestGreeting(data.IsNamedGuest) }
				</div>
				<div class="overlay-guest-name">{ data.GuestName }</div>

				<button class="btn-start" onclick={ templpkg.JSFuncCall("startMusic") }>
					<i class="bi bi-envelope-open"></i>
					Buka Undangan
				</button>

				<p class="hint">Tap untuk membuka undangan</p>
			</div>
		</div>

		<!-- MUSIC PLAYER -->
		@shared.MusicPlayer()

		<!-- HERO -->
		<section class="hero-editorial" id="section-hero">
			if data.HeroImage != "" {
				<img src={ data.HeroImage } alt="" class="hero-bg-img" loading="eager"/>
			}
			<div class="hero-inner" data-aos="fade-up" data-aos-duration="1200">
				<div class="hero-eyebrow">The Wedding Of</div>

				<h1 class="hero-names">
					<span>{ data.GroomName }</span>
					<span class="amp">&amp;</span>
					<span>{ data.BrideName }</span>
				</h1>

				<div class="hero-divider"></div>

				<div class="hero-dates">
					if data.ShouldShowAkadDate() {
						{ data.AkadDate }
					}
					if data.ShouldShowBothDates() {
						<span> · </span>
					}
					if data.ShouldShowResepsiDate() {
						{ data.ResepsiDate }
					}
				</div>

				<a href="#section-opening" class="btn-scroll">
					<i class="bi bi-arrow-down"></i>
					Lihat Undangan
				</a>
			</div>

			<button class="scroll-down" onclick={ templpkg.JSFuncCall("scrollToOpening") }>
				<i class="bi bi-chevron-double-down"></i>
			</button>
		</section>

		<!-- OPENING STATEMENT -->
		<section class="opening-mini" id="section-opening">
			<div class="opening-mini-inner" data-aos="fade-up">
				<div class="opening-mini-quote">
					"Dengan memohon rahmat dan ridho Tuhan Yang Maha Esa, kami bermaksud menyelenggarakan pernikahan putra-putri kami."
				</div>
				<div class="opening-mini-source">The Wedding Of { data.GroomName } &amp; { data.BrideName }</div>
			</div>
		</section>

		<!-- COUPLE -->
		<section class="section-mini" id="section-couple">
			<div class="container">
				<div class="section-label" data-aos="fade-up">The Bride &amp; Groom</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Mempelai<br/><em>yang berbahagia</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Dengan penuh rasa syukur, kami mempersembahkan dua insan yang akan diikat dalam janji suci pernikahan
				</p>

				<div class="couple-editorial">
					<!-- GROOM -->
					<div class="couple-editorial-row" data-aos="fade-up" data-aos-delay="150">
						<div class="couple-editorial-photo">
							<img src={ data.GroomPhotoOrDefault() } alt={ data.GroomName } loading="lazy"/>
						</div>
						<div class="couple-editorial-info">
							<div class="couple-editorial-role">The Groom</div>
							<h3>{ data.GroomName }</h3>
							<div class="couple-editorial-divider"></div>
							<div class="couple-editorial-parents-label">Putra dari</div>
							<div class="couple-editorial-parents">
								{ data.ParentsGroom() }
							</div>
							if data.GroomInstagram != "" {
								<div class="couple-editorial-social">
									<a href={ templpkg.SafeURL(data.GroomInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>

					<!-- BRIDE -->
					<div class="couple-editorial-row reverse" data-aos="fade-up" data-aos-delay="200">
						<div class="couple-editorial-photo">
							<img src={ data.BridePhotoOrDefault() } alt={ data.BrideName } loading="lazy"/>
						</div>
						<div class="couple-editorial-info">
							<div class="couple-editorial-role">The Bride</div>
							<h3>{ data.BrideName }</h3>
							<div class="couple-editorial-divider"></div>
							<div class="couple-editorial-parents-label">Putri dari</div>
							<div class="couple-editorial-parents">
								{ data.ParentsBride() }
							</div>
							if data.BrideInstagram != "" {
								<div class="couple-editorial-social">
									<a href={ templpkg.SafeURL(data.BrideInstagram) } target="_blank" rel="noopener">
										<i class="bi bi-instagram"></i>
									</a>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- LOVE STORY -->
		if len(data.LoveStories) > 0 {
			<section class="section-mini-alt" id="section-love">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Our Story</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Perjalanan<br/><em>yang kami lalui</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Setiap langkah adalah bagian dari cerita yang membawa kami hingga di hari bahagia ini
					</p>

					<div class="story-editorial">
						for index, story := range data.LoveStories {
							<div class="story-editorial-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<div class="story-editorial-num">0{ invitation.FormatInt(index + 1) }</div>
								<div class="story-editorial-content">
									<h4>{ story.Title }</h4>
									<p>{ story.Desc }</p>
								</div>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- EVENT -->
		<section class="section-mini" id="section-event">
			<div class="container">
				<div class="section-label" data-aos="fade-up">When &amp; Where</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Detail<br/><em>acara</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Dengan penuh rasa hormat, kami mengundang Bapak/Ibu/Saudara/i untuk hadir di acara kami
				</p>

				<div class="event-editorial-grid">
					<!-- Akad -->
					<div class="event-editorial-card" data-aos="fade-up" data-aos-delay="150">
						<div class="event-editorial-icon">
							<i class="bi bi-heart"></i>
						</div>
						<h3 class="event-editorial-title">Akad Nikah</h3>
						<div class="event-editorial-detail">
							<div class="row">
								<span class="label">Tanggal</span>
								<span class="value">{ data.AkadDate }</span>
							</div>
							<div class="row">
								<span class="label">Waktu</span>
								<span class="value">{ data.AkadTime } WIB</span>
							</div>
							<div class="row">
								<span class="label">Tempat</span>
								<span class="value">{ data.AkadVenue }</span>
							</div>
						</div>
						if data.MapsURLAkad != "" {
							<a href={ templpkg.SafeURL(data.MapsURLAkad) } target="_blank" rel="noopener" class="event-editorial-btn">
								Lihat Lokasi <i class="bi bi-arrow-right"></i>
							</a>
						}
					</div>

					<!-- Resepsi -->
					<div class="event-editorial-card" data-aos="fade-up" data-aos-delay="200">
						<div class="event-editorial-icon">
							<i class="bi bi-stars"></i>
						</div>
						<h3 class="event-editorial-title">{ data.ResepsiLabelDisplay() }</h3>
						if data.IsIslamicResepsi() && data.ResepsiArabic() != "" {
							<div class="event-editorial-arabic">{ data.ResepsiArabic() }</div>
						}
						<div class="event-editorial-detail">
							<div class="row">
								<span class="label">Tanggal</span>
								<span class="value">{ data.ResepsiDate }</span>
							</div>
							<div class="row">
								<span class="label">Waktu</span>
								<span class="value">{ data.ResepsiTime } WIB</span>
							</div>
							<div class="row">
								<span class="label">Tempat</span>
								<span class="value">{ data.ResepsiVenue }</span>
							</div>
						</div>
						if data.MapsURLResepsi != "" {
							<a href={ templpkg.SafeURL(data.MapsURLResepsi) } target="_blank" rel="noopener" class="event-editorial-btn">
								Lihat Lokasi <i class="bi bi-arrow-right"></i>
							</a>
						}
					</div>
				</div>
			</div>
		</section>

		<!-- GALLERY -->
		if len(data.Gallery) > 0 {
			<section class="section-mini-alt" id="section-gallery">
				<div class="container-wide">
					<div class="section-label" data-aos="fade-up">Gallery</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Momen<br/><em>terindah</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Kumpulan kenangan yang kami abadikan dalam perjalanan menuju hari bahagia
					</p>

					<div class="gallery-masonry">
						for index, img := range data.Gallery {
							<div class="gallery-masonry-item" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(60 * ((index % 6) + 1)) }>
								<img src={ img } alt={ "Foto " + invitation.FormatInt(index+1) } loading="lazy"/>
								<i class="bi bi-arrows-fullscreen"></i>
							</div>
						}
					</div>
				</div>
			</section>
		}

		<!-- RSVP -->
		<section class="section-mini" id="section-rsvp">
			<div class="container">
				<div class="section-label" data-aos="fade-up">RSVP</div>
				<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
					Konfirmasi<br/><em>kehadiran</em>
				</h2>
				<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
					Mohon konfirmasi kehadiran Anda untuk membantu kami mempersiapkan acara dengan lebih baik
				</p>

				@shared.RSVPForm(data, shared.RSVPTextIndonesia)

				@shared.RSVPListWrap()
			</div>
		</section>

		<!-- AMPLOP DIGITAL -->
		if data.ShouldShowBankAccounts() && len(data.BankAccounts) > 0 {
			<section class="section-mini-alt" id="section-bank">
				<div class="container">
					<div class="section-label" data-aos="fade-up">Wedding Gift</div>
					<h2 class="section-title" data-aos="fade-up" data-aos-delay="50">
						Amplop<br/><em>digital</em>
					</h2>
					<p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
						Doa restu Anda adalah hadiah terindah. Namun jika ingin memberi, kami sediakan
					</p>

					<div class="bank-mini-grid">
						for index, account := range data.BankAccounts {
							<div class="bank-mini-card" data-aos="fade-up" data-aos-delay={ invitation.FormatInt(80 * (index + 1)) }>
								<div class="bank-mini-logo">
									if invitation.HasCustomIcon(account) {
										<img src={ invitation.GetAccountIconURL(account) } alt={ invitation.GetAccountBankName(account) } loading="lazy"/>
									} else {
										<span class="initial">{ invitation.GetAccountInitial(account) }</span>
									}
								</div>
								<div class="bank-mini-name">{ invitation.GetAccountBankName(account) }</div>

								<div class="bank-mini-number" data-number={ invitation.GetAccountNumber(account) } onclick={ templpkg.JSFuncCall("copyBankNumberFromEl", templpkg.JSExpression("this")) }>
									<span>{ invitation.GetAccountNumber(account) }</span>
									<i class="bi bi-clipboard"></i>
								</div>

								<div class="bank-mini-holder">
									a.n. <strong>{ invitation.GetAccountName(account) }</strong>
								</div>
							</div>
						}
					</div>

					<p class="bank-mini-note" data-aos="fade-up">
						<i class="bi bi-info-circle me-1"></i>
						Ketuk nomor untuk menyalin
					</p>
				</div>
			</section>
		}

		<!-- FOOTER -->
		<footer class="footer-mini">
			<div class="footer-mini-couple">
				{ data.GroomName }<span class="amp">&amp;</span>{ data.BrideName }
			</div>
			<div class="footer-mini-divider"></div>
			<div class="footer-mini-date">{ data.AkadDate }</div>

			@shared.SocialLinks(data, shared.SocialLinksTextDefault)

			<p class="footer-mini-prayer">
				"Merupakan suatu kebahagiaan bagi kami apabila Anda berkenan hadir dan memberikan doa restu"
			</p>
		</footer>

		<!-- WEB FOOTER -->
		@shared.WebFooter(data, shared.WebFooterTextShort)

		<!-- SCRIPTS -->
		<script src="https://unpkg.com/aos@2.3.1/dist/aos.js">
			// Lock scroll saat overlay tampil
			document.addEventListener('DOMContentLoaded', function() {
				var overlay = document.getElementById('startOverlay');
				if (overlay && overlay.style.display !== 'none') {
					document.body.classList.add('overlay-active');
				}
			});
			</script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

		<script>
			AOS.init({
				duration: 900,
				easing: 'ease-out',
				once: true,
				mirror: false,
				offset: 60,
				disable: function() { return window.innerWidth < 480; }
			});
			window.addEventListener('resize', function() { AOS.refresh(); });

			// MUSIC PLAYER
			var musicUrl = document.body.dataset.musicUrl || '';
			var projectID = document.body.dataset.projectId || '';
			var projectSlug = document.body.dataset.projectSlug || '';
			var audio = null;
			var isPlaying = false;
			var hasStarted = false;
			var MUSIC_KEY = 'wedding_music_state_' + projectID;

			function initAudio() {
				if (!musicUrl) return false;
				if (audio) return true;
				audio = new Audio(musicUrl);
				audio.loop = true;
				audio.volume = 0.5;
				return true;
			}

			window.startMusic = function() {
				if (!initAudio()) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					closeOverlay();
					return;
				}
				audio.play().then(function() {
					isPlaying = true;
					hasStarted = true;
					var btn = document.getElementById('musicToggle');
					if (btn) {
						btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
						btn.classList.add('playing');
					}
					localStorage.setItem(MUSIC_KEY, 'playing');
					closeOverlay();
				}).catch(function(e) {
					console.log('Play failed:', e);
					closeOverlay();
					document.addEventListener('click', function retry() {
						audio.play().catch(function(){});
						document.removeEventListener('click', retry);
					}, { once: true });
				});
			};

			function closeOverlay() {
				var overlay = document.getElementById('startOverlay');
				if (overlay) {
					overlay.style.opacity = '0';
					setTimeout(function() {
						overlay.style.display = 'none';
					}, 800);
				}
				document.body.classList.remove('overlay-active');
				window.scrollTo(0, 0);
			}
			}

			window.toggleMusic = function() {
				if (!audio && musicUrl) initAudio();
				if (!audio) {
					showToast('info', 'Belum ada musik untuk undangan ini');
					return;
				}
				var btn = document.getElementById('musicToggle');
				if (isPlaying) {
					audio.pause();
					isPlaying = false;
					btn.innerHTML = '<i class="bi bi-music-note"></i>';
					btn.classList.remove('playing');
					localStorage.setItem(MUSIC_KEY, 'paused');
				} else {
					audio.play().catch(function(e) { console.log('Play blocked'); });
					isPlaying = true;
					btn.innerHTML = '<i class="bi bi-pause-fill"></i>';
					btn.classList.add('playing');
					localStorage.setItem(MUSIC_KEY, 'playing');
				}
			};

			document.getElementById('startOverlay')?.addEventListener('click', function(e) {
				startMusic();
			});
			document.getElementById('musicToggle')?.addEventListener('click', function(e) {
				if (!hasStarted) startMusic();
			});
			document.addEventListener('keydown', function(e) {
				if (e.key === ' ' && !hasStarted) { e.preventDefault(); startMusic(); }
			});

			window.scrollToOpening = function() {
				var el = document.getElementById('section-opening');
				if (el) el.scrollIntoView({ behavior: 'smooth' });
			};

			function showToast(type, message) {
				var container = document.querySelector('.toast-container');
				if (!container) {
					container = document.createElement('div');
					container.className = 'toast-container';
					document.body.appendChild(container);
				}
				var toast = document.createElement('div');
				toast.className = 'toast';
				var icons = { success: 'bi-check-circle-fill', error: 'bi-x-circle-fill', info: 'bi-info-circle-fill' };
				toast.innerHTML = '<i class="bi ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
				container.appendChild(toast);
				setTimeout(function() {
					toast.style.opacity = '0';
					toast.style.transform = 'translateX(100px)';
					setTimeout(function() { toast.remove(); }, 400);
				}, 3000);
			}

			function escapeHtml(text) {
				if (!text) return '';
				var div = document.createElement('div');
				div.textContent = text;
				return div.innerHTML;
			}

			window.copyBankNumberFromEl = function(el) {
				var number = el.getAttribute('data-number');
				if (!number) return;
				copyText(number, el);
			};

			function copyText(number, element) {
				var doSuccess = function() {
					showToast('success', 'Nomor rekening dicopy!');
					if (element) {
						var icon = element.querySelector('i');
						if (icon) {
							var original = icon.className;
							icon.className = 'bi bi-check-lg';
							icon.style.color = '#10b981';
							setTimeout(function() {
								icon.className = original;
								icon.style.color = '';
							}, 1500);
						}
					}
				};
				if (navigator.clipboard) {
					navigator.clipboard.writeText(number).then(doSuccess).catch(function() {
						fallbackCopy(number, element);
					});
				} else {
					fallbackCopy(number, element);
				}
			}

			function fallbackCopy(text, element) {
				var textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.appendChild(textarea);
				textarea.select();
				try {
					document.execCommand('copy');
					showToast('success', 'Nomor rekening dicopy!');
				} catch (err) {
					showToast('error', 'Gagal copy nomor');
				}
				document.body.removeChild(textarea);
			}

			// GALLERY LIGHTBOX
			document.addEventListener('DOMContentLoaded', function() {
				document.querySelectorAll('.gallery-masonry-item').forEach(function(item) {
					item.addEventListener('click', function() {
						var img = this.querySelector('img');
						if (img) {
							var lb = document.createElement('div');
							lb.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.94);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:20px;';
							lb.innerHTML = '<span style="position:absolute;top:20px;right:24px;color:#fff;font-size:2rem;cursor:pointer;opacity:0.7;">&times;</span><img src="' + img.src + '" style="max-width:92%;max-height:92%;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,0.5);"/>';
							document.body.appendChild(lb);
							lb.addEventListener('click', function(e) {
								if (e.target === this || e.target.textContent === '×') {
									this.remove();
								}
							});
						}
					});
				});
			});

			// LOAD RSVP LIST
			function loadRsvpList() {
				var listContainer = document.getElementById('rsvpList');
				var countContainer = document.getElementById('rsvpCount');
				if (!listContainer) return;

				fetch('/invitation/' + projectSlug + '/rsvp-list')
					.then(function(r) { return r.json(); })
					.then(function(data) {
						if (!data || data.length === 0) {
							listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-envelope"></i>Belum ada konfirmasi kehadiran</div>';
							if (countContainer) countContainer.textContent = '0 tamu';
							return;
						}
						var totalGuests = 0;
						var html = '';
						data.forEach(function(item) {
							var statusText = item.attendance === 'hadir' ? 'Hadir' : (item.attendance === 'tidak_hadir' ? 'Tidak Hadir' : 'Ragu');
							totalGuests += parseInt(item.total_guests || 1);
							var time = new Date(item.created_at);
							var timeStr = time.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
							var messageHtml = item.message ? '<div class="message">' + escapeHtml(item.message) + '</div>' : '';
							html += '<div class="rsvp-item"><div class="row-main"><span class="guest-name">' + escapeHtml(item.guest_name) + '</span><span class="status-badge ' + item.attendance + '">' + statusText + '</span></div><div class="row-detail"><div class="meta"><span><i class="bi bi-calendar"></i> ' + timeStr + '</span><span><i class="bi bi-people"></i> ' + (item.total_guests || 1) + ' org</span></div></div>' + messageHtml + '</div>';
						});
						listContainer.innerHTML = html;
						if (countContainer) countContainer.textContent = totalGuests + ' tamu';
					})
					.catch(function() {
						listContainer.innerHTML = '<div class="rsvp-empty"><i class="bi bi-exclamation-triangle"></i>Gagal memuat daftar konfirmasi<br><button onclick="loadRsvpList()" style="margin-top:12px; padding:8px 20px; background:var(--text); color:white; border:none; border-radius:2px; cursor:pointer; font-size:0.75rem; letter-spacing:1px; text-transform:uppercase;"><i class="bi bi-arrow-clockwise me-1"></i> Coba Lagi</button></div>';
					});
			}

			// SUBMIT RSVP
			document.addEventListener('DOMContentLoaded', function() {
				var form = document.getElementById('rsvpForm');
				if (!form) return;
				form.addEventListener('submit', function(e) {
					e.preventDefault();
					var formData = new FormData(form);
					var btn = form.querySelector('button[type="submit"]');
					var originalText = btn.innerHTML;
					btn.disabled = true;
					btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Mengirim...';
					fetch(form.action, { method: 'POST', body: formData })
						.then(function(r) { return r.json(); })
						.then(function(data) {
							if (data.success) {
								var isUpdate = data.updated === true;
								Swal.fire({
									title: isUpdate ? 'Konfirmasi Diperbarui!' : 'Terima Kasih!',
									text: data.message,
									icon: 'success',
									confirmButtonColor: '#4a5d4a',
									background: '#fafaf9',
									color: '#1c1917',
									timer: 2200,
									timerProgressBar: true,
									showConfirmButton: false
								});
								if (!isUpdate) form.reset();
								setTimeout(function() { loadRsvpList(); }, 500);
							} else {
								Swal.fire({
									title: 'Gagal!',
									text: data.message || 'Terjadi kesalahan',
									icon: 'error',
									confirmButtonColor: '#4a5d4a',
									background: '#fafaf9',
									color: '#1c1917'
								});
							}
						})
						.catch(function() {
							Swal.fire({
								title: 'Error!',
								text: 'Terjadi kesalahan, silakan coba lagi',
								icon: 'error',
								confirmButtonColor: '#4a5d4a',
								background: '#fafaf9',
								color: '#1c1917'
							});
						})
						.finally(function() {
							btn.disabled = false;
							btn.innerHTML = originalText;
						});
				});
				loadRsvpList();
			});
		</script>
	</body>
	</html>
}
