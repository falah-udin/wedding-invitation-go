package templates

import "wedding-invitation-go/internal/models"

// EditContent — form edit template
templ EditContent(tmpl models.Template, errorMsg string) {
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold" style="color: #8b5cf6;">Edit Template</h2>
			<p class="text-secondary m-0">Edit data template { tmpl.Name }</p>
		</div>
		<a href="/admin/templates" class="btn" style="background: #2a2a2a; border: 1px solid #3a3a3a; border-radius: 12px; padding: 8px 20px; color: #fff; text-decoration: none;">
			<i class="bi bi-arrow-left me-2"></i>Kembali
		</a>
	</div>

	if errorMsg != "" {
		<div class="alert alert-danger mb-3" style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 16px;">
			<i class="bi bi-exclamation-triangle me-2"></i>{ errorMsg }
		</div>
	}

	<div class="p-4" style="background: #1e1e1e; border-radius: 16px; border: 1px solid #2a2a2a;">
		<form method="POST" action={ templ.URL("/admin/templates/" + formatUint(tmpl.ID) + "/edit") } enctype="multipart/form-data">
			<div class="row g-4">
				<div class="col-12 col-md-6">
					<label class="form-label" style="color: #9ca3af;">Nama Template <span class="text-danger">*</span></label>
					<input type="text" name="name" value={ tmpl.Name } class="form-control-dark" required/>
				</div>

				<div class="col-12 col-md-6">
					<label class="form-label" style="color: #9ca3af;">Slug <span class="text-danger">*</span></label>
					<input type="text" name="slug" value={ tmpl.Slug } class="form-control-dark" required/>
				</div>

				<div class="col-12 col-md-6">
					<label class="form-label" style="color: #9ca3af;">Folder <span class="text-danger">*</span></label>
					<input type="text" name="folder" value={ tmpl.Folder } class="form-control-dark" required/>
				</div>

				<div class="col-12 col-md-6">
					<label class="form-label" style="color: #9ca3af;">Urutan Tampil</label>
					<input type="number" name="order" value={ formatInt(tmpl.Order) } class="form-control-dark" min="0"/>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Deskripsi</label>
					<textarea name="description" class="form-control-dark" rows="3">{ derefStr(tmpl.Description, "") }</textarea>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Thumbnail</label>
					if tmpl.Thumbnail != nil && *tmpl.Thumbnail != "" {
						<div class="mb-2">
							<img src={ *tmpl.Thumbnail } alt="Current" style="width: 120px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #2a2a2a;"/>
							<p style="color: #6b7280; font-size: 0.75rem; margin-top: 4px;">Thumbnail saat ini</p>
						</div>
					}
					<input type="file" name="thumbnail" class="form-control-dark" accept="image/*"/>
					<small style="color: #6b7280;">Biarkan kosong jika tidak ingin ganti thumbnail. Max 2MB.</small>
				</div>

				<div class="col-12">
					<button type="submit" class="btn" style="width:100%; background:#8b5cf6; border:none; border-radius:12px; padding:12px; color:white; font-weight:600;">
						<i class="bi bi-save me-2"></i>Update Template
					</button>
				</div>
			</div>
		</form>
	</div>
}
