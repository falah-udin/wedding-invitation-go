package settings

// IndexContent — form pengaturan situs
templ IndexContent(settings map[string]string, errorMsg string, successMsg string) {
	<div class="container-fluid">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<div>
				<h3 class="mb-1" style="color: #8b5cf6;">
					<i class="bi bi-gear-fill me-2"></i>Pengaturan Situs
				</h3>
				<p class="text-secondary mb-0">Kelola informasi footer, kontak, sosial media, favicon, dan PWA</p>
			</div>
		</div>

		if successMsg != "" {
			<div class="alert mb-3" style="background: rgba(16,185,129,0.1); border-left: 4px solid #10b981; color: #10b981; border-radius: 12px; padding: 12px 16px;">
				<i class="bi bi-check-circle-fill me-2"></i>{ successMsg }
			</div>
		}
		if errorMsg != "" {
			<div class="alert mb-3" style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 16px;">
				<i class="bi bi-exclamation-triangle-fill me-2"></i>{ errorMsg }
			</div>
		}

		<form method="POST" action="/admin/settings" enctype="multipart/form-data">
			<div class="row g-4">
				<!-- KONTAK -->
				<div class="col-lg-6">
					<div class="card-dark p-4 h-100">
						<h5 class="mb-3" style="color: #8b5cf6;">
							<i class="bi bi-envelope-at me-2"></i>Kontak
						</h5>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;">Email</label>
							<input type="email" name="contact_email" value={ settings["contact_email"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;">Telepon</label>
							<input type="text" name="contact_phone" value={ settings["contact_phone"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;">WhatsApp (angka saja)</label>
							<input type="text" name="contact_whatsapp" value={ settings["contact_whatsapp"] } class="form-control-dark"/>
						</div>
						<div class="mb-0">
							<label class="form-label" style="color: #9ca3af;">Alamat</label>
							<input type="text" name="contact_address" value={ settings["contact_address"] } class="form-control-dark"/>
						</div>
					</div>
				</div>

				<!-- SOSIAL MEDIA -->
				<div class="col-lg-6">
					<div class="card-dark p-4 h-100">
						<h5 class="mb-3" style="color: #8b5cf6;">
							<i class="bi bi-share me-2"></i>Sosial Media
						</h5>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;"><i class="bi bi-instagram me-1"></i>Instagram</label>
							<input type="url" name="social_instagram" value={ settings["social_instagram"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;"><i class="bi bi-facebook me-1"></i>Facebook</label>
							<input type="url" name="social_facebook" value={ settings["social_facebook"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;"><i class="bi bi-tiktok me-1"></i>TikTok</label>
							<input type="url" name="social_tiktok" value={ settings["social_tiktok"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;"><i class="bi bi-youtube me-1"></i>YouTube</label>
							<input type="url" name="social_youtube" value={ settings["social_youtube"] } class="form-control-dark"/>
						</div>
						<div class="mb-0">
							<label class="form-label" style="color: #9ca3af;"><i class="bi bi-twitter-x me-1"></i>Twitter</label>
							<input type="url" name="social_twitter" value={ settings["social_twitter"] } class="form-control-dark"/>
						</div>
					</div>
				</div>

				<!-- QRIS dengan 2 card preview -->
				<div class="col-lg-6">
					<div class="card-dark p-4 h-100">
						<h5 class="mb-3" style="color: #8b5cf6;">
							<i class="bi bi-qr-code me-2"></i>QRIS / Donasi
						</h5>
						<p style="color: #9ca3af; font-size: 0.85rem;">
							Upload gambar QRIS untuk ditampilkan di footer halaman home.
						</p>

						<div class="d-flex align-items-start gap-3 mb-3 flex-wrap">
							<!-- Card Saat Ini -->
							<div>
								<div style="font-size: 0.7rem; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px;">
									Saat Ini
								</div>
								<div style="width: 140px; height: 140px; background: #0f0f0f; border: 2px solid #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
									if settings["qris_image"] != "" {
										<img src={ "/storage/" + settings["qris_image"] } alt="QRIS saat ini" style="width: 100%; height: 100%; object-fit: contain; background: white;"/>
									} else {
										<i class="bi bi-qr-code text-secondary" style="font-size: 2rem; color: #4b5563;"></i>
									}
								</div>
								<div style="font-size: 0.65rem; color: #6b7280; margin-top: 4px; text-align: center;">
									if settings["qris_image"] != "" {
										Tersimpan
									} else {
										Belum ada
									}
								</div>
							</div>

							<!-- Arrow -->
							<div style="align-self: center; margin-top: 20px;">
								<i class="bi bi-arrow-right" style="color: #4b5563; font-size: 1.5rem;"></i>
							</div>

							<!-- Card Preview Baru -->
							<div>
								<div style="font-size: 0.7rem; color: #8b5cf6; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">
									Preview Baru
								</div>
								<div id="qris-new-box" style="width: 140px; height: 140px; background: #0f0f0f; border: 2px dashed #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: all 0.3s;">
									<div id="qris-new-placeholder" style="text-align: center; color: #6b7280;">
										<i class="bi bi-cloud-arrow-up" style="font-size: 1.5rem; display: block; margin-bottom: 2px;"></i>
										<span style="font-size: 0.6rem;">Pilih file</span>
									</div>
									<img id="qris-new-preview" src="" alt="Preview QRIS baru" style="width: 100%; height: 100%; object-fit: contain; display: none; background: white;"/>
								</div>
								<div id="qris-new-info" style="font-size: 0.65rem; color: #6b7280; margin-top: 4px; text-align: center; max-width: 140px; word-wrap: break-word;">
									Belum dipilih
								</div>
							</div>
						</div>

						<div class="mb-2">
							<input type="file" name="qris_image" id="qris_image_input" class="form-control-dark" accept=".png,.jpg,.jpeg,.webp" onchange="previewQris(this)"/>
						</div>
						<small style="color: #6b7280; display: block; margin-bottom: 8px;">Format: PNG, JPG, WebP. Max 2 MB. Disarankan rasio 1:1.</small>

						if settings["qris_image"] != "" {
							<button type="button" class="btn btn-sm" style="background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 6px 14px; font-size: 0.75rem;" onclick="confirmDeleteQris()">
								<i class="bi bi-trash me-1"></i>Hapus QRIS
							</button>
						}
					</div>
				</div>

				<!-- BRAND -->
				<div class="col-lg-6">
					<div class="card-dark p-4 h-100">
						<h5 class="mb-3" style="color: #8b5cf6;">
							<i class="bi bi-shop me-2"></i>Brand
						</h5>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;">Nama Situs</label>
							<input type="text" name="site_name" value={ settings["site_name"] } class="form-control-dark"/>
						</div>
						<div class="mb-3">
							<label class="form-label" style="color: #9ca3af;">Tagline</label>
							<input type="text" name="site_tagline" value={ settings["site_tagline"] } class="form-control-dark"/>
						</div>

						<!-- FAVICON dengan 2 card preview -->
						<div class="mb-0">
							<label class="form-label" style="color: #9ca3af;">
								<i class="bi bi-browser-chrome me-1"></i>Favicon
							</label>

							<div class="d-flex align-items-start gap-3 mb-3 flex-wrap">
								<!-- Card Saat Ini -->
								<div>
									<div style="font-size: 0.7rem; color: #6b7280; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px;">
										Saat Ini
									</div>
									<div style="width: 80px; height: 80px; background: #0f0f0f; border: 2px solid #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
										if settings["site_favicon"] != "" {
											<img src={ "/storage/" + settings["site_favicon"] } alt="Favicon saat ini" style="width: 100%; height: 100%; object-fit: contain;"/>
										} else {
											<i class="bi bi-image text-secondary" style="font-size: 1.5rem; color: #4b5563;"></i>
										}
									</div>
									<div style="font-size: 0.65rem; color: #6b7280; margin-top: 4px; text-align: center;">
										if settings["site_favicon"] != "" {
											Tersimpan
										} else {
											Belum ada
										}
									</div>
								</div>

								<!-- Arrow -->
								<div style="align-self: center; margin-top: 20px;">
									<i class="bi bi-arrow-right" style="color: #4b5563; font-size: 1.5rem;"></i>
								</div>

								<!-- Card Preview Baru -->
								<div>
									<div style="font-size: 0.7rem; color: #8b5cf6; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">
										Preview Baru
									</div>
									<div id="favicon-new-box" style="width: 80px; height: 80px; background: #0f0f0f; border: 2px dashed #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; transition: all 0.3s;">
										<div id="favicon-new-placeholder" style="text-align: center; color: #6b7280;">
											<i class="bi bi-cloud-arrow-up" style="font-size: 1.5rem; display: block; margin-bottom: 2px;"></i>
											<span style="font-size: 0.6rem;">Pilih file</span>
										</div>
										<img id="favicon-new-preview" src="" alt="Preview favicon baru" style="width: 100%; height: 100%; object-fit: contain; display: none;"/>
									</div>
									<div id="favicon-new-info" style="font-size: 0.65rem; color: #6b7280; margin-top: 4px; text-align: center; max-width: 80px; word-wrap: break-word;">
										Belum dipilih
									</div>
								</div>
							</div>

							<div class="mb-2">
								<input type="file" name="site_favicon" id="site_favicon_input" class="form-control-dark" accept=".png,.jpg,.jpeg,.ico,.svg,.webp" onchange="previewFavicon(this)"/>
							</div>
							<small style="color: #6b7280; display: block; margin-bottom: 8px;">Format: PNG, JPG, ICO, SVG, WebP. Max 512 KB. Ukuran ideal: 32×32 atau 64×64 px.</small>

							if settings["site_favicon"] != "" {
								<button type="button" class="btn btn-sm" style="background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 6px 14px; font-size: 0.75rem;" onclick="confirmDeleteFavicon()">
									<i class="bi bi-trash me-1"></i>Hapus Favicon
								</button>
							}
						</div>
					</div>
				</div>

				<!-- DEVELOPER -->
				<div class="col-lg-12">
					<div class="card-dark p-4">
						<h5 class="mb-3" style="color: #8b5cf6;">
							<i class="bi bi-code-slash me-2"></i>Developer
						</h5>
						<div class="row g-3">
							<div class="col-md-4">
								<label class="form-label" style="color: #9ca3af;">Nama</label>
								<input type="text" name="developer_name" value={ settings["developer_name"] } class="form-control-dark"/>
							</div>
							<div class="col-md-4">
								<label class="form-label" style="color: #9ca3af;">Email</label>
								<input type="email" name="developer_email" value={ settings["developer_email"] } class="form-control-dark"/>
							</div>
							<div class="col-md-4">
								<label class="form-label" style="color: #9ca3af;">Website</label>
								<input type="url" name="developer_url" value={ settings["developer_url"] } class="form-control-dark"/>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- FOOTER -->
			<div class="mt-4 col-lg-12">
				<div class="card-dark p-4 h-100">
					<h5 class="mb-3" style="color: #8b5cf6;">
						<i class="bi bi-layout-text-window-reverse me-2"></i>Footer
					</h5>
					<div class="mb-3">
						<label class="form-label" style="color: #9ca3af;">Deskripsi Footer</label>
						<textarea name="footer_description" class="form-control-dark" rows="3">{ settings["footer_description"] }</textarea>
					</div>
					<div class="mb-3">
						<label class="form-label" style="color: #9ca3af;">Copyright</label>
						<input type="text" name="footer_copyright" value={ settings["footer_copyright"] } class="form-control-dark"/>
					</div>
					<div class="mb-0">
						<label class="form-label" style="color: #9ca3af;">Versi</label>
						<input type="text" name="footer_version" value={ settings["footer_version"] } class="form-control-dark" placeholder="v1.0.0"/>
					</div>
				</div>
			</div>
			
			<!-- PWA -->
			<div class="mt-4 col-lg-12">
				<div class="card-dark p-4">
					<h5 class="mb-3" style="color: #8b5cf6;">
						<i class="bi bi-phone me-2"></i>PWA (Progressive Web App)
					</h5>
					<p style="color: #9ca3af; font-size: 0.85rem;">
						Pengaturan untuk install aplikasi ke home screen HP. Kalau icon PWA tidak diupload, otomatis pakai favicon.
					</p>

					<div class="row g-3 mb-3">
						<div class="col-md-4">
							<label class="form-label" style="color: #9ca3af;">Nama Pendek</label>
							<input type="text" name="pwa_short_name" value={ settings["pwa_short_name"] } class="form-control-dark" maxlength="12" placeholder="Wedding"/>
							<small style="color: #6b7280;">Max 12 karakter</small>
						</div>
						<div class="col-md-4">
							<label class="form-label" style="color: #9ca3af;">Theme Color</label>
							if settings["pwa_theme_color"] != "" {
								<input type="color" name="pwa_theme_color" value={ settings["pwa_theme_color"] } class="form-control-dark" style="height: 44px; padding: 4px;"/>
							} else {
								<input type="color" name="pwa_theme_color" value="#8b5cf6" class="form-control-dark" style="height: 44px; padding: 4px;"/>
							}
						</div>
						<div class="col-md-4">
							<label class="form-label" style="color: #9ca3af;">Background Color</label>
							if settings["pwa_background_color"] != "" {
								<input type="color" name="pwa_background_color" value={ settings["pwa_background_color"] } class="form-control-dark" style="height: 44px; padding: 4px;"/>
							} else {
								<input type="color" name="pwa_background_color" value="#0f0f0f" class="form-control-dark" style="height: 44px; padding: 4px;"/>
							}
						</div>
					</div>

					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label" style="color: #9ca3af;">
								<i class="bi bi-image me-1"></i>Icon 192×192
							</label>
							<div class="d-flex align-items-center gap-3 mb-2">
								<div style="width: 96px; height: 96px; background: #0f0f0f; border: 2px solid #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
									if settings["pwa_icon_192"] != "" {
										<img src={ "/storage/" + settings["pwa_icon_192"] } alt="Icon 192" style="width: 100%; height: 100%; object-fit: contain;"/>
									} else {
										<i class="bi bi-image text-secondary" style="font-size: 1.5rem; color: #4b5563;"></i>
									}
								</div>
								<div style="flex: 1;">
									<input type="file" name="pwa_icon_192" class="form-control-dark" accept=".png,.jpg,.jpeg,.webp"/>
									<small style="color: #6b7280;">PNG/JPG/WebP. Max 1 MB. 192×192 px.</small>
								</div>
							</div>
							if settings["pwa_icon_192"] != "" {
								<button type="button" class="btn btn-sm" style="background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 6px 14px; font-size: 0.75rem;" onclick="confirmDeletePwaIcon('192')">
									<i class="bi bi-trash me-1"></i>Hapus Icon 192
								</button>
							}
						</div>

						<div class="col-md-6">
							<label class="form-label" style="color: #9ca3af;">
								<i class="bi bi-image me-1"></i>Icon 512×512
							</label>
							<div class="d-flex align-items-center gap-3 mb-2">
								<div style="width: 96px; height: 96px; background: #0f0f0f; border: 2px solid #2a2a2a; border-radius: 12px; display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0;">
									if settings["pwa_icon_512"] != "" {
										<img src={ "/storage/" + settings["pwa_icon_512"] } alt="Icon 512" style="width: 100%; height: 100%; object-fit: contain;"/>
									} else {
										<i class="bi bi-image text-secondary" style="font-size: 1.5rem; color: #4b5563;"></i>
									}
								</div>
								<div style="flex: 1;">
									<input type="file" name="pwa_icon_512" class="form-control-dark" accept=".png,.jpg,.jpeg,.webp"/>
									<small style="color: #6b7280;">PNG/JPG/WebP. Max 1 MB. 512×512 px.</small>
								</div>
							</div>
							if settings["pwa_icon_512"] != "" {
								<button type="button" class="btn btn-sm" style="background: rgba(239,68,68,0.1); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); border-radius: 8px; padding: 6px 14px; font-size: 0.75rem;" onclick="confirmDeletePwaIcon('512')">
									<i class="bi bi-trash me-1"></i>Hapus Icon 512
								</button>
							}
						</div>
					</div>

					<div class="mt-3 p-3" style="background: rgba(59,130,246,0.08); border-left: 3px solid #3b82f6; border-radius: 8px;">
						<small style="color: #93c5fd;">
							<i class="bi bi-info-circle me-1"></i>
							Setelah upload, buka <code style="color: #93c5fd;">/manifest.webmanifest</code> untuk verifikasi. Cek juga DevTools → Application → Manifest.
						</small>
					</div>
				</div>
			</div>
			
			<div class="mt-4 d-flex justify-content-end gap-2">
				<a href="/admin/dashboard" class="btn" style="background:#2a2a2a; color:white; border:none; padding:10px 24px; border-radius:12px; text-decoration:none;">Batal</a>
				<button type="submit" class="btn-primary-custom">
					<i class="bi bi-save me-2"></i>Simpan Pengaturan
				</button>
			</div>
		</form>

		<!-- Hidden forms untuk delete -->
		if settings["site_favicon"] != "" {
			<form id="deleteFaviconForm" action="/admin/settings/delete-favicon" method="POST" style="display:none;">
				<input type="hidden" name="_method" value="DELETE"/>
			</form>
		}
		
		if settings["qris_image"] != "" {
			<form id="deleteQrisForm" action="/admin/settings/delete-qris" method="POST" style="display:none;">
				<input type="hidden" name="_method" value="DELETE"/>
			</form>
		}

		<form id="deletePwaIconForm" action="/admin/settings/delete-pwa-icon" method="POST" style="display:none;">
			<input type="hidden" name="size" id="deletePwaIconSize" value=""/>
		</form>

		<!-- JavaScript untuk preview -->
		<script>

			function confirmDeletePwaIcon(size) {
				if (confirm('Yakin hapus icon PWA ' + size + '×' + size + '?')) {
					document.getElementById('deletePwaIconSize').value = size;
					document.getElementById('deletePwaIconForm').submit();
				}
			}

			function previewFavicon(input) {
				const file = input.files[0];
				const previewImg = document.getElementById('favicon-new-preview');
				const placeholder = document.getElementById('favicon-new-placeholder');
				const infoText = document.getElementById('favicon-new-info');
				const newBox = document.getElementById('favicon-new-box');

				if (!file) {
					resetFaviconPreview();
					return;
				}

				// Validasi ukuran (512KB)
				if (file.size > 512 * 1024) {
					alert('File terlalu besar! Maksimal 512 KB. Ukuran Anda: ' + (file.size / 1024).toFixed(1) + ' KB');
					input.value = '';
					resetFaviconPreview();
					return;
				}

				// Validasi ekstensi
				const allowed = ['png', 'jpg', 'jpeg', 'ico', 'svg', 'webp'];
				const ext = file.name.split('.').pop().toLowerCase();
				if (!allowed.includes(ext)) {
					alert('Format tidak didukung! Gunakan: PNG, JPG, ICO, SVG, WebP');
					input.value = '';
					resetFaviconPreview();
					return;
				}

				const reader = new FileReader();
				reader.onload = function(e) {
					previewImg.src = e.target.result;
					previewImg.style.display = 'block';
					placeholder.style.display = 'none';

					const sizeKB = (file.size / 1024).toFixed(1);
					const fileName = file.name.length > 15 ? file.name.substring(0, 12) + '...' : file.name;
					infoText.innerHTML = '<span style="color: #10b981;">✅ ' + fileName + '</span><br><span style="color: #6b7280;">' + sizeKB + ' KB</span>';
					newBox.style.borderColor = '#10b981';
					newBox.style.borderStyle = 'solid';
					newBox.style.background = 'rgba(16, 185, 129, 0.05)';
				};
				reader.readAsDataURL(file);
			}

			function resetFaviconPreview() {
				document.getElementById('favicon-new-preview').src = '';
				document.getElementById('favicon-new-preview').style.display = 'none';
				document.getElementById('favicon-new-placeholder').style.display = 'block';
				document.getElementById('favicon-new-info').innerHTML = 'Belum dipilih';
				const box = document.getElementById('favicon-new-box');
				box.style.borderColor = '#2a2a2a';
				box.style.borderStyle = 'dashed';
				box.style.background = '#0f0f0f';
			}

			function previewQris(input) {
				const file = input.files[0];
				const previewImg = document.getElementById('qris-new-preview');
				const placeholder = document.getElementById('qris-new-placeholder');
				const infoText = document.getElementById('qris-new-info');
				const newBox = document.getElementById('qris-new-box');

				if (!file) {
					resetQrisPreview();
					return;
				}

				// Validasi ukuran (2MB)
				if (file.size > 2 * 1024 * 1024) {
					alert('File terlalu besar! Maksimal 2 MB. Ukuran Anda: ' + (file.size / 1024 / 1024).toFixed(2) + ' MB');
					input.value = '';
					resetQrisPreview();
					return;
				}

				// Validasi ekstensi
				const allowed = ['png', 'jpg', 'jpeg', 'webp'];
				const ext = file.name.split('.').pop().toLowerCase();
				if (!allowed.includes(ext)) {
					alert('Format tidak didukung! Gunakan: PNG, JPG, WebP');
					input.value = '';
					resetQrisPreview();
					return;
				}

				const reader = new FileReader();
				reader.onload = function(e) {
					previewImg.src = e.target.result;
					previewImg.style.display = 'block';
					placeholder.style.display = 'none';

					const sizeKB = (file.size / 1024).toFixed(1);
					const fileName = file.name.length > 20 ? file.name.substring(0, 17) + '...' : file.name;
					infoText.innerHTML = '<span style="color: #10b981;">✅ ' + fileName + '</span><br><span style="color: #6b7280;">' + sizeKB + ' KB</span>';
					newBox.style.borderColor = '#8b5cf6';
					newBox.style.borderStyle = 'solid';
					newBox.style.background = 'rgba(139, 92, 246, 0.05)';
				};
				reader.readAsDataURL(file);
			}

			function resetQrisPreview() {
				document.getElementById('qris-new-preview').src = '';
				document.getElementById('qris-new-preview').style.display = 'none';
				document.getElementById('qris-new-placeholder').style.display = 'block';
				document.getElementById('qris-new-info').innerHTML = 'Belum dipilih';
				const box = document.getElementById('qris-new-box');
				box.style.borderColor = '#2a2a2a';
				box.style.borderStyle = 'dashed';
				box.style.background = '#0f0f0f';
			}

			function confirmDeleteFavicon() {
				if (confirm('Yakin hapus favicon? Favicon akan diganti dengan default.')) {
					document.getElementById('deleteFaviconForm').submit();
				}
			}

			function confirmDeleteQris() {
				if (confirm('Yakin hapus QRIS? QRIS tidak akan muncul di footer.')) {
					document.getElementById('deleteQrisForm').submit();
				}
			}
		</script>
	</div>
}
