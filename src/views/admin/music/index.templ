package music

import "wedding-invitation-go/internal/models"

// IndexContent — list semua music
templ IndexContent(musics []models.Music) {
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
		<div>
			<h2 class="fw-bold" style="color: #8b5cf6;">
				<i class="bi bi-music-note-beamed me-2"></i>Gudang Musik
			</h2>
			<p class="text-secondary m-0">Kelola musik latar untuk undangan</p>
		</div>
		<a href="/admin/music/create" class="btn-primary-custom">
			<i class="bi bi-plus-lg me-2"></i>Upload Musik
		</a>
	</div>

	<div style="background: #1e1e1e; border-radius: 20px; border: 1px solid #2a2a2a; overflow: hidden;">
		<div class="table-responsive">
			<table class="table table-hover mb-0">
				<thead>
					<tr>
						<th class="ps-3 py-3" style="color: #8b5cf6;">ID</th>
						<th class="py-3" style="color: #8b5cf6;">Judul</th>
						<th class="d-none d-md-table-cell py-3" style="color: #8b5cf6;">Artis</th>
						<th class="d-none d-md-table-cell py-3" style="color: #8b5cf6;">Uploader</th>
						<th class="py-3" style="color: #8b5cf6;">Status</th>
						<th class="text-center py-3" style="color: #8b5cf6;">Preview &amp; Aksi</th>
					</tr>
				</thead>
				<tbody>
					if len(musics) > 0 {
						for _, m := range musics {
							<tr id={ "music-row-" + formatUint(m.ID) } style="border-bottom: 1px solid #2a2a2a;">
								<td class="ps-3 py-3" style="color: white;">{ formatUint(m.ID) }</td>
								<td class="py-3" style="color: white;">{ m.Title }</td>
								<td class="d-none d-md-table-cell py-3" style="color: #9ca3af;">{ derefStr(m.Artist, "-") }</td>
								<td class="d-none d-md-table-cell py-3" style="color: #9ca3af;">
									if m.User != nil {
										{ m.User.Name }
									} else {
										<span style="color:#6b7280;">-</span>
									}
								</td>
								<td class="py-3">
									if m.IsShared {
										<span class="badge" style="background: #10b981; padding: 6px 12px; border-radius: 20px;">Publik</span>
									} else {
										<span class="badge" style="background: #6b7280; padding: 6px 12px; border-radius: 20px;">Private</span>
									}
								</td>
								<td class="text-center py-3">
									<div class="d-flex gap-2 justify-content-center align-items-center">
										<audio controls style="height: 32px; width: 140px;">
											<source src={ m.FilePath } type="audio/mpeg"/>
										</audio>
										<a href={ templ.URL("/admin/music/" + formatUint(m.ID) + "/toggle") } class="btn btn-sm" style="background: #f59e0b; color: #1a1a1a; border-radius: 8px;" title="Toggle Status">
											<i class="bi bi-arrow-repeat"></i>
										</a>
										<form action={ templ.URL("/admin/music/" + formatUint(m.ID) + "/delete") } method="POST" class="d-inline" onsubmit="return confirm('Yakin hapus musik ini?')">
											<button type="submit" class="btn btn-sm" style="background: #ef4444; color: white; border-radius: 8px;">
												<i class="bi bi-trash"></i>
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="6" class="text-center py-5" style="color:#6b7280;">
								<i class="bi bi-inbox fs-3 d-block mb-2"></i>
								Belum ada musik. Upload musik pertama Anda!
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
