package music

// CreateContent — form upload musik
templ CreateContent(errorMsg string) {
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold" style="color: #8b5cf6;">Upload Musik</h2>
			<p class="text-secondary m-0">Upload musik dari komputer</p>
		</div>
		<a href="/admin/music" class="btn" style="background: #2a2a2a; border: 1px solid #3a3a3a; border-radius: 12px; padding: 8px 20px; color: #fff; text-decoration: none;">
			<i class="bi bi-arrow-left me-2"></i>Kembali ke Library
		</a>
	</div>

	if errorMsg != "" {
		<div class="alert alert-danger mb-3" style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 16px;">
			<i class="bi bi-exclamation-triangle me-2"></i>{ errorMsg }
		</div>
	}

	<div style="background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 12px; padding: 12px 16px; margin-bottom: 20px; display: flex; gap: 10px; align-items: flex-start;">
		<i class="bi bi-exclamation-triangle-fill" style="color: #f59e0b; font-size: 1.1rem; margin-top: 2px;"></i>
		<div style="color: #fbbf24; font-size: 0.85rem; line-height: 1.5;">
			<strong>Perhatian:</strong> Format didukung: <strong>MP3, WAV, OGG</strong>. Ukuran maksimal <strong>2 MB</strong>. Kalau file lebih besar, silakan compress dulu di <a href="https://www.123apps.com/id/audio-converter/" target="_blank" style="color: #8b5cf6; text-decoration: underline;">123apps.com</a>.
		</div>
	</div>

	<div style="background: #1e1e1e; border-radius: 20px; border: 1px solid #2a2a2a; padding: 30px;">
		<form method="POST" action="/admin/music/create" enctype="multipart/form-data">
			<div class="row g-4">
				<div class="col-12">
					<label class="form-label" style="color: #d1d5db;">File Musik <span class="text-danger">*</span></label>
					<input type="file" name="music_file" id="musicFileInput" class="form-control-dark" accept=".mp3,.wav,.ogg" required/>
					<small style="color: #6b7280; display: block; margin-top: 6px;">
						<i class="bi bi-info-circle me-1"></i>Format: MP3, WAV, OGG • Maksimal 10MB
					</small>
					<div id="fileInfo" style="display:none; margin-top: 10px; padding: 10px 14px; background: #0f0f0f; border: 1px solid #2a2a2a; border-radius: 10px; font-size: 0.8rem;">
						<div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
							<div style="color: #d1d5db; display: flex; align-items: center; gap: 6px; min-width: 0; flex: 1;">
								<i class="bi bi-file-earmark-music" style="color: #8b5cf6;"></i>
								<span id="fileName" style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"></span>
							</div>
							<div id="fileSize" style="color: #9ca3af; font-weight: 600; white-space: nowrap;"></div>
						</div>
					</div>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #d1d5db;">Judul Lagu <span class="text-danger">*</span></label>
					<input type="text" name="title" class="form-control-dark" placeholder="Contoh: My Love" required/>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #d1d5db;">Nama Artis</label>
					<input type="text" name="artist" class="form-control-dark" placeholder="Contoh: John Doe"/>
				</div>

				<div class="col-12">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" name="is_shared" id="isShared" value="1" checked/>
						<label class="form-check-label" for="isShared" style="color: #d1d5db;">
							Bagikan ke semua user (Publik)
						</label>
					</div>
				</div>

				<div class="col-12">
					<button type="submit" class="btn" style="width:100%; background:#8b5cf6; border:none; border-radius:12px; padding:12px; color:white; font-weight:600;">
						<i class="bi bi-cloud-upload me-2"></i>Upload Musik
					</button>
				</div>
			</div>
		</form>
	</div>

	<script>
		document.getElementById('musicFileInput').addEventListener('change', function(e) {
			const file = this.files[0];
			const fileInfo = document.getElementById('fileInfo');
			const fileName = document.getElementById('fileName');
			const fileSize = document.getElementById('fileSize');

			if (!file) {
				fileInfo.style.display = 'none';
				return;
			}

			fileName.textContent = file.name;

			const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
			fileSize.textContent = sizeMB + ' MB';

			if (file.size > 10 * 1024 * 1024) {
				fileSize.style.color = '#ef4444';
				fileSize.textContent = sizeMB + ' MB ⚠️';
				fileInfo.style.borderColor = '#ef4444';
				fileInfo.style.background = 'rgba(239, 68, 68, 0.05)';
			} else {
				fileSize.style.color = '#10b981';
				fileInfo.style.borderColor = '#2a2a2a';
				fileInfo.style.background = '#0f0f0f';
			}

			fileInfo.style.display = 'block';
		});
	</script>
}
