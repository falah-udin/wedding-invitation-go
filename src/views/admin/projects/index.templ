package projects

import (
	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/models"
)

// IndexContent — list project dengan filter + modal aksi
templ IndexContent(
	projects []models.Project,
	templates []models.Template,
	search string,
	statusFilter string,
	templateFilter string,
	totalProjects int64,
	totalDraft int64,
	totalPublished int64,
	totalArchived int64,
	totalViews int64,
	totalRsvp int64,
) {
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
		<div>
			<h2 class="fw-bold" style="color: #8b5cf6;">
				<i class="bi bi-envelope-paper me-2"></i>Proyek Undangan
			</h2>
			<p class="text-secondary m-0">Kelola semua proyek undangan dari client</p>
		</div>
		<a href="/invitation/create/select-client" class="btn-primary-custom">
			<i class="bi bi-plus-circle me-2"></i>Buat Undangan
		</a>
	</div>

	<!-- STATS -->
	<div class="row g-3 mb-4">
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #8b5cf6;">{ formatInt(int(totalProjects)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">Total</small>
			</div>
		</div>
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #f59e0b;">{ formatInt(int(totalDraft)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">Draft</small>
			</div>
		</div>
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #10b981;">{ formatInt(int(totalPublished)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">Published</small>
			</div>
		</div>
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #6b7280;">{ formatInt(int(totalArchived)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">Archived</small>
			</div>
		</div>
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #8b5cf6;">{ formatInt(int(totalViews)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">Views</small>
			</div>
		</div>
		<div class="col-6 col-md-2">
			<div class="p-3 text-center" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<h5 class="mb-1" style="color: #ec489a;">{ formatInt(int(totalRsvp)) }</h5>
				<small style="color: #9ca3af; font-size: 0.75rem;">RSVP</small>
			</div>
		</div>
	</div>

	<!-- FILTER -->
	<div class="mb-4 p-3" style="background: #1e1e1e; border-radius: 16px; border: 1px solid #2a2a2a;">
		<form method="GET" action="/admin/projects" class="row g-3 align-items-end">
			<div class="col-12 col-md-4">
				<label class="form-label small" style="color: #9ca3af;">Cari</label>
				<input type="text" name="search" value={ search } placeholder="Judul atau nama client..." class="form-control-dark"/>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small" style="color: #9ca3af;">Status</label>
				<select name="status" class="form-control-dark">
					<option value="">Semua</option>
					<option value="draft" selected?={ statusFilter == "draft" }>Draft</option>
					<option value="published" selected?={ statusFilter == "published" }>Published</option>
					<option value="archived" selected?={ statusFilter == "archived" }>Archived</option>
				</select>
			</div>
			<div class="col-6 col-md-2">
				<label class="form-label small" style="color: #9ca3af;">Template</label>
				<select name="template_id" class="form-control-dark">
					<option value="">Semua</option>
					for _, t := range templates {
						<option value={ formatUint(t.ID) } selected?={ templateFilter == formatUint(t.ID) }>{ t.Name }</option>
					}
				</select>
			</div>
			<div class="col-6 col-md-2">
				<button type="submit" class="btn" style="width:100%; background:#8b5cf6; border:none; border-radius:10px; padding:8px; color:white; font-weight:600;">
					<i class="bi bi-search me-1"></i> Filter
				</button>
			</div>
			<div class="col-6 col-md-2">
				<a href="/admin/projects" class="btn" style="width:100%; background:#2a2a2a; border:none; border-radius:10px; padding:8px; color:white; font-weight:600; text-decoration:none; display:inline-block; text-align:center;">
					<i class="bi bi-arrow-repeat me-1"></i> Reset
				</a>
			</div>
		</form>
	</div>

	<!-- TABLE (Desktop) -->
	<div class="d-none d-md-block" style="background: #1e1e1e; border-radius: 20px; border: 1px solid #2a2a2a; overflow: visible;">
		<div class="table-responsive" style="border-radius: 20px;">
			<table class="table table-hover mb-0" style="min-width: 900px;">
				<thead>
					<tr>
						<th class="ps-3 py-3" style="color: #8b5cf6;">ID</th>
						<th class="py-3" style="color: #8b5cf6;">Judul</th>
						<th class="py-3" style="color: #8b5cf6;">Client</th>
						<th class="py-3" style="color: #8b5cf6;">Template</th>
						<th class="py-3" style="color: #8b5cf6;">Status</th>
						<th class="py-3" style="color: #8b5cf6;">Views</th>
						<th class="py-3" style="color: #8b5cf6;">RSVP</th>
						<th class="py-3" style="color: #8b5cf6;">Dibuat</th>
						<th class="text-center pe-3 py-3" style="color: #8b5cf6;">Aksi</th>
					</tr>
				</thead>
				<tbody>
					if len(projects) > 0 {
						for _, project := range projects {
							<tr style="border-bottom: 1px solid #2a2a2a;">
								<td class="ps-3 py-3" style="color: #6b7280;">#{ formatUint(project.ID) }</td>
								<td class="py-3">
									<div style="color:white; font-weight:600;">{ project.Title }</div>
									<small style="color:#6b7280; font-size:0.7rem;">{ project.Slug }</small>
								</td>
								<td class="py-3">
									if project.User != nil {
										<div style="color:white;">{ project.User.Name }</div>
										<small style="color:#6b7280; font-size:0.7rem;">{ project.User.Email }</small>
									}
								</td>
								<td class="py-3">
									if project.Template != nil {
										<span class="badge" style="background:#3b82f6; font-size:0.7rem;">{ project.Template.Name }</span>
									}
								</td>
								<td class="py-3">
									if project.Status == "published" {
										<span class="badge" style="background:#10b981; font-size:0.7rem;">Published</span>
									} else if project.Status == "draft" {
										<span class="badge" style="background:#f59e0b; color:#1a1a1a; font-size:0.7rem;">Draft</span>
									} else {
										<span class="badge" style="background:#6b7280; font-size:0.7rem;">Archived</span>
									}
								</td>
								<td class="py-3">
									<i class="bi bi-eye me-1" style="color:#8b5cf6;"></i>
									<span>{ formatInt(project.TotalViews) }</span>
								</td>
								<td class="py-3">
									<i class="bi bi-envelope-check me-1" style="color:#ec489a;"></i>
									<span>{ formatInt(project.TotalRsvp) }</span>
								</td>
								<td class="py-3" style="color:#6b7280; font-size:0.75rem;">
									{ formatDate(project.CreatedAt) }
								</td>
								<td class="text-center pe-3 py-3">
									<div class="d-flex gap-1 justify-content-center align-items-center">
										<!-- Tombol Salin Link (hanya kalau published) -->
										if project.Status == "published" {
											<button type="button" onclick={ templpkg.JSFuncCall("copyInvitationLink", "/invitation/"+project.Slug, project.Title) } class="btn btn-sm" style="background:#10b981; color:white; border-radius:8px;" title="Salin Link">
												<i class="bi bi-clipboard"></i>
											</button>
										}

										<!-- Tombol Aksi (buka modal) -->
										<button type="button" onclick={ templpkg.JSFuncCall("openActionModal",
											formatUint(project.ID),
											project.Title,
											project.Slug,
											project.Status,
											formatInt(int(project.TotalRsvp)),
										) } class="btn btn-sm" style="background:#2a2a2a; color:white; border-radius:8px;" title="Aksi">
											<i class="bi bi-grid-3x3-gap-fill"></i>
										</button>
									</div>
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="9" class="text-center py-5" style="color:#6b7280;">
								<i class="bi bi-inbox fs-3 d-block mb-2"></i>
								Belum ada project
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- CARD LIST (Mobile) -->
	<div class="d-md-none">
		if len(projects) > 0 {
			<div class="d-flex flex-column gap-3">
				for _, project := range projects {
					<div style="background:#1e1e1e; border-radius:16px; border:1px solid #2a2a2a; padding:16px;">
						<!-- Header -->
						<div class="d-flex justify-content-between align-items-start mb-3">
							<div style="flex:1; min-width:0;">
								<div style="color:white; font-weight:700; font-size:1rem; word-break:break-word;">
									{ project.Title }
								</div>
								<small style="color:#6b7280; font-size:0.7rem; word-break:break-all;">
									#{ formatUint(project.ID) } • { project.Slug }
								</small>
							</div>
							<span class="ms-2 flex-shrink-0">
								if project.Status == "published" {
									<span class="badge" style="background:#10b981; font-size:0.65rem;">Published</span>
								} else if project.Status == "draft" {
									<span class="badge" style="background:#f59e0b; color:#1a1a1a; font-size:0.65rem;">Draft</span>
								} else {
									<span class="badge" style="background:#6b7280; font-size:0.65rem;">Archived</span>
								}
							</span>
						</div>

						<!-- Info -->
						<div class="d-flex flex-column gap-2 mb-3" style="font-size:0.8rem;">
							<div class="d-flex justify-content-between">
								<span style="color:#9ca3af;">Client</span>
								<span style="color:white; text-align:right; margin-left:8px; word-break:break-word;">
									if project.User != nil {
										{ project.User.Name }
									} else {
										Unknown
									}
								</span>
							</div>
							<div class="d-flex justify-content-between">
								<span style="color:#9ca3af;">Template</span>
								<span style="text-align:right; margin-left:8px;">
									if project.Template != nil {
										<span class="badge" style="background:#3b82f6; font-size:0.65rem;">{ project.Template.Name }</span>
									} else {
										<span style="color:#6b7280;">-</span>
									}
								</span>
							</div>
							<div class="d-flex justify-content-between">
								<span style="color:#9ca3af;">Views</span>
								<span style="color:white;">
									<i class="bi bi-eye me-1" style="color:#8b5cf6;"></i>{ formatInt(project.TotalViews) }
								</span>
							</div>
							<div class="d-flex justify-content-between">
								<span style="color:#9ca3af;">RSVP</span>
								<span style="color:white;">
									<i class="bi bi-envelope-check me-1" style="color:#ec489a;"></i>{ formatInt(project.TotalRsvp) }
								</span>
							</div>
							<div class="d-flex justify-content-between">
								<span style="color:#9ca3af;">Dibuat</span>
								<span style="color:white;">{ formatDate(project.CreatedAt) }</span>
							</div>
						</div>

						<!-- Aksi -->
						<div class="row g-2">
							<div class="col-6">
								if project.Status == "published" {
									<button type="button"
									        onclick={ templpkg.JSFuncCall("copyInvitationLink", "/invitation/"+project.Slug, project.Title) }
									        class="btn w-100"
									        style="background:rgba(16,185,129,0.1); color:#10b981; border:1px solid rgba(16,185,129,0.3); border-radius:8px; padding:8px; font-size:0.78rem; font-weight:600;">
										<i class="bi bi-clipboard me-1"></i> Salin
									</button>
								} else {
									<button type="button" disabled
									        class="btn w-100"
									        style="background:#1a1a1a; color:#4b5563; border:1px solid #2a2a2a; border-radius:8px; padding:8px; font-size:0.78rem; font-weight:600;">
										<i class="bi bi-clipboard me-1"></i> Salin
									</button>
								}
							</div>
							<div class="col-6">
								<button type="button"
								        onclick={ templpkg.JSFuncCall("openActionModal",
								            formatUint(project.ID),
								            project.Title,
								            project.Slug,
								            project.Status,
								            formatInt(int(project.TotalRsvp)),
								        ) }
								        class="btn w-100"
								        style="background:#8b5cf6; color:white; border:none; border-radius:8px; padding:8px; font-size:0.78rem; font-weight:600;">
									<i class="bi bi-lightning-charge-fill me-1"></i> Aksi
								</button>
							</div>
						</div>
					</div>
				}
			</div>
		} else {
			<div style="background:#1e1e1e; border-radius:16px; border:1px solid #2a2a2a; padding:40px 20px; text-align:center; color:#6b7280;">
				<i class="bi bi-inbox fs-2 d-block mb-2"></i>
				Belum ada project
			</div>
		}
	</div>
	
	<!-- MODAL AKSI -->
	<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content" style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:20px;">
				<div class="modal-header" style="border-bottom:1px solid #2a2a2a; padding:20px 24px;">
					<div>
						<h5 class="modal-title" style="color:#ffffff; font-weight:700; margin:0;">
							<i class="bi bi-lightning-charge-fill me-2" style="color:#8b5cf6;"></i>Aksi
						</h5>
						<small id="actionModalSubtitle" style="color:#9ca3af; font-size:0.75rem;">-</small>
					</div>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body" style="padding:16px 24px;">
					<div class="d-grid gap-2">
						<a id="actionRsvp" href="#" style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; color:#d1d5db; text-decoration:none; transition:all 0.2s;">
							<i class="bi bi-people" style="color:#ec489a; font-size:1.2rem;"></i>
							<div style="flex:1;">
								<div style="color:white; font-weight:600; font-size:0.9rem;">Reservasi</div>
								<div style="color:#6b7280; font-size:0.7rem;">Kelola konfirmasi kehadiran</div>
							</div>
							<span id="rsvpBadge" class="badge" style="background:#ef4444; font-size:0.65rem; display:none;">0</span>
							<i class="bi bi-chevron-right" style="color:#4b5563;"></i>
						</a>

						<a id="actionShare" href="#" style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; color:#d1d5db; text-decoration:none; transition:all 0.2s;">
							<i class="bi bi-whatsapp" style="color:#25D366; font-size:1.2rem;"></i>
							<div style="flex:1;">
								<div style="color:white; font-weight:600; font-size:0.9rem;">Share WhatsApp</div>
								<div style="color:#6b7280; font-size:0.7rem;">Bagikan undangan ke tamu</div>
							</div>
							<i class="bi bi-chevron-right" style="color:#4b5563;"></i>
						</a>

						<a id="actionDetail" href="#" style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; color:#d1d5db; text-decoration:none; transition:all 0.2s;">
							<i class="bi bi-eye" style="color:#8b5cf6; font-size:1.2rem;"></i>
							<div style="flex:1;">
								<div style="color:white; font-weight:600; font-size:0.9rem;">Detail</div>
								<div style="color:#6b7280; font-size:0.7rem;">Lihat data lengkap project</div>
							</div>
							<i class="bi bi-chevron-right" style="color:#4b5563;"></i>
						</a>

						<a id="actionEdit" href="#" style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; color:#d1d5db; text-decoration:none; transition:all 0.2s;">
							<i class="bi bi-pencil" style="color:#f59e0b; font-size:1.2rem;"></i>
							<div style="flex:1;">
								<div style="color:white; font-weight:600; font-size:0.9rem;">Edit</div>
								<div style="color:#6b7280; font-size:0.7rem;">Ubah data undangan</div>
							</div>
							<i class="bi bi-chevron-right" style="color:#4b5563;"></i>
						</a>

						<a id="actionView" href="#" target="_blank" style="display:flex; align-items:center; gap:12px; padding:14px 16px; background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; color:#d1d5db; text-decoration:none; transition:all 0.2s;">
							<i class="bi bi-box-arrow-up-right" style="color:#8b5cf6; font-size:1.2rem;"></i>
							<div style="flex:1;">
								<div style="color:white; font-weight:600; font-size:0.9rem;">Lihat Undangan</div>
								<div style="color:#6b7280; font-size:0.7rem;">Buka undangan di tab baru</div>
							</div>
							<i class="bi bi-chevron-right" style="color:#4b5563;"></i>
						</a>

						<hr style="border-color:#2a2a2a; margin:8px 0;"/>

						<form id="actionDeleteForm" method="POST" action="#" style="margin:0;">
							<button type="submit" onclick="return confirm('Yakin hapus project ini? Data tidak bisa dikembalikan!')" style="width:100%; display:flex; align-items:center; gap:12px; padding:14px 16px; background:rgba(239,68,68,0.08); border:1px solid rgba(239,68,68,0.3); border-radius:12px; color:#ef4444; cursor:pointer; font-weight:600; font-size:0.9rem;">
								<i class="bi bi-trash" style="font-size:1.2rem;"></i>
								<div style="flex:1; text-align:left;">
									<div style="font-weight:600;">Hapus Project</div>
									<div style="color:#9ca3af; font-size:0.7rem; font-weight:400;">Tindakan ini tidak bisa dibatalkan</div>
								</div>
							</button>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>

	@projectIndexScript()
}

// ============================================
// SCRIPT
// ============================================
templ projectIndexScript() {
	<script>
		// ============================================
		// COPY LINK
		// ============================================
		window.copyInvitationLink = function(path, title) {
			var fullUrl = window.location.origin + path;
			if (navigator.clipboard) {
				navigator.clipboard.writeText(fullUrl).then(function() {
					alert('✅ Link tersalin!\n\n' + title + '\n' + fullUrl);
				}).catch(function() {
					alert('Link: ' + fullUrl);
				});
			} else {
				alert('Link: ' + fullUrl);
			}
		};

		// ============================================
		// OPEN ACTION MODAL
		// ============================================
		window.openActionModal = function(id, title, slug, status, rsvpCount) {
			// Isi subtitle
			document.getElementById('actionModalSubtitle').textContent = title;

			// Isi link
			document.getElementById('actionRsvp').href = '/admin/projects/' + id + '/rsvp';
			document.getElementById('actionShare').href = '/share/invitation/' + id;
			document.getElementById('actionDetail').href = '/admin/projects/' + id;
			document.getElementById('actionEdit').href = '/invitation/create/edit/' + id;
			document.getElementById('actionView').href = '/invitation/' + slug;
			document.getElementById('actionDeleteForm').action = '/admin/projects/' + id + '/delete';

			// Badge RSVP
			var rsvpBadge = document.getElementById('rsvpBadge');
			var count = parseInt(rsvpCount, 10);
			if (count > 0) {
				rsvpBadge.textContent = count;
				rsvpBadge.style.display = 'inline-block';
			} else {
				rsvpBadge.style.display = 'none';
			}

			// Sembunyikan tombol "Lihat Undangan" kalau belum published
			var actionView = document.getElementById('actionView');
			if (status !== 'published') {
				actionView.style.opacity = '0.4';
				actionView.style.pointerEvents = 'none';
				actionView.title = 'Undangan belum dipublikasikan';
			} else {
				actionView.style.opacity = '1';
				actionView.style.pointerEvents = 'auto';
				actionView.title = '';
			}

			// Show modal
			var modalEl = document.getElementById('actionModal');
			var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
			modal.show();
		};
	</script>
}
