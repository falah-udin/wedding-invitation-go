package users

import "wedding-invitation-go/internal/models"

// EditContent — form edit user
templ EditContent(user models.User, errorMsg string) {
	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2 class="fw-bold" style="color: #8b5cf6;">Edit User</h2>
			<p class="text-secondary m-0">Edit data user { user.Name }</p>
		</div>
		<a href="/admin/users" class="btn" style="background: #2a2a2a; border: 1px solid #3a3a3a; border-radius: 12px; padding: 8px 20px; color: #fff; text-decoration: none;">
			<i class="bi bi-arrow-left me-2"></i>Kembali
		</a>
	</div>

	if errorMsg != "" {
		<div class="alert alert-danger mb-3" style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 16px;">
			<i class="bi bi-exclamation-triangle me-2"></i>{ errorMsg }
		</div>
	}

	<div class="p-4" style="background: #1e1e1e; border-radius: 16px; border: 1px solid #2a2a2a;">
		<form method="POST" action={ templ.URL("/admin/users/" + formatUint(user.ID) + "/edit") }>
			<div class="row g-4">
				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Nama Lengkap <span class="text-danger">*</span></label>
					<input type="text" name="name" value={ user.Name } class="form-control-dark" required/>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Email <span class="text-danger">*</span></label>
					<input type="email" name="email" value={ user.Email } class="form-control-dark" required/>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Password <span style="color:#6b7280;">(Kosongkan jika tidak diubah)</span></label>
					<input type="password" name="password" class="form-control-dark"/>
					<small style="color: #6b7280;">Minimal 6 karakter</small>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Konfirmasi Password</label>
					<input type="password" name="password_confirmation" class="form-control-dark"/>
				</div>

				<div class="col-12">
					<label class="form-label" style="color: #9ca3af;">Role <span class="text-danger">*</span></label>
					<select name="role" class="form-control-dark" required>
						<option value="admin" selected?={ user.Role == "admin" }>Admin</option>
						<option value="staff" selected?={ user.Role == "staff" }>Staff</option>
						<option value="client" selected?={ user.Role == "client" }>Client</option>
					</select>
				</div>

				<div class="col-12">
					<button type="submit" class="btn" style="width:100%; background:#8b5cf6; border:none; border-radius:12px; padding:12px; color:white; font-weight:600;">
						<i class="bi bi-save me-2"></i>Update User
					</button>
				</div>
			</div>
		</form>
	</div>
}
