package reservations

import (
	"fmt"
	"wedding-invitation-go/internal/models"
)

type ShowData struct {
	User    models.User
	Setting models.Config
	Project models.Project
	Rsvps   []models.Rsvp
	Stats   map[string]int
}

templ ShowPage(data ShowData) {
	<style>
		.card-detail {
			background: #1a1a1a;
			border: 1px solid #2a2a2a;
			border-radius: 12px;
			overflow: hidden;
		}
		.card-detail .card-body {
			padding: 0;
			overflow-x: auto;
		}
		.table-rsvp {
			color: #ffffff !important;
			background: transparent !important;
			width: 100%;
			min-width: 600px;
		}
		.table-rsvp thead th {
			color: #10b981 !important;
			background: transparent !important;
			border-bottom: 1px solid #2a2a2a !important;
			font-weight: 500 !important;
			padding: 10px 12px !important;
			font-size: 0.8rem !important;
		}
		.table-rsvp tbody td {
			color: #d1d5db !important;
			background: transparent !important;
			border-bottom: 1px solid #1a1a1a !important;
			padding: 8px 12px !important;
			font-size: 0.85rem !important;
		}
		.table-rsvp tbody tr:hover {
			background: rgba(16, 185, 129, 0.05) !important;
		}
		.table-rsvp tbody tr:last-child td {
			border-bottom: none !important;
		}
		.badge-status {
			font-size: 0.65rem !important;
			padding: 2px 12px !important;
			border-radius: 12px !important;
			font-weight: 500 !important;
		}
		.badge-status.hadir { background: #10b981 !important; color: white !important; }
		.badge-status.tidak { background: #ef4444 !important; color: white !important; }
		.badge-status.ragu { background: #f59e0b !important; color: #1a1a1a !important; }
		.badge-jumlah { background: #2a2a2a !important; color: white !important; font-size: 0.65rem !important; padding: 2px 10px !important; border-radius: 8px !important; }
		.btn-delete-rsvp {
			background: transparent !important;
			border: none !important;
			color: #6b7280 !important;
			font-size: 0.85rem !important;
			padding: 4px 8px !important;
			border-radius: 6px !important;
			transition: all 0.2s ease !important;
			cursor: pointer !important;
		}
		.btn-delete-rsvp:hover { color: #ef4444 !important; background: rgba(239, 68, 68, 0.1) !important; }
		.stat-box {
			background: #1a1a1a !important;
			border: 1px solid #2a2a2a !important;
			border-radius: 12px !important;
			padding: 12px !important;
			text-align: center !important;
		}
		.stat-box .number { font-size: 1.5rem !important; font-weight: 700 !important; }
		.stat-box .label { color: #9ca3af !important; font-size: 0.75rem !important; }
		.stat-box.total .number { color: #10b981 !important; }
		.stat-box.hadir .number { color: #34d399 !important; }
		.stat-box.tidak .number { color: #f87171 !important; }
		.stat-box.ragu .number { color: #fbbf24 !important; }
		.ucapan-text {
			color: #9ca3af !important;
			font-style: italic !important;
			font-size: 0.8rem !important;
			max-width: 150px !important;
			display: inline-block !important;
			white-space: nowrap !important;
			overflow: hidden !important;
			text-overflow: ellipsis !important;
		}
		.ucapan-kosong { color: #4a4a4a !important; font-size: 0.75rem !important; }
		.guest-name { color: white !important; font-weight: 600 !important; }
	</style>

	<input type="hidden" id="projectIdData" value={ fmt.Sprintf("%d", data.Project.ID) }/>

	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
		<div>
			<h2 class="fw-bold" style="color: #10b981; font-size: 1.4rem;">
				<i class="bi bi-envelope-paper me-2"></i>{ data.Project.Title }
			</h2>
			<p class="text-secondary m-0" style="font-size: 0.9rem;">
				<a href="/client/reservations" style="color: #10b981; text-decoration: none;">
					<i class="bi bi-arrow-left me-1"></i>Kembali ke Daftar Undangan
				</a>
				&nbsp;•&nbsp; { fmt.Sprintf("%d", len(data.Rsvps)) } reservasi
			</p>
		</div>
		<div class="d-flex gap-2">
			<span class="badge" style="background: #2a2a2a; color: white; font-size: 0.8rem; padding: 8px 16px;">
				<i class="bi bi-eye me-1"></i> { fmt.Sprintf("%d", data.Project.TotalViews) } views
			</span>
			<a href={ templ.URL("/invitation/" + data.Project.Slug) } target="_blank"
			   class="btn" style="background: #8b5cf6; color: white; border: none; padding: 8px 20px; border-radius: 10px; font-weight: 600; font-size: 0.85rem;">
				<i class="bi bi-box-arrow-up-right me-2"></i>Lihat Undangan
			</a>
		</div>
	</div>

	<div class="row g-2 g-md-3 mb-4">
		<div class="col-3 col-md-3"><div class="stat-box total"><div class="number">{ fmt.Sprintf("%d", data.Stats["total"]) }</div><div class="label">Total</div></div></div>
		<div class="col-3 col-md-3"><div class="stat-box hadir"><div class="number">{ fmt.Sprintf("%d", data.Stats["hadir"]) }</div><div class="label">Hadir</div></div></div>
		<div class="col-3 col-md-3"><div class="stat-box tidak"><div class="number">{ fmt.Sprintf("%d", data.Stats["tidak_hadir"]) }</div><div class="label">Tidak</div></div></div>
		<div class="col-3 col-md-3"><div class="stat-box ragu"><div class="number">{ fmt.Sprintf("%d", data.Stats["ragu"]) }</div><div class="label">Ragu</div></div></div>
	</div>

	<div class="card-detail">
		<div class="card-body">
			<table class="table-rsvp table table-sm mb-0">
				<thead>
					<tr>
						<th style="width:30px;text-align:center;">#</th>
						<th style="text-align:left;">Nama</th>
						<th style="text-align:center;">Kehadiran</th>
						<th style="text-align:center;">Jml</th>
						<th style="text-align:left;">Ucapan</th>
						<th style="text-align:left;">Tanggal</th>
						<th style="text-align:center;width:40px;">Aksi</th>
					</tr>
				</thead>
				<tbody>
					if len(data.Rsvps) > 0 {
						for i, rsvp := range data.Rsvps {
							<tr>
								<td style="text-align:center;color:#6b7280;font-size:0.75rem;">{ fmt.Sprintf("%d", i+1) }</td>
								<td><span class="guest-name">{ rsvp.GuestName }</span></td>
								<td style="text-align:center;">
									if rsvp.Attendance == "hadir" {
										<span class="badge-status hadir">✅ Hadir</span>
									} else if rsvp.Attendance == "tidak_hadir" {
										<span class="badge-status tidak">❌ Tidak</span>
									} else {
										<span class="badge-status ragu">❓ Ragu</span>
									}
								</td>
								<td style="text-align:center;"><span class="badge-jumlah">{ fmt.Sprintf("%d", rsvp.TotalGuests) }</span></td>
								<td>
									if rsvp.GetMessage() != "" {
										<span class="ucapan-text">"{ truncate(rsvp.GetMessage(), 30) }"</span>
									} else {
										<span class="ucapan-kosong">-</span>
									}
								</td>
								<td><small class="text-secondary" style="font-size:0.7rem;">{ rsvp.CreatedAt.Format("02/01/2006 15:04") }</small></td>
								<td style="text-align:center;">
									<button type="button"
									        class="btn-delete-rsvp"
									        data-id={ fmt.Sprintf("%d", rsvp.ID) }
									        data-name={ rsvp.GuestName }
									        onclick="deleteRsvp(this)"
									        title="Hapus">
										<i class="bi bi-trash"></i>
									</button>
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="7" class="text-center py-4 text-secondary">
								<i class="bi bi-inbox fs-3 d-block mb-2" style="color: #2a2a2a;"></i>
								Belum ada reservasi untuk undangan ini
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<script>
		function deleteRsvp(btn) {
			const id = btn.dataset.id;
			const name = btn.dataset.name;
			const projectId = document.getElementById('projectIdData').value;

			Swal.fire({
				title: 'Hapus Reservasi?',
				html: 'Yakin ingin menghapus reservasi dari <strong style="color: #ef4444;">' + name + '</strong>?',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#ef4444',
				cancelButtonColor: '#6b7280',
				confirmButtonText: 'Ya, Hapus!',
				cancelButtonText: 'Batal',
				background: '#1e1e1e',
				color: '#ffffff'
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: 'Menghapus...',
						text: 'Mohon tunggu',
						allowOutsideClick: false,
						didOpen: () => { Swal.showLoading(); },
						background: '#1e1e1e',
						color: '#ffffff'
					});

					fetch('/client/reservations/' + projectId + '/rsvp/' + id, {
						method: 'DELETE',
						headers: {
							'X-Requested-With': 'XMLHttpRequest',
							'Accept': 'application/json'
						}
					})
					.then(r => r.json())
					.then(data => {
						if (data.success) {
							Swal.fire({
								title: 'Berhasil!',
								text: data.message,
								icon: 'success',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff',
								timer: 1500,
								timerProgressBar: true,
								showConfirmButton: false
							}).then(() => window.location.reload());
						} else {
							Swal.fire({
								title: 'Gagal!',
								text: data.message || 'Terjadi kesalahan',
								icon: 'error',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff'
							});
						}
					})
					.catch(err => {
						Swal.fire({
							title: 'Error!',
							text: 'Terjadi kesalahan: ' + err.message,
							icon: 'error',
							confirmButtonColor: '#10b981',
							background: '#1e1e1e',
							color: '#ffffff'
						});
					});
				}
			});
		}
	</script>
}

func truncate(s string, n int) string {
	runes := []rune(s)
	if len(runes) <= n {
		return s
	}
	return string(runes[:n]) + "..."
}
