package wedding

import (
	"wedding-invitation-go/internal/models"
)

type WeddingData struct {
	User     models.User
	Setting  models.Config
	Projects []models.Project
	Success  string
	Error    string
}

templ WeddingPage(data WeddingData) {
	<style>
		.card-project {
			background: #1a1a1a;
			border: 1px solid #2a2a2a;
			border-radius: 14px;
			padding: 18px 22px;
			transition: all 0.2s ease;
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 12px;
		}
		.card-project:hover {
			border-color: #10b981;
			transform: translateY(-2px);
			box-shadow: 0 8px 25px rgba(16, 185, 129, 0.08);
		}
		.card-project .title {
			color: white;
			font-weight: 600;
			font-size: 1.05rem;
			margin-bottom: 6px;
		}
		.card-project .meta {
			color: #9ca3af;
			font-size: 0.8rem;
			display: flex;
			gap: 12px;
			flex-wrap: wrap;
			align-items: center;
		}
		.badge-status {
			font-size: 0.65rem;
			padding: 3px 10px;
			border-radius: 10px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}
		.badge-status.published { background: #10b981; color: white; }
		.badge-status.draft { background: #f59e0b; color: #1a1a1a; }
		.badge-status.archived { background: #6b7280; color: white; }

		.btn-action {
			border: none;
			padding: 6px 14px;
			border-radius: 8px;
			font-size: 0.78rem;
			font-weight: 600;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			gap: 4px;
			text-decoration: none;
			transition: all 0.2s;
		}
		.btn-action:hover { filter: brightness(1.15); }
		.btn-share { background: #25D366; color: white; }
		.btn-copy { background: #10b981; color: white; }
		.btn-view { background: #8b5cf6; color: white; }
		.btn-edit { background: #f59e0b; color: #1a1a1a; }
		.btn-delete { background: #ef4444; color: white; }

		.empty-state {
			text-align: center;
			padding: 60px 20px;
			color: #6b7280;
		}
		.empty-state i {
			font-size: 3.5rem;
			display: block;
			margin-bottom: 16px;
			opacity: 0.3;
		}
	</style>

	<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
		<div>
			<h2 class="fw-bold mb-1" style="color: #10b981;">
				<i class="bi bi-envelope-paper me-2"></i>Undangan Saya
			</h2>
			<p class="text-secondary m-0">Kelola semua undangan pernikahan Anda</p>
		</div>
		<a href="/invitation/create/select-client"
		   class="btn"
		   style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%); color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600;">
			<i class="bi bi-plus-lg me-2"></i>Buat Undangan
		</a>
	</div>

	if data.Success != "" {
		<div class="alert alert-success alert-dismissible fade show mb-4"
		     style="background: rgba(16,185,129,0.1); border-left: 4px solid #10b981; color: #10b981; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-check-circle me-2"></i>
			{ data.Success }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}
	if data.Error != "" {
		<div class="alert alert-danger alert-dismissible fade show mb-4"
		     style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-exclamation-triangle me-2"></i>
			{ data.Error }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}

	<div style="background: #1a1a1a; border-radius: 20px; border: 1px solid #2a2a2a; padding: 20px;">
		if len(data.Projects) > 0 {
			<div class="d-flex flex-column gap-3">
				for _, p := range data.Projects {
					<div class="card-project">
						<div style="flex: 1; min-width: 250px;">
							<div class="title">
								<i class="bi bi-envelope-paper me-2" style="color: #10b981;"></i>
								{ p.Title }
							</div>
							<div class="meta">
								<span class={ "badge-status", p.Status }>{ p.Status }</span>
								<span><i class="bi bi-eye me-1"></i>{ formatNumber(p.TotalViews) }</span>
								<span><i class="bi bi-people me-1"></i>{ formatNumber(p.TotalRsvp) }</span>
								<span><i class="bi bi-calendar me-1"></i>{ p.CreatedAt.Format("02 Jan 2006") }</span>
							</div>
						</div>
						<div class="d-flex gap-2 flex-wrap">
							if p.Status == "published" {
								<a href={ templ.URL("/share/invitation/" + formatUint(p.ID)) }
								   class="btn-action btn-share"
								   title="Share ke WhatsApp">
									<i class="bi bi-whatsapp"></i> Share
								</a>
								<button type="button"
									class="btn-action btn-copy"
									data-link={ "/invitation/" + p.Slug }
									onclick="copyBtn(this)">
									<i class="bi bi-clipboard"></i> Salin
								</button>
							}
							<a href={ templ.URL("/invitation/" + p.Slug) }
							   target="_blank"
							   class="btn-action btn-view">
								<i class="bi bi-box-arrow-up-right"></i> Lihat
							</a>
							<a href={ templ.URL("/invitation/create/edit/" + formatUint(p.ID)) }
							   class="btn-action btn-edit">
								<i class="bi bi-pencil"></i> Edit
							</a>
							if p.Status == "draft" {
							<button type="button"
									class="btn-action btn-delete"
									data-id={ formatUint(p.ID) }
									data-title={ p.Title }
									onclick="deleteBtn(this)">
									<i class="bi bi-trash"></i> Hapus
								</button>
							}
						</div>
					</div>
				}
			</div>
		} else {
			<div class="empty-state">
				<i class="bi bi-inbox"></i>
				<p>Belum ada undangan. Buat undangan pertama Anda!</p>
				<a href="/invitation/create/select-client"
				   class="btn"
				   style="background: #10b981; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600;">
					<i class="bi bi-plus-lg me-2"></i>Buat Undangan Sekarang
				</a>
			</div>
		}
	</div>

	<script>
		function copyBtn(btn) {
			const link = window.location.origin + btn.dataset.link;
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(link).then(() => showCopySuccess(link)).catch(() => fallbackCopy(link));
			} else {
				fallbackCopy(link);
			}
		}

		function showCopySuccess(link) {
			Swal.fire({
				title: 'Link Tersalin!',
				html: '<div style="word-break:break-all; font-size:0.85rem;">' + link + '</div>',
				icon: 'success',
				timer: 3000,
				showConfirmButton: true,
				confirmButtonColor: '#10b981',
				background: '#1e1e1e',
				color: '#ffffff',
				confirmButtonText: 'OK'
			});
		}

		function fallbackCopy(text) {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.left = '-9999px';
			document.body.appendChild(ta);
			ta.select();
			try {
				document.execCommand('copy');
				showCopySuccess(text);
			} catch (e) {
				Swal.fire({
					title: 'Gagal Menyalin',
					html: '<code style="background:#0f0f0f;padding:6px;border-radius:4px;word-break:break-all;">' + text + '</code>',
					icon: 'error',
					confirmButtonColor: '#10b981',
					background: '#1e1e1e',
					color: '#ffffff'
				});
			}
			document.body.removeChild(ta);
		}

		function deleteBtn(btn) {
			const id = btn.dataset.id;
			const title = btn.dataset.title;

			Swal.fire({
				title: 'Hapus Undangan?',
				html: 'Yakin hapus <strong style="color:#ef4444;">' + title + '</strong>?<br>Data tidak dapat dikembalikan!',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#ef4444',
				cancelButtonColor: '#6b7280',
				confirmButtonText: 'Ya, Hapus!',
				cancelButtonText: 'Batal',
				background: '#1e1e1e',
				color: '#ffffff'
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: 'Menghapus...',
						text: 'Mohon tunggu',
						allowOutsideClick: false,
						didOpen: () => { Swal.showLoading(); },
						background: '#1e1e1e',
						color: '#ffffff'
					});

					fetch('/client/wedding/' + id, {
						method: 'DELETE',
						headers: {
							'X-Requested-With': 'XMLHttpRequest',
							'Accept': 'application/json'
						}
					})
					.then(r => r.json())
					.then(data => {
						if (data.success) {
							Swal.fire({
								title: 'Berhasil!',
								text: data.message,
								icon: 'success',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff',
								timer: 1500,
								timerProgressBar: true,
								showConfirmButton: false
							}).then(() => window.location.reload());
						} else {
							Swal.fire({
								title: 'Gagal!',
								text: data.message || 'Terjadi kesalahan',
								icon: 'error',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff'
							});
						}
					})
					.catch(err => {
						Swal.fire({
							title: 'Error!',
							text: 'Terjadi kesalahan: ' + err.message,
							icon: 'error',
							confirmButtonColor: '#10b981',
							background: '#1e1e1e',
							color: '#ffffff'
						});
					});
				}
			});
		}
	</script>
}

// formatNumber — format ribuan dengan titik
func formatNumber(n int) string {
	if n == 0 { return "0" }
	neg := n < 0
	if neg { n = -n }
	s := ""
	i := 0
	for n > 0 {
		if i > 0 && i%3 == 0 {
			s = "." + s
		}
		s = string(rune('0'+n%10)) + s
		n /= 10
		i++
	}
	if neg { s = "-" + s }
	return s
}

// formatUint — uint ke string
func formatUint(n uint) string {
	if n == 0 { return "0" }
	s := ""
	for n > 0 {
		s = string(rune('0'+n%10)) + s
		n /= 10
	}
	return s
}
