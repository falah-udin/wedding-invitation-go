package wedding

import (
	"wedding-invitation-go/internal/models"
)

type WeddingData struct {
	User     models.User
	Setting  models.Config
	Projects  []models.Project
	Templates []models.Template
	Success  string
	Error    string
}

templ WeddingPage(data WeddingData) {
	<style>
		.card-project {
			background: #1a1a1a;
			border: 1px solid #2a2a2a;
			border-radius: 14px;
			padding: 18px 22px;
			transition: all 0.2s ease;
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 12px;
		}
		.card-project:hover {
			border-color: #10b981;
			transform: translateY(-2px);
			box-shadow: 0 8px 25px rgba(16, 185, 129, 0.08);
		}
		.card-project .title {
			color: white;
			font-weight: 600;
			font-size: 1.05rem;
			margin-bottom: 6px;
		}
		.card-project .meta {
			color: #9ca3af;
			font-size: 0.8rem;
			display: flex;
			gap: 12px;
			flex-wrap: wrap;
			align-items: center;
		}
		.badge-status {
			font-size: 0.65rem;
			padding: 3px 10px;
			border-radius: 10px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.5px;
		}
		.badge-status.published { background: #10b981; color: white; }
		.badge-status.draft { background: #f59e0b; color: #1a1a1a; }
		.badge-status.archived { background: #6b7280; color: white; }

		.btn-action {
			border: none;
			padding: 6px 14px;
			border-radius: 8px;
			font-size: 0.78rem;
			font-weight: 600;
			cursor: pointer;
			display: inline-flex;
			align-items: center;
			gap: 4px;
			text-decoration: none;
			transition: all 0.2s;
		}
		.btn-action:hover { filter: brightness(1.15); }
		.btn-share { background: #25D366; color: white; }
		.btn-copy { background: #10b981; color: white; }
		.btn-view { background: #8b5cf6; color: white; }
		.btn-edit { background: #f59e0b; color: #1a1a1a; }
		.btn-delete { background: #ef4444; color: white; }

		.empty-state {
			text-align: center;
			padding: 60px 20px;
			color: #6b7280;
		}
		.empty-state i {
			font-size: 3.5rem;
			display: block;
			margin-bottom: 16px;
			opacity: 0.3;
		}
	</style>

	<!-- CSS MODAL GANTI TEMA -->
	<style>
		.btn-change-template {
			background: #8b5cf6;
			color: white;
		}

		.template-modal-overlay {
			display: none;
			position: fixed;
			top: 0; left: 0; right: 0; bottom: 0;
			background: rgba(0, 0, 0, 0.85);
			z-index: 99999;
			align-items: center;
			justify-content: center;
			padding: 20px;
			overflow-y: auto;
		}

		.template-modal-overlay.active {
			display: flex;
		}

		.template-modal-content {
			background: #1a1a1a;
			border: 1px solid #2a2a2a;
			border-radius: 20px;
			padding: 24px;
			max-width: 1000px;
			width: 100%;
			max-height: 90vh;
			overflow-y: auto;
			position: relative;
		}

		.template-modal-close {
			position: absolute;
			top: 16px; right: 16px;
			width: 36px; height: 36px;
			background: #2a2a2a;
			border: none;
			border-radius: 50%;
			color: #9ca3af;
			cursor: pointer;
			font-size: 1.1rem;
			display: flex;
			align-items: center;
			justify-content: center;
			transition: all 0.2s;
		}

		.template-modal-close:hover {
			background: #ef4444;
			color: white;
		}

		.template-modal-title {
			color: white;
			font-size: 1.3rem;
			font-weight: 700;
			margin-bottom: 6px;
		}

		.template-modal-subtitle {
			color: #9ca3af;
			font-size: 0.85rem;
			margin-bottom: 20px;
		}

		.template-modal-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
			gap: 16px;
			margin-bottom: 20px;
		}

		.template-modal-card {
			background: #0f0f0f;
			border: 2px solid #2a2a2a;
			border-radius: 14px;
			padding: 12px;
			cursor: pointer;
			transition: all 0.2s;
			position: relative;
		}

		.template-modal-card:hover {
			border-color: #8b5cf6;
			transform: translateY(-2px);
			box-shadow: 0 8px 20px rgba(139, 92, 246, 0.15);
		}

		.template-modal-card.selected {
			border-color: #8b5cf6;
			background: rgba(139, 92, 246, 0.08);
			box-shadow: 0 0 0 1px #8b5cf6;
		}

		.template-modal-thumb {
			width: 100%;
			height: 110px;
			border-radius: 10px;
			overflow: hidden;
			margin-bottom: 10px;
			background: linear-gradient(135deg, #1a1a1a 0%, #262626 100%);
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.template-modal-thumb img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			object-position: top center;
			transition: transform 0.4s ease;
		}

		.template-modal-card:hover .template-modal-thumb img {
			transform: scale(1.06);
		}

		.template-modal-thumb i {
			font-size: 2rem;
			color: #8b5cf6;
		}

		.template-modal-name {
			color: white;
			font-weight: 700;
			font-size: 0.85rem;
			text-align: center;
			margin-bottom: 4px;
		}

		.template-modal-desc {
			color: #9ca3af;
			font-size: 0.7rem;
			text-align: center;
			line-height: 1.4;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.template-modal-check {
			display: none;
			position: absolute;
			top: 8px;
			right: 8px;
			width: 26px;
			height: 26px;
			background: #8b5cf6;
			border-radius: 50%;
			color: white;
			font-size: 0.85rem;
			align-items: center;
			justify-content: center;
			z-index: 10;
			box-shadow: 0 2px 8px rgba(139, 92, 246, 0.5);
		}

		.template-modal-card.selected .template-modal-check {
			display: flex;
		}

		.template-modal-actions {
			display: flex;
			justify-content: flex-end;
			gap: 10px;
		}

		.template-modal-btn {
			padding: 10px 24px;
			border-radius: 10px;
			font-weight: 600;
			font-size: 0.85rem;
			border: none;
			cursor: pointer;
			transition: all 0.2s;
		}

		.template-modal-btn-cancel {
			background: #2a2a2a;
			color: #9ca3af;
		}

		.template-modal-btn-cancel:hover {
			background: #3a3a3a;
			color: white;
		}

		.template-modal-btn-save {
			background: linear-gradient(135deg, #8b5cf6 0%, #a78bfa 100%);
			color: white;
		}

		.template-modal-btn-save:hover {
			filter: brightness(1.1);
			transform: translateY(-1px);
		}

		.template-modal-btn-save:disabled {
			opacity: 0.5;
			cursor: not-allowed;
			transform: none;
		}
	</style>

	<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
		<div>
			<h2 class="fw-bold mb-1" style="color: #10b981;">
				<i class="bi bi-envelope-paper me-2"></i>Undangan Saya
			</h2>
			<p class="text-secondary m-0">Kelola semua undangan pernikahan Anda</p>
		</div>
		<a href="/invitation/create/select-client"
		   class="btn"
		   style="background: linear-gradient(135deg, #10b981 0%, #34d399 100%); color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600;">
			<i class="bi bi-plus-lg me-2"></i>Buat Undangan
		</a>
	</div>

	if data.Success != "" {
		<div class="alert alert-success alert-dismissible fade show mb-4"
		     style="background: rgba(16,185,129,0.1); border-left: 4px solid #10b981; color: #10b981; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-check-circle me-2"></i>
			{ data.Success }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}
	if data.Error != "" {
		<div class="alert alert-danger alert-dismissible fade show mb-4"
		     style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-exclamation-triangle me-2"></i>
			{ data.Error }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}

	<div style="background: #1a1a1a; border-radius: 20px; border: 1px solid #2a2a2a; padding: 20px;">
		if len(data.Projects) > 0 {
			<div class="d-flex flex-column gap-3">
				for _, p := range data.Projects {
					<div class="card-project">
						<div style="flex: 1; min-width: 250px;">
							<div class="title">
								<i class="bi bi-envelope-paper me-2" style="color: #10b981;"></i>
								{ p.Title }
							</div>
							<div class="meta">
								<span class={ "badge-status", p.Status }>{ p.Status }</span>
								<span><i class="bi bi-eye me-1"></i>{ formatNumber(p.TotalViews) }</span>
								<span><i class="bi bi-people me-1"></i>{ formatNumber(p.TotalRsvp) }</span>
								<span><i class="bi bi-calendar me-1"></i>{ p.CreatedAt.Format("02 Jan 2006") }</span>
							</div>
						</div>
						<div class="d-flex gap-2 flex-wrap">
							if p.Status == "published" {
								<a href={ templ.URL("/share/invitation/" + formatUint(p.ID)) }
								   class="btn-action btn-share"
								   title="Share ke WhatsApp">
									<i class="bi bi-whatsapp"></i> Share
								</a>
								<button type="button"
									class="btn-action btn-copy"
									data-link={ "/invitation/" + p.Slug }
									onclick="copyBtn(this)">
									<i class="bi bi-clipboard"></i> Salin
								</button>
							}
							<a href={ templ.URL("/invitation/" + p.Slug) }
							   target="_blank"
							   class="btn-action btn-view">
								<i class="bi bi-box-arrow-up-right"></i> Lihat
							</a>
							<a href={ templ.URL("/invitation/create/edit/" + formatUint(p.ID)) }
							   class="btn-action btn-edit">
								<i class="bi bi-pencil"></i> Edit
							</a>

<button type="button"
        class="btn-action btn-change-template"
        data-id={ formatUint(p.ID) }
        data-title={ p.Title }
        data-current={ formatUint(p.TemplateID) }
        onclick="openTemplateModal(this)">
        <i class="bi bi-palette"></i> Ganti Tema
</button>
							if p.Status == "draft" {
							<button type="button"
									class="btn-action btn-delete"
									data-id={ formatUint(p.ID) }
									data-title={ p.Title }
									onclick="deleteBtn(this)">
									<i class="bi bi-trash"></i> Hapus
								</button>
							}
						</div>
					</div>
				}
			</div>
		} else {
			<div class="empty-state">
				<i class="bi bi-inbox"></i>
				<p>Belum ada undangan. Buat undangan pertama Anda!</p>
				<a href="/invitation/create/select-client"
				   class="btn"
				   style="background: #10b981; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600;">
					<i class="bi bi-plus-lg me-2"></i>Buat Undangan Sekarang
				</a>
			</div>
		}
	</div>

	<!-- MODAL GANTI TEMA -->
	<div class="template-modal-overlay" id="templateModal" onclick="closeTemplateModalOnOverlay(event)">
		<div class="template-modal-content">
			<button type="button" class="template-modal-close" onclick="closeTemplateModal()">
				<i class="bi bi-x-lg"></i>
			</button>

			<h3 class="template-modal-title">
				<i class="bi bi-palette me-2" style="color:#8b5cf6;"></i>Ganti Tema Undangan
			</h3>
			<p class="template-modal-subtitle">
				Pilih tema baru untuk <strong id="modalProjectTitle" style="color:white;">undangan ini</strong>
			</p>

			<div class="template-modal-grid" id="templateModalGrid">
				if len(data.Templates) > 0 {
					for _, tmpl := range data.Templates {
						<div class="template-modal-card"
						     data-template-id={ formatUint(tmpl.ID) }
						     onclick="selectTemplateCard(this)">
							<div class="template-modal-check">
								<i class="bi bi-check"></i>
							</div>
							<div class="template-modal-thumb">
								if tmpl.Thumbnail != nil && *tmpl.Thumbnail != "" {
									<img src={ *tmpl.Thumbnail } alt={ tmpl.Name } loading="lazy"/>
								} else {
									<i class="bi bi-brush"></i>
								}
							</div>
							<div class="template-modal-name">{ tmpl.Name }</div>
							if tmpl.Description != nil {
								<div class="template-modal-desc">{ *tmpl.Description }</div>
							}
						</div>
					}
				} else {
					<p style="color:#9ca3af; grid-column: 1 / -1; text-align:center;">Belum ada template tersedia</p>
				}
			</div>

			<div class="template-modal-actions">
				<button type="button" class="template-modal-btn template-modal-btn-cancel" onclick="closeTemplateModal()">
					Batal
				</button>
				<button type="button" class="template-modal-btn template-modal-btn-save" id="templateModalSaveBtn" onclick="submitChangeTemplate()" disabled>
					<i class="bi bi-check-lg me-1"></i>Simpan Perubahan
				</button>
			</div>
		</div>
	</div>

	<script>
		function copyBtn(btn) {
			const link = window.location.origin + btn.dataset.link;
			if (navigator.clipboard && navigator.clipboard.writeText) {
				navigator.clipboard.writeText(link).then(() => showCopySuccess(link)).catch(() => fallbackCopy(link));
			} else {
				fallbackCopy(link);
			}
		}

		function showCopySuccess(link) {
			Swal.fire({
				title: 'Link Tersalin!',
				html: '<div style="word-break:break-all; font-size:0.85rem;">' + link + '</div>',
				icon: 'success',
				timer: 3000,
				showConfirmButton: true,
				confirmButtonColor: '#10b981',
				background: '#1e1e1e',
				color: '#ffffff',
				confirmButtonText: 'OK'
			});
		}

		function fallbackCopy(text) {
			const ta = document.createElement('textarea');
			ta.value = text;
			ta.style.position = 'fixed';
			ta.style.left = '-9999px';
			document.body.appendChild(ta);
			ta.select();
			try {
				document.execCommand('copy');
				showCopySuccess(text);
			} catch (e) {
				Swal.fire({
					title: 'Gagal Menyalin',
					html: '<code style="background:#0f0f0f;padding:6px;border-radius:4px;word-break:break-all;">' + text + '</code>',
					icon: 'error',
					confirmButtonColor: '#10b981',
					background: '#1e1e1e',
					color: '#ffffff'
				});
			}
			document.body.removeChild(ta);
		}

		function deleteBtn(btn) {
			const id = btn.dataset.id;
			const title = btn.dataset.title;

			Swal.fire({
				title: 'Hapus Undangan?',
				html: 'Yakin hapus <strong style="color:#ef4444;">' + title + '</strong>?<br>Data tidak dapat dikembalikan!',
				icon: 'warning',
				showCancelButton: true,
				confirmButtonColor: '#ef4444',
				cancelButtonColor: '#6b7280',
				confirmButtonText: 'Ya, Hapus!',
				cancelButtonText: 'Batal',
				background: '#1e1e1e',
				color: '#ffffff'
			}).then((result) => {
				if (result.isConfirmed) {
					Swal.fire({
						title: 'Menghapus...',
						text: 'Mohon tunggu',
						allowOutsideClick: false,
						didOpen: () => { Swal.showLoading(); },
						background: '#1e1e1e',
						color: '#ffffff'
					});

					fetch('/client/wedding/' + id, {
						method: 'DELETE',
						headers: {
							'X-Requested-With': 'XMLHttpRequest',
							'Accept': 'application/json'
						}
					})
					.then(r => r.json())
					.then(data => {
						if (data.success) {
							Swal.fire({
								title: 'Berhasil!',
								text: data.message,
								icon: 'success',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff',
								timer: 1500,
								timerProgressBar: true,
								showConfirmButton: false
							}).then(() => window.location.reload());
						} else {
							Swal.fire({
								title: 'Gagal!',
								text: data.message || 'Terjadi kesalahan',
								icon: 'error',
								confirmButtonColor: '#10b981',
								background: '#1e1e1e',
								color: '#ffffff'
							});
						}
					})
					.catch(err => {
						Swal.fire({
							title: 'Error!',
							text: 'Terjadi kesalahan: ' + err.message,
							icon: 'error',
							confirmButtonColor: '#10b981',
							background: '#1e1e1e',
							color: '#ffffff'
						});
					});
				}
			});
		}

		// ============================================
		// MODAL GANTI TEMA
		// ============================================
		var _modalProjectId = 0;
		var _modalSelectedTemplateId = 0;

		function openTemplateModal(btn) {
			_modalProjectId = parseInt(btn.dataset.id);
			_modalSelectedTemplateId = parseInt(btn.dataset.current || 0);
			var title = btn.dataset.title || 'Undangan';

			document.getElementById('modalProjectTitle').textContent = title;

			// Reset semua card
			document.querySelectorAll('.template-modal-card').forEach(function(c) {
				c.classList.remove('selected');
			});

			// Auto-select current template
			if (_modalSelectedTemplateId > 0) {
				document.querySelectorAll('.template-modal-card').forEach(function(c) {
					if (parseInt(c.dataset.templateId) === _modalSelectedTemplateId) {
						c.classList.add('selected');
					}
				});
			}

			updateSaveBtn();
			document.getElementById('templateModal').classList.add('active');
			document.body.style.overflow = 'hidden';
		}

		function closeTemplateModal() {
			document.getElementById('templateModal').classList.remove('active');
			document.body.style.overflow = '';
			_modalProjectId = 0;
			_modalSelectedTemplateId = 0;
		}

		function closeTemplateModalOnOverlay(event) {
			if (event.target.id === 'templateModal') {
				closeTemplateModal();
			}
		}

		function selectTemplateCard(card) {
			// Deselect all
			document.querySelectorAll('.template-modal-card').forEach(function(c) {
				c.classList.remove('selected');
			});
			// Select clicked
			card.classList.add('selected');
			_modalSelectedTemplateId = parseInt(card.dataset.templateId);
			updateSaveBtn();
		}

		function updateSaveBtn() {
			var btn = document.getElementById('templateModalSaveBtn');
			if (!btn) return;
			btn.disabled = (_modalSelectedTemplateId === 0);
		}

		function submitChangeTemplate() {
			if (!_modalProjectId || !_modalSelectedTemplateId) return;

			var btn = document.getElementById('templateModalSaveBtn');
			var originalHtml = btn.innerHTML;
			btn.disabled = true;
			btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Menyimpan...';

			fetch('/client/wedding/' + _modalProjectId + '/change-template', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
					'X-Requested-With': 'XMLHttpRequest',
					'Accept': 'application/json'
				},
				body: JSON.stringify({ template_id: _modalSelectedTemplateId })
			})
			.then(function(r) { return r.json(); })
			.then(function(data) {
				if (data.success) {
					closeTemplateModal();
					Swal.fire({
						title: 'Berhasil!',
						text: data.message,
						icon: 'success',
						confirmButtonColor: '#8b5cf6',
						background: '#1e1e1e',
						color: '#ffffff',
						timer: 1800,
						timerProgressBar: true,
						showConfirmButton: false
					}).then(function() {
						window.location.reload();
					});
				} else {
					Swal.fire({
						title: 'Gagal!',
						text: data.message || 'Terjadi kesalahan',
						icon: 'error',
						confirmButtonColor: '#8b5cf6',
						background: '#1e1e1e',
						color: '#ffffff'
					});
					btn.disabled = false;
					btn.innerHTML = originalHtml;
				}
			})
			.catch(function(err) {
				Swal.fire({
					title: 'Error!',
					text: 'Terjadi kesalahan: ' + err.message,
					icon: 'error',
					confirmButtonColor: '#8b5cf6',
					background: '#1e1e1e',
					color: '#ffffff'
				});
				btn.disabled = false;
				btn.innerHTML = originalHtml;
			});
		}

		// ESC untuk tutup modal
		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				closeTemplateModal();
			}
		});
	</script>
}

// formatNumber — format ribuan dengan titik
func formatNumber(n int) string {
	if n == 0 { return "0" }
	neg := n < 0
	if neg { n = -n }
	s := ""
	i := 0
	for n > 0 {
		if i > 0 && i%3 == 0 {
			s = "." + s
		}
		s = string(rune('0'+n%10)) + s
		n /= 10
		i++
	}
	if neg { s = "-" + s }
	return s
}

// formatUint — uint ke string
func formatUint(n uint) string {
	if n == 0 { return "0" }
	s := ""
	for n > 0 {
		s = string(rune('0'+n%10)) + s
		n /= 10
	}
	return s
}
