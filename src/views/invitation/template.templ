package invitation

import (
	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/models"
)

// TemplateContent — Step 2: Pilih template + isi field dinamis
templ TemplateContent(
	project models.Project,
	templates []models.Template,
	selectedTemplate models.Template,
	fieldsSchema []models.FieldSchema,
	specificData map[string]interface{},
	errorMsg string,
	successMsg string,
) {
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
		<div>
			<h2 class="fw-bold mb-1" style="color: #8b5cf6; font-size: 1.5rem;">
				<i class="bi bi-layout-three-columns me-2"></i>Step 3: Pilih Template
			</h2>
			<p class="text-secondary m-0" style="font-size: 0.9rem;">
				Pilih template dan isi data tambahan yang dibutuhkan
			</p>
		</div>
	</div>

	<!-- PROGRESS BAR -->
	<div class="mb-4">
		<div class="d-flex justify-content-between mb-2 flex-wrap gap-2">
			<span style="color: #10b981; font-weight: 600; font-size: 0.85rem;">
				<i class="bi bi-check-circle-fill me-1"></i> Step 1: Pilih Client
			</span>
			<span style="color: #10b981; font-weight: 600; font-size: 0.85rem;">
				<i class="bi bi-check-circle-fill me-1"></i> Step 2: Data Umum
			</span>
			<span style="color: #8b5cf6; font-weight: 600; font-size: 0.85rem;">
				<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Step 3: Pilih Template
			</span>
			<span style="color: #9ca3af; font-size: 0.85rem;">
				<i class="bi bi-arrow-right me-1"></i> Step 4: Preview
			</span>
		</div>
		<div class="progress" style="height: 6px; background: #2a2a2a; border-radius: 10px;">
			<div class="progress-bar" role="progressbar" style="width: 75%; background: #8b5cf6; border-radius: 10px;"></div>
		</div>
	</div>

	if errorMsg != "" {
		<div class="alert mb-3" style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 16px;">
			<i class="bi bi-exclamation-triangle me-2"></i>{ errorMsg }
		</div>
	}
	if successMsg != "" {
		<div class="alert mb-3" style="background: rgba(16,185,129,0.1); border-left: 4px solid #10b981; color: #10b981; border-radius: 12px; padding: 12px 16px;">
			<i class="bi bi-check-circle me-2"></i>{ successMsg }
		</div>
	}

	<!-- CARD 1: PILIH TEMPLATE -->
	<div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:20px; padding:28px; margin-bottom:20px;">
		<div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom:1px solid #2a2a2a;">
			<div style="width:42px; height:42px; border-radius:12px; background:rgba(139,92,246,0.15); border:1px solid rgba(139,92,246,0.3); display:flex; align-items:center; justify-content:center; color:#8b5cf6; font-size:1.2rem;">
				<i class="bi bi-brush"></i>
			</div>
			<div>
				<h5 class="mb-0" style="color:#ffffff; font-weight:700; font-size:1.05rem;">Pilih Template</h5>
				<p class="m-0" style="color:#9ca3af; font-size:0.8rem;">
					Data yang sudah diisi akan otomatis tersimpan saat ganti template
				</p>
			</div>
		</div>

		<div class="row g-3">
			if len(templates) > 0 {
				for _, tmpl := range templates {
					<div class="col-6 col-md-4 col-lg-3">
						<a href={ templ.URL("/invitation/create/template?template_id=" + formatUintV2(tmpl.ID)) } style="text-decoration:none;">
							<div class="template-card" style={ "background:#0f0f0f; border:2px solid " + getBorderColor(tmpl.ID, selectedTemplate.ID) + "; border-radius:16px; padding:16px; text-align:center; transition:all 0.3s; position:relative; height:100%; cursor:pointer;" }>
								if tmpl.ID == selectedTemplate.ID {
									<div style="position:absolute; top:8px; right:8px; width:24px; height:24px; background:#8b5cf6; border-radius:50%; display:flex; align-items:center; justify-content:center; color:white; font-size:0.8rem;">
										<i class="bi bi-check"></i>
									</div>
								}
								<i class="bi bi-brush" style="font-size:2rem; color:#8b5cf6; display:block; margin-bottom:10px;"></i>
								<div style="color:white; font-weight:700; font-size:0.9rem; margin-bottom:4px;">{ tmpl.Name }</div>
								if tmpl.Description != nil {
									<div style="color:#9ca3af; font-size:0.72rem; line-height:1.4;">
										{ truncateStr(*tmpl.Description, 60) }
									</div>
								}
								if len(tmpl.GetFieldsSchema()) > 0 {
									<div style="margin-top:10px;">
										<span style="background:rgba(139,92,246,0.15); color:#a78bfa; border:1px solid rgba(139,92,246,0.3); font-size:0.6rem; padding:3px 10px; border-radius:10px; display:inline-flex; align-items:center; gap:4px;">
											<i class="bi bi-puzzle"></i> Data Spesifik
										</span>
									</div>
								}
							</div>
						</a>
					</div>
				}
			}
		</div>

		<div class="mt-3 p-3" style="background:rgba(59,130,246,0.08); border-left:3px solid #3b82f6; border-radius:10px; font-size:0.8rem; color:#93c5fd;">
			<i class="bi bi-info-circle me-1"></i>
			Template aktif: <strong style="color:white;">{ selectedTemplate.Name }</strong>
		</div>
	</div>

	<!-- CARD 2: FORM DATA SPESIFIK -->
	if len(fieldsSchema) > 0 {
		<form method="POST" action="/invitation/create/template" enctype="multipart/form-data" id="templateForm">
			<input type="hidden" name="template_id" value={ formatUintV2(selectedTemplate.ID) }/>

			<div style="background:#1a1a1a; border:1px solid #2a2a2a; border-radius:20px; padding:28px; margin-bottom:20px;">
				<div class="d-flex align-items-center gap-3 mb-4 pb-3" style="border-bottom:1px solid #2a2a2a;">
					<div style="width:42px; height:42px; border-radius:12px; background:rgba(139,92,246,0.15); border:1px solid rgba(139,92,246,0.3); display:flex; align-items:center; justify-content:center; color:#8b5cf6; font-size:1.2rem;">
						<i class="bi bi-puzzle"></i>
					</div>
					<div>
						<h5 class="mb-0" style="color:#ffffff; font-weight:700; font-size:1.05rem;">Data Spesifik: { selectedTemplate.Name }</h5>
						<p class="m-0" style="color:#9ca3af; font-size:0.8rem;">
							Isi data tambahan yang spesifik untuk template ini
						</p>
					</div>
				</div>

				@renderFieldsByGroup(fieldsSchema, specificData)
			</div>

			<!-- SUBMIT -->
			<div class="d-flex gap-3 flex-wrap">
				<a href="/invitation/create/general" class="btn" style="background:#2a2a2a; border:none; border-radius:12px; padding:14px 32px; color:white; text-decoration:none; font-weight:600;">
					<i class="bi bi-arrow-left me-2"></i>Kembali ke Data Umum
				</a>
				<button type="submit" class="btn" style="flex:1; min-width:240px; background:#8b5cf6; border:none; border-radius:12px; padding:14px 32px; color:white; font-weight:600;">
					<i class="bi bi-save me-2"></i>Simpan & Lihat Preview
				</button>
			</div>
		</form>
	}

	@templateScript()
}

// ============================================
// RENDER FIELDS BY GROUP
// ============================================
templ renderFieldsByGroup(schema []models.FieldSchema, data map[string]interface{}) {
	{{ textFields := filterFields(schema, "text") }}
	{{ fileFields := filterFields(schema, "file") }}
	{{ galleryFields := filterFields(schema, "file_multiple") }}
	{{ repeaterFields := filterFields(schema, "repeater") }}

	// TEXT FIELDS
	if len(textFields) > 0 {
		<div style="margin-bottom:24px; padding-bottom:24px; border-bottom:1px dashed #2a2a2a;">
			<div style="display:flex; align-items:center; gap:8px; color:#9ca3af; font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:16px;">
				<i class="bi bi-pencil-square" style="color:#8b5cf6;"></i>
				Informasi &amp; Teks
				<div style="flex:1; height:1px; background:#2a2a2a;"></div>
			</div>
			<div class="row g-4">
				for _, field := range textFields {
					<div class="col-12 col-md-6">
						@renderTextField(field, getStringFromMap(data, field.Name, ""))
					</div>
				}
			</div>
		</div>
	}

	// FILE FIELDS (single upload)
	if len(fileFields) > 0 {
		<div style="margin-bottom:24px; padding-bottom:24px; border-bottom:1px dashed #2a2a2a;">
			<div style="display:flex; align-items:center; gap:8px; color:#9ca3af; font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:16px;">
				<i class="bi bi-image" style="color:#8b5cf6;"></i>
				Foto
				<div style="flex:1; height:1px; background:#2a2a2a;"></div>
			</div>
			<div class="row g-4">
				for _, field := range fileFields {
					<div class="col-12 col-md-6">
						@renderFileField(field, getStringFromMap(data, field.Name, ""))
					</div>
				}
			</div>
		</div>
	}

	// GALLERY FIELDS (multiple upload)
	if len(galleryFields) > 0 {
		<div style="margin-bottom:24px; padding-bottom:24px; border-bottom:1px dashed #2a2a2a;">
			<div style="display:flex; align-items:center; gap:8px; color:#9ca3af; font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:16px;">
				<i class="bi bi-images" style="color:#8b5cf6;"></i>
				Galeri Foto
				<div style="flex:1; height:1px; background:#2a2a2a;"></div>
			</div>
			for _, field := range galleryFields {
				@renderGalleryField(field, getSliceFromMap(data, field.Name))
			}
		</div>
	}

	// REPEATER FIELDS
	if len(repeaterFields) > 0 {
		<div>
			<div style="display:flex; align-items:center; gap:8px; color:#9ca3af; font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:1.5px; margin-bottom:16px;">
				<i class="bi bi-heart-fill" style="color:#8b5cf6;"></i>
				Cerita &amp; Momen
				<div style="flex:1; height:1px; background:#2a2a2a;"></div>
			</div>
			for _, field := range repeaterFields {
				@renderRepeaterField(field, getRepeaterItemsFromMap(data, field.Name))
			}
		</div>
	}
}

// ============================================
// RENDER TEXT FIELD
// ============================================
templ renderTextField(field models.FieldSchema, value string) {
	<div>
		<label style="color:#d1d5db; font-weight:500; margin-bottom:6px; display:block; font-size:0.85rem;">
			{ field.Label }
			if field.Required {
				<span class="text-danger">*</span>
			}
			if field.Description != "" {
				<i class="bi bi-info-circle text-secondary ms-1" title={ field.Description } style="cursor:help;"></i>
			}
		</label>

		if field.Type == "textarea" {
			<textarea name={ "specific." + field.Name } class="form-control-dark" rows={ field.Rows } placeholder={ field.Placeholder } style="width:100%; resize:vertical;">{ value }</textarea>
		} else if field.Type == "select" {
			<select name={ "specific." + field.Name } class="form-control-dark" style="width:100%;">
				<option value="">Pilih { field.Label }</option>
				for optVal, optLabel := range field.Options {
					<option value={ optVal } selected?={ value == optVal }>{ optLabel }</option>
				}
			</select>
		} else if field.Type == "url" {
			<input type="url" name={ "specific." + field.Name } value={ value } class="form-control-dark" placeholder={ field.Placeholder } style="width:100%;"/>
		} else if field.Type == "number" {
			<input type="number" name={ "specific." + field.Name } value={ value } class="form-control-dark" placeholder={ field.Placeholder } style="width:100%;"/>
		} else {
			<input type="text" name={ "specific." + field.Name } value={ value } class="form-control-dark" placeholder={ field.Placeholder } style="width:100%;"/>
		}

		if field.Description != "" {
			<small style="color:#6b7280; font-size:0.72rem; display:block; margin-top:4px;">{ field.Description }</small>
		}
	</div>
}

// ============================================
// RENDER FILE FIELD (single)
// ============================================
templ renderFileField(field models.FieldSchema, value string) {
	<div>
		<label style="color:#d1d5db; font-weight:500; margin-bottom:6px; display:block; font-size:0.85rem;">
			{ field.Label }
			if field.Required {
				<span class="text-danger">*</span>
			}
		</label>

		<div style="display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap;">
			if value != "" {
				<div style="position:relative;">
					<img src={ value } alt={ field.Label } style="width:100px; height:100px; object-fit:cover; border-radius:12px; border:2px solid #2a2a2a;"/>
				</div>
			}
			<div style="flex:1; min-width:200px;">
				<input type="file" name={ "specific." + field.Name } class="form-control-dark" accept={ field.Accept } style="font-size:0.85rem; padding:10px;"/>
				if value != "" {
					<label style="display:flex; align-items:center; gap:6px; margin-top:8px; font-size:0.75rem; color:#ef4444; cursor:pointer;">
						<input type="checkbox" name={ "specific." + field.Name + "_delete" } value="1" style="accent-color:#ef4444;"/>
						Hapus foto ini
					</label>
				}
				<small style="color:#6b7280; font-size:0.7rem; display:block; margin-top:4px;">
					<i class="bi bi-info-circle me-1"></i>Max 5MB (JPG, PNG)
				</small>
			</div>
		</div>
	</div>
}

// ============================================
// RENDER GALLERY FIELD (multiple)
// ============================================
templ renderGalleryField(field models.FieldSchema, files []interface{}) {
	<div>
		<label style="color:#d1d5db; font-weight:500; margin-bottom:10px; display:block; font-size:0.85rem;">
			{ field.Label }
			if field.Required {
				<span class="text-danger">*</span>
			}
		</label>

		{{ galleryFieldName := field.Name }}

		if len(files) > 0 {
			<div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(100px, 1fr)); gap:10px; margin-bottom:12px;">
				for _, file := range files {
					if fileStr, ok := file.(string); ok {
						<div style="position:relative; border-radius:12px; overflow:hidden; border:1px solid #2a2a2a;">
							<img src={ fileStr } style="width:100%; height:100px; object-fit:cover;"/>
							<button type="button" onclick={ templpkg.JSFuncCall("deleteGalleryItem", galleryFieldName, fileStr) } style="position:absolute; top:4px; right:4px; background:#ef4444; color:white; border:none; border-radius:50%; width:22px; height:22px; font-size:12px; display:flex; align-items:center; justify-content:center; cursor:pointer;">
								<i class="bi bi-x"></i>
							</button>
						</div>
					}
				}
			</div>
		}

		<input type="file" name={ "specific." + field.Name } class="form-control-dark" accept={ field.Accept } multiple style="font-size:0.85rem; padding:10px;"/>
		<small style="color:#6b7280; font-size:0.7rem; display:block; margin-top:6px;">
			{ field.Description }
		</small>
	</div>
}

// ============================================
// RENDER REPEATER FIELD
// ============================================
templ renderRepeaterField(field models.FieldSchema, items []map[string]string) {
	<div style="margin-bottom:24px;">
		<label style="color:#d1d5db; font-weight:500; margin-bottom:6px; display:block; font-size:0.85rem;">
			{ field.Label }
		</label>
		if field.Description != "" {
			<small style="color:#9ca3af; font-size:0.75rem; display:block; margin-bottom:12px;">{ field.Description }</small>
		}

		<div class="repeater-wrapper" data-field={ field.Name }>
			<div class="repeater-items" id={ "repeater-" + field.Name }>
				if len(items) == 0 {
					<!-- Default items -->
					for i := 0; i < field.DefaultCount; i++ {
						@repeaterItem(field.Name, i, "", "")
					}
				} else {
					for i, item := range items {
						@repeaterItem(field.Name, i, item["title"], item["desc"])
					}
				}
			</div>

			<button type="button" onclick={ templpkg.JSFuncCall("addRepeaterItem", field.Name) } style="background:transparent; border:1.5px dashed #8b5cf6; color:#8b5cf6; border-radius:10px; padding:12px 20px; font-size:0.85rem; font-weight:600; cursor:pointer; margin-top:10px;">
				<i class="bi bi-plus-circle me-2"></i>Tambah Cerita
			</button>
		</div>
	</div>
}

// ============================================
// REPEATER ITEM
// ============================================
templ repeaterItem(fieldName string, index int, title string, desc string) {
	<div class="repeater-item" data-index={ formatIntV2(index) } style="background:#0f0f0f; border:1px solid #2a2a2a; border-radius:12px; padding:16px; margin-bottom:12px; position:relative;">
		<div class="row g-3">
			<div class="col-12 col-md-4">
				<label style="color:#9ca3af; font-size:0.75rem; margin-bottom:6px; display:block;">Judul</label>
				<input type="text" name={ repeaterFieldName(fieldName, index, "title") } value={ title } class="form-control-dark" placeholder="Contoh: Pertemuan Pertama" style="font-size:0.85rem;"/>
			</div>
			<div class="col-12 col-md-8">
				<label style="color:#9ca3af; font-size:0.75rem; margin-bottom:6px; display:block;">Deskripsi</label>
				<textarea name={ repeaterFieldName(fieldName, index, "desc") } class="form-control-dark" rows="2" placeholder="Ceritakan momen indah ini..." style="font-size:0.85rem; resize:vertical;">{ desc }</textarea>
			</div>
		</div>
		<button type="button" onclick="removeRepeaterItem(this)" style="position:absolute; top:10px; right:10px; background:rgba(239,68,68,0.15); color:#ef4444; border:1px solid rgba(239,68,68,0.3); border-radius:8px; width:26px; height:26px; font-size:12px; display:flex; align-items:center; justify-content:center; cursor:pointer;">
			<i class="bi bi-x"></i>
		</button>
	</div>
}

// ============================================
// HELPER: filter fields by type
// ============================================
func filterFields(schema []models.FieldSchema, fieldType string) []models.FieldSchema {
	var result []models.FieldSchema
	for _, f := range schema {
		if fieldType == "text" {
			if f.Type != "file" && f.Type != "file_multiple" && f.Type != "repeater" {
				result = append(result, f)
			}
		} else if f.Type == fieldType {
			result = append(result, f)
		}
	}
	return result
}

// ============================================
// HELPER: repeater field name
// ============================================
func repeaterFieldName(fieldName string, index int, subfield string) string {
	return "specific." + fieldName + "[" + formatIntV2(index) + "][" + subfield + "]"
}

// ============================================
// HELPER: format int
// ============================================
func formatIntV2(n int) string {
	if n == 0 {
		return "0"
	}
	neg := false
	if n < 0 {
		neg = true
		n = -n
	}
	digits := []byte{}
	for n > 0 {
		digits = append([]byte{byte('0' + n%10)}, digits...)
		n /= 10
	}
	if neg {
		return "-" + string(digits)
	}
	return string(digits)
}

// ============================================
// HELPER: get border color for template card
// ============================================
func getBorderColor(tmplID, selectedID uint) string {
	if tmplID == selectedID {
		return "#8b5cf6"
	}
	return "#2a2a2a"
}

// ============================================
// HELPER: truncate string
// ============================================
func truncateStr(s string, max int) string {
	if len(s) <= max {
		return s
	}
	return s[:max] + "..."
}
