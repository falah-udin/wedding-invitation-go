package layouts

import (
	templpkg "github.com/a-h/templ"
	"wedding-invitation-go/internal/models"
)

// AdminLayout — layout untuk semua halaman admin
// Parameter:
//   - user: user yang sedang login (untuk topbar)
//   - setting: site setting (untuk favicon, nama situs)
//   - activePage: key menu yang sedang aktif (untuk highlight sidebar)
//   - content: komponen halaman yang akan dirender di dalam <main>
templ AdminLayout(user models.User, setting models.Config, activePage string, content templpkg.Component) {
	<!DOCTYPE html>
	<html lang="id">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes"/>
		<title>Admin Panel - { setting.SiteName }</title>

		<link rel="icon" type="image/x-icon" href="/favicon.ico"/>

		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
		<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

		<link rel="stylesheet" href="/css/admin.css"/>
	</head>
	<body x-data={ "{ sidebarOpen: false }" }>

		<div class="overlay" x-bind:class={ "{'active': sidebarOpen}" } x-on:click={ "sidebarOpen = false" }></div>

		<!-- ============================================ -->
		<!-- SIDEBAR -->
		<!-- ============================================ -->
		<div class="sidebar" x-bind:class={ "{'open': sidebarOpen}" }>
			<div class="sidebar-header">
				<a href="/" class="text-decoration-none d-flex align-items-center gap-2">
					if setting.SiteFavicon != "" {
						<img src={ "/storage/" + setting.SiteFavicon } alt="Logo" style="width: 36px; height: 36px; object-fit: contain; border-radius: 8px;"/>
					}
					<div>
						<h4 class="sidebar-logo mb-0">Wedding SaaS</h4>
						<small class="sidebar-tagline">Admin Area</small>
					</div>
				</a>
			</div>

			<nav class="mt-3">
				@adminSidebarItem("/admin/dashboard", "bi-speedometer2", "Dashboard", "admin.dashboard", activePage)
				@adminSidebarItem("/admin/users", "bi-people", "Kelola User", "admin.users", activePage)
				@adminSidebarItem("/admin/templates", "bi-layout-three-columns", "Template", "admin.templates", activePage)
				@adminSidebarItem("/admin/projects", "bi-envelope-paper", "Proyek Undangan", "admin.projects", activePage)
				@adminSidebarItem("/invitation/create/select-client", "bi-plus-circle", "Buat Undangan", "invitation.create", activePage)
				@adminSidebarItem("/admin/music", "bi-music-note", "Gudang Musik", "admin.music", activePage)
				@adminSidebarItem("/admin/settings", "bi-gear-fill", "Pengaturan Situs", "admin.settings", activePage)
			</nav>

			<div class="position-absolute bottom-0 start-0 end-0 p-3">
				<hr class="border-secondary"/>
				<form action="/logout" method="POST">
					<button type="submit" class="btn-logout w-100">
						<i class="bi bi-box-arrow-right me-2"></i>Logout
					</button>
				</form>
			</div>
		</div>

		<!-- ============================================ -->
		<!-- MAIN CONTENT -->
		<!-- ============================================ -->
		<div class="main-content">

			<!-- TOPBAR -->
			<div class="topbar">
				<div class="d-flex justify-content-between align-items-center">
					<div class="d-flex align-items-center gap-3">
						<button class="menu-toggle" x-on:click={ "sidebarOpen = !sidebarOpen" }>
							<i class="bi bi-list"></i>
						</button>
						<h5 class="mb-0 d-none d-sm-block">Admin Panel</h5>
					</div>

					<div class="dropdown">
						<button class="btn btn-dark dropdown-toggle" data-bs-toggle="dropdown">
							<i class="bi bi-person-circle me-2"></i>
							<span class="d-none d-sm-inline">{ user.Name }</span>
							<span class="badge ms-1" style="background:#8b5cf6; font-size:0.55rem;">
								{ user.Role }
							</span>
						</button>
						<ul class="dropdown-menu dropdown-menu-dark">
							<li>
								<a class="dropdown-item" href="/">
									<i class="bi bi-house me-2"></i>Lihat Website
								</a>
							</li>
							<li><hr class="dropdown-divider"/></li>
							<li>
								<form action="/logout" method="POST">
									<button type="submit" class="dropdown-item text-danger">
										<i class="bi bi-box-arrow-right me-2"></i>Logout
									</button>
								</form>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- MAIN CONTENT AREA -->
			<main class="p-3 p-md-4 p-lg-5">
				@content
			</main>

		</div>

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
		<script>
			window.confirmDelete = function(form, name) {
				Swal.fire({
					title: 'Hapus Data?',
					html: 'Yakin ingin menghapus <strong style="color: #8b5cf6;">' + name + '</strong>?<br>Data yang dihapus tidak dapat dikembalikan!',
					icon: 'warning',
					showCancelButton: true,
					confirmButtonColor: '#ef4444',
					cancelButtonColor: '#6b7280',
					confirmButtonText: '<i class="bi bi-trash me-2"></i>Ya, Hapus!',
					cancelButtonText: '<i class="bi bi-x-lg me-2"></i>Batal',
					background: '#1e1e1e',
					color: '#ffffff'
				}).then((result) => {
					if (result.isConfirmed) {
						form.submit();
					}
				});
				return false;
			}

			window.showToast = function(icon, title) {
				Swal.fire({
					toast: true,
					position: 'top-end',
					icon: icon,
					title: title,
					showConfirmButton: false,
					timer: 3000,
					timerProgressBar: true,
					background: '#1e1e1e',
					color: '#ffffff'
				});
			}
		</script>
	</body>
	</html>
}

// adminSidebarItem — komponen kecil untuk 1 item sidebar
templ adminSidebarItem(href string, icon string, label string, routeKey string, activePage string) {
	<a href={ templpkg.URL(href) } class={ "sidebar-item", templpkg.KV("active", routeKey == activePage) }>
		<i class={ "bi", icon }></i>
		<span>{ label }</span>
	</a>
}