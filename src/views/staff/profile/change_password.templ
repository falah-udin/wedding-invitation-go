package profile

import (
	"wedding-invitation-go/internal/models"
)

type ChangePasswordData struct {
	User         models.User
	Setting      models.Config
	Success      string
	Error        string
	IsGoogleUser bool
}

templ ChangePasswordPage(data ChangePasswordData) {
	<style>
		.form-control-dark {
			background: #0f0f0f !important;
			border: 1px solid #2a2a2a !important;
			border-radius: 12px !important;
			padding: 12px 16px !important;
			color: #ffffff !important;
			width: 100%;
			transition: all 0.3s;
			padding-right: 45px !important;
		}
		.form-control-dark:focus {
			border-color: #3b82f6 !important;
			box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
			outline: none;
		}
		.form-control-dark::placeholder {
			color: #6b7280;
		}
		.form-label-custom {
			color: #9ca3af;
			font-weight: 500;
			margin-bottom: 6px;
			display: block;
		}
		.card-profile {
			background: #1e1e1e;
			border: 1px solid #2a2a2a;
			border-radius: 20px;
			padding: 30px;
			width: 100%;
			transition: all 0.3s;
		}
		.password-wrapper {
			position: relative;
			width: 100%;
		}
		.password-wrapper .toggle-password {
			position: absolute;
			right: 14px;
			top: 50%;
			transform: translateY(-50%);
			background: transparent;
			border: none;
			color: #6b7280;
			cursor: pointer;
			font-size: 1.2rem;
			padding: 4px 8px;
			transition: all 0.3s;
			z-index: 5;
		}
		.password-wrapper .toggle-password:hover {
			color: #3b82f6;
		}
		@media (max-width: 768px) {
			.card-profile { padding: 24px; }
			.form-control-dark {
				padding: 10px 14px !important;
				padding-right: 40px !important;
				font-size: 0.95rem !important;
			}
			.password-wrapper .toggle-password { font-size: 1rem; right: 10px; }
		}
		@media (max-width: 576px) {
			.card-profile { padding: 16px; border-radius: 16px; }
			.form-control-dark {
				padding: 10px 12px !important;
				padding-right: 36px !important;
				font-size: 0.9rem !important;
			}
			.password-wrapper .toggle-password { font-size: 0.9rem; right: 8px; }
		}
	</style>

	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
		<div>
			<h2 class="fw-bold" style="color: #3b82f6;">
				<i class="bi bi-key me-2"></i>Ganti Sandi
			</h2>
			<p class="text-secondary m-0">Ubah password akun Anda untuk keamanan yang lebih baik</p>
		</div>
		<a href="/staff/dashboard" class="btn btn-secondary" style="background: #2a2a2a; border: none; border-radius: 12px; padding: 8px 20px; color: white; white-space: nowrap;">
			<i class="bi bi-arrow-left me-2"></i>Kembali
		</a>
	</div>

	if data.Success != "" {
		<div class="alert alert-success alert-dismissible fade show mb-4"
		     style="background: rgba(16,185,129,0.1); border-left: 4px solid #10b981; color: #10b981; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-check-circle me-2"></i>
			{ data.Success }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}
	if data.Error != "" {
		<div class="alert alert-danger alert-dismissible fade show mb-4"
		     style="background: rgba(239,68,68,0.1); border-left: 4px solid #ef4444; color: #ef4444; border-radius: 12px; padding: 12px 20px;">
			<i class="bi bi-exclamation-triangle me-2"></i>
			{ data.Error }
			<button type="button" class="btn-close" data-bs-dismiss="alert" style="filter: invert(1);"></button>
		</div>
	}

	if data.IsGoogleUser {
		<div class="card-profile" style="text-align: center;">
			<i class="bi bi-google" style="font-size: 3rem; color: #4285F4; display: block; margin-bottom: 16px;"></i>
			<h5 style="color: white;">Akun Google Terhubung</h5>
			<p class="text-secondary" style="max-width: 500px; margin: 0 auto 20px;">
				Akun Anda terhubung dengan Google. Anda tidak perlu mengganti password di sini — login via tombol <strong>"Login dengan Google"</strong> di halaman login.
			</p>
			<a href="/staff/dashboard" class="btn"
			   style="background: #3b82f6; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600;">
				<i class="bi bi-arrow-left me-2"></i>Kembali ke Dashboard
			</a>
		</div>
	} else {
		<div class="card-profile" style="max-width: 100%;">
			<!-- WARNING BOX -->
			<div class="alert mb-4"
			     style="background: rgba(245,158,11,0.1); border-left: 4px solid #f59e0b; color: #f59e0b; border-radius: 12px; padding: 14px 18px;">
				<div class="d-flex align-items-start gap-2">
					<i class="bi bi-shield-exclamation" style="font-size: 1.2rem; margin-top: 2px;"></i>
					<div style="font-size: 0.85rem; line-height: 1.5;">
						<strong>Perhatian:</strong> Anda akan mengganti password akun di bawah ini.
						Pastikan Anda adalah pemilik akun. Setelah diganti, gunakan password baru untuk login berikutnya.
					</div>
				</div>
			</div>

			<form method="POST" action="/staff/profile/change-password">
				<!-- EMAIL (readonly) -->
				<div class="mb-3">
					<label class="form-label-custom">Email Akun</label>
					<input type="email" value={ data.User.Email } class="form-control-dark" readonly
					       style="background: #0a0a0a !important; color: #6b7280 !important; cursor: not-allowed; padding-right: 16px !important;"/>
				</div>

				<!-- NEW PASSWORD -->
				<div class="mb-3">
					<label class="form-label-custom">Password Baru <span class="text-danger">*</span></label>
					<div class="password-wrapper">
						<input type="password" name="new_password" id="new_password" class="form-control-dark" placeholder="Minimal 6 karakter" required minlength="6"/>
						<button type="button" class="toggle-password" onclick="togglePassword('new_password', this)">
							<i class="bi bi-eye"></i>
						</button>
					</div>
					<small class="text-secondary d-block mt-1" style="font-size:0.7rem;">
						<i class="bi bi-info-circle me-1"></i>Minimal 6 karakter
					</small>
				</div>

				<!-- CONFIRM NEW PASSWORD -->
				<div class="mb-4">
					<label class="form-label-custom">Konfirmasi Password Baru <span class="text-danger">*</span></label>
					<div class="password-wrapper">
						<input type="password" name="new_password_confirmation" id="new_password_confirmation" class="form-control-dark" placeholder="Ketik ulang password baru" required/>
						<button type="button" class="toggle-password" onclick="togglePassword('new_password_confirmation', this)">
							<i class="bi bi-eye"></i>
						</button>
					</div>
				</div>

				<!-- SUBMIT -->
				<button type="submit" class="btn w-100"
				        style="background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%); color: white; border: none; padding: 12px; border-radius: 12px; font-weight: 600;">
					<i class="bi bi-save me-2"></i>Simpan Password Baru
				</button>

				<div class="mt-3 text-center">
					<small class="text-secondary">
						<i class="bi bi-shield-check me-1"></i>
						Password Anda akan dienkripsi untuk keamanan
					</small>
				</div>
			</form>
		</div>
	}

	<script>
		function togglePassword(inputId, button) {
			const input = document.getElementById(inputId);
			const icon = button.querySelector('i');

			if (input.type === 'password') {
				input.type = 'text';
				icon.classList.remove('bi-eye');
				icon.classList.add('bi-eye-slash');
			} else {
				input.type = 'password';
				icon.classList.remove('bi-eye-slash');
				icon.classList.add('bi-eye');
			}
		}
	</script>
}
