package dashboard

import (
	"fmt"
	"time"
	"wedding-invitation-go/internal/models"
)

type DashboardData struct {
	User           models.User
	Setting        models.Config
	TotalProjects  int
	TotalDraft     int
	TotalPublished int
	TotalArchived  int
	TotalViews     int
	TotalRsvp      int
	TotalClients   int
	StaleDrafts    []models.Project
	RecentProjects []models.Project
	TopViewed      []models.Project
}

templ DashboardPage(data DashboardData) {
	<style>
		.stat-card-main {
			background: #1e1e1e;
			border-radius: 16px;
			border: 1px solid #2a2a2a;
			padding: 16px;
			text-align: center;
			transition: all 0.2s;
		}
		.stat-card-main:hover {
			transform: translateY(-2px);
			box-shadow: 0 8px 25px rgba(59,130,246,0.08);
		}
		.table-custom {
			color: #ffffff !important;
			background: transparent !important;
			width: 100%;
		}
		.table-custom thead th {
			color: #3b82f6 !important;
			background: transparent !important;
			border-bottom: 1px solid #2a2a2a !important;
			font-weight: 500 !important;
			font-size: 0.8rem !important;
			padding: 14px 16px !important;
		}
		.table-custom tbody td {
			color: #d1d5db !important;
			background: transparent !important;
			border-bottom: 1px solid #2a2a2a !important;
			padding: 12px 16px !important;
			font-size: 0.85rem !important;
			vertical-align: middle !important;
		}
		.table-custom tbody tr:last-child td {
			border-bottom: none !important;
		}
		.table-custom tbody tr:hover {
			background: rgba(59,130,246,0.05) !important;
		}
		.badge-status {
			font-size: 0.65rem;
			padding: 4px 10px;
			border-radius: 10px;
			font-weight: 600;
		}
		.badge-status.published { background: #10b981; color: white; }
		.badge-status.draft { background: #f59e0b; color: #1a1a1a; }
		.badge-status.archived { background: #6b7280; color: white; }
	</style>

	<!-- HEADER -->
	<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
		<div>
			<h2 class="fw-bold mb-1" style="color: #3b82f6;">
				<i class="bi bi-speedometer2 me-2"></i>Dashboard Staff
			</h2>
			<p class="text-secondary m-0">
				Selamat datang, <strong style="color:white;">{ data.User.Name }</strong>!
				<span class="badge ms-1" style="background:#3b82f6;">Staff</span>
			</p>
		</div>
		<a href="/invitation/create/select-client"
		   class="btn"
		   style="background: #3b82f6; color: white; border: none; padding: 10px 24px; border-radius: 12px; font-weight: 600; white-space: nowrap;">
			<i class="bi bi-plus-circle me-2"></i>Buat Undangan
		</a>
	</div>

	<!-- STATS UTAMA -->
	<div class="row g-3 mb-4">
		<div class="col-6 col-md-3">
			<div class="stat-card-main" style="border-top: 4px solid #10b981;">
				<i class="bi bi-envelope-paper fs-2 mb-2" style="color:#10b981;"></i>
				<h6 class="mb-1" style="color:#9ca3af; font-size:0.75rem;">Total Project</h6>
				<h2 class="fw-bold mb-0" style="color:white; font-size:2rem;">{ fmt.Sprintf("%d", data.TotalProjects) }</h2>
			</div>
		</div>
		<div class="col-6 col-md-3">
			<div class="stat-card-main" style="border-top: 4px solid #f59e0b;">
				<i class="bi bi-pencil-square fs-2 mb-2" style="color:#f59e0b;"></i>
				<h6 class="mb-1" style="color:#9ca3af; font-size:0.75rem;">Draft</h6>
				<h2 class="fw-bold mb-0" style="color:white; font-size:2rem;">{ fmt.Sprintf("%d", data.TotalDraft) }</h2>
			</div>
		</div>
		<div class="col-6 col-md-3">
			<div class="stat-card-main" style="border-top: 4px solid #34d399;">
				<i class="bi bi-check-circle fs-2 mb-2" style="color:#34d399;"></i>
				<h6 class="mb-1" style="color:#9ca3af; font-size:0.75rem;">Published</h6>
				<h2 class="fw-bold mb-0" style="color:white; font-size:2rem;">{ fmt.Sprintf("%d", data.TotalPublished) }</h2>
			</div>
		</div>
		<div class="col-6 col-md-3">
			<div class="stat-card-main" style="border-top: 4px solid #ec489a;">
				<i class="bi bi-envelope-check fs-2 mb-2" style="color:#ec489a;"></i>
				<h6 class="mb-1" style="color:#9ca3af; font-size:0.75rem;">Total RSVP</h6>
				<h2 class="fw-bold mb-0" style="color:white; font-size:2rem;">{ fmt.Sprintf("%d", data.TotalRsvp) }</h2>
			</div>
		</div>
	</div>

	<!-- STATS SECONDARY -->
	<div class="row g-3 mb-4">
		<div class="col-12 col-md-4">
			<div class="p-3 d-flex align-items-center gap-3" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<div style="width:42px; height:42px; background:rgba(139,92,246,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center;">
					<i class="bi bi-eye" style="color:#8b5cf6; font-size:1.2rem;"></i>
				</div>
				<div>
					<div style="color:#9ca3af; font-size:0.7rem;">Total Views</div>
					<div style="color:white; font-weight:700; font-size:1.1rem;">{ fmt.Sprintf("%d", data.TotalViews) }</div>
				</div>
			</div>
		</div>
		<div class="col-12 col-md-4">
			<div class="p-3 d-flex align-items-center gap-3" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<div style="width:42px; height:42px; background:rgba(16,185,129,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center;">
					<i class="bi bi-people" style="color:#10b981; font-size:1.2rem;"></i>
				</div>
				<div>
					<div style="color:#9ca3af; font-size:0.7rem;">Total Client</div>
					<div style="color:white; font-weight:700; font-size:1.1rem;">{ fmt.Sprintf("%d", data.TotalClients) }</div>
				</div>
			</div>
		</div>
		<div class="col-12 col-md-4">
			<div class="p-3 d-flex align-items-center gap-3" style="background:#1e1e1e; border-radius:12px; border:1px solid #2a2a2a;">
				<div style="width:42px; height:42px; background:rgba(107,114,128,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center;">
					<i class="bi bi-archive" style="color:#6b7280; font-size:1.2rem;"></i>
				</div>
				<div>
					<div style="color:#9ca3af; font-size:0.7rem;">Archived</div>
					<div style="color:white; font-weight:700; font-size:1.1rem;">{ fmt.Sprintf("%d", data.TotalArchived) }</div>
				</div>
			</div>
		</div>
	</div>

	<!-- STALE DRAFTS -->
	if len(data.StaleDrafts) > 0 {
		<div class="mb-4" style="background:#1e1e1e; border-radius:16px; border:1px solid #f59e0b; overflow:hidden;">
			<div class="p-3" style="border-bottom:1px solid #2a2a2a; background:rgba(245,158,11,0.05);">
				<h5 class="mb-0" style="color:#f59e0b; font-size:1rem;">
					<i class="bi bi-exclamation-triangle me-2"></i>Draft Butuh Perhatian
					<span class="badge ms-2" style="background:#f59e0b; color:#1a1a1a;">{ fmt.Sprintf("%d", len(data.StaleDrafts)) }</span>
				</h5>
				<small style="color:#9ca3af; font-size:0.75rem;">Draft yang sudah lebih dari 7 hari belum dipublish</small>
			</div>
			<div class="table-responsive">
				<table class="table-custom mb-0">
					<thead>
						<tr>
							<th>Judul</th>
							<th>Client</th>
							<th>Umur</th>
							<th style="text-align:right;">Aksi</th>
						</tr>
					</thead>
					<tbody>
						for _, d := range data.StaleDrafts {
							<tr>
								<td>
									<div style="color:white; font-weight:600;">{ d.Title }</div>
								</td>
								<td>
									if d.User != nil {
										{ d.User.Name }
									} else {
										Unknown
									}
								</td>
								<td style="color:#f59e0b;">
									<i class="bi bi-clock me-1"></i>
									{ daysAgo(d.CreatedAt) }
								</td>
								<td style="text-align:right;">
									<a href={ templ.URL(fmt.Sprintf("/invitation/create/edit/%d", d.ID)) }
									   class="btn btn-sm" style="background:#f59e0b; color:#1a1a1a; border-radius:8px; font-weight:600;">
										<i class="bi bi-pencil me-1"></i>Lanjutkan
									</a>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}

	<!-- RECENT PROJECTS -->
	<div class="mb-4" style="background:#1e1e1e; border-radius:16px; border:1px solid #2a2a2a; overflow:hidden;">
		<div class="p-3" style="border-bottom:1px solid #2a2a2a;">
			<h5 class="mb-0" style="color:#3b82f6; font-size:1rem;">
				<i class="bi bi-clock-history me-2"></i>Project Terbaru
			</h5>
		</div>
		<div class="table-responsive">
			<table class="table-custom mb-0">
				<thead>
					<tr>
						<th>Judul</th>
						<th>Client</th>
						<th>Status</th>
						<th>Dibuat</th>
					</tr>
				</thead>
				<tbody>
					if len(data.RecentProjects) > 0 {
						for _, p := range data.RecentProjects {
							<tr>
								<td>
									<div style="color:white; font-weight:600;">{ p.Title }</div>
								</td>
								<td>
									if p.User != nil {
										{ p.User.Name }
									} else {
										Unknown
									}
								</td>
								<td>
									<span class={ "badge-status", p.Status }>{ p.Status }</span>
								</td>
								<td style="color:#6b7280; font-size:0.8rem;">
									{ p.CreatedAt.Format("02/01/2006") }
								</td>
							</tr>
						}
					} else {
						<tr>
							<td colspan="4" style="text-align:center; padding:40px; color:#6b7280;">
								<i class="bi bi-inbox fs-3 d-block mb-2"></i>
								Belum ada project
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>

	<!-- TOP VIEWED -->
	if len(data.TopViewed) > 0 {
		<div class="mb-4" style="background:#1e1e1e; border-radius:16px; border:1px solid #2a2a2a; overflow:hidden;">
			<div class="p-3" style="border-bottom:1px solid #2a2a2a;">
				<h5 class="mb-0" style="color:#8b5cf6; font-size:1rem;">
					<i class="bi bi-trophy me-2"></i>Project Paling Banyak Dilihat
				</h5>
			</div>
			<div class="table-responsive">
				<table class="table-custom mb-0">
					<thead>
						<tr>
							<th style="width:60px;">#</th>
							<th>Judul</th>
							<th>Client</th>
							<th style="text-align:right;">Views</th>
						</tr>
					</thead>
					<tbody>
						for i, p := range data.TopViewed {
							<tr>
								<td style="color:#8b5cf6; font-weight:700; font-size:1.1rem;">#{ fmt.Sprintf("%d", i+1) }</td>
								<td style="color:white;">{ p.Title }</td>
								<td>
									if p.User != nil {
										{ p.User.Name }
									} else {
										Unknown
									}
								</td>
								<td style="text-align:right;">
									<span class="badge" style="background:#8b5cf6;">
										<i class="bi bi-eye me-1"></i>{ fmt.Sprintf("%d", p.TotalViews) }
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}

	<!-- INFO AKUN -->
	<div class="p-4" style="background:#1e1e1e; border-radius:16px; border:1px solid #2a2a2a;">
		<h5 class="fw-bold mb-3" style="color:#3b82f6; font-size:1rem;">
			<i class="bi bi-info-circle me-2"></i>Informasi Akun
		</h5>
		<div class="row g-3">
			<div class="col-12 col-md-6">
				<div class="d-flex justify-content-between py-2" style="border-bottom:1px solid #2a2a2a;">
					<span style="color:#9ca3af;">Nama</span>
					<span style="color:white;">{ data.User.Name }</span>
				</div>
			</div>
			<div class="col-12 col-md-6">
				<div class="d-flex justify-content-between py-2" style="border-bottom:1px solid #2a2a2a;">
					<span style="color:#9ca3af;">Email</span>
					<span style="color:white;">{ data.User.Email }</span>
				</div>
			</div>
			<div class="col-12 col-md-6">
				<div class="d-flex justify-content-between py-2" style="border-bottom:1px solid #2a2a2a;">
					<span style="color:#9ca3af;">Role</span>
					<span class="badge" style="background:#3b82f6;">{ data.User.Role }</span>
				</div>
			</div>
			<div class="col-12 col-md-6">
				<div class="d-flex justify-content-between py-2" style="border-bottom:1px solid #2a2a2a;">
					<span style="color:#9ca3af;">Terdaftar Sejak</span>
					<span style="color:white;">{ data.User.CreatedAt.Format("02 Jan 2006") }</span>
				</div>
			</div>
		</div>
	</div>
}

// daysAgo — format "X hari lalu"
func daysAgo(t time.Time) string {
	d := time.Since(t)
	days := int(d.Hours() / 24)
	if days > 0 {
		if days == 1 {
			return "1 hari lalu"
		}
		return fmt.Sprintf("%d hari lalu", days)
	}
	hours := int(d.Hours())
	if hours > 0 {
		if hours == 1 {
			return "1 jam lalu"
		}
		return fmt.Sprintf("%d jam lalu", hours)
	}
	return "baru saja"
}
