# ============================================
# APPLICATION
# ============================================
APP_NAME="Wedding Invitation Go"
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8086
APP_DEBUG=true

# ============================================
# DATABASE
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=wedding_invitation_db
